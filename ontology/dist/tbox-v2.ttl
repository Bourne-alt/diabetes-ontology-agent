    .
dmo:supportsDiagnosis a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "supportsDiagnosis" ;
    rdfs:domain dmo:Assessment ;
    rdfs:range dmo:Diagnosis ;
    rdfs:comment "评估支持但不单独决定的诊断记录。" ;
    .
dmo:hasMedicationUse a owl:ObjectProperty, owl:InverseFunctionalProperty ;
