    rdfs:comment "推荐适用的分型。" ;
    .
dmo:targetsComplication a owl:ObjectProperty ;
    rdfs:label "targetsComplication" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range dmo:Complication ;
    rdfs:comment "推荐针对的并发症。" ;
    .
dmo:recommendsDrugClass a owl:ObjectProperty ;
    rdfs:label "recommendsDrugClass" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range dmo:DrugClass ;
    rdfs:comment "推荐涉及的药物类别（类别级，不到具体剂量）。" ;
    .
dmo:recommendsLifestyle a owl:ObjectProperty ;
    rdfs:label "recommendsLifestyle" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range dmo:LifestyleIntervention ;
    rdfs:comment "推荐涉及的生活方式干预。" ;
    .
dmo:definesTarget a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "definesTarget" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range dmo:GlycemicTarget ;
    rdfs:comment "推荐所定义的管理目标区间。" ;
    .
dmo:definesSchedule a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "definesSchedule" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range dmo:MonitoringSchedule ;
    rdfs:comment "推荐所定义的随访/筛查频率。" ;
    .
dmo:schedulesTest a owl:ObjectProperty ;
    rdfs:label "schedulesTest" ;
    rdfs:domain dmo:MonitoringSchedule ;
    rdfs:range dmo:LabTest ;
    rdfs:comment "随访计划所安排的检验项目。" ;
    .
dmo:targetMeasuredBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "targetMeasuredBy" ;
    rdfs:domain dmo:GlycemicTarget ;
    rdfs:range dmo:LabTest ;
    rdfs:comment "目标所依据的检验项目。" ;
    .
dmo:citesSource a owl:ObjectProperty ;
    rdfs:label "citesSource" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range dmo:GuidelineSource ;
    rdfs:comment "推荐的出处。每条回答必须能回溯到这里。" ;
    .
dmo:hasClinicalObservation a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "hasClinicalObservation" ;
    rdfs:domain dmo:Patient ;
    rdfs:range dmo:ClinicalObservation ;
    rdfs:comment "患者历次非实验室临床观察。" ;
    .
dmo:observationRecordedAt a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "observationRecordedAt" ;
    rdfs:domain dmo:ClinicalObservation ;
    rdfs:range dmo:ClinicalEncounter ;
    rdfs:comment "临床观察记录所在的就诊事件。" ;
