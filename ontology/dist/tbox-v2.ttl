    rdfs:range dmo:LabResult ;
    rdfs:comment "评估使用的一个或多个检验结果。" ;
    .
dmo:appliesThreshold a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "appliesThreshold" ;
    rdfs:domain dmo:Assessment ;
    rdfs:range dmo:DiagnosticThreshold ;
