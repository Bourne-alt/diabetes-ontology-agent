# 由 build_tbox.py 从 diabetes-ontology-v2.json 生成，不要手改。
# 手写公理见 ontology/src/dmo-axioms.ttl。

@prefix dmo:  <https://example.org/dmo#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo> a owl:Ontology ;
    rdfs:label "Diabetes Care Ontology V2 — TBox 骨架" ;
    rdfs:comment "机械生成部分。公理层见 dmo-axioms.ttl。" .

# ─── 标注属性 ────────────────────────────────────────────────
dmo:unit a owl:AnnotationProperty ;
    rdfs:comment "属性取值的计量单位" .
dmo:evidenceQuote a owl:AnnotationProperty ;
    rdfs:comment "支持该断言的原文逐字片段" .
dmo:tboxRoute a owl:AnnotationProperty ;
    rdfs:comment "该类型走 §2.3 的哪条路线：class / skos / individual" .

# ─── 实体类型 → owl:Class ────────────────────────────────────
dmo:Patient a owl:Class ;
    rdfs:label "Patient" ;
    rdfs:comment "接受糖尿病筛查、诊断或管理的个体。只保存稳定人口学属性；会随时间变化的临床事实通过就诊、观察、诊断和用药记录表达。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:DiabetesType a owl:Class ;
    rdfs:label "DiabetesType" ;
    rdfs:comment "糖尿病分型术语节点（T1DM / T2DM / GDM / 单基因 / 前期 / 继发性）。ER 模型中分型是实例而非子类，OWL 子类层次另在 Turtle TBox 中维护。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:ClinicalEncounter a owl:Class ;
    rdfs:label "ClinicalEncounter" ;
    rdfs:comment "一次就诊/接触事件，是检验结果的时间锚点。妊娠相关就诊记录孕周。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:LabTest a owl:Class ;
    rdfs:label "LabTest" ;
    rdfs:comment "检验项目定义（术语层），如 A1C、FPG、OGTT-2h、随机血糖、UACR、eGFR、尿酮体。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:LabResult a owl:Class ;
    rdfs:label "LabResult" ;
    rdfs:comment "患者在特定时间完成的一次检验结果。只保存原始测量事实；诊断或目标解释由独立 Assessment 实体记录。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:DiagnosticThreshold a owl:Class ;
    rdfs:label "DiagnosticThreshold" ;
    rdfs:comment "把数值区间映射到分类结论的阈值节点。这是数值推理的落点——OWL-RL 做不到数值区间推理，因此阈值建模为数据，由 SPARQL CONSTRUCT 消费。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:GlycemicTarget a owl:Class ;
    rdfs:label "GlycemicTarget" ;
    rdfs:comment "血糖管理目标区间，仅包含 A1C、餐前/餐后血糖和 TIR；血压与血脂等非血糖目标不在此实体中。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:Complication a owl:Class ;
    rdfs:label "Complication" ;
    rdfs:comment "糖尿病并发症与合并症，含慢性（DKD/DR/DPN/DFU/CVD）与急性（低血糖/DKA/HHS）两类。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:ComplicationStage a owl:Class ;
    rdfs:label "ComplicationStage" ;
    rdfs:comment "并发症分期节点（NPDR→PDR、CKD G1-G5/A1-A3、低血糖 Level 1-3）。stageOrder 支撑 OWL TransitiveProperty worseThan 的传递闭包。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:Symptom a owl:Class ;
    rdfs:label "Symptom" ;
    rdfs:comment "症状/体征节点，用于「症状 → 可能情形」的多跳检索与急诊分流。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:RiskFactor a owl:Class ;
    rdfs:label "RiskFactor" ;
    rdfs:comment "风险因素节点，区分可干预与不可干预——这是生活方式干预建议能否落地的判据。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:DrugClass a owl:Class ;
    rdfs:label "DrugClass" ;
    rdfs:comment "降糖药物类别（二甲双胍/SU/TZD/DPP4i/SGLT2i/GLP-1RA/胰岛素等）。禁忌与不良反应挂在类别层，而非单药层。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:Medication a owl:Class ;
    rdfs:label "Medication" ;
    rdfs:comment "具体药物成分节点（通用名）。胰岛素的时效属性放在这一层，因为同类胰岛素起效时间差异显著。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:Contraindication a owl:Class ;
    rdfs:label "Contraindication" ;
    rdfs:comment "禁忌/慎用规则节点。这是「一般用 X，除非 Y」这类默认规则的落点——不进 OWL TBox，作为数据由 SHACL 安全形状消费。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:AdverseEffect a owl:Class ;
    rdfs:label "AdverseEffect" ;
    rdfs:comment "药物不良反应节点。与 Complication 分开：不良反应归因于药物，并发症归因于疾病；低血糖两者都可指向，靠边不同区分。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:LifestyleIntervention a owl:Class ;
    rdfs:label "LifestyleIntervention" ;
    rdfs:comment "生活方式干预节点（营养、身体活动、体重管理、戒烟、自我管理教育 DSMES）。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:Device a owl:Class ;
    rdfs:label "Device" ;
    rdfs:comment "监测与给药设备节点（CGM、胰岛素泵、血糖仪、人工胰腺、尿酮试纸）。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:MonitoringSchedule a owl:Class ;
    rdfs:label "MonitoringSchedule" ;
    rdfs:comment "随访/筛查频率节点（UACR 与 eGFR 每年、散瞳眼底每年、A1C 每 3 个月、GDM 24-28 周、正常者每 3 年复查）。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:ClinicalObservation a owl:Class ;
    rdfs:label "ClinicalObservation" ;
    rdfs:comment "患者在特定时间的非实验室临床观察，如 BMI、血压、吸烟状态、妊娠状态和孕周。用于替代 Patient 上会随时间变化的属性。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:Diagnosis a owl:Class ;
    rdfs:label "Diagnosis" ;
    rdfs:comment "患者的一次诊断或临床判断记录，连接患者、就诊、疾病术语和分期；保留诊断状态、确定性与时间。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:Assessment a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "基于一个或多个检验结果和版本化规则生成的解释结论；不覆盖原始 LabResult。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:MedicationUse a owl:Class ;
    rdfs:label "MedicationUse" ;
    rdfs:comment "患者使用某种药物的一段治疗记录，连接患者、药物、诊断与就诊；刻意不包含剂量字段。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:SourcePassage a owl:Class ;
    rdfs:label "SourcePassage" ;
    rdfs:comment "指南中的具体证据片段，记录页码、章节或文本定位，使阈值、推荐与安全规则可精确追溯。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:Recommendation a owl:Class ;
    rdfs:label "Recommendation" ;
    rdfs:comment "指南推荐条目。指南逻辑一律建模为数据实例而非 TBox 公理——这是本设计最关键的一条边界。" ;
    dmo:tboxRoute "individual" ;
    .

dmo:GuidelineSource a owl:Class ;
    rdfs:label "GuidelineSource" ;
    rdfs:comment "出处节点。provenance 是本体 agent 相对纯 RAG 的核心卖点，因此出处是一等公民实体，而不是字符串字段。" ;
    dmo:tboxRoute "individual" ;
    .

# ─── 属性 → owl:DatatypeProperty ─────────────────────────────
dmo:activityTarget a owl:DatatypeProperty ;
    rdfs:label "activityTarget" ;
    rdfs:domain dmo:LifestyleIntervention ;
    rdfs:range xsd:string ;
    rdfs:comment "可量化目标，如「每周 150 分钟中等强度活动」「减重 5%-7%」" ;
    .
dmo:adminRoute a owl:DatatypeProperty ;
    rdfs:label "adminRoute" ;
    rdfs:domain dmo:DrugClass ;
    rdfs:range xsd:string ;
    rdfs:comment "给药途径" ;
    .
dmo:adverseEffectCode a owl:DatatypeProperty ;
    rdfs:label "adverseEffectCode" ;
    rdfs:domain dmo:AdverseEffect ;
    rdfs:range xsd:string ;
    rdfs:comment "不良反应编码" ;
    .
dmo:affectedOrgan a owl:DatatypeProperty ;
    rdfs:label "affectedOrgan" ;
    rdfs:domain dmo:Complication ;
    rdfs:range xsd:string ;
    rdfs:comment "受累器官；对应 OWL 属性链 hasComplication ∘ affectsOrgan" ;
    .
dmo:applicableContext a owl:DatatypeProperty ;
    rdfs:label "applicableContext" ;
    rdfs:domain dmo:Assessment ;
    rdfs:range xsd:string ;
    rdfs:comment "评估时使用的人群与临床上下文" ;
    .
dmo:appliesTo a owl:DatatypeProperty ;
    rdfs:label "appliesTo" ;
    rdfs:domain dmo:MonitoringSchedule ;
    rdfs:range xsd:string ;
    rdfs:comment "适用人群描述" ;
    .
dmo:assessedAt a owl:DatatypeProperty ;
    rdfs:label "assessedAt" ;
    rdfs:domain dmo:Assessment ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "评估生成时间" ;
    .
dmo:assessmentId a owl:DatatypeProperty ;
    rdfs:label "assessmentId" ;
    rdfs:domain dmo:Assessment ;
    rdfs:range xsd:string ;
    rdfs:comment "评估唯一标识" ;
    .
dmo:atcCode a owl:DatatypeProperty ;
    rdfs:label "atcCode" ;
    rdfs:domain dmo:DrugClass ;
    rdfs:range xsd:string ;
    rdfs:comment "ATC 编码引用（WHO 版权，仅存 code+label）" ;
    .
dmo:birthYear a owl:DatatypeProperty ;
    rdfs:label "birthYear" ;
    rdfs:domain dmo:Patient ;
    rdfs:range xsd:integer ;
    rdfs:comment "出生年份，用于推导年龄相关风险（≥35 岁列为 T2DM 筛查人群）" ;
    .
dmo:boundUnit a owl:DatatypeProperty ;
    rdfs:label "boundUnit" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range xsd:string ;
    rdfs:comment "边界单位" ;
    .
dmo:classification a owl:DatatypeProperty ;
    rdfs:label "classification" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range xsd:string ;
    rdfs:comment "该区间对应的分类结论" ;
    .
dmo:clinicalStatus a owl:DatatypeProperty ;
    rdfs:label "clinicalStatus" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range xsd:string ;
    rdfs:comment "当前临床状态" ;
    .
dmo:codeSystem a owl:DatatypeProperty ;
    rdfs:label "codeSystem" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range xsd:string ;
    rdfs:comment "该临床记录采用的编码体系，如 ICD-10-CM 或 SNOMED CT" ;
    .
dmo:collectedAt a owl:DatatypeProperty ;
    rdfs:label "collectedAt" ;
    rdfs:domain dmo:LabResult ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "采样时间" ;
    .
dmo:complicationCode a owl:DatatypeProperty ;
    rdfs:label "complicationCode" ;
    rdfs:domain dmo:Complication ;
    rdfs:range xsd:string ;
    rdfs:comment "并发症编码，如 DKD / DR / DME / DPN / DFU / CVD / HYPO / DKA" ;
    .
dmo:conclusion a owl:DatatypeProperty ;
    rdfs:label "conclusion" ;
    rdfs:domain dmo:Assessment ;
    rdfs:range xsd:string ;
    rdfs:comment "规则得出的解释结论" ;
    .
dmo:confirmationRequired a owl:DatatypeProperty ;
    rdfs:label "confirmationRequired" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range xsd:boolean ;
    rdfs:comment "是否需要复测或额外临床证据确认" ;
    .
dmo:contentHash a owl:DatatypeProperty ;
    rdfs:label "contentHash" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dmo:GuidelineSource dmo:SourcePassage ) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "规范化片段 SHA-256" ;
    .
dmo:contraCode a owl:DatatypeProperty ;
    rdfs:label "contraCode" ;
    rdfs:domain dmo:Contraindication ;
    rdfs:range xsd:string ;
    rdfs:comment "禁忌规则编码" ;
    .
dmo:definition a owl:DatatypeProperty ;
    rdfs:label "definition" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dmo:Complication dmo:DiabetesType dmo:LabTest ) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "来源原文的定义摘录" ;
    .
dmo:deviceCode a owl:DatatypeProperty ;
    rdfs:label "deviceCode" ;
    rdfs:domain dmo:Device ;
    rdfs:range xsd:string ;
    rdfs:comment "设备编码" ;
    .
dmo:deviceType a owl:DatatypeProperty ;
    rdfs:label "deviceType" ;
    rdfs:domain dmo:Device ;
    rdfs:range xsd:string ;
    rdfs:comment "设备类别" ;
    .
dmo:diabetesTypeCode a owl:DatatypeProperty ;
    rdfs:label "diabetesTypeCode" ;
    rdfs:domain dmo:DiabetesType ;
    rdfs:range xsd:string ;
    rdfs:comment "分型编码，如 T1DM / T2DM / GDM / MODY / PREDIABETES" ;
    .
dmo:diagnosedDate a owl:DatatypeProperty ;
    rdfs:label "diagnosedDate" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range xsd:date ;
    rdfs:comment "诊断日期" ;
    .
dmo:diagnosisId a owl:DatatypeProperty ;
    rdfs:label "diagnosisId" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range xsd:string ;
    rdfs:comment "诊断记录唯一标识" ;
    .
dmo:diagnosisKind a owl:DatatypeProperty ;
    rdfs:label "diagnosisKind" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range xsd:string ;
    rdfs:comment "诊断记录类别" ;
    .
dmo:documentVersion a owl:DatatypeProperty ;
    rdfs:label "documentVersion" ;
    rdfs:domain dmo:GuidelineSource ;
    rdfs:range xsd:string ;
    rdfs:comment "指南或文档版本" ;
    .
dmo:drugClassCode a owl:DatatypeProperty ;
    rdfs:label "drugClassCode" ;
    rdfs:domain dmo:DrugClass ;
    rdfs:range xsd:string ;
    rdfs:comment "类别编码，如 BIGUANIDE / SGLT2I / GLP1RA / SU / TZD / DPP4I / INSULIN" ;
    .
dmo:durationHours a owl:DatatypeProperty ;
    rdfs:label "durationHours" ;
    rdfs:domain dmo:Medication ;
    rdfs:range xsd:decimal ;
    rdfs:comment "作用持续时间（小时）" ;
    dmo:unit "hour" ;
    .
dmo:encounterDate a owl:DatatypeProperty ;
    rdfs:label "encounterDate" ;
    rdfs:domain dmo:ClinicalEncounter ;
    rdfs:range xsd:date ;
    rdfs:comment "就诊日期" ;
    .
dmo:encounterId a owl:DatatypeProperty ;
    rdfs:label "encounterId" ;
    rdfs:domain dmo:ClinicalEncounter ;
    rdfs:range xsd:string ;
    rdfs:comment "就诊唯一标识" ;
    .
dmo:encounterType a owl:DatatypeProperty ;
    rdfs:label "encounterType" ;
    rdfs:domain dmo:ClinicalEncounter ;
    rdfs:range xsd:string ;
    rdfs:comment "就诊类型" ;
    .
dmo:endDate a owl:DatatypeProperty ;
    rdfs:label "endDate" ;
    rdfs:domain dmo:MedicationUse ;
    rdfs:range xsd:date ;
    rdfs:comment "结束日期" ;
    .
dmo:evidenceNote a owl:DatatypeProperty ;
    rdfs:label "evidenceNote" ;
    rdfs:domain dmo:RiskFactor ;
    rdfs:range xsd:string ;
    rdfs:comment "证据说明与出处" ;
    .
dmo:expectedBenefit a owl:DatatypeProperty ;
    rdfs:label "expectedBenefit" ;
    rdfs:domain dmo:LifestyleIntervention ;
    rdfs:range xsd:string ;
    rdfs:comment "预期收益，如「T2DM 发病风险降低 58%（60 岁以上 71%）」" ;
    .
dmo:externalCode a owl:DatatypeProperty ;
    rdfs:label "externalCode" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range xsd:string ;
    rdfs:comment "编码体系中的诊断代码" ;
    .
dmo:fastingRequired a owl:DatatypeProperty ;
    rdfs:label "fastingRequired" ;
    rdfs:domain dmo:LabTest ;
    rdfs:range xsd:boolean ;
    rdfs:comment "是否需要空腹（FPG、OGTT 需空腹≥8 小时）" ;
    .
dmo:frequencyCategory a owl:DatatypeProperty ;
    rdfs:label "frequencyCategory" ;
    rdfs:domain dmo:AdverseEffect ;
    rdfs:range xsd:string ;
    rdfs:comment "发生频度分类" ;
    .
dmo:frequencyMonths a owl:DatatypeProperty ;
    rdfs:label "frequencyMonths" ;
    rdfs:domain dmo:MonitoringSchedule ;
    rdfs:range xsd:integer ;
    rdfs:comment "间隔月数；一次性窗口筛查留空并用 triggerWindow 表达" ;
    dmo:unit "month" ;
    .
dmo:gestationalWeek a owl:DatatypeProperty ;
    rdfs:label "gestationalWeek" ;
    rdfs:domain dmo:ClinicalEncounter ;
    rdfs:range xsd:integer ;
    rdfs:comment "孕周；GDM 筛查窗口为 24-28 周" ;
    dmo:unit "week" ;
    .
dmo:gradingSystem a owl:DatatypeProperty ;
    rdfs:label "gradingSystem" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range xsd:string ;
    rdfs:comment "证据分级体系，如 ADA、GRADE、VA-DoD" ;
    .
dmo:hpoCode a owl:DatatypeProperty ;
    rdfs:label "hpoCode" ;
    rdfs:domain dmo:Symptom ;
    rdfs:range xsd:string ;
    rdfs:comment "HPO CURIE 引用" ;
    .
dmo:hypoglycemiaRisk a owl:DatatypeProperty ;
    rdfs:label "hypoglycemiaRisk" ;
    rdfs:domain dmo:DrugClass ;
    rdfs:range xsd:string ;
    rdfs:comment "致低血糖风险；SU 与胰岛素为 High" ;
    .
dmo:indicationText a owl:DatatypeProperty ;
    rdfs:label "indicationText" ;
    rdfs:domain dmo:MedicationUse ;
    rdfs:range xsd:string ;
    rdfs:comment "适应证摘要；结构化适应证通过 treatsDiagnosis 关系表达" ;
    .
dmo:insulinAction a owl:DatatypeProperty ;
    rdfs:label "insulinAction" ;
    rdfs:domain dmo:Medication ;
    rdfs:range xsd:string ;
    rdfs:comment "胰岛素时效分类" ;
    .
dmo:insulinRequired a owl:DatatypeProperty ;
    rdfs:label "insulinRequired" ;
    rdfs:domain dmo:DiabetesType ;
    rdfs:range xsd:boolean ;
    rdfs:comment "是否必须依赖外源胰岛素维持生命（T1DM 为真）" ;
    .
dmo:interventionCode a owl:DatatypeProperty ;
    rdfs:label "interventionCode" ;
    rdfs:domain dmo:LifestyleIntervention ;
    rdfs:range xsd:string ;
    rdfs:comment "干预编码" ;
    .
dmo:interventionType a owl:DatatypeProperty ;
    rdfs:label "interventionType" ;
    rdfs:domain dmo:LifestyleIntervention ;
    rdfs:range xsd:string ;
    rdfs:comment "干预类别" ;
    .
dmo:isEmergency a owl:DatatypeProperty ;
    rdfs:label "isEmergency" ;
    rdfs:domain dmo:Complication ;
    rdfs:range xsd:boolean ;
    rdfs:comment "是否属于需急诊处理的情形（DKA、严重低血糖为真）" ;
    .
dmo:isInsulin a owl:DatatypeProperty ;
    rdfs:label "isInsulin" ;
    rdfs:domain dmo:Medication ;
    rdfs:range xsd:boolean ;
    rdfs:comment "是否为胰岛素制剂" ;
    .
dmo:isRealTime a owl:DatatypeProperty ;
    rdfs:label "isRealTime" ;
    rdfs:domain dmo:Device ;
    rdfs:range xsd:boolean ;
    rdfs:comment "是否提供连续实时数据（CGM 可在夜间低血糖时报警）" ;
    .
dmo:jurisdiction a owl:DatatypeProperty ;
    rdfs:label "jurisdiction" ;
    rdfs:domain dmo:GuidelineSource ;
    rdfs:range xsd:string ;
    rdfs:comment "适用国家、地区或医疗体系" ;
    .
dmo:labResultId a owl:DatatypeProperty ;
    rdfs:label "labResultId" ;
    rdfs:domain dmo:LabResult ;
    rdfs:range xsd:string ;
    rdfs:comment "结果唯一标识" ;
    .
dmo:labTestCode a owl:DatatypeProperty ;
    rdfs:label "labTestCode" ;
    rdfs:domain dmo:LabTest ;
    rdfs:range xsd:string ;
    rdfs:comment "检验编码，如 A1C / FPG / OGTT2H / RPG / GCT1H / UACR / EGFR / KETONE" ;
    .
dmo:languageCode a owl:DatatypeProperty ;
    rdfs:label "languageCode" ;
    rdfs:domain dmo:GuidelineSource ;
    rdfs:range xsd:string ;
    rdfs:comment "BCP 47 语言代码，如 en-US、zh-CN" ;
    .
dmo:localFile a owl:DatatypeProperty ;
    rdfs:label "localFile" ;
    rdfs:domain dmo:GuidelineSource ;
    rdfs:range xsd:string ;
    rdfs:comment "本仓库中的采集副本路径，如 ontology/knowledges/niddk-a1c-test.txt" ;
    .
dmo:locator a owl:DatatypeProperty ;
    rdfs:label "locator" ;
    rdfs:domain dmo:SourcePassage ;
    rdfs:range xsd:string ;
    rdfs:comment "页码、章节、表格或字符区间" ;
    .
dmo:loincCode a owl:DatatypeProperty ;
    rdfs:label "loincCode" ;
    rdfs:domain dmo:LabTest ;
    rdfs:range xsd:string ;
    rdfs:comment "LOINC 编码引用（仅存 code+label，不分发全表）" ;
    .
dmo:lowerBound a owl:DatatypeProperty ;
    rdfs:label "lowerBound" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range xsd:decimal ;
    rdfs:comment "区间下界（含）。无下界时留空" ;
    .
dmo:lowerOperator a owl:DatatypeProperty ;
    rdfs:label "lowerOperator" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range xsd:string ;
    rdfs:comment "下界比较操作符：大于、大于等于或无下界" ;
    .
dmo:mechanism a owl:DatatypeProperty ;
    rdfs:label "mechanism" ;
    rdfs:domain dmo:DrugClass ;
    rdfs:range xsd:string ;
    rdfs:comment "作用机制的通俗描述（来自 FDA 原文）" ;
    .
dmo:medicationCode a owl:DatatypeProperty ;
    rdfs:label "medicationCode" ;
    rdfs:domain dmo:Medication ;
    rdfs:range xsd:string ;
    rdfs:comment "药物编码" ;
    .
dmo:medicationUseId a owl:DatatypeProperty ;
    rdfs:label "medicationUseId" ;
    rdfs:domain dmo:MedicationUse ;
    rdfs:range xsd:string ;
    rdfs:comment "用药记录唯一标识" ;
    .
dmo:mondoCode a owl:DatatypeProperty ;
    rdfs:label "mondoCode" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dmo:Complication dmo:DiabetesType ) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "MONDO CURIE，如 MONDO:0005147" ;
    .
dmo:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dmo:AdverseEffect dmo:Complication dmo:ComplicationStage dmo:Device dmo:DiabetesType dmo:DrugClass dmo:GuidelineSource dmo:LabTest dmo:LifestyleIntervention dmo:Medication dmo:MonitoringSchedule dmo:RiskFactor dmo:Symptom ) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "分型名称" ;
    .
dmo:nativeEvidenceGrade a owl:DatatypeProperty ;
    rdfs:label "nativeEvidenceGrade" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range xsd:string ;
    rdfs:comment "来源指南原始证据等级；不得跨分级体系臆造转换" ;
    .
dmo:observationId a owl:DatatypeProperty ;
    rdfs:label "observationId" ;
    rdfs:domain dmo:ClinicalObservation ;
    rdfs:range xsd:string ;
    rdfs:comment "临床观察唯一标识" ;
    .
dmo:observationType a owl:DatatypeProperty ;
    rdfs:label "observationType" ;
    rdfs:domain dmo:ClinicalObservation ;
    rdfs:range xsd:string ;
    rdfs:comment "观察指标类型" ;
    .
dmo:observedAt a owl:DatatypeProperty ;
    rdfs:label "observedAt" ;
    rdfs:domain dmo:ClinicalObservation ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "观察时间" ;
    .
dmo:onsetDate a owl:DatatypeProperty ;
    rdfs:label "onsetDate" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range xsd:date ;
    rdfs:comment "估计起病日期" ;
    .
dmo:onsetMinutes a owl:DatatypeProperty ;
    rdfs:label "onsetMinutes" ;
    rdfs:domain dmo:Medication ;
    rdfs:range xsd:integer ;
    rdfs:comment "起效时间（分钟）——描述药代特征，不是给药建议" ;
    dmo:unit "minute" ;
    .
dmo:onsetPattern a owl:DatatypeProperty ;
    rdfs:label "onsetPattern" ;
    rdfs:domain dmo:Complication ;
    rdfs:range xsd:string ;
    rdfs:comment "起病模式" ;
    .
dmo:passageId a owl:DatatypeProperty ;
    rdfs:label "passageId" ;
    rdfs:domain dmo:SourcePassage ;
    rdfs:range xsd:string ;
    rdfs:comment "证据片段唯一标识" ;
    .
dmo:patientId a owl:DatatypeProperty ;
    rdfs:label "patientId" ;
    rdfs:domain dmo:Patient ;
    rdfs:range xsd:string ;
    rdfs:comment "患者唯一标识（假名化）" ;
    .
dmo:populationContext a owl:DatatypeProperty ;
    rdfs:label "populationContext" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range xsd:string ;
    rdfs:comment "适用人群；妊娠期使用不同 cutoff" ;
    .
dmo:populationScope a owl:DatatypeProperty ;
    rdfs:label "populationScope" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range xsd:string ;
    rdfs:comment "适用人群限定" ;
    .
dmo:prevalenceShare a owl:DatatypeProperty ;
    rdfs:label "prevalenceShare" ;
    rdfs:domain dmo:DiabetesType ;
    rdfs:range xsd:decimal ;
    rdfs:comment "占糖尿病总病例比例（T2DM 约 90-95%）" ;
    dmo:unit "percent" ;
    .
dmo:publishedYear a owl:DatatypeProperty ;
    rdfs:label "publishedYear" ;
    rdfs:domain dmo:GuidelineSource ;
    rdfs:range xsd:integer ;
    rdfs:comment "发布/最后审阅年份" ;
    .
dmo:publisher a owl:DatatypeProperty ;
    rdfs:label "publisher" ;
    rdfs:domain dmo:GuidelineSource ;
    rdfs:range xsd:string ;
    rdfs:comment "发布机构" ;
    .
dmo:quote a owl:DatatypeProperty ;
    rdfs:label "quote" ;
    rdfs:domain dmo:SourcePassage ;
    rdfs:range xsd:string ;
    rdfs:comment "经过逐字验证的支持文本" ;
    .
dmo:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale" ;
    rdfs:domain dmo:Contraindication ;
    rdfs:range xsd:string ;
    rdfs:comment "机制解释与出处，如二甲双胍与乳酸酸中毒风险" ;
    .
dmo:recommendationId a owl:DatatypeProperty ;
    rdfs:label "recommendationId" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range xsd:string ;
    rdfs:comment "推荐唯一标识" ;
    .
dmo:recommendationStrength a owl:DatatypeProperty ;
    rdfs:label "recommendationStrength" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range xsd:string ;
    rdfs:comment "推荐强度；来源未明确时为 Unspecified" ;
    .
dmo:recommendationType a owl:DatatypeProperty ;
    rdfs:label "recommendationType" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range xsd:string ;
    rdfs:comment "推荐类别" ;
    .
dmo:regimenRole a owl:DatatypeProperty ;
    rdfs:label "regimenRole" ;
    rdfs:domain dmo:MedicationUse ;
    rdfs:range xsd:string ;
    rdfs:comment "治疗方案中的角色，不包含剂量" ;
    .
dmo:resolvedDate a owl:DatatypeProperty ;
    rdfs:label "resolvedDate" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range xsd:date ;
    rdfs:comment "缓解或结束日期" ;
    .
dmo:resultUnit a owl:DatatypeProperty ;
    rdfs:label "resultUnit" ;
    rdfs:domain dmo:LabResult ;
    rdfs:range xsd:string ;
    rdfs:comment "结果单位，须与 LabTest.unitOfMeasure 一致（SHACL 校验点）" ;
    .
dmo:resultValue a owl:DatatypeProperty ;
    rdfs:label "resultValue" ;
    rdfs:domain dmo:LabResult ;
    rdfs:range xsd:decimal ;
    rdfs:comment "测量数值" ;
    .
dmo:retrievedAt a owl:DatatypeProperty ;
    rdfs:label "retrievedAt" ;
    rdfs:domain dmo:GuidelineSource ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "本地副本获取时间" ;
    .
dmo:riskCategory a owl:DatatypeProperty ;
    rdfs:label "riskCategory" ;
    rdfs:domain dmo:RiskFactor ;
    rdfs:range xsd:string ;
    rdfs:comment "是否可干预" ;
    .
dmo:riskFactorCode a owl:DatatypeProperty ;
    rdfs:label "riskFactorCode" ;
    rdfs:domain dmo:RiskFactor ;
    rdfs:range xsd:string ;
    rdfs:comment "风险因素编码" ;
    .
dmo:ruleId a owl:DatatypeProperty ;
    rdfs:label "ruleId" ;
    rdfs:domain dmo:Assessment ;
    rdfs:range xsd:string ;
    rdfs:comment "执行该评估的 SPARQL/SHACL 规则标识" ;
    .
dmo:ruleVersion a owl:DatatypeProperty ;
    rdfs:label "ruleVersion" ;
    rdfs:domain dmo:Assessment ;
    rdfs:range xsd:string ;
    rdfs:comment "规则版本" ;
    .
dmo:rxNormCode a owl:DatatypeProperty ;
    rdfs:label "rxNormCode" ;
    rdfs:domain dmo:Medication ;
    rdfs:range xsd:string ;
    rdfs:comment "RxNorm 编码引用" ;
    .
dmo:scheduleId a owl:DatatypeProperty ;
    rdfs:label "scheduleId" ;
    rdfs:domain dmo:MonitoringSchedule ;
    rdfs:range xsd:string ;
    rdfs:comment "计划唯一标识" ;
    .
dmo:severity a owl:DatatypeProperty ;
    rdfs:label "severity" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dmo:AdverseEffect dmo:Contraindication dmo:Diagnosis ) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "禁忌强度：绝对禁忌 / 相对禁忌 / 需谨慎评估" ;
    .
dmo:sex a owl:DatatypeProperty ;
    rdfs:label "sex" ;
    rdfs:domain dmo:Patient ;
    rdfs:range xsd:string ;
    rdfs:comment "生理性别；CVD 风险与 GDM 相关规则依赖该字段" ;
    .
dmo:sourceId a owl:DatatypeProperty ;
    rdfs:label "sourceId" ;
    rdfs:domain dmo:GuidelineSource ;
    rdfs:range xsd:string ;
    rdfs:comment "出处唯一标识" ;
    .
dmo:sourceUrl a owl:DatatypeProperty ;
    rdfs:label "sourceUrl" ;
    rdfs:domain dmo:GuidelineSource ;
    rdfs:range xsd:string ;
    rdfs:comment "原文链接" ;
    .
dmo:specimen a owl:DatatypeProperty ;
    rdfs:label "specimen" ;
    rdfs:domain dmo:LabTest ;
    rdfs:range xsd:string ;
    rdfs:comment "标本类型" ;
    .
dmo:stageCode a owl:DatatypeProperty ;
    rdfs:label "stageCode" ;
    rdfs:domain dmo:ComplicationStage ;
    rdfs:range xsd:string ;
    rdfs:comment "分期编码，如 CKD-G4 / DR-PDR / HYPO-L2" ;
    .
dmo:stageCriteria a owl:DatatypeProperty ;
    rdfs:label "stageCriteria" ;
    rdfs:domain dmo:ComplicationStage ;
    rdfs:range xsd:string ;
    rdfs:comment "分期判定标准（引用检验区间，不含处置剂量）" ;
    .
dmo:stageOrder a owl:DatatypeProperty ;
    rdfs:label "stageOrder" ;
    rdfs:domain dmo:ComplicationStage ;
    rdfs:range xsd:integer ;
    rdfs:comment "严重度序号，越大越重；传递序关系的基础" ;
    .
dmo:startDate a owl:DatatypeProperty ;
    rdfs:label "startDate" ;
    rdfs:domain dmo:MedicationUse ;
    rdfs:range xsd:date ;
    rdfs:comment "开始日期" ;
    .
dmo:statement a owl:DatatypeProperty ;
    rdfs:label "statement" ;
    rdfs:domain dmo:Recommendation ;
    rdfs:range xsd:string ;
    rdfs:comment "推荐正文（不含任何具体剂量数字）" ;
    .
dmo:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dmo:ClinicalObservation dmo:MedicationUse ) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "观察记录状态" ;
    .
dmo:symptomCode a owl:DatatypeProperty ;
    rdfs:label "symptomCode" ;
    rdfs:domain dmo:Symptom ;
    rdfs:range xsd:string ;
    rdfs:comment "症状编码" ;
    .
dmo:targetHigh a owl:DatatypeProperty ;
    rdfs:label "targetHigh" ;
    rdfs:domain dmo:GlycemicTarget ;
    rdfs:range xsd:decimal ;
    rdfs:comment "目标上界" ;
    .
dmo:targetId a owl:DatatypeProperty ;
    rdfs:label "targetId" ;
    rdfs:domain dmo:GlycemicTarget ;
    rdfs:range xsd:string ;
    rdfs:comment "目标唯一标识" ;
    .
dmo:targetLow a owl:DatatypeProperty ;
    rdfs:label "targetLow" ;
    rdfs:domain dmo:GlycemicTarget ;
    rdfs:range xsd:decimal ;
    rdfs:comment "目标下界" ;
    .
dmo:targetMetric a owl:DatatypeProperty ;
    rdfs:label "targetMetric" ;
    rdfs:domain dmo:GlycemicTarget ;
    rdfs:range xsd:string ;
    rdfs:comment "目标指标" ;
    .
dmo:targetPopulation a owl:DatatypeProperty ;
    rdfs:label "targetPopulation" ;
    rdfs:domain dmo:GlycemicTarget ;
    rdfs:range xsd:string ;
    rdfs:comment "适用人群描述，如「多数成人」「合并心血管疾病者更严格」" ;
    .
dmo:targetUnit a owl:DatatypeProperty ;
    rdfs:label "targetUnit" ;
    rdfs:domain dmo:GlycemicTarget ;
    rdfs:range xsd:string ;
    rdfs:comment "目标单位" ;
    .
dmo:thresholdId a owl:DatatypeProperty ;
    rdfs:label "thresholdId" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range xsd:string ;
    rdfs:comment "阈值唯一标识，如 A1C-DIABETES-NONPREG" ;
    .
dmo:triggerCriteria a owl:DatatypeProperty ;
    rdfs:label "triggerCriteria" ;
    rdfs:domain dmo:Contraindication ;
    rdfs:range xsd:string ;
    rdfs:comment "触发条件的可判定表述，如「严重肾功能损害或透析」" ;
    .
dmo:triggerWindow a owl:DatatypeProperty ;
    rdfs:label "triggerWindow" ;
    rdfs:domain dmo:MonitoringSchedule ;
    rdfs:range xsd:string ;
    rdfs:comment "触发窗口，如「妊娠 24-28 周」「产后 12 周内」「T1DM 病程满 5 年起」" ;
    .
dmo:typicalOnset a owl:DatatypeProperty ;
    rdfs:label "typicalOnset" ;
    rdfs:domain dmo:DiabetesType ;
    rdfs:range xsd:string ;
    rdfs:comment "典型起病阶段" ;
    .
dmo:unitCode a owl:DatatypeProperty ;
    rdfs:label "unitCode" ;
    rdfs:domain dmo:ClinicalObservation ;
    rdfs:range xsd:string ;
    rdfs:comment "UCUM 单位代码" ;
    .
dmo:unitOfMeasure a owl:DatatypeProperty ;
    rdfs:label "unitOfMeasure" ;
    rdfs:domain dmo:LabTest ;
    rdfs:range xsd:string ;
    rdfs:comment "结果单位，如 percent / mg-per-dL / mg-per-g / mL-per-min" ;
    .
dmo:upperBound a owl:DatatypeProperty ;
    rdfs:label "upperBound" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range xsd:decimal ;
    rdfs:comment "区间上界（含）。无上界时留空" ;
    .
dmo:upperOperator a owl:DatatypeProperty ;
    rdfs:label "upperOperator" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range xsd:string ;
    rdfs:comment "上界比较操作符：小于、小于等于或无上界" ;
    .
dmo:urgency a owl:DatatypeProperty ;
    rdfs:label "urgency" ;
    rdfs:domain dmo:Symptom ;
    rdfs:range xsd:string ;
    rdfs:comment "紧急程度；Emergency 触发「立即就医」话术而非解释性回答" ;
    .
dmo:valueDecimal a owl:DatatypeProperty ;
    rdfs:label "valueDecimal" ;
    rdfs:domain dmo:ClinicalObservation ;
    rdfs:range xsd:decimal ;
    rdfs:comment "数值型结果；非数值观察留空" ;
    .
dmo:valueText a owl:DatatypeProperty ;
    rdfs:label "valueText" ;
    rdfs:domain dmo:ClinicalObservation ;
    rdfs:range xsd:string ;
    rdfs:comment "枚举或文本结果；数值观察可留空" ;
    .
dmo:verificationStatus a owl:DatatypeProperty ;
    rdfs:label "verificationStatus" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range xsd:string ;
    rdfs:comment "诊断确定性" ;
    .
dmo:weightEffect a owl:DatatypeProperty ;
    rdfs:label "weightEffect" ;
    rdfs:domain dmo:DrugClass ;
    rdfs:range xsd:string ;
    rdfs:comment "体重影响；TZD/SU 增重，GLP-1RA/SGLT2i 减重" ;
    .

# ─── enum 取值 → skos:ConceptScheme ──────────────────────────
dmo:adminRouteScheme a skos:ConceptScheme ;
    rdfs:label "adminRoute 取值域" .
dmo:adminRoute-Oral a skos:Concept ;
    skos:inScheme dmo:adminRouteScheme ;
    skos:prefLabel "Oral" .
dmo:adminRoute-Subcutaneous a skos:Concept ;
    skos:inScheme dmo:adminRouteScheme ;
    skos:prefLabel "Subcutaneous" .
