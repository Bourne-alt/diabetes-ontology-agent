# ─── 关系 → owl:ObjectProperty ───────────────────────────────
dmo:hasEncounter a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "hasEncounter" ;
    rdfs:domain dmo:Patient ;
    rdfs:range dmo:ClinicalEncounter ;
    rdfs:comment "患者的历次就诊记录。" ;
    .
dmo:producesLabResult a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "producesLabResult" ;
    rdfs:domain dmo:ClinicalEncounter ;
    rdfs:range dmo:LabResult ;
    rdfs:comment "一次就诊产生的检验结果。" ;
    .
dmo:measuredByTest a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "measuredByTest" ;
    rdfs:domain dmo:LabResult ;
    rdfs:range dmo:LabTest ;
    rdfs:comment "结果对应的检验项目定义。" ;
    .
dmo:hasThreshold a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "hasThreshold" ;
    rdfs:domain dmo:LabTest ;
    rdfs:range dmo:DiagnosticThreshold ;
    rdfs:comment "检验项目的诊断切点集合（正常/前期/糖尿病，妊娠与非妊娠分支）。" ;
    .
dmo:classifiesInto a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "classifiesInto" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range dmo:DiabetesType ;
    rdfs:comment "阈值命中后支持的诊断类别术语；不得单凭血糖阈值推断 T1DM 或 T2DM 病因分型。" ;
    .
dmo:thresholdCitedFrom a owl:ObjectProperty ;
    rdfs:label "thresholdCitedFrom" ;
    rdfs:domain dmo:DiagnosticThreshold ;
    rdfs:range dmo:GuidelineSource ;
    rdfs:comment "阈值的出处，保证每个数字都能追溯。" ;
    .
dmo:hasStage a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "hasStage" ;
    rdfs:domain dmo:Complication ;
    rdfs:range dmo:ComplicationStage ;
    rdfs:comment "并发症的分期集合。" ;
    .
dmo:predisposesTo a owl:ObjectProperty ;
    rdfs:label "predisposesTo" ;
    rdfs:domain dmo:DiabetesType ;
    rdfs:range dmo:Complication ;
    rdfs:comment "该分型易发生的并发症，例如 T1DM 更易发生 DKA。" ;
    .
dmo:presentsWith a owl:ObjectProperty ;
    rdfs:label "presentsWith" ;
    rdfs:domain dmo:Complication ;
    rdfs:range dmo:Symptom ;
    rdfs:comment "并发症的典型症状表现。" ;
    .
dmo:screenedByTest a owl:ObjectProperty ;
    rdfs:label "screenedByTest" ;
    rdfs:domain dmo:Complication ;
    rdfs:range dmo:LabTest ;
    rdfs:comment "并发症的筛查手段，例如 DKD 由 UACR 与 eGFR 双指标筛查。" ;
    .
dmo:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "hasRiskFactor" ;
    rdfs:domain dmo:Patient ;
    rdfs:range dmo:RiskFactor ;
    rdfs:comment "患者具备的风险因素。" ;
    .
dmo:increasesRiskOf a owl:ObjectProperty ;
    rdfs:label "increasesRiskOf" ;
    rdfs:domain dmo:RiskFactor ;
    rdfs:range dmo:DiabetesType ;
    rdfs:comment "风险因素指向的疾病分型。" ;
    .
dmo:belongsToDrugClass a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "belongsToDrugClass" ;
    rdfs:domain dmo:Medication ;
    rdfs:range dmo:DrugClass ;
    rdfs:comment "药物所属类别。" ;
    .
dmo:hasContraindication a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "hasContraindication" ;
    rdfs:domain dmo:DrugClass ;
    rdfs:range dmo:Contraindication ;
    rdfs:comment "该类药物的禁忌规则。" ;
    .
dmo:triggeredByCondition a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "triggeredByCondition" ;
    rdfs:domain dmo:Contraindication ;
    rdfs:range dmo:Complication ;
    rdfs:comment "触发禁忌的临床情形，例如 SGLT2i 禁用于严重肾功能损害/透析。" ;
    .
dmo:causesAdverseEffect a owl:ObjectProperty ;
    rdfs:label "causesAdverseEffect" ;
    rdfs:domain dmo:DrugClass ;
    rdfs:range dmo:AdverseEffect ;
    rdfs:comment "该类药物的常见不良反应。" ;
    .
dmo:usesDevice a owl:ObjectProperty ;
    rdfs:label "usesDevice" ;
    rdfs:domain dmo:Patient ;
    rdfs:range dmo:Device ;
    rdfs:comment "患者使用的监测/给药设备。" ;
    .
dmo:deviceMeasuresTest a owl:ObjectProperty ;
    rdfs:label "deviceMeasuresTest" ;
    rdfs:domain dmo:Device ;
    rdfs:range dmo:LabTest ;
    rdfs:comment "设备可测量的指标，例如 CGM 对应 TIR 与葡萄糖。" ;
    .
dmo:followsIntervention a owl:ObjectProperty ;
    rdfs:label "followsIntervention" ;
    rdfs:domain dmo:Patient ;
    rdfs:range dmo:LifestyleIntervention ;
    rdfs:comment "患者执行中的生活方式干预。" ;
    .
dmo:mitigatesRiskFactor a owl:ObjectProperty ;
