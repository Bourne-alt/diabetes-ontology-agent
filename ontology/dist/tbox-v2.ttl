    skos:inScheme dmo:adminRouteScheme ;
    skos:prefLabel "Inhaled" .
dmo:adminRoute-Intravenous a skos:Concept ;
    skos:inScheme dmo:adminRouteScheme ;
    skos:prefLabel "Intravenous" .

