dmo:observationOfSymptom a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "observationOfSymptom" ;
    rdfs:domain dmo:ClinicalObservation ;
    rdfs:range dmo:Symptom ;
    rdfs:comment "症状类观察对应的症状术语；非症状观察不使用该关系。" ;
    .
dmo:hasDiagnosis a owl:ObjectProperty, owl:InverseFunctionalProperty ;
    rdfs:label "hasDiagnosis" ;
    rdfs:domain dmo:Patient ;
    rdfs:range dmo:Diagnosis ;
    rdfs:comment "患者历次诊断或临床判断记录。" ;
    .
dmo:diagnosedAt a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "diagnosedAt" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range dmo:ClinicalEncounter ;
    rdfs:comment "诊断作出或记录所在的就诊事件。" ;
    .
dmo:diagnosisType a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "diagnosisType" ;
    rdfs:domain dmo:Diagnosis ;
    rdfs:range dmo:DiabetesType ;
