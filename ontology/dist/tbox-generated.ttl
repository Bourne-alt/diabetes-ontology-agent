dmo:severityScheme a skos:ConceptScheme ;
    rdfs:label "severity 取值域" .
dmo:severity-Absolute a skos:Concept ;
    skos:inScheme dmo:severityScheme ;
    skos:prefLabel "Absolute" .
dmo:severity-Relative a skos:Concept ;
    skos:inScheme dmo:severityScheme ;
    skos:prefLabel "Relative" .
dmo:severity-Caution a skos:Concept ;
    skos:inScheme dmo:severityScheme ;
    skos:prefLabel "Caution" .

dmo:sexScheme a skos:ConceptScheme ;
    rdfs:label "sex 取值域" .
dmo:sex-Female a skos:Concept ;
    skos:inScheme dmo:sexScheme ;
    skos:prefLabel "Female" .
dmo:sex-Male a skos:Concept ;
    skos:inScheme dmo:sexScheme ;
    skos:prefLabel "Male" .
dmo:sex-Other a skos:Concept ;
    skos:inScheme dmo:sexScheme ;
    skos:prefLabel "Other" .
dmo:sex-Unknown a skos:Concept ;
    skos:inScheme dmo:sexScheme ;
    skos:prefLabel "Unknown" .

dmo:smokingStatusScheme a skos:ConceptScheme ;
    rdfs:label "smokingStatus 取值域" .
dmo:smokingStatus-Never a skos:Concept ;
    skos:inScheme dmo:smokingStatusScheme ;
    skos:prefLabel "Never" .
dmo:smokingStatus-Former a skos:Concept ;
    skos:inScheme dmo:smokingStatusScheme ;
    skos:prefLabel "Former" .
dmo:smokingStatus-Current a skos:Concept ;
    skos:inScheme dmo:smokingStatusScheme ;
    skos:prefLabel "Current" .
dmo:smokingStatus-Unknown a skos:Concept ;
    skos:inScheme dmo:smokingStatusScheme ;
    skos:prefLabel "Unknown" .

dmo:specimenScheme a skos:ConceptScheme ;
    rdfs:label "specimen 取值域" .
dmo:specimen-Blood a skos:Concept ;
    skos:inScheme dmo:specimenScheme ;
    skos:prefLabel "Blood" .
dmo:specimen-Urine a skos:Concept ;
    skos:inScheme dmo:specimenScheme ;
    skos:prefLabel "Urine" .
dmo:specimen-Breath a skos:Concept ;
    skos:inScheme dmo:specimenScheme ;
    skos:prefLabel "Breath" .
dmo:specimen-Genomic a skos:Concept ;
    skos:inScheme dmo:specimenScheme ;
    skos:prefLabel "Genomic" .

dmo:targetMetricScheme a skos:ConceptScheme ;
    rdfs:label "targetMetric 取值域" .
dmo:targetMetric-A1C a skos:Concept ;
    skos:inScheme dmo:targetMetricScheme ;
    skos:prefLabel "A1C" .
dmo:targetMetric-PreMealGlucose a skos:Concept ;
    skos:inScheme dmo:targetMetricScheme ;
    skos:prefLabel "PreMealGlucose" .
dmo:targetMetric-PostMealGlucose a skos:Concept ;
    skos:inScheme dmo:targetMetricScheme ;
    skos:prefLabel "PostMealGlucose" .
dmo:targetMetric-TimeInRange a skos:Concept ;
    skos:inScheme dmo:targetMetricScheme ;
    skos:prefLabel "TimeInRange" .
dmo:targetMetric-BloodPressure a skos:Concept ;
    skos:inScheme dmo:targetMetricScheme ;
    skos:prefLabel "BloodPressure" .
dmo:targetMetric-LDL a skos:Concept ;
    skos:inScheme dmo:targetMetricScheme ;
    skos:prefLabel "LDL" .

dmo:typicalOnsetScheme a skos:ConceptScheme ;
    rdfs:label "typicalOnset 取值域" .
dmo:typicalOnset-Neonatal a skos:Concept ;
    skos:inScheme dmo:typicalOnsetScheme ;
    skos:prefLabel "Neonatal" .
dmo:typicalOnset-Childhood a skos:Concept ;
    skos:inScheme dmo:typicalOnsetScheme ;
    skos:prefLabel "Childhood" .
dmo:typicalOnset-Adolescence a skos:Concept ;
    skos:inScheme dmo:typicalOnsetScheme ;
    skos:prefLabel "Adolescence" .
dmo:typicalOnset-Adulthood a skos:Concept ;
    skos:inScheme dmo:typicalOnsetScheme ;
    skos:prefLabel "Adulthood" .
dmo:typicalOnset-Pregnancy a skos:Concept ;
    skos:inScheme dmo:typicalOnsetScheme ;
    skos:prefLabel "Pregnancy" .
dmo:typicalOnset-AnyAge a skos:Concept ;
    skos:inScheme dmo:typicalOnsetScheme ;
    skos:prefLabel "AnyAge" .

dmo:urgencyScheme a skos:ConceptScheme ;
    rdfs:label "urgency 取值域" .
dmo:urgency-Routine a skos:Concept ;
