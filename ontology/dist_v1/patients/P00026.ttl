<https://example.org/dmo/id/labResult/EHR-LAB-TC00026-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-11-02T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00026|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TSH> ;
    dmo:resultUnit "mIU-per-L" ;
