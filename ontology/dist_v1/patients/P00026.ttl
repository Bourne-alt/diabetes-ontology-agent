    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00026-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00026-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00026-SUB03-STATE>,
