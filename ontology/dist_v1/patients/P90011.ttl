@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/2060ad8f-9aa6-5958-bddc-d391ca652746> a dmo:Patient ;
    dmo:birthYear 1975 ;
    dmo:demoScenario "S10" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90011-1> ;
    dmo:patientId "P90011" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/E90011-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-02-14"^^xsd:date ;
    dmo:encounterId "E90011-1" ;
    dmo:encounterType "Emergency" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90011-GLU> .

<https://example.org/dmo/id/labResult/L90011-GLU> a dmo:LabResult ;
    dmo:collectedAt "2026-02-14T02:15:00"^^xsd:dateTime ;
    dmo:demoScenario "S10" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90011-GLU" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-GLU> ;
    dmo:resultUnit "mg-per-dL" ;
    dmo:resultValue 62.0 ;
    dmo:valueTrustLevel "Curated" .

