@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00131-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-08-26T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00131|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 23.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00131-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2023-08-26T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00131|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 14.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/a49522d0-e3af-506c-8dd4-8d42ba0713a3> a dmo:Patient ;
    dmo:birthYear 2020 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00131-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00131-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00131-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00131-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00131-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00131-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00131-C00131> ;
    dmo:patientId "P00131" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00131-C00131> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-12-16"^^xsd:date ;
    dmo:encounterId "EHR-P00131|C00131" ;
    dmo:encounterType "儿科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00131-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00131|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-08-26T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "白细胞：上游判读 异常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00131-SUB02-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00131|SUB02-STATE" ;
