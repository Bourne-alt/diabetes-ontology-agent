@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00115-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-03-28T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00115|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 24.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00115-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-03-28T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00115|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TG> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 15.3 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00115-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-03-28T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00115|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 15.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/b5225a79-3534-597b-828d-e5e40bbc7a15> a dmo:Patient ;
    dmo:birthYear 2022 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00115-SUB01>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00115-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00115-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00115-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00115-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00115-C00115> ;
    dmo:patientId "P00115" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00115-C00115> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2020-04-24"^^xsd:date ;
    dmo:encounterId "EHR-P00115|C00115" ;
    dmo:encounterType "儿科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00115-SUB01> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00115|SUB01" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-03-28T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "血红蛋白 = 24.9 （参考范围 10-15；未作数值判定：映射未核实(candidate)）" ;
    dmo:valueTrustLevel "Unverified" .

