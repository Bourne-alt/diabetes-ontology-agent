        <https://example.org/dmo/id/observation/EHR-LAB-TC00170-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00170-C00170> ;
    dmo:patientId "P00170" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00170-C00170> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2023-03-21"^^xsd:date ;
