@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00014-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-04-11T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00014|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 8.2 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00014-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2023-04-11T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00014|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 16.4 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/ef41a8b4-3c20-50bb-8df7-9252c8ccb1ed> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00014-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00014-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00014-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00014-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00014-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00014-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00014-C00014> ;
    dmo:patientId "P00014" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00014-C00014> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-10-17"^^xsd:date ;
    dmo:encounterId "EHR-P00014|C00014" ;
    dmo:encounterType "皮肤科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00014-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00014|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-04-11T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "总胆固醇：上游判读 正常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00014-SUB02> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00014|SUB02" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-04-11T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白 = 17.1 （参考范围 阴性；未作数值判定：映射未核实(unmappable)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00014-SUB02-STATE> a dmo:ClinicalObservation ;
