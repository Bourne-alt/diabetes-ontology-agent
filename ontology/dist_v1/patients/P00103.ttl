<https://example.org/dmo/id/patient/ac07f1f9-9ea6-58f6-9666-d33e841f7b8d> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00103-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00103-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00103-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00103-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00103-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00103-C00103> ;
    dmo:patientId "P00103" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00103-C00103> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2020-11-22"^^xsd:date ;
    dmo:encounterId "EHR-P00103|C00103" ;
    dmo:encounterType "骨科" ;
    dmo:factOrigin "ehr-legacy" .

