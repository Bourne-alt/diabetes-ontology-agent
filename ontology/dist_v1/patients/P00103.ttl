@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00103-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-12-10T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00103|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 9.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00103-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2023-12-10T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00103|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
