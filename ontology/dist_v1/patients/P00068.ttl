<https://example.org/dmo/id/patient/e2baf76a-9aff-597d-b8ab-b072092ab988> a dmo:Patient ;
    dmo:birthYear 2022 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00068-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00068-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00068-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00068-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00068-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00068-C00068> ;
    dmo:patientId "P00068" ;
    dmo:sex "Female" .

