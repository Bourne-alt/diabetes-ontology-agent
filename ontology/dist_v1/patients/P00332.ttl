    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00332-C00332> ;
    dmo:patientId "P00332" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00332-C00332> a dmo:ClinicalEncounter ;
