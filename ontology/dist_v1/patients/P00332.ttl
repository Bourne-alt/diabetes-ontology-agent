<https://example.org/dmo/id/patient/9e213d1a-cdeb-52a6-9b3d-bd3c082f5c35> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00332-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00332-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00332-SUB03>,
