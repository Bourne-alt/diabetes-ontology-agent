    dmo:labResultId "EHR-LAB-TC00336|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 18.0 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00336-SUB02> a dmo:LabResult ;
