@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/45b9f4ea-6eea-5b17-86df-822c692cbe1e> a dmo:Patient ;
    dmo:birthYear 1981 ;
    dmo:demoScenario "S29b" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90033-1> ;
    dmo:patientId "P90033" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/E90033-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-05-15"^^xsd:date ;
    dmo:encounterId "E90033-1" ;
    dmo:encounterType "Screening" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90033-OGTT> .

<https://example.org/dmo/id/labResult/L90033-OGTT> a dmo:LabResult ;
    dmo:collectedAt "2026-05-15T10:30:00"^^xsd:dateTime ;
    dmo:demoScenario "S29b" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90033-OGTT" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-OGTT2H> ;
    dmo:resultUnit "mg-per-dL" ;
    dmo:resultValue 165.0 ;
    dmo:valueTrustLevel "Curated" .

