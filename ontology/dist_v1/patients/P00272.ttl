<https://example.org/dmo/id/labResult/EHR-LAB-TC00272-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-06-04T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00272|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 14.1 ;
    dmo:valueTrustLevel "Unverified" .

