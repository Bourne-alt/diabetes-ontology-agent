@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00013-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-04-26T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00013|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 9.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00013-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-04-26T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00013|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 8.3 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00013-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-04-26T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00013|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 20.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/02e0e86c-fd80-50d5-b29d-a22b384a0f87> a dmo:Patient ;
    dmo:birthYear 2026 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00013-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00013-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00013-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00013-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00013-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00013-C00013> ;
    dmo:patientId "P00013" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00013-C00013> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2020-12-18"^^xsd:date ;
    dmo:encounterId "EHR-P00013|C00013" ;
    dmo:encounterType "急诊内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00013-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00013|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-04-26T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "ALT：上游判读 异常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00013-SUB02> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00013|SUB02" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-04-26T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "血红蛋白 = 15.3 （参考范围 10-15；未作数值判定：映射未核实(candidate)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00013-SUB02-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00013|SUB02-STATE" ;
    dmo:observationType "Other" ;
