<https://example.org/dmo/id/observation/EHR-LAB-TC00280-SUB03> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00280|SUB03" ;
    dmo:observationType "Other" ;
