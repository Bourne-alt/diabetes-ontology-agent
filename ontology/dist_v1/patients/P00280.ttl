@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00280-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-06-10T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00280|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 15.5 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00280-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-06-10T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00280|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-GLU> ;
    dmo:resultUnit "mg-per-dL" ;
    dmo:resultValue 174.77654 ;
    dmo:sourceUnit "mmol-per-L" ;
    dmo:sourceValue 9.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/5bed7cc9-1c2c-5383-8aa7-eb07c0b3ba94> a dmo:Patient ;
    dmo:birthYear 2026 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00280-SUB01>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00280-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00280-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00280-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00280-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00280-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00280-C00280> ;
    dmo:patientId "P00280" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00280-C00280> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-10-05"^^xsd:date ;
    dmo:encounterId "EHR-P00280|C00280" ;
    dmo:encounterType "呼吸内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00280-SUB01> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00280|SUB01" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-06-10T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "血红蛋白 = 7.2 （参考范围 10-15；未作数值判定：映射未核实(candidate)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00280-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00280|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-06-10T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "血红蛋白：上游判读 偏低" ;
