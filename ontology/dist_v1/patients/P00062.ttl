@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00062-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-05-11T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00062|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-BUN> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 5.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00062-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2023-05-11T00:00:00"^^xsd:dateTime ;
