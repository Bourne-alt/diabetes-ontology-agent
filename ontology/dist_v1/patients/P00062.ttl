    dmo:sourceValue 20.2 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/af7b758c-ef26-5575-8bb2-232d9aca0ec3> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00062-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00062-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00062-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00062-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00062-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00062-C00062> ;
    dmo:patientId "P00062" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00062-C00062> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2023-09-07"^^xsd:date ;
    dmo:encounterId "EHR-P00062|C00062" ;
    dmo:encounterType "儿科" ;
    dmo:factOrigin "ehr-legacy" .

