<https://example.org/dmo/id/labResult/EHR-LAB-TC00282-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-02-28T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00282|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
