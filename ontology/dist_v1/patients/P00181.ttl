@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00181-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-04-01T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00181|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 12.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00181-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2023-04-01T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00181|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 5.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00181-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2023-04-01T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00181|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 6.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/9e4c5edc-38f5-53b4-9930-abb43e04333f> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00181-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00181-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00181-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00181-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00181-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00181-C00181> ;
    dmo:patientId "P00181" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00181-C00181> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-03-10"^^xsd:date ;
    dmo:encounterId "EHR-P00181|C00181" ;
    dmo:encounterType "心内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00181-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00181|SUB01-STATE" ;
    dmo:observationType "Other" ;
