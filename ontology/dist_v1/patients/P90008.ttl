@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/40698bdb-a453-5648-85c6-40dd2b091eeb> a dmo:Patient ;
    dmo:birthYear 1955 ;
    dmo:demoScenario "S07" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/O90008-BMI> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/D90008-DM>,
        <https://example.org/dmo/id/diagnosis/D90008-ESRD> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90008-1> ;
    dmo:hasMedicationUse <https://example.org/dmo/id/medicationUse/M90008-EMPA>,
        <https://example.org/dmo/id/medicationUse/M90008-MET-OLD> ;
    dmo:patientId "P90008" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/diagnosis/D90008-ESRD> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:demoScenario "S07" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90008-1> ;
    dmo:diagnosedDate "2024-02-20"^^xsd:date ;
    dmo:diagnosisComplication <https://example.org/dmo/id/KidneyFailure> ;
    dmo:diagnosisId "D90008-ESRD" ;
    dmo:diagnosisKind "Complication" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/labResult/L90008-A1C> a dmo:LabResult ;
    dmo:collectedAt "2026-02-11T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S07" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90008-A1C" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-A1C> ;
    dmo:resultUnit "percent" ;
    dmo:resultValue 8.5 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/medicationUse/M90008-EMPA> a dmo:MedicationUse ;
    dmo:demoScenario "S07" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:medicationUseId "M90008-EMPA" ;
    dmo:regimenRole "口服降糖" ;
    dmo:startDate "2025-06-01"^^xsd:date ;
    dmo:status "Active" ;
    dmo:treatsDiagnosis <https://example.org/dmo/id/diagnosis/D90008-DM> ;
    dmo:usesMedication <https://example.org/dmo/id/medication/empagliflozin> .

<https://example.org/dmo/id/medicationUse/M90008-MET-OLD> a dmo:MedicationUse ;
    dmo:demoScenario "S07" ;
    dmo:endDate "2025-05-20"^^xsd:date ;
    dmo:factOrigin "demo-cohort" ;
    dmo:medicationUseId "M90008-MET-OLD" ;
    dmo:regimenRole "口服降糖" ;
    dmo:startDate "2010-07-01"^^xsd:date ;
    dmo:status "Stopped" ;
    dmo:treatsDiagnosis <https://example.org/dmo/id/diagnosis/D90008-DM> ;
    dmo:usesMedication <https://example.org/dmo/id/medication/metformin> .

<https://example.org/dmo/id/observation/O90008-BMI> a dmo:ClinicalObservation ;
    dmo:demoScenario "S07" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:observationId "O90008-BMI" ;
    dmo:observationRecordedAt <https://example.org/dmo/id/encounter/E90008-1> ;
    dmo:observationType "BMI" ;
    dmo:observedAt "2026-02-11T09:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:unitCode "kg-per-m2" ;
    dmo:valueDecimal 27.1 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/diagnosis/D90008-DM> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:demoScenario "S07" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90008-1> ;
    dmo:diagnosedDate "2010-06-15"^^xsd:date ;
    dmo:diagnosisId "D90008-DM" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/E90008-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-02-11"^^xsd:date ;
    dmo:encounterId "E90008-1" ;
    dmo:encounterType "Routine" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90008-A1C> .

