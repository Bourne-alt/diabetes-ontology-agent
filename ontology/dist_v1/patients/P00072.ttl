@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00072-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-05-02T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00072|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 7.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00072-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2023-05-02T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00072|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 12.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/3d8f296e-aac9-5390-b8df-650d5ad0315f> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00072-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00072-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00072-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00072-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00072-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00072-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00072-C00072> ;
    dmo:patientId "P00072" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00072-C00072> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2020-09-25"^^xsd:date ;
    dmo:encounterId "EHR-P00072|C00072" ;
    dmo:encounterType "肾内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00072-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00072|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-05-02T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "总胆固醇：上游判读 异常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00072-SUB02> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00072|SUB02" ;
    dmo:observationType "Other" ;
