<https://example.org/dmo/id/patient/695d3bdd-1c46-5603-bae1-129a8fb77337> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00303-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00303-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00303-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00303-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00303-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00303-C00303> ;
    dmo:patientId "P00303" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00303-C00303> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2023-11-08"^^xsd:date ;
    dmo:encounterId "EHR-P00303|C00303" ;
    dmo:encounterType "心内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00303-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00303|SUB01-STATE" ;
    dmo:observationType "Other" ;
