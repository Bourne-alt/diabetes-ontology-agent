@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00260-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-06-11T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00260|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 18.5 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00260-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2023-06-11T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00260|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 16.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00260-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2023-06-11T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00260|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TG> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 15.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/d00a85c5-8f8d-5a00-979e-3df48b04f5aa> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00260-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00260-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00260-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00260-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00260-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00260-C00260> ;
    dmo:hasMedicationUse <https://example.org/dmo/id/medicationUse/EHR-MU-P00260-C00260-T004> ;
    dmo:patientId "P00260" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00260-C00260> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2020-11-09"^^xsd:date ;
    dmo:encounterId "EHR-P00260|C00260" ;
    dmo:encounterType "急诊内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/medicationUse/EHR-MU-P00260-C00260-T004> a dmo:MedicationUse ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:medicationUseId "EHR-MU-P00260|C00260|T004" ;
    dmo:status "Active" ;
    dmo:usesMedication <https://example.org/dmo/id/medication/metformin> .

