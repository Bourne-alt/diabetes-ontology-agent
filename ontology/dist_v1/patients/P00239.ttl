    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00239-C00239> ;
    dmo:patientId "P00239" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00239-C00239> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2020-11-23"^^xsd:date ;
