<https://example.org/dmo/id/labResult/EHR-LAB-TC00078-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2023-01-30T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00078|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 11.2 ;
    dmo:valueTrustLevel "Unverified" .

