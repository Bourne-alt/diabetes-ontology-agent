@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00389-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-06-15T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00389|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 22.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00389-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2023-06-15T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00389|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TG> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 24.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/50f92754-7045-5dd6-a166-d8486eb67a85> a dmo:Patient ;
    dmo:birthYear 2024 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00389-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00389-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00389-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00389-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00389-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00389-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00389-C00389> ;
    dmo:patientId "P00389" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00389-C00389> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-09-24"^^xsd:date ;
    dmo:encounterId "EHR-P00389|C00389" ;
