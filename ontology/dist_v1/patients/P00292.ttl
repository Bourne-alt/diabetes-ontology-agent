@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00292-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-08-03T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00292|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 22.8 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00292-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-08-03T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00292|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TSH> ;
    dmo:resultUnit "mIU-per-L" ;
    dmo:resultValue 24.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00292-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-08-03T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00292|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 12.2 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/7a58f484-7fcb-5744-9df8-68eb5373e9f2> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00292-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00292-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00292-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00292-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00292-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00292-C00292-D568> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00292-C00292> ;
    dmo:patientId "P00292" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00292-C00292-D568> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00292|C00292|D568" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00292-C00292> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-02-24"^^xsd:date ;
    dmo:encounterId "EHR-P00292|C00292" ;
    dmo:encounterType "消化内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00292-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00292|SUB01-STATE" ;
    dmo:observationType "Other" ;
