@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/be39a483-c5fa-5318-8fba-e848c1a3563b> a dmo:Patient ;
    dmo:birthYear 1964 ;
    dmo:demoScenario "S22" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/O90025-BMI> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/D90025-DM> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90025-1> ;
    dmo:patientId "P90025" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/D90025-DM> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:demoScenario "S22" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90025-1> ;
    dmo:diagnosedDate "2020-10-19"^^xsd:date ;
    dmo:diagnosisId "D90025-DM" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/labResult/L90025-A1C> a dmo:LabResult ;
    dmo:collectedAt "2026-02-13T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S22" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90025-A1C" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-A1C> ;
    dmo:resultUnit "percent" ;
    dmo:resultValue 7.1 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/observation/O90025-BMI> a dmo:ClinicalObservation ;
    dmo:demoScenario "S22" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:observationId "O90025-BMI" ;
    dmo:observationRecordedAt <https://example.org/dmo/id/encounter/E90025-1> ;
    dmo:observationType "BMI" ;
    dmo:observedAt "2026-02-13T09:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:unitCode "kg-per-m2" ;
    dmo:valueDecimal 24.0 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/encounter/E90025-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-02-13"^^xsd:date ;
    dmo:encounterId "E90025-1" ;
    dmo:encounterType "Routine" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90025-A1C> .

