@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/112152ca-53ec-5d0e-937d-fd323a44a301> a dmo:Patient ;
    dmo:birthYear 1977 ;
    dmo:demoScenario "S29c" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90034-1> ;
    dmo:patientId "P90034" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/E90034-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-05-18"^^xsd:date ;
    dmo:encounterId "E90034-1" ;
    dmo:encounterType "Screening" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90034-OGTT> .

<https://example.org/dmo/id/labResult/L90034-OGTT> a dmo:LabResult ;
    dmo:collectedAt "2026-05-18T10:30:00"^^xsd:dateTime ;
    dmo:demoScenario "S29c" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90034-OGTT" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-OGTT2H> ;
    dmo:resultUnit "mg-per-dL" ;
    dmo:resultValue 215.0 ;
    dmo:valueTrustLevel "Curated" .

