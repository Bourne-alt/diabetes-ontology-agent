@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00366-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-03-31T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00366|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 21.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00366-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-03-31T00:00:00"^^xsd:dateTime ;
