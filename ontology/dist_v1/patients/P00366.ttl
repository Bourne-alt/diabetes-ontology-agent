<https://example.org/dmo/id/patient/018fa71e-e981-562a-a217-c0053c0b4c54> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00366-SUB01>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00366-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00366-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00366-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00366-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00366-C00366> ;
    dmo:patientId "P00366" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00366-C00366> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-11-12"^^xsd:date ;
    dmo:encounterId "EHR-P00366|C00366" ;
    dmo:encounterType "骨科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00366-SUB01> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00366|SUB01" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-03-31T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白 = 11.7 （参考范围 阴性；未作数值判定：映射未核实(unmappable)）" ;
    dmo:valueTrustLevel "Unverified" .

