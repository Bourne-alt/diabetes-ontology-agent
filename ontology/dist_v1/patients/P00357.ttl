    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00357-C00357> ;
    dmo:patientId "P00357" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00357-C00357-D901> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
