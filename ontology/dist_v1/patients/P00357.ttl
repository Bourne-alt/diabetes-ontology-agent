    dmo:labResultId "EHR-LAB-TC00357|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TG> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 11.5 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/086befd2-2b27-558e-8ec8-46fbc9de2f0b> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00357-SUB01>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00357-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00357-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00357-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00357-SUB04>,
