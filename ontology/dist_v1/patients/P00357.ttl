    dmo:diagnosisKind "Comorbidity" ;
    dmo:externalCode "E78" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00357-C00357> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-04-07"^^xsd:date ;
    dmo:encounterId "EHR-P00357|C00357" ;
