@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/c004714b-db4c-5673-8694-afda4cdee45a> a dmo:Patient ;
    dmo:birthYear 1968 ;
    dmo:demoScenario "S02" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90002-1> ;
    dmo:patientId "P90002" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/E90002-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-01-15"^^xsd:date ;
    dmo:encounterId "E90002-1" ;
    dmo:encounterType "Routine" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90002-A1C> .

<https://example.org/dmo/id/labResult/L90002-A1C> a dmo:LabResult ;
    dmo:collectedAt "2026-01-15T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S02" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90002-A1C" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-A1C> ;
    dmo:resultUnit "percent" ;
    dmo:resultValue 7.4 ;
    dmo:valueTrustLevel "Curated" .

