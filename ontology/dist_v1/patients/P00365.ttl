@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00365-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-07-30T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00365|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 21.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00365-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-07-30T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00365|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 19.4 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/69c488b9-3f17-571a-85d7-f4d5af719cdf> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00365-SUB01>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00365-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00365-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00365-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00365-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00365-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00365-C00365> ;
    dmo:patientId "P00365" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00365-C00365> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-05-27"^^xsd:date ;
    dmo:encounterId "EHR-P00365|C00365" ;
    dmo:encounterType "肾内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00365-SUB01> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00365|SUB01" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-07-30T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "血红蛋白 = 19.9 （参考范围 10-15；未作数值判定：映射未核实(candidate)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00365-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
