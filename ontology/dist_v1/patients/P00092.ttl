@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00092-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-05-28T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00092|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 24.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00092-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-05-28T00:00:00"^^xsd:dateTime ;
