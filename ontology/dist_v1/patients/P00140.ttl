    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00140-C00140> ;
    dmo:patientId "P00140" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00140-C00140-D724> a dmo:Diagnosis ;
