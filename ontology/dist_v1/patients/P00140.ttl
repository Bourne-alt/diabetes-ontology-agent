<https://example.org/dmo/id/patient/e69054c2-fc34-59c6-a96d-fcee7ffc980c> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00140-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00140-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00140-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00140-SUB03-STATE>,
