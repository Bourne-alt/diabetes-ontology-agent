@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00393-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-06-23T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00393|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 22.2 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00393-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-06-23T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00393|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 10.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00393-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-06-23T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00393|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 15.0 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/7b0c6a4b-fcb8-55b0-88b7-2903dad4e98e> a dmo:Patient ;
    dmo:birthYear 2023 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00393-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00393-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00393-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00393-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00393-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00393-C00393> ;
    dmo:patientId "P00393" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00393-C00393> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-08-05"^^xsd:date ;
    dmo:encounterId "EHR-P00393|C00393" ;
    dmo:encounterType "消化内科" ;
    dmo:factOrigin "ehr-legacy" .

