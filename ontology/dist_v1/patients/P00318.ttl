<https://example.org/dmo/id/patient/88d48f7a-3932-57bc-8231-3394d189c0ac> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00318-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00318-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00318-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00318-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00318-SUB04-STATE> ;
