    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00318-C00318> ;
    dmo:hasMedicationUse <https://example.org/dmo/id/medicationUse/EHR-MU-P00318-C00318-T004> ;
    dmo:patientId "P00318" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00318-C00318-D568> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00318|C00318|D568" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00318-C00318> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2020-07-05"^^xsd:date ;
    dmo:encounterId "EHR-P00318|C00318" ;
    dmo:encounterType "呼吸内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/medicationUse/EHR-MU-P00318-C00318-T004> a dmo:MedicationUse ;
