@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00048-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-06-14T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00048|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TG> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 11.4 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00048-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-06-14T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00048|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 9.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/e09bf62f-1ed7-57ac-a8e7-218123ab01e6> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00048-SUB01>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00048-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00048-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00048-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00048-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00048-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00048-C00048> ;
    dmo:patientId "P00048" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00048-C00048> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2023-12-22"^^xsd:date ;
    dmo:encounterId "EHR-P00048|C00048" ;
    dmo:encounterType "消化内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00048-SUB01> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00048|SUB01" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-06-14T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白 = 19.6 （参考范围 阴性；未作数值判定：映射未核实(unmappable)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00048-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
