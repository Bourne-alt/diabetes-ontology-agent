<https://example.org/dmo/id/patient/7e8bdff5-a553-5e10-9e8d-3ac3dde8165f> a dmo:Patient ;
    dmo:birthYear 2020 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00076-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00076-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00076-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00076-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00076-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00076-C00076> ;
    dmo:patientId "P00076" ;
    dmo:sex "Female" .

