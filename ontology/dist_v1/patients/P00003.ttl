@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00003-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-08-03T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00003|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-BUN> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 12.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00003-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-08-03T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00003|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 11.2 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00003-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-08-03T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00003|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TSH> ;
    dmo:resultUnit "mIU-per-L" ;
    dmo:resultValue 24.4 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/e0d02141-39c6-543e-9253-277397ca7615> a dmo:Patient ;
    dmo:birthYear 2022 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00003-SUB01>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00003-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00003-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00003-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00003-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00003-C00003-D505> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00003-C00003> ;
    dmo:patientId "P00003" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00003-C00003-D505> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00003|C00003|D505" ;
    dmo:diagnosisKind "Comorbidity" ;
    dmo:externalCode "E66" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00003-C00003> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2023-06-08"^^xsd:date ;
    dmo:encounterId "EHR-P00003|C00003" ;
    dmo:encounterType "心内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00003-SUB01> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00003|SUB01" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-08-03T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "血红蛋白 = 13.3 （参考范围 10-15；未作数值判定：映射未核实(candidate)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00003-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00003|SUB01-STATE" ;
