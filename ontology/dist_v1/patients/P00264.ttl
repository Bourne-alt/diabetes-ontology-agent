@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00264-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2023-07-03T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00264|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 23.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00264-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2023-07-03T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00264|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 22.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/da11d5bd-82f1-5fc2-90e8-2f5c39b89e0f> a dmo:Patient ;
    dmo:birthYear 2024 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB01>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00264-C00264-D846> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00264-C00264> ;
    dmo:patientId "P00264" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00264-C00264-D846> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisComplication <https://example.org/dmo/id/CVD> ;
    dmo:diagnosisId "EHR-DX-P00264|C00264|D846" ;
    dmo:diagnosisKind "Complication" ;
    dmo:externalCode "I25" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00264-C00264> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-03-19"^^xsd:date ;
    dmo:encounterId "EHR-P00264|C00264" ;
    dmo:encounterType "急诊内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB01> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00264|SUB01" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-07-03T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白 = 19.7 （参考范围 阴性；未作数值判定：映射未核实(unmappable)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00264|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-07-03T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白：上游判读 正常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB02> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00264|SUB02" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-07-03T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "血红蛋白 = 24.8 （参考范围 10-15；未作数值判定：映射未核实(candidate)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB02-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00264|SUB02-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-07-03T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "血红蛋白：上游判读 正常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00264-SUB03-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00264|SUB03-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-07-03T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "肌酐：上游判读 偏高" ;
