@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00127-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00127|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 5.8 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00127-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00127|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TG> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 11.4 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00127-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00127|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-BUN> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 18.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/5b6060f7-4be8-5a2e-bdec-653e5133e2a8> a dmo:Patient ;
    dmo:birthYear 2022 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00127-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00127-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00127-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00127-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00127-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00127-C00127> ;
    dmo:patientId "P00127" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00127-C00127> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2024-01-06"^^xsd:date ;
    dmo:encounterId "EHR-P00127|C00127" ;
    dmo:encounterType "妇科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00127-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00127|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "白细胞：上游判读 正常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00127-SUB02-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00127|SUB02-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "甘油三酯：上游判读 偏高" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00127-SUB03-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00127|SUB03-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿素氮：上游判读 异常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00127-SUB04> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00127|SUB04" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白 = 7.5 （参考范围 阴性；未作数值判定：映射未核实(unmappable)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00127-SUB04-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00127|SUB04-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白：上游判读 正常" ;
    dmo:valueTrustLevel "Unverified" .

