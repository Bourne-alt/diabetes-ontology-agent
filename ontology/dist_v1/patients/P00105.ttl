@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00105-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-06-16T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00105|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 19.5 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00105-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-06-16T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00105|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-GLU> ;
    dmo:resultUnit "mg-per-dL" ;
    dmo:resultValue 129.73104 ;
    dmo:sourceUnit "mmol-per-L" ;
    dmo:sourceValue 7.2 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00105-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-06-16T00:00:00"^^xsd:dateTime ;
