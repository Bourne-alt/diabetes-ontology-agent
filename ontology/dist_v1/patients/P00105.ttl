    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/da988c9c-0369-5f2e-899c-1836b9de8f13> a dmo:Patient ;
    dmo:birthYear 2021 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00105-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00105-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00105-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00105-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00105-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00105-C00105> ;
    dmo:patientId "P00105" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00105-C00105> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-03-08"^^xsd:date ;
    dmo:encounterId "EHR-P00105|C00105" ;
    dmo:encounterType "消化内科" ;
