<https://example.org/dmo/id/labResult/EHR-LAB-TC00021-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2023-07-04T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00021|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TSH> ;
    dmo:resultUnit "mIU-per-L" ;
    dmo:resultValue 23.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/209cc437-efac-5eab-a3f4-ee46b5f0dd47> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00021-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00021-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00021-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00021-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00021-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00021-C00021> ;
    dmo:hasMedicationUse <https://example.org/dmo/id/medicationUse/EHR-MU-P00021-C00021-T004> ;
    dmo:patientId "P00021" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00021-C00021> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2020-01-15"^^xsd:date ;
    dmo:encounterId "EHR-P00021|C00021" ;
    dmo:encounterType "儿科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/medicationUse/EHR-MU-P00021-C00021-T004> a dmo:MedicationUse ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:medicationUseId "EHR-MU-P00021|C00021|T004" ;
    dmo:status "Active" ;
    dmo:usesMedication <https://example.org/dmo/id/medication/metformin> .

<https://example.org/dmo/id/observation/EHR-LAB-TC00021-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00021|SUB01-STATE" ;
    dmo:observationType "Other" ;
