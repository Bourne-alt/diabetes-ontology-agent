@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00082-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-02-18T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00082|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 9.5 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00082-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-02-18T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00082|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 20.0 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00082-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-02-18T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00082|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 9.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/ecda67d8-dbab-5acc-a50b-70a086519000> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00082-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00082-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00082-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00082-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00082-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00082-C00082> ;
    dmo:patientId "P00082" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00082-C00082> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2020-05-26"^^xsd:date ;
    dmo:encounterId "EHR-P00082|C00082" ;
    dmo:encounterType "消化内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00082-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00082|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-02-18T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "白细胞：上游判读 偏低" ;
    dmo:valueTrustLevel "Unverified" .

