<https://example.org/dmo/id/labResult/EHR-LAB-TC00196-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-06-29T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00196|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 19.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00196-SUB02> a dmo:LabResult ;
