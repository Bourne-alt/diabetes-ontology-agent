@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/8c4f4004-7a53-5f8d-9e5c-d220539db6af> a dmo:Patient ;
    dmo:birthYear 1953 ;
    dmo:demoScenario "S27" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/O90030-BMI> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/D90030-DM>,
        <https://example.org/dmo/id/diagnosis/D90030-HTN>,
        <https://example.org/dmo/id/diagnosis/D90030-LIP> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90030-1> ;
    dmo:hasMedicationUse <https://example.org/dmo/id/medicationUse/M90030-PIO> ;
    dmo:patientId "P90030" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/diagnosis/D90030-HTN> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:demoScenario "S27" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90030-1> ;
    dmo:diagnosedDate "2015-05-20"^^xsd:date ;
    dmo:diagnosisId "D90030-HTN" ;
    dmo:diagnosisKind "Comorbidity" ;
    dmo:externalCode "I10" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/diagnosis/D90030-LIP> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:demoScenario "S27" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90030-1> ;
    dmo:diagnosedDate "2016-03-11"^^xsd:date ;
    dmo:diagnosisId "D90030-LIP" ;
    dmo:diagnosisKind "Comorbidity" ;
    dmo:externalCode "E78" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/labResult/L90030-A1C> a dmo:LabResult ;
    dmo:collectedAt "2026-02-21T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S27" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90030-A1C" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-A1C> ;
    dmo:resultUnit "percent" ;
    dmo:resultValue 7.2 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/medicationUse/M90030-PIO> a dmo:MedicationUse ;
    dmo:demoScenario "S27" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:medicationUseId "M90030-PIO" ;
    dmo:regimenRole "口服降糖" ;
    dmo:startDate "2024-08-01"^^xsd:date ;
    dmo:status "Active" ;
    dmo:treatsDiagnosis <https://example.org/dmo/id/diagnosis/D90030-DM> ;
    dmo:usesMedication <https://example.org/dmo/id/medication/pioglitazone> .

<https://example.org/dmo/id/observation/O90030-BMI> a dmo:ClinicalObservation ;
    dmo:demoScenario "S27" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:observationId "O90030-BMI" ;
    dmo:observationRecordedAt <https://example.org/dmo/id/encounter/E90030-1> ;
    dmo:observationType "BMI" ;
    dmo:observedAt "2026-02-21T09:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:unitCode "kg-per-m2" ;
    dmo:valueDecimal 28.8 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/diagnosis/D90030-DM> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:demoScenario "S27" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90030-1> ;
    dmo:diagnosedDate "2017-12-01"^^xsd:date ;
    dmo:diagnosisId "D90030-DM" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/E90030-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-02-21"^^xsd:date ;
    dmo:encounterId "E90030-1" ;
    dmo:encounterType "Routine" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90030-A1C> .

