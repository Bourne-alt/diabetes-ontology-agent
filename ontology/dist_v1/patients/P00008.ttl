<https://example.org/dmo/id/patient/8a76424f-8efe-5ea0-a9ec-62e449a7ff8d> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00008-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00008-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00008-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00008-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00008-C00008-D901> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00008-C00008> ;
    dmo:patientId "P00008" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00008-C00008-D901> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00008|C00008|D901" ;
    dmo:diagnosisKind "Comorbidity" ;
    dmo:externalCode "E78" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00008-C00008> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-12-06"^^xsd:date ;
    dmo:encounterId "EHR-P00008|C00008" ;
