@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00316-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00316|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 16.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00316-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00316|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 5.2 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00316-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00316|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-BUN> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 7.3 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/42aae6bc-fcea-55c5-9a81-b311461f9f0e> a dmo:Patient ;
    dmo:birthYear 2025 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00316-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00316-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00316-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00316-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00316-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00316-C00316-D568> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00316-C00316> ;
    dmo:patientId "P00316" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00316-C00316-D568> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00316|C00316|D568" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00316-C00316> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2023-08-23"^^xsd:date ;
    dmo:encounterId "EHR-P00316|C00316" ;
    dmo:encounterType "心内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00316-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00316|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "血小板：上游判读 异常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00316-SUB02-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00316|SUB02-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-01-31T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "AST：上游判读 偏低" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00316-SUB03-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00316|SUB03-STATE" ;
    dmo:observationType "Other" ;
