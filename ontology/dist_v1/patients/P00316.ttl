<https://example.org/dmo/id/observation/EHR-LAB-TC00316-SUB04> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00316|SUB04" ;
    dmo:observationType "Other" ;
