<https://example.org/dmo/id/labResult/EHR-LAB-TC00328-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-06-13T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00328|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 11.8 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00328-SUB02> a dmo:LabResult ;
