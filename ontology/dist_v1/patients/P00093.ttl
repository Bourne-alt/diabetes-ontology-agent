@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00093-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-07-15T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00093|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 25.0 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00093-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2023-07-15T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00093|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 20.8 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00093-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2023-07-15T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00093|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 11.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/3ca8d066-715c-5e16-beae-70cd50e4ac56> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00093-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00093-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00093-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00093-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00093-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00093-C00093-D568> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00093-C00093> ;
    dmo:patientId "P00093" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00093-C00093-D568> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00093|C00093|D568" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00093-C00093> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2020-09-10"^^xsd:date ;
    dmo:encounterId "EHR-P00093|C00093" ;
    dmo:encounterType "眼科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00093-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00093|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-07-15T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "白细胞：上游判读 偏高" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00093-SUB02-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
