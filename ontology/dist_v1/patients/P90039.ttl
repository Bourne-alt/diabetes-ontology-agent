@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/00fac3c7-bc2d-5a50-8b97-cce6ccb1ae63> a dmo:Patient ;
    dmo:birthYear 1964 ;
    dmo:demoScenario "S34" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/D90039-DM>,
        <https://example.org/dmo/id/diagnosis/D90039-DME> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90039-1> ;
    dmo:patientId "P90039" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/diagnosis/D90039-DM> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:demoScenario "S34" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90039-1> ;
    dmo:diagnosedDate "2011-07-22"^^xsd:date ;
    dmo:diagnosisId "D90039-DM" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/diagnosis/D90039-DME> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:demoScenario "S34" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90039-1> ;
    dmo:diagnosedDate "2025-03-06"^^xsd:date ;
    dmo:diagnosisComplication <https://example.org/dmo/id/DME> ;
    dmo:diagnosisId "D90039-DME" ;
    dmo:diagnosisKind "Complication" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/E90039-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-06-11"^^xsd:date ;
    dmo:encounterId "E90039-1" ;
    dmo:encounterType "Routine" ;
    dmo:factOrigin "demo-cohort" .

