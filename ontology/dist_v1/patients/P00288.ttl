<https://example.org/dmo/id/labResult/EHR-LAB-TC00288-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2023-05-30T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00288|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 23.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/6b1ebdce-6842-5b2b-895d-c46d7efe26cc> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00288-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00288-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00288-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00288-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00288-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00288-C00288> ;
    dmo:patientId "P00288" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00288-C00288> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-06-19"^^xsd:date ;
    dmo:encounterId "EHR-P00288|C00288" ;
    dmo:encounterType "儿科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00288-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00288|SUB01-STATE" ;
    dmo:observationType "Other" ;
