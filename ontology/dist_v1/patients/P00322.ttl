    dmo:resultValue 419.82406 ;
    dmo:sourceUnit "mmol-per-L" ;
    dmo:sourceValue 23.3 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/952d7bfa-e451-5ed4-9a3d-c024b4766d09> a dmo:Patient ;
    dmo:birthYear 2022 ;
