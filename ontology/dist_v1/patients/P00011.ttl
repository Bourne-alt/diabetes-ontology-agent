@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00011-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-03-21T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00011|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 7.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00011-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-03-21T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00011|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 22.5 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00011-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-03-21T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00011|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 6.8 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/ec8e05d6-d066-5cf7-9987-3adcd49978ef> a dmo:Patient ;
    dmo:birthYear 2021 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00011-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00011-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00011-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00011-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00011-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00011-C00011> ;
    dmo:patientId "P00011" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00011-C00011> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-10-31"^^xsd:date ;
    dmo:encounterId "EHR-P00011|C00011" ;
    dmo:encounterType "儿科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00011-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00011|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-03-21T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "ALT：上游判读 正常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00011-SUB02-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00011|SUB02-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-03-21T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "肌酐：上游判读 正常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00011-SUB03-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00011|SUB03-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-03-21T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "白细胞：上游判读 偏低" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00011-SUB04> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00011|SUB04" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-03-21T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白 = 8.5 （参考范围 阴性；未作数值判定：映射未核实(unmappable)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00011-SUB04-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00011|SUB04-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-03-21T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白：上游判读 偏高" ;
    dmo:valueTrustLevel "Unverified" .

