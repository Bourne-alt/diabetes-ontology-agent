@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00151-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-03-29T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00151|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 12.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00151-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-03-29T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00151|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 12.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00151-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-03-29T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00151|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 22.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/106d8328-afc3-5360-9920-0ae5325dfbce> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00151-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00151-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00151-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00151-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00151-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00151-C00151> ;
    dmo:patientId "P00151" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00151-C00151> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-02-17"^^xsd:date ;
    dmo:encounterId "EHR-P00151|C00151" ;
    dmo:encounterType "消化内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00151-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00151|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-03-29T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "ALT：上游判读 正常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00151-SUB02> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00151|SUB02" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-03-29T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白 = 17.9 （参考范围 阴性；未作数值判定：映射未核实(unmappable)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00151-SUB02-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00151|SUB02-STATE" ;
