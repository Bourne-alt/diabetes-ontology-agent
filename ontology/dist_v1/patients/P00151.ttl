<https://example.org/dmo/id/observation/EHR-LAB-TC00151-SUB03-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00151|SUB03-STATE" ;
