@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00283-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-01-10T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00283|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-BUN> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 15.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00283-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-01-10T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00283|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 22.8 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00283-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-01-10T00:00:00"^^xsd:dateTime ;
