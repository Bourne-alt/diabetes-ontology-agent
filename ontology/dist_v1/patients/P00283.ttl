    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 13.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/64bb59d9-13be-5cd4-a5fc-1bce27b4eaa5> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00283-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00283-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00283-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00283-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00283-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00283-C00283> ;
    dmo:patientId "P00283" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00283-C00283> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-09-07"^^xsd:date ;
    dmo:encounterId "EHR-P00283|C00283" ;
    dmo:encounterType "肾内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00283-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00283|SUB01-STATE" ;
    dmo:observationType "Other" ;
