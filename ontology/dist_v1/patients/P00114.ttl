@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00114-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-03-11T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00114|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TG> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 15.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00114-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-03-11T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00114|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 7.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00114-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-03-11T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00114|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TSH> ;
    dmo:resultUnit "mIU-per-L" ;
    dmo:resultValue 7.4 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/9aaeb45d-e2c1-5a3f-8246-b9277a9f5603> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00114-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00114-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00114-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00114-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00114-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00114-C00114-D846> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00114-C00114> ;
    dmo:patientId "P00114" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00114-C00114-D846> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisComplication <https://example.org/dmo/id/CVD> ;
    dmo:diagnosisId "EHR-DX-P00114|C00114|D846" ;
    dmo:diagnosisKind "Complication" ;
    dmo:externalCode "I25" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00114-C00114> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-07-23"^^xsd:date ;
    dmo:encounterId "EHR-P00114|C00114" ;
    dmo:encounterType "皮肤科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00114-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00114|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-03-11T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "甘油三酯：上游判读 偏低" ;
