@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00050-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2023-05-07T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00050|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 5.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00050-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2023-05-07T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00050|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 17.0 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00050-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2023-05-07T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00050|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-BUN> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 24.1 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/15be1531-1edd-5e27-acc9-e5b0db84dee0> a dmo:Patient ;
    dmo:birthYear 2025 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00050-SUB01>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00050-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00050-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00050-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00050-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00050-C00050> ;
    dmo:patientId "P00050" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00050-C00050> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-08-02"^^xsd:date ;
    dmo:encounterId "EHR-P00050|C00050" ;
    dmo:encounterType "眼科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00050-SUB01> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00050|SUB01" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2023-05-07T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白 = 11.7 （参考范围 阴性；未作数值判定：映射未核实(unmappable)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00050-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
