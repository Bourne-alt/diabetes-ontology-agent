@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00321-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-05-21T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00321|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TSH> ;
    dmo:resultUnit "mIU-per-L" ;
    dmo:resultValue 20.0 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00321-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-05-21T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00321|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 18.8 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00321-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-05-21T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00321|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-WBC> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 22.2 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/8ae1400f-b3b1-559f-bec1-fed55ca1cfc6> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00321-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00321-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00321-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00321-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00321-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00321-C00321> ;
    dmo:patientId "P00321" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00321-C00321> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-03-03"^^xsd:date ;
    dmo:encounterId "EHR-P00321|C00321" ;
    dmo:encounterType "消化内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00321-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00321|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-05-21T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "TSH：上游判读 异常" ;
    dmo:valueTrustLevel "Unverified" .

