<https://example.org/dmo/id/labResult/EHR-LAB-TC00364-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-09-25T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00364|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 10.2 ;
