<https://example.org/dmo/id/patient/e309d9e1-504f-58f8-924c-6f83ec2b934e> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00341-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00341-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00341-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00341-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00341-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00341-C00341-D724> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00341-C00341> ;
    dmo:patientId "P00341" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00341-C00341-D724> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00341|C00341|D724" ;
    dmo:diagnosisKind "Comorbidity" ;
    dmo:externalCode "I10" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00341-C00341> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-06-20"^^xsd:date ;
    dmo:encounterId "EHR-P00341|C00341" ;
    dmo:encounterType "儿科" ;
    dmo:factOrigin "ehr-legacy" .

