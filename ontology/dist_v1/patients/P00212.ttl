<https://example.org/dmo/id/patient/67fd7ee1-f725-55af-a508-40ef6b45101c> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00212-SUB01>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00212-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00212-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00212-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00212-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00212-C00212-D505> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00212-C00212> ;
    dmo:patientId "P00212" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00212-C00212-D505> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00212|C00212|D505" ;
    dmo:diagnosisKind "Comorbidity" ;
    dmo:externalCode "E66" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00212-C00212> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-02-12"^^xsd:date ;
    dmo:encounterId "EHR-P00212|C00212" ;
    dmo:encounterType "皮肤科" ;
