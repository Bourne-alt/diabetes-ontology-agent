@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00006-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-08-16T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00006|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 9.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00006-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-08-16T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00006|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 14.9 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00006-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-08-16T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00006|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-BUN> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 14.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/ccc988e0-6bb7-52c1-a60b-b2f71b6821ab> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00006-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00006-SUB02>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00006-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00006-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00006-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00006-C00006-D901> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00006-C00006> ;
    dmo:patientId "P00006" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00006-C00006-D901> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00006|C00006|D901" ;
    dmo:diagnosisKind "Comorbidity" ;
    dmo:externalCode "E78" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00006-C00006> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-07-22"^^xsd:date ;
    dmo:encounterId "EHR-P00006|C00006" ;
    dmo:encounterType "骨科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00006-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00006|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-08-16T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "AST：上游判读 异常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00006-SUB02> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00006|SUB02" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-08-16T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白 = 9.5 （参考范围 阴性；未作数值判定：映射未核实(unmappable)）" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00006-SUB02-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00006|SUB02-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-08-16T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白：上游判读 偏高" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00006-SUB03-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00006|SUB03-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-08-16T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "血小板：上游判读 正常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00006-SUB04-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00006|SUB04-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-08-16T00:00:00"^^xsd:dateTime ;
