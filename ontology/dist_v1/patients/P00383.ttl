@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00383-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-10-25T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00383|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 17.7 ;
    dmo:valueTrustLevel "Unverified" .

