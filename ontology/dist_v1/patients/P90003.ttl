@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/72ff0635-d018-57c5-9f63-4c06b26277f3> a dmo:Patient ;
    dmo:birthYear 1965 ;
    dmo:demoScenario "S03" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/D90003-DM> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90003-1>,
        <https://example.org/dmo/id/encounter/E90003-2> ;
    dmo:patientId "P90003" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/diagnosis/D90003-DM> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:demoScenario "S03" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90003-1> ;
    dmo:diagnosedDate "2026-01-08"^^xsd:date ;
    dmo:diagnosisId "D90003-DM" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/E90003-2> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-02-19"^^xsd:date ;
    dmo:encounterId "E90003-2" ;
    dmo:encounterType "Routine" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90003-A1C-2> .

<https://example.org/dmo/id/labResult/L90003-A1C-1> a dmo:LabResult ;
    dmo:collectedAt "2026-01-08T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S03" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90003-A1C-1" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-A1C> ;
    dmo:resultUnit "percent" ;
    dmo:resultValue 7.1 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/labResult/L90003-A1C-2> a dmo:LabResult ;
    dmo:collectedAt "2026-02-19T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S03" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90003-A1C-2" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-A1C> ;
    dmo:resultUnit "percent" ;
    dmo:resultValue 7.3 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/encounter/E90003-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-01-08"^^xsd:date ;
    dmo:encounterId "E90003-1" ;
    dmo:encounterType "Routine" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90003-A1C-1> .

