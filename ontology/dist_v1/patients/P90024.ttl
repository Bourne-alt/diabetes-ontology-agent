<https://example.org/dmo/id/medicationUse/M90024-MET> a dmo:MedicationUse ;
    dmo:demoScenario "S21" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:medicationUseId "M90024-MET" ;
    dmo:regimenRole "口服降糖" ;
