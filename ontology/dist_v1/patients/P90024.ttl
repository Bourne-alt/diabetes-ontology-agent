@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/924d7d4b-8093-586e-b006-e9187a63e15f> a dmo:Patient ;
    dmo:birthYear 1961 ;
    dmo:demoScenario "S21" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/O90024-ACT>,
        <https://example.org/dmo/id/observation/O90024-BMI>,
        <https://example.org/dmo/id/observation/O90024-SMOKE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/D90024-DM> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90024-1> ;
    dmo:hasMedicationUse <https://example.org/dmo/id/medicationUse/M90024-MET> ;
    dmo:patientId "P90024" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/labResult/L90024-A1C> a dmo:LabResult ;
    dmo:collectedAt "2026-02-13T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S21" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90024-A1C" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-A1C> ;
    dmo:resultUnit "percent" ;
    dmo:resultValue 6.6 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/labResult/L90024-EGFR> a dmo:LabResult ;
    dmo:collectedAt "2026-02-13T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S21" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90024-EGFR" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-EGFR> ;
    dmo:resultUnit "mL-per-min" ;
    dmo:resultValue 88.0 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/labResult/L90024-UACR> a dmo:LabResult ;
    dmo:collectedAt "2026-02-13T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S21" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90024-UACR" ;
