    dmo:status "Active" ;
    dmo:treatsDiagnosis <https://example.org/dmo/id/diagnosis/D90024-DM> ;
    dmo:usesMedication <https://example.org/dmo/id/medication/metformin> .

<https://example.org/dmo/id/observation/O90024-ACT> a dmo:ClinicalObservation ;
    dmo:demoScenario "S21" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:observationId "O90024-ACT" ;
    dmo:observationRecordedAt <https://example.org/dmo/id/encounter/E90024-1> ;
    dmo:observationType "PhysicalActivityPerWeek" ;
    dmo:observedAt "2026-02-13T09:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:unitCode "per-week" ;
    dmo:valueDecimal 5.0 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/observation/O90024-BMI> a dmo:ClinicalObservation ;
    dmo:demoScenario "S21" ;
    dmo:factOrigin "demo-cohort" ;
