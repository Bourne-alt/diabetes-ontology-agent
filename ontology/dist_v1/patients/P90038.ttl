@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/995daa36-24c4-53f7-b943-62245313e7db> a dmo:Patient ;
    dmo:birthYear 1959 ;
    dmo:demoScenario "S33" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/D90038-DM>,
        <https://example.org/dmo/id/diagnosis/D90038-DPN> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90038-1> ;
    dmo:patientId "P90038" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/D90038-DM> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:demoScenario "S33" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90038-1> ;
    dmo:diagnosedDate "2010-02-05"^^xsd:date ;
    dmo:diagnosisId "D90038-DM" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/diagnosis/D90038-DPN> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:demoScenario "S33" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90038-1> ;
    dmo:diagnosedDate "2024-09-19"^^xsd:date ;
    dmo:diagnosisComplication <https://example.org/dmo/id/DPN> ;
    dmo:diagnosisId "D90038-DPN" ;
    dmo:diagnosisKind "Complication" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/labResult/L90038-A1C> a dmo:LabResult ;
    dmo:collectedAt "2026-06-09T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S33" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90038-A1C" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-A1C> ;
    dmo:resultUnit "percent" ;
    dmo:resultValue 8.3 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/encounter/E90038-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-06-09"^^xsd:date ;
    dmo:encounterId "E90038-1" ;
    dmo:encounterType "Routine" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90038-A1C> .

