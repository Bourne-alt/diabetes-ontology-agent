@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00060-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-11-15T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00060|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 24.3 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00060-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2023-11-15T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00060|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 18.7 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00060-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2023-11-15T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00060|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TSH> ;
    dmo:resultUnit "mIU-per-L" ;
    dmo:resultValue 18.0 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/8e633d4e-2c36-5563-8069-357500093547> a dmo:Patient ;
    dmo:birthYear 2022 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00060-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00060-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00060-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00060-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00060-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00060-C00060> ;
    dmo:hasMedicationUse <https://example.org/dmo/id/medicationUse/EHR-MU-P00060-C00060-T004> ;
    dmo:patientId "P00060" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00060-C00060> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-03-13"^^xsd:date ;
    dmo:encounterId "EHR-P00060|C00060" ;
    dmo:encounterType "皮肤科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/medicationUse/EHR-MU-P00060-C00060-T004> a dmo:MedicationUse ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:medicationUseId "EHR-MU-P00060|C00060|T004" ;
    dmo:status "Active" ;
    dmo:usesMedication <https://example.org/dmo/id/medication/metformin> .

<https://example.org/dmo/id/observation/EHR-LAB-TC00060-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00060|SUB01-STATE" ;
    dmo:observationType "Other" ;
