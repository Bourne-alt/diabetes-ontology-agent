<https://example.org/dmo/id/patient/17063aee-4e30-5d6e-ad0e-f33b5b250de9> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00210-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00210-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00210-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00210-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00210-C00210> ;
    dmo:patientId "P00210" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00210-C00210> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2022-03-09"^^xsd:date ;
