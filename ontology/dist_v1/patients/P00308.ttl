<https://example.org/dmo/id/patient/b2e40e5b-f28a-57c2-a3bd-f6d1132c404e> a dmo:Patient ;
    dmo:birthYear 2021 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00308-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00308-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00308-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00308-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00308-C00308> ;
    dmo:patientId "P00308" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00308-C00308> a dmo:ClinicalEncounter ;
