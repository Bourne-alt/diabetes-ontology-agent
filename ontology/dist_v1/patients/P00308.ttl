@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00308-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-03-06T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00308|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 9.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00308-SUB02> a dmo:LabResult ;
