    dmo:labResultId "EHR-LAB-TC00346|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 14.5 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00346-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2023-06-09T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00346|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 22.5 ;
