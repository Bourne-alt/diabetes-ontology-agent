<https://example.org/dmo/id/patient/ed097c9f-449d-5222-bfcb-28d2bf91a84f> a dmo:Patient ;
    dmo:birthYear 2025 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00346-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00346-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00346-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00346-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00346-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00346-C00346-D505> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00346-C00346> ;
    dmo:patientId "P00346" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00346-C00346-D505> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00346|C00346|D505" ;
    dmo:diagnosisKind "Comorbidity" ;
    dmo:externalCode "E66" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00346-C00346> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-03-23"^^xsd:date ;
    dmo:encounterId "EHR-P00346|C00346" ;
    dmo:encounterType "急诊内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00346-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00346|SUB01-STATE" ;
    dmo:observationType "Other" ;
