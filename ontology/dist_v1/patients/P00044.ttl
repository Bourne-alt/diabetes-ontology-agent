@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00044-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-07-21T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00044|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 17.0 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00044-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-07-21T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00044|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 17.2 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00044-SUB03> a dmo:LabResult ;
    dmo:collectedAt "2024-07-21T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00044|SUB03" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-ALT> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 24.4 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/05820122-33c9-5259-821d-c15b548c980f> a dmo:Patient ;
    dmo:birthYear 2020 ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00044-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00044-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00044-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00044-SUB04>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00044-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00044-C00044> ;
    dmo:patientId "P00044" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/encounter/EHR-P00044-C00044> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2023-08-12"^^xsd:date ;
    dmo:encounterId "EHR-P00044|C00044" ;
    dmo:encounterType "心内科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00044-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00044|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-07-21T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "总胆固醇：上游判读 偏高" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00044-SUB02-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00044|SUB02-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-07-21T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "AST：上游判读 正常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00044-SUB03-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00044|SUB03-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-07-21T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "ALT：上游判读 异常" ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/observation/EHR-LAB-TC00044-SUB04> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00044|SUB04" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-07-21T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "尿蛋白 = 23.7 （参考范围 阴性；未作数值判定：映射未核实(unmappable)）" ;
