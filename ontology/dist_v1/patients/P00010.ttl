@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00010-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-07-27T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00010|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 10.5 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00010-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-07-27T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00010|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 18.5 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00010-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-07-27T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00010|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CREAT> ;
    dmo:resultUnit "umol-per-L" ;
    dmo:resultValue 12.0 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/c666f4cd-c465-56fe-b027-56ca5f034441> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00010-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00010-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00010-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00010-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00010-SUB04-STATE> ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/EHR-DX-P00010-C00010-D724> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00010-C00010> ;
    dmo:patientId "P00010" ;
    dmo:sex "Female" .

<https://example.org/dmo/id/diagnosis/EHR-DX-P00010-C00010-D724> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:diagnosisId "EHR-DX-P00010|C00010|D724" ;
    dmo:diagnosisKind "Comorbidity" ;
    dmo:externalCode "I10" ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/encounter/EHR-P00010-C00010> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2023-07-01"^^xsd:date ;
    dmo:encounterId "EHR-P00010|C00010" ;
    dmo:encounterType "妇科" ;
    dmo:factOrigin "ehr-legacy" .

