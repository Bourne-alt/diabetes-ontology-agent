@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00281-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2024-06-10T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00281|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-AST> ;
    dmo:resultUnit "U-per-L" ;
    dmo:resultValue 12.8 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00281-SUB02> a dmo:LabResult ;
    dmo:collectedAt "2024-06-10T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00281|SUB02" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-TG> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 17.4 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/labResult/EHR-LAB-TC00281-SUB04> a dmo:LabResult ;
    dmo:collectedAt "2024-06-10T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00281|SUB04" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-CHOL> ;
    dmo:resultUnit "mmol-per-L" ;
    dmo:resultValue 8.6 ;
    dmo:valueTrustLevel "Unverified" .

<https://example.org/dmo/id/patient/b9c9d4b2-2c00-5d35-8569-c68e6d7ff48b> a dmo:Patient ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:hasClinicalObservation <https://example.org/dmo/id/observation/EHR-LAB-TC00281-SUB01-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00281-SUB02-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00281-SUB03>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00281-SUB03-STATE>,
        <https://example.org/dmo/id/observation/EHR-LAB-TC00281-SUB04-STATE> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/EHR-P00281-C00281> ;
    dmo:hasMedicationUse <https://example.org/dmo/id/medicationUse/EHR-MU-P00281-C00281-T004> ;
    dmo:patientId "P00281" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/EHR-P00281-C00281> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2021-06-06"^^xsd:date ;
    dmo:encounterId "EHR-P00281|C00281" ;
    dmo:encounterType "眼科" ;
    dmo:factOrigin "ehr-legacy" .

<https://example.org/dmo/id/medicationUse/EHR-MU-P00281-C00281-T004> a dmo:MedicationUse ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:medicationUseId "EHR-MU-P00281|C00281|T004" ;
    dmo:status "Active" ;
    dmo:usesMedication <https://example.org/dmo/id/medication/metformin> .

<https://example.org/dmo/id/observation/EHR-LAB-TC00281-SUB01-STATE> a dmo:ClinicalObservation ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:observationId "EHR-LAB-TC00281|SUB01-STATE" ;
    dmo:observationType "Other" ;
    dmo:observedAt "2024-06-10T00:00:00"^^xsd:dateTime ;
    dmo:status "Final" ;
    dmo:valueText "AST：上游判读 偏低" ;
    dmo:valueTrustLevel "Unverified" .

