<https://example.org/dmo/id/labResult/EHR-LAB-TC00398-SUB01> a dmo:LabResult ;
    dmo:collectedAt "2023-10-12T00:00:00"^^xsd:dateTime ;
    dmo:factOrigin "ehr-legacy" ;
    dmo:labResultId "EHR-LAB-TC00398|SUB01" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-PLT> ;
    dmo:resultUnit "10*9-per-L" ;
    dmo:resultValue 8.3 ;
    dmo:valueTrustLevel "Unverified" .

