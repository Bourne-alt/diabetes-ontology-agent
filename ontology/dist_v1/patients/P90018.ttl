@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/d4ee8730-1ad5-5f04-99e0-571133d76175> a dmo:Patient ;
    dmo:birthYear 1974 ;
    dmo:demoScenario "S16" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90018-1> ;
    dmo:patientId "P90018" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/encounter/E90018-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-02-06"^^xsd:date ;
    dmo:encounterId "E90018-1" ;
    dmo:encounterType "Screening" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90018-A1C> .

<https://example.org/dmo/id/labResult/L90018-A1C> a dmo:LabResult ;
    dmo:collectedAt "2026-02-06T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S16" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90018-A1C" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-A1C> ;
    dmo:resultUnit "percent" ;
    dmo:resultValue 6.4 ;
    dmo:valueTrustLevel "Curated" .

