@prefix dmo: <https://example.org/dmo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dmo/id/patient/ff20f2b3-f5f7-503d-81b8-52bf134f5413> a dmo:Patient ;
    dmo:birthYear 1958 ;
    dmo:demoScenario "S05" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:hasDiagnosis <https://example.org/dmo/id/diagnosis/D90006-DKD>,
        <https://example.org/dmo/id/diagnosis/D90006-DM> ;
    dmo:hasEncounter <https://example.org/dmo/id/encounter/E90006-1> ;
    dmo:patientId "P90006" ;
    dmo:sex "Male" .

<https://example.org/dmo/id/diagnosis/D90006-DKD> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:demoScenario "S05" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90006-1> ;
    dmo:diagnosedDate "2024-09-01"^^xsd:date ;
    dmo:diagnosisComplication <https://example.org/dmo/id/DKD> ;
    dmo:diagnosisId "D90006-DKD" ;
    dmo:diagnosisKind "Complication" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/diagnosis/D90006-DM> a dmo:Diagnosis ;
    dmo:clinicalStatus "Active" ;
    dmo:codeSystem "ICD-10" ;
    dmo:demoScenario "S05" ;
    dmo:diagnosedAt <https://example.org/dmo/id/encounter/E90006-1> ;
    dmo:diagnosedDate "2018-05-14"^^xsd:date ;
    dmo:diagnosisId "D90006-DM" ;
    dmo:diagnosisKind "Diabetes" ;
    dmo:diagnosisType <https://example.org/dmo/id/T2DM> ;
    dmo:externalCode "E11" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:verificationStatus "Confirmed" .

<https://example.org/dmo/id/labResult/L90006-A1C> a dmo:LabResult ;
    dmo:collectedAt "2026-02-02T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S05" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90006-A1C" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-A1C> ;
    dmo:resultUnit "percent" ;
    dmo:resultValue 8.2 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/labResult/L90006-UACR> a dmo:LabResult ;
    dmo:collectedAt "2026-02-02T09:00:00"^^xsd:dateTime ;
    dmo:demoScenario "S05" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:labResultId "L90006-UACR" ;
    dmo:measuredByTest <https://example.org/dmo/id/LabTest-UACR> ;
    dmo:resultUnit "mg-per-g" ;
    dmo:resultValue 420.0 ;
    dmo:valueTrustLevel "Curated" .

<https://example.org/dmo/id/encounter/E90006-1> a dmo:ClinicalEncounter ;
    dmo:encounterDate "2026-02-02"^^xsd:date ;
    dmo:encounterId "E90006-1" ;
    dmo:encounterType "Routine" ;
    dmo:factOrigin "demo-cohort" ;
    dmo:producesLabResult <https://example.org/dmo/id/labResult/L90006-A1C>,
        <https://example.org/dmo/id/labResult/L90006-UACR> .

