<https://example.org/dmo/id/complication/peripheral-neuropathy> a dmo:Complication ;
    rdfs:label "Peripheral Neuropathy" ;
    dmo:affectedOrgan "Nerve" ;
    dmo:complicationCode "peripheral-neuropathy" ;
    dmo:definition "Peripheral neuropathy is nerve damage that typically affects the feet and legs and sometimes affects the hands and arms." ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Peripheral Neuropathy" ;
    dmo:onsetPattern "Chronic" ;
    dmo:evidenceQuote "Peripheral neuropathy is nerve damage that typically affects the feet and legs and sometimes affects the hands and arms." ;
    dmo:evidenceQuote "Foot care is very important for all people with diabetes, and it’s even more important if you have peripheral neuropathy." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-diabetic-neuropathy> .

<https://example.org/dmo/id/complication/proximal-neuropathy> a dmo:Complication ;
    rdfs:label "Proximal Neuropathy" ;
    dmo:affectedOrgan "Nerve" ;
    dmo:complicationCode "proximal-neuropathy" ;
    dmo:definition "Proximal neuropathy is a rare and disabling type of nerve damage in your hip, buttock, or thigh. This type of nerve damage typically affects one side of your body and may rarely spread to the other side. Proximal neuropathy often causes severe pain and may lead to significant weight loss." ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005150" ;
    dmo:name "Proximal Neuropathy" ;
    dmo:onsetPattern "Chronic" ;
    dmo:evidenceQuote "Proximal neuropathy is a rare and disabling type of nerve damage in your hip, buttock, or thigh. This type of nerve damage typically affects one side of your body and may rarely spread to the other side. Proximal neuropathy often causes severe pain and may lead to significant weight loss." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-diabetic-neuropathy> .

