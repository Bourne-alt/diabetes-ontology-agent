    dmo:definition "Nerve damage can also cause problems with balance and coordination, leading to falls and fractures." ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005152" ;
    dmo:name "Balance and Coordination Problems" ;
