<https://example.org/dmo/id/complication/diabetic-neuropathy> a dmo:Complication ;
    rdfs:label "Diabetic Neuropathy" ;
    dmo:affectedOrgan "Nerve" ;
    dmo:complicationCode "diabetic-neuropathy" ;
    dmo:definition "If you have diabetic neuropathy, you should manage your diabetes, which means managing your blood glucose, blood pressure, cholesterol levels, and weight to keep nerve damage from getting worse." ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Diabetic Neuropathy" ;
    dmo:onsetPattern "Chronic" ;
    dmo:evidenceQuote "If you have diabetic neuropathy, you should manage your diabetes, which means managing your blood glucose, blood pressure, cholesterol levels, and weight to keep nerve damage from getting worse." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-diabetic-neuropathy> .

