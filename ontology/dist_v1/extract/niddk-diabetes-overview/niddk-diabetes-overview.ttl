<https://example.org/dmo/id/diabetesType/type-2-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:definition "If you have type 2 diabetes, the cells in your body don’t use insulin properly. The pancreas may be making insulin but is not making enough insulin to keep your blood glucose level in the normal range." ;
    dmo:diabetesTypeCode "type-2-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
