<https://example.org/dmo/id/diabetesType/gestational-diabetes> a dmo:DiabetesType ;
    rdfs:label "Gestational Diabetes" ;
    dmo:definition "Gestational diabetes is a type of diabetes that occurs only during pregnancy." ;
    dmo:diabetesTypeCode "gestational-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Gestational Diabetes" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "Pregnancy" ;
    dmo:evidenceQuote "Gestational diabetes is a type of diabetes that occurs only during pregnancy." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-gestational-diabetes> .

<https://example.org/dmo/id/labTest/glucose-challenge-test> a dmo:LabTest ;
    rdfs:label "Glucose Challenge Test" ;
    dmo:definition "A test used to screen for gestational diabetes, performed between 24 and 28 weeks of pregnancy. If the results show high blood glucose, an oral glucose tolerance test is required to confirm the diagnosis." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "glucose-challenge-test" ;
    dmo:name "Glucose Challenge Test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Your doctor will test you for gestational diabetes between 24 and 28 weeks of pregnancy. Tests include the glucose challenge test and the oral glucose tolerance test (OGTT). If the results of the glucose challenge test show high blood glucose, you will return for an OGTT test to confirm the diagnosis of gestational diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-gestational-diabetes> .

<https://example.org/dmo/id/labTest/oral-glucose-tolerance-test> a dmo:LabTest ;
    rdfs:label "Oral Glucose Tolerance Test" ;
    dmo:definition "A test used to confirm the diagnosis of gestational diabetes after a positive glucose challenge test. It measures blood glucose levels before and after consuming a glucose solution." ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "oral-glucose-tolerance-test" ;
    dmo:loincCode "15076-8" ;
    dmo:name "Oral Glucose Tolerance Test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "If the results of the glucose challenge test show high blood glucose, you will return for an OGTT test to confirm the diagnosis of gestational diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-gestational-diabetes> .

