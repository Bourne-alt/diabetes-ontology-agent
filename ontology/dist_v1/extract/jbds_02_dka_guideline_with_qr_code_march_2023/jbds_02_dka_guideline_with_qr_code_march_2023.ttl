<https://example.org/dmo/id/labTest/osmolality> a dmo:LabTest ;
    rdfs:label "Osmolality" ;
    dmo:definition "Osmolality is checked for HHS normalization as part of exit criteria." ;
    dmo:labTestCode "osmolality" ;
    dmo:name "Osmolality" ;
    dmo:evidenceQuote "HHS: Osmolality normalised and               ☐" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/pancreatic-enzymes> a dmo:LabTest ;
    rdfs:label "Pancreatic Enzymes" ;
    dmo:definition "Enzymes produced by the pancreas, which may rise with or without acute pancreatitis in the context of DKA." ;
    dmo:labTestCode "pancreatic-enzymes" ;
    dmo:name "Pancreatic Enzymes" ;
    dmo:evidenceQuote "Other, rare complications include pulmonary oedema; a rise in pancreatic enzymes, with or without acute pancreatitis; cardiomyopathy; rhabdomyolysis; and, gastrointestinal bleeding (25)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/ph> a dmo:LabTest ;
    rdfs:label "pH" ;
    dmo:definition "A measure of the acidity or alkalinity of the blood, which was not significantly different in people with end stage renal disease compared to those with preserved renal function." ;
    dmo:labTestCode "ph" ;
    dmo:name "pH" ;
    dmo:evidenceQuote "Bicarbonate and pH were not significantly different (58)." ;
    dmo:evidenceQuote "Check creatinine, electrolyte and venous bicarbonate and pH at 2 hours then 2 to 4 hourly until venous bicarbonate >15 mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/plasma-electrolytes> a dmo:LabTest ;
    rdfs:label "Plasma Electrolytes" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "plasma-electrolytes" ;
    dmo:name "Plasma Electrolytes" ;
    dmo:evidenceQuote "• 4 hourly plasma electrolytes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/plasma-glucose> a dmo:LabTest ;
    rdfs:label "Plasma Glucose" ;
    dmo:definition "Plasma glucose is monitored hourly. A fall of at least 3 mmol/L/hr is expected. If glucose falls below 14 mmol/L, 10% glucose is added." ;
    dmo:labTestCode "plasma-glucose" ;
    dmo:name "Plasma Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Plasma glucose not falling by at least 3 mmol/L/hr" ;
    dmo:evidenceQuote "Alternatively use plasma glucose. If the glucose is not falling by at least 3.0 mmol/L/hr call a prescribing clinician to increase the insulin infusion rate by 1.0 unit/hr increments hourly until glucose falls at this rate. Glucose level is not an accurate indicator of resolution of acidosis in ketoacidosis, so the acidosis resolution should be verified by venous gas analysis**" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/potassium> a dmo:LabTest ;
    rdfs:label "Potassium" ;
    dmo:definition "Potassium is monitored hourly. If outside normal range, re-assess replacement and check hourly. Abnormal levels require immediate senior advice." ;
    dmo:labTestCode "potassium" ;
    dmo:name "Potassium" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "If potassium is outside normal range, re-assess potassium replacement and check hourly. If abnormal after further hour seek immediate senior medical advice" ;
    dmo:evidenceQuote "Maintain potassium between 4.0 and 5.5 mmol/L" ;
    dmo:evidenceQuote "If the potassium is outside the reference range (4.0 – 5.5 mmol/L), assess the appropriateness of the potassium replacement and check it hourly. If it remains abnormal after a further hour, seek immediate senior medical advice (see Action 3 p26)" ;
    dmo:evidenceQuote "At 12 hours check venous pH, bicarbonate, potassium, as well as blood ketones and glucose" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/pregnancy-test> a dmo:LabTest ;
    rdfs:label "Pregnancy Test" ;
    dmo:definition "Test to detect pregnancy in women of childbearing age, as pregnancy can precipitate or complicate DKA." ;
    dmo:labTestCode "pregnancy-test" ;
    dmo:name "Pregnancy Test" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "ng/mL" ;
    dmo:evidenceQuote "• Pregnancy test in women of child bearing age" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/serum-potassium> a dmo:LabTest ;
    rdfs:label "Serum Potassium" ;
    dmo:definition "Serum potassium concentration may be normal or even elevated due to the extracellular shift of potassium in acidotic conditions, and this very poorly reflects total potassium stores." ;
    dmo:labTestCode "serum-potassium" ;
    dmo:name "Serum Potassium" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "However, potassium will almost always fall as the DKA is treated with insulin and the UK survey showed that 67.1% developed hypokalaemia (<4.0 mmol/L) at 24 hours after admission (45)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/urinalysis-and-culture> a dmo:LabTest ;
    rdfs:label "Urinalysis and Culture" ;
    dmo:definition "Urinalysis to detect urinary tract infection or other abnormalities, and culture to identify pathogens." ;
    dmo:labTestCode "urinalysis-and-culture" ;
    dmo:name "Urinalysis and Culture" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "NA" ;
    dmo:evidenceQuote "• Urinalysis and culture" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/urine-ketones> a dmo:LabTest ;
    rdfs:label "Urine Ketones" ;
    dmo:definition "acetoacetate is measured by urinary dipstick" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-ketones" ;
    dmo:name "Urine Ketones" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "++ or more" ;
    dmo:evidenceQuote "• capillary ketones above 3 mmol/L or urine ketones ++ or more" ;
    dmo:evidenceQuote "In addition, acetoacetate is measured by urinary dipstick." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/urine-output> a dmo:LabTest ;
    rdfs:label "Urine Output" ;
    dmo:definition "Minimum urine output should be 0.5 ml/kg/hr to assess renal function and fluid balance." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-output" ;
    dmo:loincCode "2708-6" ;
    dmo:name "Urine Output" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "ml/kg/hr" ;
    dmo:evidenceQuote "minimum urine output 0.5ml/kg/hr" ;
    dmo:evidenceQuote "Poor urine output (<0.5ml/kg/hour)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/venous-bicarbonate> a dmo:LabTest ;
    rdfs:label "Venous Bicarbonate" ;
    dmo:definition "Venous bicarbonate is measured at 60 minutes, 2 hours and 2 hourly thereafter to assess acidosis resolution. A rise of at least 3 mmol/L/hr is expected." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-bicarbonate" ;
    dmo:loincCode "2075-0" ;
    dmo:name "Venous Bicarbonate" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "• venous pH less than 7.3 and/or bicarbonate less than 15 mmol/L" ;
    dmo:evidenceQuote "Venous bicarbonate not rising by at least 3 mmol/L/hr" ;
    dmo:evidenceQuote "Increase the venous bicarbonate by 3.0 mmol/L/hour" ;
    dmo:evidenceQuote "If blood ketone measurement is not available, use venous bicarbonate. If the bicarbonate is not rising by at least 3.0 mmol/L/hr call a prescribing clinician to increase the insulin infusion rate by 1 unit/hr increments hourly until the bicarbonate is rising at this rate**" ;
    dmo:evidenceQuote "Venous bicarbonate <15 mmol/L and/or venous pH <7.3" ;
    dmo:evidenceQuote "Check creatinine, electrolyte and venous bicarbonate and pH at 2 hours then 2 to 4 hourly until venous bicarbonate >15 mmol/L" ;
    dmo:evidenceQuote "3. Venous pH<7.3 and/or venous bicarbonate<15mmol/L" ;
    dmo:evidenceQuote "Venous bicarbonate to rise by at least 3mmol/L/hour" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/venous-bicarbonate-and-potassium> a dmo:LabTest ;
    rdfs:label "Venous Bicarbonate and Potassium" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-bicarbonate-and-potassium" ;
    dmo:name "Venous Bicarbonate and Potassium" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "• Venous bicarbonate and potassium at 60 minutes, 2 hours and 2 hourly thereafter" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/venous-blood> a dmo:LabTest ;
    rdfs:label "Venous Blood" ;
    dmo:definition "if meter reads “blood glucose over 20 mmol/L” or “Hi” venous blood should be sent to the laboratory hourly or measured using venous blood in a blood gas analyser until the point of care testing meter is within its QA range" ;
    dmo:labTestCode "venous-blood" ;
    dmo:name "Venous Blood" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "if meter reads “blood glucose over 20 mmol/L” or “Hi” venous blood should be sent to the laboratory hourly or measured using venous blood in a blood gas analyser until the point of care testing meter is within its QA range" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/venous-blood-gas> a dmo:LabTest ;
    rdfs:label "Venous Blood Gas" ;
    dmo:definition "Analysis of venous blood for pH, bicarbonate, and potassium to assess acid-base status and electrolyte balance in diabetic ketoacidosis (DKA)." ;
    dmo:labTestCode "venous-blood-gas" ;
    dmo:name "Venous Blood Gas" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "Measure venous blood gas for pH, bicarbonate and potassium at 60 minutes, 2 hours and 2 hourly thereafter" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/venous-k> a dmo:LabTest ;
    rdfs:label "Venous K+" ;
    dmo:definition "Venous potassium (K+) is monitored as part of U&Es at 6, 12, and 24 hours to assess electrolyte balance during DKA treatment." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-k" ;
    dmo:name "Venous K+" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "U+Es – 4, 6, 12, 24 HOURS" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/venous-ph> a dmo:LabTest ;
    rdfs:label "Venous pH" ;
    dmo:definition "A venous pH <7.3 is required for the diagnosis of DKA." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-ph" ;
    dmo:loincCode "2708-6" ;
    dmo:name "Venous pH" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "pH" ;
    dmo:evidenceQuote "• venous pH less than 7.3 and/or bicarbonate less than 15 mmol/L" ;
    dmo:evidenceQuote "The ‘A’ – a bicarbonate concentration of <15.0 mmol/L and/or venous pH <7.3" ;
    dmo:evidenceQuote "Therefore glucose, ketones and electrolytes, including bicarbonate and venous pH, should be assessed at or near the bedside using point of care testing." ;
    dmo:evidenceQuote "Resolution of DKA is defined as ketones less than 0.6 mmol/L, and venous pH over 7.3" ;
    dmo:evidenceQuote "Venous bicarbonate <15 mmol/L and/or venous pH <7.3" ;
    dmo:evidenceQuote "3. Venous pH<7.3 and/or venous bicarbonate<15mmol/L" ;
    dmo:evidenceQuote "pH – 2, 4, 6, 12, 18, 24 HOURS (or until resolved)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/ß-hydroxybutyrate-concentrations> a dmo:LabTest ;
    rdfs:label "ß-Hydroxybutyrate Concentrations" ;
    dmo:definition "A measure of ketone levels in the blood, which were lower in those presenting in DKA with end stage renal disease compared to those with preserved renal function." ;
    dmo:labTestCode "ß-hydroxybutyrate-concentrations" ;
    dmo:name "ß-Hydroxybutyrate Concentrations" ;
    dmo:evidenceQuote "Recent data suggest that those presenting in DKA with end stage renal disease have lower ß-hydroxybutyrate concentrations, and higher glucose and anion gap than those with preserved renal function (58)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

