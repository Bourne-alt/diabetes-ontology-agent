<https://example.org/dmo/id/medication/canagliflozin> a dmo:Medication ;
    rdfs:label "canagliflozin" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "canagliflozin" ;
    dmo:name "canagliflozin" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "With the widespread use of the sodium-glucose cotransporter (SGLT) inhibitor class of drugs (e.g. dapagliflozin, canagliflozin, empagliflozin, ertugliflozin, sotagliflozin) people with type 2 diabetes, and increasingly in those with type 1, has highlighted the importance of using pH and ketones (rather than the older ‘glucose-centric’ care) to guide the diagnosis and management." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

