    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Once the glucose drops to <14 mmol/L then in addition to adding a 10% dextrose infusion consider reducing the rate of intravenous insulin infusion to 0.05 units/kg/hr to avoid the risk of developing hypoglycaemia and hypokalaemia." ;
    dmo:evidenceQuote "Once the glucose drops to <14 mmol/L then in addition to adding a 10% dextrose infusion consider reducing the rate of intravenous insulin infusion to 0.05 units/kg/hr to avoid the risk of developing hypoglycaemia and hypokalaemia." ;
