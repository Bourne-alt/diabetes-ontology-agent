<https://example.org/dmo/id/recommendation/use-of-0-9-sodium-chloride-for-initial-fluid-management> a dmo:Recommendation ;
    rdfs:label "Use of 0.9% sodium chloride for initial fluid management" ;
    dmo:recommendationId "use-of-0-9-sodium-chloride-for-initial-fluid-management" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "0.9% sodium chloride 1 litre (no KCl) Over 1st hour" ;
    dmo:evidenceQuote "0.9% sodium chloride 1 litre (no KCl) Over 1st hour" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/recommendation/use-of-0-9-sodium-chloride-solution-for-hypotensive-patients> a dmo:Recommendation ;
    rdfs:label "Use of 0.9% Sodium Chloride Solution for Hypotensive Patients" ;
    dmo:gradingSystem "Not specified" ;
    dmo:nativeEvidenceGrade "Not specified" ;
    dmo:populationScope "Individuals with DKA and systolic BP < 90 mmHg on admission" ;
    dmo:recommendationId "use-of-0-9-sodium-chloride-solution-for-hypotensive-patients" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Give 500 ml of 0.9% sodium chloride solution over 10-15 minutes. If SBP remains below 90 mmHg this may be repeated whilst awaiting senior input. In practice most individuals require between 500 to 1000 ml given rapidly" ;
    dmo:evidenceQuote "Give 500 ml of 0.9% sodium chloride solution over 10-15 minutes. If SBP remains below 90 mmHg this may be repeated whilst awaiting senior input. In practice most individuals require between 500 to 1000 ml given rapidly" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/recommendation/use-of-0-9-sodium-chloride-solution-for-initial-fluid-replacement> a dmo:Recommendation ;
    rdfs:label "Use of 0.9% Sodium Chloride Solution for Initial Fluid Replacement" ;
    dmo:recommendationId "use-of-0-9-sodium-chloride-solution-for-initial-fluid-replacement" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Commence 0.9% sodium chloride solution (use a large bore cannula) via an infusion pump" ;
    dmo:evidenceQuote "Action 1: Commence 0.9% sodium chloride solution (use a large bore cannula) via an infusion pump" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

