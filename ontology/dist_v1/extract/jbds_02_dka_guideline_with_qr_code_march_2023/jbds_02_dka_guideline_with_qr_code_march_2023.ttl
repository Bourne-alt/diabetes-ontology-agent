<https://example.org/dmo/id/riskFactor/adolescence> a dmo:RiskFactor ;
    rdfs:label "Adolescence" ;
    dmo:evidenceNote "Other risk factors for recurrent episodes include female sex, adolescence, low socioeconomic status, and previous DKA admissions." ;
    dmo:name "Adolescence" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "adolescence" ;
    dmo:evidenceQuote "Other risk factors for recurrent episodes include female sex, adolescence, low socioeconomic status, and previous DKA admissions." ;
