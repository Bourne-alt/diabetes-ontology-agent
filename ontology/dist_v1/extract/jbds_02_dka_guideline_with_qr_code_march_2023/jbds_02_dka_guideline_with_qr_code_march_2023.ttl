<https://example.org/dmo/id/contraindication/cautious-fluid-replacement-in-young-adults> a dmo:Contraindication ;
    rdfs:label "Cautious fluid replacement in young adults" ;
    dmo:contraCode "cautious-fluid-replacement-in-young-adults" ;
    dmo:rationale "Cautious fluid replacement in young adults" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Cautious fluid replacement in young adults" ;
    dmo:evidenceQuote "Cautious fluid replacement in young adults" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/cerebral-oedema> a dmo:Contraindication ;
    rdfs:label "Cerebral oedema" ;
    dmo:contraCode "cerebral-oedema" ;
    dmo:rationale "If cerebral oedema is suspected, urgent treatment with mannitol or hypertonic saline to induce osmotic fluid shifts should be started and not be delayed whilst awaiting imaging (25)." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "any deterioration in Glasgow Coma Scale score" ;
    dmo:evidenceQuote "If cerebral oedema is suspected, urgent treatment with mannitol or hypertonic saline to induce osmotic fluid shifts should be started and not be delayed whilst awaiting imaging (25)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/colloid-solutions-for-fluid-resuscitation> a dmo:Contraindication ;
    rdfs:label "Colloid solutions for fluid resuscitation" ;
    dmo:contraCode "colloid-solutions-for-fluid-resuscitation" ;
    dmo:rationale "A 2007 Cochrane review also did not support the use of colloid in preference to crystalloid fluid (34). A further 2013 consensus document suggested that colloids should be avoided where possible, due to a potential risk of increased mortality and morbidity associated with their use (35)." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in DKA" ;
    dmo:evidenceQuote "Therefore, we recommend the use of crystalloid fluid as the initial fluid of choice." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/do-not-give-kcl-if-anuric> a dmo:Contraindication ;
    rdfs:label "DO NOT GIVE KCl IF ANURIC" ;
    dmo:contraCode "do-not-give-kcl-if-anuric" ;
    dmo:rationale "Life threatening hypokalemia can occur with insulin infusion." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "anuric" ;
    dmo:evidenceQuote "DO NOT GIVE KCl IF ANURIC" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/fluid-replacement-in-end-stage-renal-failure> a dmo:Contraindication ;
    rdfs:label "Fluid replacement in end stage renal failure" ;
    dmo:contraCode "fluid-replacement-in-end-stage-renal-failure" ;
    dmo:rationale "The inability to develop an osmotic diuresis means that dialysis associated hyperglycaemia and ketosis can occur without much dehydration. A mixed picture of DKA and HHS may also occur because of the high serum tonicity (56). In addition, the circulating intravascular volume may increase at the expense of intracellular volume that resolves as the glucose and ketosis normalises. Therefore there may be no need for fluid replacement in those with end stage renal failure or those on dialysis." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in those with end stage renal failure or those on dialysis" ;
    dmo:evidenceQuote "Therefore there may be no need for fluid replacement in those with end stage renal failure or those on dialysis." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/hypoglycaemia> a dmo:Contraindication ;
    rdfs:label "Hypoglycaemia" ;
    dmo:contraCode "hypoglycaemia" ;
    dmo:rationale "The main driver for hypoglycaemia is the use of insulin. Thus, in addition to commencing 10% dextrose to run alongside the 0.9% sodium chloride solution, when glucose drops below 14 mmol/L, consider reducing the rate of intravenous insulin infusion to 0.05 units/kg/hr." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "when glucose drops below 14 mmol/L" ;
    dmo:evidenceQuote "when glucose drops below 14 mmol/L, consider reducing the rate of intravenous insulin infusion to 0.05 units/kg/hr." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/insulin-infusion-rate-in-end-stage-renal-failure> a dmo:Contraindication ;
    rdfs:label "Insulin infusion rate in end stage renal failure" ;
    dmo:contraCode "insulin-infusion-rate-in-end-stage-renal-failure" ;
    dmo:rationale "If the rate of fall is faster, or the glucose falls to <14.0 mmol/L strongly consider reducing the rate of intravenous insulin infusion to 0.05 units/kg/hr." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "if the rate of glucose reduction is faster, or the glucose falls to <14.0 mmol/L" ;
    dmo:evidenceQuote "If the rate of fall is faster, or the glucose falls to <14.0 mmol/L strongly consider reducing the rate of intravenous insulin infusion to 0.05 units/kg/hr." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/more-cautious-fluid-replacement-in-young-people-aged-18-25-years-elderly-pregnant-heart-or-renal-failure> a dmo:Contraindication ;
    rdfs:label "More cautious fluid replacement in young people aged 18-25 years, elderly, pregnant, heart or renal failure" ;
    dmo:contraCode "more-cautious-fluid-replacement-in-young-people-aged-18-25-years-elderly-pregnant-heart-or-renal-failure" ;
    dmo:rationale "More cautious fluid replacement in young people aged 18-25 years, elderly, pregnant, heart or renal failure. (Consider HDU and/or central line)" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "young people aged 18-25 years, elderly, pregnant, heart or renal failure" ;
    dmo:evidenceQuote "More cautious fluid replacement in young people aged 18-25 years, elderly, pregnant, heart or renal failure. (Consider HDU and/or central line)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/phosphate-supplementation> a dmo:Contraindication ;
    rdfs:label "Phosphate supplementation" ;
    dmo:contraCode "phosphate-supplementation" ;
    dmo:rationale "Phosphate should not be supplemented routinely" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "not recommended routinely" ;
    dmo:evidenceQuote "Phosphate should not be supplemented routinely" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/potassium-prescription-with-initial-fluid-resuscitation-in-dka> a dmo:Contraindication ;
    rdfs:label "Potassium prescription with initial fluid resuscitation in DKA" ;
    dmo:contraCode "potassium-prescription-with-initial-fluid-resuscitation-in-dka" ;
    dmo:rationale "It is recommended that no potassium be prescribed with the initial fluid resuscitation or if the serum potassium level remains above 5.5 mmol/L" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "If the serum potassium level remains above 5.5 mmol/L" ;
    dmo:evidenceQuote "it is recommended that no potassium be prescribed with the initial fluid resuscitation or if the serum potassium level remains above 5.5 mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/potassium-supplementation-in-end-stage-renal-failure> a dmo:Contraindication ;
    rdfs:label "Potassium supplementation in end stage renal failure" ;
    dmo:contraCode "potassium-supplementation-in-end-stage-renal-failure" ;
    dmo:rationale "Potassium supplementation is not usually required because the lack of the osmotic diuresis means that there is significantly less potassium loss that for those with preserved renal function. However, the acidosis may lead to significant hyperkalaemia, and this is more common in those with renal failure (54)." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in the presence of acidosis leading to significant hyperkalaemia" ;
    dmo:evidenceQuote "However, the acidosis may lead to significant hyperkalaemia, and this is more common in those with renal failure (54)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/priming-bolus-dose-of-insulin> a dmo:Contraindication ;
    rdfs:label "Priming (bolus) dose of insulin" ;
    dmo:contraCode "priming-bolus-dose-of-insulin" ;
    dmo:rationale "Do not use a priming (bolus) dose of insulin" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Do not use a priming (bolus) dose of insulin" ;
    dmo:evidenceQuote "Do not use a priming (bolus) dose of insulin" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/rapid-fluid-replacement-in-young-adults> a dmo:Contraindication ;
    rdfs:label "Rapid fluid replacement in young adults" ;
    dmo:contraCode "rapid-fluid-replacement-in-young-adults" ;
    dmo:rationale "For many years there has been concern that rapid fluid replacement may lead to cerebral oedema in children and young adults." ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "in young adults with DKA" ;
    dmo:evidenceQuote "Cautious fluid replacement in young adults" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/routine-phosphate-replacement-in-dka> a dmo:Contraindication ;
    rdfs:label "Routine phosphate replacement in DKA" ;
    dmo:contraCode "routine-phosphate-replacement-in-dka" ;
    dmo:rationale "In general, there is no evidence of benefit of routine phosphate replacement (47)" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "In general, there is no evidence of benefit of routine phosphate replacement" ;
    dmo:evidenceQuote "Therefore we do not recommend the routine replacement of phosphate." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

