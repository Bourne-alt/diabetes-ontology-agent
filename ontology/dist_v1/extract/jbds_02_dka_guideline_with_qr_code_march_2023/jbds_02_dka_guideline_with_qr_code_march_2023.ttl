    dmo:deviceCode "handheld-ketone-meters" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Handheld ketone meters" ;
    dmo:evidenceQuote "Assess the need for, and where necessary, provision of handheld ketone meters for use at home – this should be the default position" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/device/infusion-pump> a dmo:Device ;
