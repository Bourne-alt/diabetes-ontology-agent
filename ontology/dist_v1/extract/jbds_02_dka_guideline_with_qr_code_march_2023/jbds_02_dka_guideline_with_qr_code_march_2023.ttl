<https://example.org/dmo/id/recommendation/define-resolution-of-dka> a dmo:Recommendation ;
    rdfs:label "Define Resolution of DKA" ;
    dmo:recommendationId "define-resolution-of-dka" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Diagnosis" ;
    dmo:statement "Resolution of DKA is defined as ketones less than 0.6 mmol/L and venous pH over 7.3 (do not use bicarbonate as a surrogate at this stage because the hyperchloraemic acidosis associated with large volumes of 0.9% sodium chloride will lower bicarbonate levels)" ;
    dmo:evidenceQuote "Resolution of DKA is defined as ketones less than 0.6 mmol/L and venous pH over 7.3 (do not use bicarbonate as a surrogate at this stage because the hyperchloraemic acidosis associated with large volumes of 0.9% sodium chloride will lower bicarbonate levels)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

