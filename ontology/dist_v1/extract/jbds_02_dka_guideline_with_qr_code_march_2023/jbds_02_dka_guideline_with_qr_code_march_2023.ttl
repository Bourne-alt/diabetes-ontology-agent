    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Where the fluid balance permits, an increase in the rate of the infusion of 0.9% sodium chloride solution with potassium 40 mmol/L is possible." ;
    dmo:evidenceQuote "Where the fluid balance permits, an increase in the rate of the infusion of 0.9% sodium chloride solution with potassium 40 mmol/L is possible." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

