<https://example.org/dmo/id/recommendation/continuation-of-long-acting-basal-insulin-in-dka-patients> a dmo:Recommendation ;
    rdfs:label "Continuation of Long Acting Basal Insulin in DKA Patients" ;
    dmo:gradingSystem "Not specified" ;
    dmo:nativeEvidenceGrade "Not specified" ;
    dmo:populationScope "Adults with DKA" ;
    dmo:recommendationId "continuation-of-long-acting-basal-insulin-in-dka-patients" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "In those already on long acting basal insulin, it should continue to be prescribed at their usual dose. In those newly diagnosed, then a long acting basal insulin should be commenced, at a dose of 0.25 units/Kg subcutaneously once daily." ;
    dmo:evidenceQuote "In those already on long acting basal insulin, it should continue to be prescribed at their usual dose. In those newly diagnosed, then a long acting basal insulin should be commenced, at a dose of 0.25 units/Kg subcutaneously once daily." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

