    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "point of care testing" ;
    dmo:evidenceQuote "These guidelines recommend that management be based on point of care testing of those admitted with DKA." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/device/point-of-care-testing-meters> a dmo:Device ;
    rdfs:label "point of care testing meters" ;
    dmo:deviceCode "point-of-care-testing-meters" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "point of care testing meters" ;
    dmo:evidenceQuote "Every Acute Trust should have trained Health Care Workers available to measure blood glucose concentrations 24 hours per day – ideally using point of care testing meters" ;
    dmo:evidenceQuote "Every Acute Trust should have trained Health Care Workers available to measure blood ketone concentrations 24 hours per day – ideally using point of care testing meters" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/device/portable-ketone-meters> a dmo:Device ;
    rdfs:label "portable ketone meters" ;
    dmo:deviceCode "portable-ketone-meters" ;
