    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "ALWAYS draw up insulin using an insulin syringe" ;
    dmo:evidenceQuote "ALWAYS draw up insulin using an insulin syringe" ;
