    dmo:name "remote glucose meters" ;
    dmo:evidenceQuote "The 2020 report of the 2019 National Inpatient Diabetes Audit (NaDIA) showed that 71.3% or hospitals used remote (networked) glucose meters (5)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/device/standard-urine-sticks> a dmo:Device ;
