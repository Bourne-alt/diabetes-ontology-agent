<https://example.org/dmo/id/recommendation/switch-from-fixed-rate-intravenous-insulin-infusion-to-variable-rate-intravenous-insulin-infusion-with-10-dextrose-with-0-15-kcl-at-50-mls-hr> a dmo:Recommendation ;
    rdfs:label "Switch from Fixed Rate Intravenous Insulin Infusion to Variable Rate Intravenous Insulin Infusion with 10% Dextrose with 0.15% KCl at 50 mls/hr" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients with DKA or HHS who are still not eating and drinking" ;
    dmo:recommendationId "switch-from-fixed-rate-intravenous-insulin-infusion-to-variable-rate-intravenous-insulin-infusion-with-10-dextrose-with-0-15-kcl-at-50-mls-hr" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Switch from fixed rate intravenous insulin infusion to variable rate intravenous insulin infusion (VRIII) with 10% dextrose with 0.15% KCl at 50 mls/hr IF: DKA: capillary blood ketones < 0.6 mmol/L and HCO3 > 15 mmol/L and STILL not eating and drinking HHS: biochemical markers have normalised and STILL not eating and drinking" ;
    dmo:evidenceQuote "SWITCH FROM FIXED RATE INTRAVENOUS INSULIN INFUSION TO VARIABLE RATE INTRAVENOUS INSULIN INFUSION (VRIII) with 10% Dextrose with 0.15% KCl at 50 mls/hr IF: DKA: CAPILLARY BLOOD KETONES < 0.6 mmol/L and HCO3 > 15 mmol/L and STILL not eating and drinking HHS: Biochemical markers have normalised and STILL not eating and drinking" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

