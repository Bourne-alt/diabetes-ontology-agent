    dmo:statement "RESOLUTION OF DKA: Blood ketones<0.3/L AND/OR pH>7.3" ;
    dmo:evidenceQuote "RESOLUTION OF DKA: Blood ketones<0.3/L AND/OR pH>7.3" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

