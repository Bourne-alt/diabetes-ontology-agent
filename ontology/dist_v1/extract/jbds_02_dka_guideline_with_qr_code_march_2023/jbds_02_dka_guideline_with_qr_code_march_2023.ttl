    dmo:name "Ketone meter" ;
    dmo:evidenceQuote "Hourly blood ketones if meter available" ;
    dmo:evidenceQuote "It is recognised that almost all units now have access to ketone meters." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/device/non-networked-glucose-meters> a dmo:Device ;
