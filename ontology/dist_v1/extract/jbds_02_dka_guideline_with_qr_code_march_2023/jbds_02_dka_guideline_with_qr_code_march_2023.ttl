<https://example.org/dmo/id/recommendation/adjustment-of-insulin-infusion-rate-when-glucose-drops-below-14-mmol-l> a dmo:Recommendation ;
    rdfs:label "Adjustment of Insulin Infusion Rate When Glucose Drops Below 14 mmol/L" ;
    dmo:gradingSystem "Not specified" ;
