<https://example.org/dmo/id/recommendation/continuation-of-long-acting-insulin-when-restarting-subcutaneous-insulin> a dmo:Recommendation ;
    rdfs:label "Continuation of long acting insulin when restarting subcutaneous insulin" ;
    dmo:populationScope "Those on basal bolus insulin" ;
    dmo:recommendationId "continuation-of-long-acting-insulin-when-restarting-subcutaneous-insulin" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If the person was previously on a long acting insulin such as glargine, degludec, detemir or human isophane, this should have been continued and thus the only action should be to restart their normal short acting insulin at the next meal" ;
    dmo:evidenceQuote "If the person was previously on a long acting insulin such as glargine, degludec, detemir or human isophane, this should have been continued and thus the only action should be to restart their normal short acting insulin at the next meal" ;
