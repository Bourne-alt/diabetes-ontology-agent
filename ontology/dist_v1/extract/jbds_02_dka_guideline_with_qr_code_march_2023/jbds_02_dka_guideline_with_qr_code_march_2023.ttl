    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "InsulinPump" ;
    dmo:evidenceQuote "Start a continuous FRIII via an infusion pump. This is made of 50 units of human soluble insulin (Actrapid®, Humulin S®) made up to 50 ml with 0.9% sodium chloride solution." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/device/ketone-meter> a dmo:Device ;
