    dmo:riskFactorCode "psychological-considerations" ;
    dmo:evidenceQuote "Many of these individuals have fragmented care, social, behavioural or psychological considerations that need to be accounted for (25; 26)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/riskFactor/social-considerations> a dmo:RiskFactor ;
    rdfs:label "Social Considerations" ;
    dmo:evidenceNote "Many of these individuals have fragmented care, social, behavioural or psychological considerations that need to be accounted for (25; 26)." ;
    dmo:name "Social Considerations" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "social-considerations" ;
    dmo:evidenceQuote "Many of these individuals have fragmented care, social, behavioural or psychological considerations that need to be accounted for (25; 26)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/riskFactor/use-of-insulin> a dmo:RiskFactor ;
    rdfs:label "Use of Insulin" ;
    dmo:evidenceNote "文档中明确指出胰岛素的使用是导致低钾血症和低血糖的主要驱动因素，因此可通过调整剂量进行干预。" ;
    dmo:name "Use of Insulin" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "use-of-insulin" ;
    dmo:evidenceQuote "In addition to inadequate replacement, the main driver for hypokalaemia is the use of insulin. Thus, when glucose drops below 14 mmol/L, consider reducing the rate of intravenous insulin infusion to 0.05 units/kg/hr." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/riskFactor/young-people-aged-18-25-years> a dmo:RiskFactor ;
    rdfs:label "Young people aged 18-25 years" ;
    dmo:evidenceNote "This group requires cautious fluid replacement and consideration for admission to a Level 2 / HDU facility." ;
    dmo:name "Young people aged 18-25 years" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "young-people-aged-18-25-years" ;
    dmo:evidenceQuote "• Young people aged 18-25 years\n• Elderly\n• Pregnant\n• Heart or kidney failure\n• Other serious co-morbidities" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/symptom/abdominal-pain> a dmo:Symptom ;
    rdfs:label "Abdominal Pain" ;
    dmo:name "Abdominal Pain" ;
    dmo:symptomCode "abdominal-pain" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "DKA in pregnancy may manifest as abdominal pain – always consider as a possible alternative to pre-term/term labour." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/symptom/acidosis> a dmo:Symptom ;
    rdfs:label "Acidosis" ;
    dmo:hpoCode "HP:0002700" ;
    dmo:name "Acidosis" ;
    dmo:symptomCode "acidosis" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "Diabetic ketoacidosis (DKA) is a complex disordered metabolic state characterised by hyperglycaemia, ketonaemia, and acidosis." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/symptom/acute-myocardial-infarction> a dmo:Symptom ;
    rdfs:label "Acute myocardial infarction" ;
    dmo:hpoCode "HP:0001650" ;
    dmo:name "Acute myocardial infarction" ;
    dmo:symptomCode "acute-myocardial-infarction" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "The main causes of mortality in the adult population include severe hypokalaemia, adult respiratory distress syndrome, and co-morbid states which may have precipitated the DKA such as pneumonia, acute myocardial infarction and sepsis (25)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/symptom/adult-respiratory-distress-syndrome> a dmo:Symptom ;
