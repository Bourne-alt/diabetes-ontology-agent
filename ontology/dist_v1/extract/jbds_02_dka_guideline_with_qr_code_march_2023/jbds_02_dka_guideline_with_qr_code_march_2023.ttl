    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/device/insulin-infusion-pump> a dmo:Device ;
    rdfs:label "insulin infusion pump" ;
    dmo:deviceCode "insulin-infusion-pump" ;
    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "insulin infusion pump" ;
    dmo:evidenceQuote "** If ketones and glucose are not falling as expected always check the insulin infusion pump is working and connected and that the correct insulin residual volume is present (to check for pump malfunction)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/device/insulin-pump> a dmo:Device ;
    rdfs:label "Insulin pump" ;
    dmo:deviceCode "insulin-pump" ;
    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Insulin pump" ;
    dmo:evidenceQuote "For those on insulin pumps, review of their use of the device and provision of further education in the use of such technology, as necessary" ;
    dmo:evidenceQuote "In those using an insulin pump, if transfer to a Level 2 / HDU or ITU is necessary, then the pump should be stopped, removed and stored safely." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/device/insulinpump> a dmo:Device ;
    rdfs:label "InsulinPump" ;
