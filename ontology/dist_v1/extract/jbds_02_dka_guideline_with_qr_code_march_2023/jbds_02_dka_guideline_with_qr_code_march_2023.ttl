<https://example.org/dmo/id/recommendation/educational-support-from-diabetes-specialist-team-prior-to-discharge-for-dka> a dmo:Recommendation ;
    rdfs:label "Educational Support from Diabetes Specialist Team Prior to Discharge for DKA" ;
    dmo:gradingSystem "Additional Best Practice Tariff Standards" ;
    dmo:nativeEvidenceGrade "100%" ;
    dmo:populationScope "People admitted to hospital with diabetic ketoacidosis" ;
    dmo:recommendationId "educational-support-from-diabetes-specialist-team-prior-to-discharge-for-dka" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "People admitted to hospital with diabetic ketoacidosis receive educational support from a member of the diabetes specialist team prior to discharge. This education should include: • Review of usual glycaemic control • Review of injection technique/blood glucose monitoring/equipment/sites • Discussion of sick day rules • Assessment of the need for home ketone testing (blood or urinary) with education to enable this • Provision of contact telephone numbers for the diabetes specialist team including out of hours" ;
    dmo:evidenceQuote "People admitted to hospital with diabetic ketoacidosis receive educational support from a member of the diabetes specialist team prior to discharge. This education should include: • Review of usual glycaemic control • Review of injection technique/blood glucose monitoring/equipment/sites • Discussion of sick day rules • Assessment of the need for home ketone testing (blood or urinary) with education to enable this • Provision of contact telephone numbers for the diabetes specialist team including out of hours" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

