<https://example.org/dmo/id/recommendation/initial-insulin-replacement-rate-of-0-1-units-kg-hr-for-end-stage-renal-failure-or-dialysis-patients> a dmo:Recommendation ;
    rdfs:label "Initial insulin replacement rate of 0.1 units/kg/hr for end stage renal failure or dialysis patients" ;
    dmo:recommendationId "initial-insulin-replacement-rate-of-0-1-units-kg-hr-for-end-stage-renal-failure-or-dialysis-patients" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "For people with end stage renal failure or those on dialysis, insulin replacement is the mainstay of treatment. This should be given as a FRIII at an initial rate of 0.1 units/kg/hr, but may need to increase if the required rate of glucose fall is not achieved." ;
    dmo:evidenceQuote "For people with end stage renal failure or those on dialysis, insulin replacement is the mainstay of treatment. This should be given as a FRIII at an initial rate of 0.1 units/kg/hr, but may need to increase if the required rate of glucose fall is not achieved." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/recommendation/initiate-dextrose-infusion-once-cbg-14-mmol-l> a dmo:Recommendation ;
    rdfs:label "Initiate dextrose infusion once CBG <14 mmol/L" ;
    dmo:recommendationId "initiate-dextrose-infusion-once-cbg-14-mmol-l" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Once CBG<14 mmol/L, or in the event of non -hyperglycaemic DKA presenting with CBG <14 mmol/L: 0.9% sodium chloride 1 litre (no KCl) Over 1st hour Give 10% Dextrose to run at 125 mls/hr AND 0.9% sodium chloride 1 litre (check K+) Over next 2 hours" ;
    dmo:evidenceQuote "Once CBG<14 mmol/L, or in the event of non -hyperglycaemic DKA presenting with CBG <14 mmol/L: 0.9% sodium chloride 1 litre (no KCl) Over 1st hour Give 10% Dextrose to run at 125 mls/hr AND 0.9% sodium chloride 1 litre (check K+) Over next 2 hours" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

