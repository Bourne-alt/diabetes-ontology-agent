<https://example.org/dmo/id/recommendation/use-of-insulin-syringe-or-pen-for-insulin-administration> a dmo:Recommendation ;
    rdfs:label "Use of insulin syringe or pen for insulin administration" ;
    dmo:gradingSystem "NPSA" ;
    dmo:recommendationId "use-of-insulin-syringe-or-pen-for-insulin-administration" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "All regular and single insulin (bolus) doses are measured and administered using an insulin syringe or commercial insulin pen device. Intravenous syringes must never be used for insulin administration" ;
    dmo:evidenceQuote "All regular and single insulin (bolus) doses are measured and administered using an insulin syringe or commercial insulin pen device. Intravenous syringes must never be used for insulin administration" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

