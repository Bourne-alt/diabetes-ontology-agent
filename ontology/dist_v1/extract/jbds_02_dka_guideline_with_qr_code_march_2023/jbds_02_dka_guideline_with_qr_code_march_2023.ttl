<https://example.org/dmo/id/recommendation/use-of-continuous-glucose-monitoring-in-critical-illness> a dmo:Recommendation ;
    rdfs:label "Use of Continuous Glucose Monitoring in Critical Illness" ;
    dmo:gradingSystem "Not specified" ;
    dmo:nativeEvidenceGrade "Preliminary data" ;
    dmo:populationScope "Individuals with diabetes in critical illness" ;
    dmo:recommendationId "use-of-continuous-glucose-monitoring-in-critical-illness" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Early data on the use of continuous glucose monitoring (e.g. Freestyle Libre®, Dexcom G6®, etc) in critical illness suggest it may be safe to use (63-65), but these are preliminary. As such, current guidelines do not support their use (66)." ;
    dmo:evidenceQuote "Early data on the use of continuous glucose monitoring (e.g. Freestyle Libre®, Dexcom G6®, etc) in critical illness suggest it may be safe to use (63-65), but these are preliminary. As such, current guidelines do not support their use (66)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/recommendation/use-of-guidance-based-on-admitting-ward> a dmo:Recommendation ;
    rdfs:label "Use of guidance based on admitting ward" ;
    dmo:gradingSystem "Not specified" ;
    dmo:nativeEvidenceGrade "Not specified" ;
    dmo:populationScope "Young people aged 16–18 with diabetes admitted to paediatric or adult units" ;
    dmo:recommendationId "use-of-guidance-based-on-admitting-ward" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "The guidance used should be determined by the ward to which the person with diabetes is admitted" ;
    dmo:evidenceQuote "This will ensure that that the staff only use guidance they are familiar with, so reducing the potential for mistakes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_dka_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/recommendation/use-of-insulin-syringe-for-drawing-up-insulin> a dmo:Recommendation ;
    rdfs:label "Use of insulin syringe for drawing up insulin" ;
