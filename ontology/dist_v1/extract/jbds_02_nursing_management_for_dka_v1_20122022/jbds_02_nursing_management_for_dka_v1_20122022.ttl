    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/hypokalaemia-on-admission> a dmo:LabTest ;
    rdfs:label "Hypokalaemia on admission" ;
    dmo:definition "Hypokalaemia on admission (under 3.5mmol/L) may indicate severe DKA." ;
    dmo:labTestCode "hypokalaemia-on-admission" ;
    dmo:name "Hypokalaemia on admission" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "• Hypokalaemia on admission (under 3.5mmol/L)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/oxygen-saturation> a dmo:LabTest ;
    rdfs:label "Oxygen saturation" ;
    dmo:definition "Oxygen saturation below 92% on air (assuming normal baseline respiratory function) may indicate severe DKA." ;
    dmo:labTestCode "oxygen-saturation" ;
    dmo:name "Oxygen saturation" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "%" ;
    dmo:evidenceQuote "• Oxygen saturation below 92% on air (assuming normal baseline respiratory f unction)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/potassium> a dmo:LabTest ;
    rdfs:label "Potassium" ;
    dmo:definition "A measure of serum potassium concentration, critical in monitoring electrolyte balance during DKA management." ;
    dmo:labTestCode "potassium" ;
    dmo:name "Potassium" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "If the potassium is not maintained between 4.0 and 5.5mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/pulse> a dmo:LabTest ;
    rdfs:label "Pulse" ;
    dmo:definition "Pulse over 100 or below 60 bpm may indicate severe DKA." ;
    dmo:labTestCode "pulse" ;
    dmo:name "Pulse" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "bpm" ;
    dmo:evidenceQuote "• Pulse over 100 or below 60 bpm" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/serum-potassium> a dmo:LabTest ;
    rdfs:label "Serum Potassium" ;
    dmo:definition "Serum potassium is often high on admission (although total body potassium is low) but falls precipitously upon treatment with insulin. Regular monitoring is mandatory." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "serum-potassium" ;
    dmo:name "Serum Potassium" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Serum potassium is often high on admission (although total body potassium is low) but falls precipitously upon treatment with insulin. Regular monitoring is mandatory." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/systolic-bp> a dmo:LabTest ;
    rdfs:label "Systolic BP" ;
    dmo:definition "Systolic BP below 90 mmHg may indicate severe DKA." ;
    dmo:labTestCode "systolic-bp" ;
    dmo:name "Systolic BP" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmHg" ;
    dmo:evidenceQuote "• Systolic BP below 90 mmHg" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/urine-ketone> a dmo:LabTest ;
    rdfs:label "Urine Ketone" ;
    dmo:definition "significant ketonuria (more than 2+ on standard urine sticks)" ;
    dmo:labTestCode "urine-ketone" ;
    dmo:name "Urine Ketone" ;
    dmo:specimen "Urine" ;
    dmo:evidenceQuote "The ‘K’  is for Ketonaemia or ketonuria - a capillary or blood ketone concentration of > 3.0mmol/L or significant ketonuria (more than 2+ on standard urine sticks)" ;
    dmo:evidenceQuote "The ‘K’ is for Ketonaemia or ketonuria - a capillary or blood ketone concentration of > 3.0mmol/L or significant ketonuria (more than 2+ on standard urine sticks)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/vbg-testing> a dmo:LabTest ;
    rdfs:label "VBG Testing" ;
    dmo:definition "the value of VBG testing in line with guidance" ;
    dmo:labTestCode "vbg-testing" ;
    dmo:name "VBG Testing" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "Explain the value of VBG testing in line with guidance" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/venous-bicarbonate> a dmo:LabTest ;
    rdfs:label "Venous Bicarbonate" ;
    dmo:definition "Assess the resolution of ketoacidosis: If blood ketone measurement is available and blood ketones are not falling by at least 0.5mmol/L/hr call a prescribing clinician to increase the insulin infusion rate by 1.0 unit/hr increments hourly until the ketones are falling at target rates (also check infusion**)" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-bicarbonate" ;
    dmo:name "Venous Bicarbonate" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Assess the resolution of ketoacidosis: \n• If blood ketone measurement is available and blood ketones are not falling by at least 0.5mmol/L/hr call a prescribing clinician to increase the insulin infusion rate by 1.0 unit/hr increments hourly until the ketones are falling at target rates (also check infusion**)" ;
    dmo:evidenceQuote "If there is NOT an increase the venous bicarbonate by 3.0mmol/L/hour" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/venous-ph> a dmo:LabTest ;
    rdfs:label "Venous pH" ;
    dmo:definition "venous pH <7.3" ;
    dmo:labTestCode "venous-ph" ;
    dmo:name "Venous pH" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "The ‘A’ is for Acidaemia/acidosis– a bicarbonate concentration of ≤15.0mmol/L and/or venous pH <7.3" ;
    dmo:evidenceQuote "• Venous/arterial pH below 7.0" ;
    dmo:evidenceQuote "Resolution of DKA is defined as ketones less than 0.6mmol/L, and venous pH over 7.3" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/medication/abasaglar> a dmo:Medication ;
    rdfs:label "Abasaglar®" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "abasaglar" ;
    dmo:name "Abasaglar®" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "If the person was previously on a basal insulin once or twice a day (e.g., Lantus®, Semglee®, Abasaglar®, Degludec®, Levemir®, or human isophane insulin such as Insulatard® or Humalin I®) this should have been continued" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/medication/abasaglar-biosimilar-glargine> a dmo:Medication ;
    rdfs:label "Abasaglar (Biosimilar Glargine)" ;
    dmo:durationHours "24"^^xsd:integer ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "abasaglar-biosimilar-glargine" ;
    dmo:name "Abasaglar (Biosimilar Glargine)" ;
    dmo:onsetMinutes "120"^^xsd:integer ;
    dmo:evidenceQuote "Onset  1 2 hrs ura on  up to 2 hrs" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/medication/actrapid> a dmo:Medication ;
    rdfs:label "Actrapid" ;
    dmo:durationHours "8"^^xsd:integer ;
    dmo:insulinAction "ShortActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "actrapid" ;
    dmo:name "Actrapid" ;
    dmo:onsetMinutes "30"^^xsd:integer ;
    dmo:evidenceQuote "Onset   0 mins Peak  2   hrs ura on  up to 8 hrs" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/medication/apidra> a dmo:Medication ;
    rdfs:label "Apidra" ;
    dmo:durationHours "3"^^xsd:integer ;
    dmo:insulinAction "UltraRapid" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "apidra" ;
    dmo:name "Apidra" ;
    dmo:onsetMinutes "10"^^xsd:integer ;
    dmo:evidenceQuote "Ensure that the rapid-acting insulin (e.g., Novorapid®, Trurapi®, Humalog®, Apidra®, FiAsp®) is prescribed appropriately." ;
    dmo:evidenceQuote "There should be an overlap between the insulin infusion and first injection of rapid acting insulin (e.g. Novorapid®, Trurapi®, Humalog®, Apidra®, FiAsp®). The rapid acting insulin should be injected with the meal and the intravenous insulin and fluids discontinued 30 to 60 minutes later" ;
    dmo:evidenceQuote "Onset  10 20mins Peak  1  hrs ura on  2 5hrs" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/medication/basal-insulin> a dmo:Medication ;
    rdfs:label "Basal Insulin" ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "basal-insulin" ;
    dmo:name "Basal Insulin" ;
    dmo:evidenceQuote "Ensure basal insulin prescribed subcutaneously alongside FRIII; If patient usually takes basal insulin, ensure this is prescribed and continued otherwise refer to local guideline for commencing basal insulin" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/medication/degludec> a dmo:Medication ;
    rdfs:label "Degludec" ;
    dmo:durationHours "24"^^xsd:integer ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "degludec" ;
    dmo:name "Degludec" ;
    dmo:onsetMinutes "30"^^xsd:integer ;
    dmo:evidenceQuote "If the individual normally takes basal insulin (e.g. Lantus®, Degludec®, Levemir®, or human isophane insulin such as Insulatard® or Humalin S®) continue this at the usual dose and usual time." ;
    dmo:evidenceQuote "If the person was previously on a basal insulin once or twice a day (e.g., Lantus®, Semglee®, Abasaglar®, Degludec®, Levemir®, or human isophane insulin such as Insulatard® or Humalin I®) this should have been continued" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/medication/fiasp> a dmo:Medication ;
    rdfs:label "FiAsp" ;
    dmo:durationHours "3"^^xsd:integer ;
    dmo:insulinAction "UltraRapid" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "fiasp" ;
    dmo:name "FiAsp" ;
    dmo:onsetMinutes "10"^^xsd:integer ;
    dmo:evidenceQuote "Ensure that the rapid-acting insulin (e.g., Novorapid®, Trurapi®, Humalog®, Apidra®, FiAsp®) is prescribed appropriately." ;
    dmo:evidenceQuote "There should be an overlap between the insulin infusion and first injection of rapid acting insulin (e.g. Novorapid®, Trurapi®, Humalog®, Apidra®, FiAsp®). The rapid acting insulin should be injected with the meal and the intravenous insulin and fluids discontinued 30 to 60 minutes later" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/medication/fixed-rate-intravenous-insulin-infusion> a dmo:Medication ;
    rdfs:label "Fixed Rate Intravenous Insulin Infusion" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "fixed-rate-intravenous-insulin-infusion" ;
    dmo:name "Fixed Rate Intravenous Insulin Infusion" ;
    dmo:evidenceQuote "Ensure FIXED rate intravenous insulin infusion (FRIII) prescribed and commenced" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/medication/humalin-i> a dmo:Medication ;
    rdfs:label "Humalin I®" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "Intermediate" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "humalin-i" ;
