<https://example.org/dmo/id/recommendation/provision-of-required-consumables-before-discharge> a dmo:Recommendation ;
    rdfs:label "Provision of Required Consumables Before Discharge" ;
    dmo:recommendationId "provision-of-required-consumables-before-discharge" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "Ensure they have required consumables including new insulin pens, cartridges or vials (if on CSII), BG and ketone meter with strips, needles)" ;
