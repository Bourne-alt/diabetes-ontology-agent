    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Onset   0 mins Peak  2   hrs ura on  up to 8 hrs" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/drugClass/twice-daily-fixed-mix-insulin> a dmo:DrugClass ;
    rdfs:label "Twice Daily Fixed-Mix Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "twice-daily-fixed-mix-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Combines a fixed ratio of rapid-acting and intermediate-acting insulin to cover both mealtime and background insulin needs." ;
    dmo:name "Twice Daily Fixed-Mix Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If they were on twice daily fixed-mix insulin (e.g., Novomix 30®, Humalog Mix 50®, Humalin M3®)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/anion-gap> a dmo:LabTest ;
    rdfs:label "Anion gap" ;
    dmo:definition "Anion gap above 16 [Anion Gap = (Na+ + K+) – (Cl- + HCO3-)] may indicate severe DKA." ;
    dmo:labTestCode "anion-gap" ;
    dmo:name "Anion gap" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "• Anion gap above16 [Anion Gap = (Na+ + K+) – (Cl- + HCO3-)]" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/bicarbonate-concentration> a dmo:LabTest ;
    rdfs:label "Bicarbonate Concentration" ;
    dmo:definition "a bicarbonate concentration of ≤15.0mmol/L and/or venous pH <7.3" ;
    dmo:labTestCode "bicarbonate-concentration" ;
    dmo:name "Bicarbonate Concentration" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "The ‘A’ is for Acidaemia/acidosis– a bicarbonate concentration of ≤15.0mmol/L and/or venous pH <7.3" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/bicarbonate-level> a dmo:LabTest ;
    rdfs:label "Bicarbonate level" ;
    dmo:definition "Bicarbonate level below 5.0mmol/L may indicate severe DKA." ;
    dmo:labTestCode "bicarbonate-level" ;
    dmo:name "Bicarbonate level" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "• Bicarbonate level below 5.0mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/blood-glucose-concentration> a dmo:LabTest ;
    rdfs:label "Blood Glucose Concentration" ;
    dmo:definition "A blood glucose concentration of >11.0mmol/L or known to have diabetes mellitus" ;
    dmo:labTestCode "blood-glucose-concentration" ;
    dmo:name "Blood Glucose Concentration" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "The ‘D’ is for Diabetes- a blood glucose concentration of >11.0mmol/L or known to have diabetes mellitus" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/blood-glucose-level> a dmo:LabTest ;
    rdfs:label "Blood glucose level" ;
    dmo:definition "Blood glucose level checked in line with local policy and information used appropriately" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-glucose-level" ;
    dmo:name "Blood glucose level" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "Blood glucose level checked in line with local policy and information used appropriately" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/blood-ketone> a dmo:LabTest ;
    rdfs:label "Blood Ketone" ;
    dmo:definition "Monitoring of blood ketone levels is required to assess the resolution of diabetic ketoacidosis and guide insulin therapy adjustments." ;
    dmo:labTestCode "blood-ketone" ;
    dmo:name "Blood Ketone" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Check the blood ketone and glucose levels regularly." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/blood-ketone-concentration> a dmo:LabTest ;
    rdfs:label "Blood Ketone Concentration" ;
    dmo:definition "A measure of ketone levels in blood, used to assess ketonaemia in DKA." ;
    dmo:labTestCode "blood-ketone-concentration" ;
    dmo:name "Blood Ketone Concentration" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "If the blood ketone concentration does not reduce by 0.5mmol/L/hour" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/blood-ketone-level> a dmo:LabTest ;
    rdfs:label "Blood ketone level" ;
    dmo:definition "Blood ketone level checked in line with local policy and information used appropriately" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-ketone-level" ;
    dmo:name "Blood ketone level" ;
