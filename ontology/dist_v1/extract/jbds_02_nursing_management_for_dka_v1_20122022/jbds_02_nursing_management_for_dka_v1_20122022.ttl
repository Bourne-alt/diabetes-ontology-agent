    dmo:recommendationId "check-insulin-infusion-pump-function" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "** If ketones and glucose are not falling as expected always check the insulin infusion pump is working and connected and that the correct insulin residual volume is present (to check for pump malfunction)" ;
