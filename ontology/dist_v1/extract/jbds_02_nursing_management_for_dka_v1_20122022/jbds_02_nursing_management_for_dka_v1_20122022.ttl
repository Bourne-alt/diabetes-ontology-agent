<https://example.org/dmo/id/recommendation/use-two-large-bore-iv-cannulae-for-dka-management> a dmo:Recommendation ;
    rdfs:label "Use Two Large Bore IV Cannulae for DKA Management" ;
    dmo:populationScope "Individuals with DKA" ;
