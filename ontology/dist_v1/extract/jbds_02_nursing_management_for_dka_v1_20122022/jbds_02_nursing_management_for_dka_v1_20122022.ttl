<https://example.org/dmo/id/drugClass/basal-insulin> a dmo:DrugClass ;
    rdfs:label "Basal Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "basal-insulin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Provides a continuous background level of insulin to control fasting blood glucose." ;
    dmo:name "Basal Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If the person was previously on a basal insulin once or twice a day (e.g., Lantus®, Semglee®, Abasaglar®, Degludec®, Levemir®, or human isophane insulin such as Insulatard® or Humalin I®) this should have been continued" ;
    dmo:evidenceQuote "Ensure basal insulin prescribed subcutaneously alongside FRIII; If patient usually takes basal insulin, ensure this is prescribed and continued otherwise refer to local guideline for commencing basal insulin" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/drugClass/fixed-rate-intravenous-insulin-infusion> a dmo:DrugClass ;
    rdfs:label "Fixed Rate Intravenous Insulin Infusion" ;
    dmo:adminRoute "Intravenous" ;
    dmo:drugClassCode "fixed-rate-intravenous-insulin-infusion" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin is administered continuously via intravenous infusion to lower blood glucose and reduce ketone production in diabetic ketoacidosis." ;
    dmo:name "Fixed Rate Intravenous Insulin Infusion" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Ensure FIXED rate intravenous insulin infusion (FRIII) prescribed and commenced" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Promotes glucose uptake by cells and inhibits hepatic glucose production, thereby lowering blood glucose levels." ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Insulin may be infused initially in the same line as the intravenous replacement fluid , provided that a Y connector with a one-way, anti-siphon valve is used." ;
    dmo:evidenceQuote "Correctly identifies when the next glucose and ketone check is required for rate review" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

