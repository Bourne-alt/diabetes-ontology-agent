<https://example.org/dmo/id/recommendation/continuation-of-basal-insulin-during-friii> a dmo:Recommendation ;
    rdfs:label "Continuation of Basal Insulin During FRIII" ;
    dmo:recommendationId "continuation-of-basal-insulin-during-friii" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Ensure basal insulin prescribed subcutaneously alongside FRIII; If patient usually takes basal insulin, ensure this is prescribed and continued otherwise refer to local guideline for commencing basal insulin" ;
    dmo:evidenceQuote "Ensure basal insulin prescribed subcutaneously alongside FRIII; If patient usually takes basal insulin, ensure this is prescribed and continued otherwise refer to local guideline for commencing basal insulin" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/recommendation/diagnosis-of-diabetic-ketoacidosis-dka> a dmo:Recommendation ;
    rdfs:label "Diagnosis of Diabetic Ketoacidosis (DKA)" ;
    dmo:recommendationId "diagnosis-of-diabetic-ketoacidosis-dka" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Diagnosis" ;
    dmo:statement "Ensure that the criteria for DKA are satisfied. This is to safeguard the use of the Fixed Rate Intravenous Insulin infusion (FRIII) only for patients who clinically require it. Using this protocol in patients without DKA could lead to unnecessary complications including increased risk of fluid overload, hypokalaemia, and hypoglycaemia. Conversely, managing DKA using inappropriate protocol could lead to delay in its resolution and may result to harm." ;
    dmo:evidenceQuote "Ensure that the criteria for DKA are satisfied. This is to safeguard the use of the Fixed Rate Intravenous Insulin infusion (FRIII) only for patients who clinically require it. Using this protocol in patients without DKA could lead to unnecessary complications including increased risk of fluid overload, hypokalaemia, and hypoglycaemia. Conversely, managing DKA using inappropriate protocol could lead to delay in its resolutio n and may result to harm." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/recommendation/discuss-management-plan-with-medical-and-nursing-teams> a dmo:Recommendation ;
    rdfs:label "Discuss Management Plan with Medical and Nursing Teams" ;
    dmo:populationScope "Individuals with DKA" ;
    dmo:recommendationId "discuss-management-plan-with-medical-and-nursing-teams" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Ensure that the management plan is discussed by the medical team with the nursing staff in charge of the individual with DKA and agreed." ;
    dmo:evidenceQuote "Ensure that the management plan is discussed by the medical team with the nursing staff in charge of the individual with DKA and agreed." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/recommendation/education-provision-prior-to-discharge> a dmo:Recommendation ;
    rdfs:label "Education Provision Prior to Discharge" ;
