<https://example.org/dmo/id/complication/diabetic-ketoacidosis> a dmo:Complication ;
    rdfs:label "Diabetic Ketoacidosis" ;
    dmo:affectedOrgan "Systemic" ;
    dmo:complicationCode "diabetic-ketoacidosis" ;
    dmo:definition "The 'D' is for Diabetes- a blood glucose concentration of >11.0mmol/L or known to have diabetes mellitus The 'K' is for Ketonaemia or ketonuria - a capillary or blood ketone concentration of > 3.0mmol/L or significant ketonuria (more than 2+ on standard urine sticks) The 'A' is for Acidaemia/acidosis– a bicarbonate concentration of ≤15.0mmol/L and/or venous pH <7.3" ;
    dmo:isEmergency "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Diabetic Ketoacidosis" ;
    dmo:onsetPattern "Acute" ;
    dmo:evidenceQuote "The 'D' is for Diabetes- a blood glucose concentration of >11.0mmol/L or known to have diabetes mellitus The 'K' is for Ketonaemia or ketonuria - a capillary or blood ketone concentration of > 3.0mmol/L or significant ketonuria (more than 2+ on standard urine sticks) The 'A' is for Acidaemia/acidosis– a bicarbonate concentration of ≤15.0mmol/L and/or venous pH <7.3" ;
    dmo:evidenceQuote "The severity of the DKA presentation will also provide a valuable clue in terms of where the individual should be appropriately managed." ;
    dmo:evidenceQuote "Nursing management for Diabetic Ketoacidosis (DKA) V1.0 12th December 2022" ;
    dmo:evidenceQuote "The ‘D’ is for Diabetes- a blood glucose concentration of >11.0mmol/L or known to have diabetes mellitus The ‘K’ is for Ketonaemia or ketonuria - a capillary or blood ketone concentration of > 3.0mmol/L or significant ketonuria (more than 2+ on standard urine sticks) The ‘A’ is for Acidaemia/acidosis– a bicarbonate concentration of ≤15.0mmol/L and/or venous pH <7.3" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

