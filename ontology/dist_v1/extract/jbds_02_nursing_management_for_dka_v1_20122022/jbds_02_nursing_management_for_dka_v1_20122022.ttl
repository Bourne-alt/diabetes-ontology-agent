    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/blood-ketones> a dmo:LabTest ;
    rdfs:label "Blood ketones" ;
    dmo:definition "Blood ketones over 6.0mmol/L may indicate severe DKA." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-ketones" ;
    dmo:name "Blood ketones" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "• Blood ketones over 6.0mmol/L" ;
    dmo:evidenceQuote "Monitor blood ketones hourly using Trust approved meter until <0.6 mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/capillary-blood-glucose> a dmo:LabTest ;
    rdfs:label "Capillary Blood Glucose" ;
    dmo:definition "Capillary blood glucose is monitored hourly using Trust approved meter. If meter reads “over POCT QA range ie >27.8mmol/L\" or “Hi\", venous blood should be sent to the laboratory hourly or measured using venous blood in a blood gas analyser." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "capillary-blood-glucose" ;
    dmo:name "Capillary Blood Glucose" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Monitor Capillary Blood Glucose hourly using Trust approved meter.  If meter reads “over POCT QA range ie >27.8mmol/L\" or “Hi\", venous blood should be sent to the laboratory hourly or measured using venous blood in a blood gas analyser." ;
    dmo:evidenceQuote "If the capillary blood glucose remains > 14 mmol/L and does not reduce by 3.0mmol/L/hour" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/capillary-or-blood-ketone-concentration> a dmo:LabTest ;
    rdfs:label "Capillary or Blood Ketone Concentration" ;
    dmo:definition "a capillary or blood ketone concentration of > 3.0mmol/L or significant ketonuria (more than 2+ on standard urine sticks)" ;
    dmo:labTestCode "capillary-or-blood-ketone-concentration" ;
    dmo:name "Capillary or Blood Ketone Concentration" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "The ‘K’  is for Ketonaemia or ketonuria - a capillary or blood ketone concentration of > 3.0mmol/L or significant ketonuria (more than 2+ on standard urine sticks)" ;
    dmo:evidenceQuote "The ‘K’ is for Ketonaemia or ketonuria - a capillary or blood ketone concentration of > 3.0mmol/L or significant ketonuria (more than 2+ on standard urine sticks)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/gcs> a dmo:LabTest ;
    rdfs:label "GCS" ;
    dmo:definition "GCS less than 12 or abnormal AVPU scale may indicate severe DKA." ;
    dmo:labTestCode "gcs" ;
    dmo:name "GCS" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "• GCS less than 12 or abnormal AVPU scale" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/labTest/glucose> a dmo:LabTest ;
    rdfs:label "Glucose" ;
