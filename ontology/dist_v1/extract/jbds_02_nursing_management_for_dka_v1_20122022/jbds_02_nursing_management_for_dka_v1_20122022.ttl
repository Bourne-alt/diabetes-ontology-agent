<https://example.org/dmo/id/labTest/hourly-blood-glucose-monitoring> a dmo:LabTest ;
    rdfs:label "Hourly Blood Glucose Monitoring" ;
    dmo:definition "the value of hourly blood glucose and ketone monitoring and recording" ;
    dmo:labTestCode "hourly-blood-glucose-monitoring" ;
    dmo:name "Hourly Blood Glucose Monitoring" ;
