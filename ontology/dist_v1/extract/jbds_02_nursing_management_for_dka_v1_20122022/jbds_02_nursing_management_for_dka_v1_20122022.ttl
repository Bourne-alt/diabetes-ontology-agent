<https://example.org/dmo/id/contraindication/transition-from-friii-vriii-to-csii-at-bedtime> a dmo:Contraindication ;
    rdfs:label "Transition from FRIII/VRIII to CSII at bedtime" ;
    dmo:contraCode "transition-from-friii-vriii-to-csii-at-bedtime" ;
    dmo:rationale "In case of set failure, transitioning at bedtime could lead to dangerous insulin deficiency during sleep" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "Transition from FRIII/VRIII to CSII is not recommended at bedtime in case of set failure" ;
    dmo:evidenceQuote "Transition from FRIII/VRIII to CSII is not recommended at bedtime in case of set failure." ;
