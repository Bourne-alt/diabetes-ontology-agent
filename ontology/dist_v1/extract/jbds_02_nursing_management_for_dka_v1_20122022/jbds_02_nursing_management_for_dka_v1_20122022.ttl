<https://example.org/dmo/id/recommendation/referral-to-diabetes-inpatient-specialist-nurse-if-insulin-pump-user> a dmo:Recommendation ;
    rdfs:label "Referral to Diabetes Inpatient Specialist Nurse if Insulin Pump User" ;
    dmo:recommendationId "referral-to-diabetes-inpatient-specialist-nurse-if-insulin-pump-user" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Referral" ;
    dmo:statement "If the patient used an insulin pump always refer to the diabetes inpatient specialist nurse" ;
    dmo:evidenceQuote "If the patient used an insulin pump always refer to the diabetes inpatient specialist nurse" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_nursing_management_for_dka_v1_20122022> .

<https://example.org/dmo/id/recommendation/referral-to-diabetes-inpatient-specialist-nurses> a dmo:Recommendation ;
    rdfs:label "Referral to Diabetes Inpatient Specialist Nurses" ;
    dmo:recommendationId "referral-to-diabetes-inpatient-specialist-nurses" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Referral" ;
