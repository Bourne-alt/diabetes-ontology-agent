<https://example.org/dmo/id/labTest/estimated-glomerular-filtration-rate> a dmo:LabTest ;
    rdfs:label "Estimated Glomerular Filtration Rate" ;
    dmo:definition "eGFR is more accurate than serum creatinine alone. Serum creatinine is affected by muscle mass, and related factors of age, sex, and race." ;
    dmo:labTestCode "estimated-glomerular-filtration-rate" ;
    dmo:name "Estimated Glomerular Filtration Rate" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mL-per-min" ;
    dmo:evidenceQuote "Calculate eGFR from stable serum creatinine levels at least once a year in all patients with diabetes." ;
