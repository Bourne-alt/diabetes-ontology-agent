    dmo:definition "UACR is a ratio between two measured substances. Unlike a dipstick test for albumin, UACR is unaffected by variation in urine concentration." ;
    dmo:labTestCode "urine-albumin-to-creatinine-ratio" ;
    dmo:name "Urine Albumin-to-Creatinine Ratio" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg/g" ;
