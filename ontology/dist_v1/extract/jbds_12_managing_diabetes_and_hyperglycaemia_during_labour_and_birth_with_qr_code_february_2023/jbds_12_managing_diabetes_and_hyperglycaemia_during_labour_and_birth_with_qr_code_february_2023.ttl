<https://example.org/dmo/id/riskFactor/sustained-maternal-hyperglycaemia-during-pregnancy> a dmo:RiskFactor ;
    rdfs:label "Sustained Maternal Hyperglycaemia During Pregnancy" ;
    dmo:evidenceNote "文档明确指出，持续的母体高血糖与多种产科和新生儿并发症相关。" ;
    dmo:name "Sustained Maternal Hyperglycaemia During Pregnancy" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "sustained-maternal-hyperglycaemia-during-pregnancy" ;
    dmo:evidenceQuote "There is overwhelming evidence that sustained maternal hyperglycaemia during pregnancy is associated with many obstetric and neonatal complications including preterm births, large for gestational age and neonatal hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/riskFactor/tight-intrapartum-glucose-targets> a dmo:RiskFactor ;
    rdfs:label "Tight Intrapartum Glucose Targets" ;
    dmo:evidenceNote "文档中指出该目标与高母体低血糖发生率相关" ;
    dmo:name "Tight Intrapartum Glucose Targets" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "tight-intrapartum-glucose-targets" ;
    dmo:evidenceQuote "The authors noted high rates of maternal hypoglycaemia associated with tight intrapartum glucose targets." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/riskFactor/type-1-diabetes> a dmo:RiskFactor ;
    rdfs:label "Type 1 Diabetes" ;
    dmo:evidenceNote "Women with type 1 diabetes are at increased risk of severe hypoglycaemia especially when breastfeeding and should have additional carbohydrate with meal or as a snack available during or before breastfeeds." ;
    dmo:name "Type 1 Diabetes" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "type-1-diabetes" ;
    dmo:evidenceQuote "Women with type 1 diabetes are at increased risk of severe hypoglycaemia especially when breastfeeding and should have additional carbohydrate with meal or as a snack available during or before breastfeeds." ;
    dmo:evidenceQuote "The main types of diabetes likely to be encountered on the obstetric wards are as follows (34): • Type 1 diabetes • Type 2 diabetes • Gestational diabetes (GDM) i.e. diabetes first detected in pregnancy. This may include women with pre-gestational (pre-existing) diabetes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/riskFactor/type-1-diabetes-pregnancy> a dmo:RiskFactor ;
