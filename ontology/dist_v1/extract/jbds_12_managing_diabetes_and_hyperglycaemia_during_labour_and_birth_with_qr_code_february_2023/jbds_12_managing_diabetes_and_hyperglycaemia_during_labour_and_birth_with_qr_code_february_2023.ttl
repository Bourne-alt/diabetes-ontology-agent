<https://example.org/dmo/id/riskFactor/postpartum-thyroiditis> a dmo:RiskFactor ;
    rdfs:label "Postpartum Thyroiditis" ;
    dmo:evidenceNote "Postpartum thyroiditis is a condition that occurs after childbirth and is not modifiable." ;
