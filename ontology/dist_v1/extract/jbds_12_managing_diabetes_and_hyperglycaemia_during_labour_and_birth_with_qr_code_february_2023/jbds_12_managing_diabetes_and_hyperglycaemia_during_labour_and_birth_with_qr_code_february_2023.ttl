<https://example.org/dmo/id/recommendation/postpartum-vriii-discontinuation-timing> a dmo:Recommendation ;
    rdfs:label "Postpartum VRIII discontinuation timing" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Women using VRIII" ;
    dmo:recommendationId "postpartum-vriii-discontinuation-timing" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "VRIII should be stopped 30 - 60 minutes after the first subcutaneous pre-meal insulin injection. Women using CSIII may not necessarily require pre-meal insulin with the first light meal after delivery" ;
    dmo:evidenceQuote "VRIII should be stopped 30 - 60 minutes after the first subcutaneous pre-meal insulin injection. Women using CSIII may not necessarily require pre-meal insulin with the first light meal after delivery" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/recommendation/postpartum-vriii-rate-reduction-after-delivery> a dmo:Recommendation ;
    rdfs:label "Postpartum VRIII rate reduction after delivery" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Women using VRIII" ;
    dmo:recommendationId "postpartum-vriii-rate-reduction-after-delivery" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "The rate of VRIII (if and when used) should be reduced by 50% immediately after delivery. Hourly glucose monitoring should be continued until the first meal is eaten. Ensure woman is eating and drinking before restarting subcutaneous insulin" ;
    dmo:evidenceQuote "The rate of VRIII (if and when used) should be reduced by 50% immediately after delivery. Hourly glucose monitoring should be continued until the first meal is eaten. Ensure woman is eating and drinking before restarting subcutaneous insulin" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/recommendation/pragmatic-intrapartum-glucose-target-range-of-5-0-8-0-mmol-l> a dmo:Recommendation ;
    rdfs:label "Pragmatic intrapartum glucose target range of 5.0 - 8.0 mmol/L" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Women during labour and delivery" ;
    dmo:recommendationId "pragmatic-intrapartum-glucose-target-range-of-5-0-8-0-mmol-l" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "The pragmatic target glucose level of 5.0 - 8.0 mmol/L during labour may be safer for women without increasing the risk of neonatal hypoglycaemia" ;
    dmo:evidenceQuote "The pragmatic target glucose level of 5.0 - 8.0 mmol/L during labour may be safer for women without increasing the risk of neonatal hypoglycaemia (Table 1)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/recommendation/pragmatic-target-range-of-5-0-8-0-mmol-l> a dmo:Recommendation ;
    rdfs:label "Pragmatic Target Range of 5.0 - 8.0 mmol/L" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "pregnant women with diabetes" ;
    dmo:recommendationId "pragmatic-target-range-of-5-0-8-0-mmol-l" ;
    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "some pregnant women with diabetes, anaesthetists, diabetes teams and obstetric units may consider that a pragmatic target range of 5.0 - 8.0 mmol/L is safer, as there is safety ‘buffer zone’ between the lowest acceptable glucose limit and hypoglycaemia" ;
    dmo:evidenceQuote "some pregnant women with diabetes, anaesthetists, diabetes teams and obstetric units may consider that a pragmatic target range of 5.0 - 8.0 mmol/L is safer, as there is safety ‘buffer zone’ between the lowest acceptable glucose limit and hypoglycaemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/recommendation/prandial-insulin-and-metformin-if-taken-should-be-stopped-if-vriii-is-started> a dmo:Recommendation ;
    rdfs:label "Prandial insulin (and metformin if taken) should be stopped if VRIII is started" ;
    dmo:recommendationId "prandial-insulin-and-metformin-if-taken-should-be-stopped-if-vriii-is-started" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Prandial insulin (and metformin if taken) should be stopped if VRIII is started" ;
    dmo:evidenceQuote "Prandial insulin (and metformin if taken) should be stopped if VRIII is started" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/recommendation/recommended-substrate-fluid-for-vriii-0-9-nacl-with-5-glucose-and-0-15-kcl-or-0-3-kcl-at-50-ml-hr> a dmo:Recommendation ;
    rdfs:label "Recommended substrate fluid for VRIII: 0.9% NaCl with 5% glucose and 0.15% KCl or 0.3% KCl at 50 mL/hr" ;
    dmo:recommendationId "recommended-substrate-fluid-for-vriii-0-9-nacl-with-5-glucose-and-0-15-kcl-or-0-3-kcl-at-50-ml-hr" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "The recommended substrate fluid to be administered alongside the VRIII is 0.9% NaCl with 5% glucose and 0.15% KCl (20 mmol/L) or 0.3% KCl (40 mmol/L) at 50 mL/hr. Additional intravenous fluids may be required as per clinical need e.g. haemorrhage. VRIII without substrate fluids may be required in some cases (e.g. fluid overload, hyponatraemia and pre-eclampsia). Pure dextrose containing fluids should be avoided due to risk of hyponatraemia" ;
    dmo:evidenceQuote "The recommended substrate fluid to be administered alongside the VRIII is 0.9% NaCl with 5% glucose and 0.15% KCl (20 mmol/L) or 0.3% KCl (40 mmol/L) at 50 mL/hr. Additional intravenous fluids may be required as per clinical need e.g. haemorrhage. VRIII without substrate fluids may be required in some cases (e.g. fluid overload, hyponatraemia and pre-eclampsia). Pure dextrose containing fluids should be avoided due to risk of hyponatraemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

