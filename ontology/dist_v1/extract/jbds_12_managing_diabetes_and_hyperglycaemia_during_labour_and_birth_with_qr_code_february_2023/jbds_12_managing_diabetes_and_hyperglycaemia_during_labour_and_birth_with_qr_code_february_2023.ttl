<https://example.org/dmo/id/riskFactor/inadequate-glucose-monitoring-after-delivery> a dmo:RiskFactor ;
    rdfs:label "Inadequate glucose monitoring after delivery" ;
    dmo:evidenceNote "Hourly glucose monitoring should be continued until the first meal is eaten" ;
    dmo:name "Inadequate glucose monitoring after delivery" ;
