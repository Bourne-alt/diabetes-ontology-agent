    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Potassium" ;
    dmo:scheduleId "potassium" ;
    dmo:triggerWindow "1 hour, 2 hours, 4 hours" ;
    dmo:evidenceQuote "Monitor blood glucose (BG) and capillary ketones (if available) hourly, venous bicarbonate and potassium at 1 hour, 2 hours, 4 hours and then depending upon the need, serum electrolytes 4 hourly (27)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

