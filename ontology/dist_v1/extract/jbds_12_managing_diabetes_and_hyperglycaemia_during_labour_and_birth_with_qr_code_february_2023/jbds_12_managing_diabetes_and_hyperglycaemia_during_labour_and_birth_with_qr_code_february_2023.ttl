<https://example.org/dmo/id/recommendation/target-blood-glucose-range-during-labour-and-delivery> a dmo:Recommendation ;
    rdfs:label "Target Blood Glucose Range During Labour and Delivery" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Women with diabetes during labour and delivery" ;
    dmo:recommendationId "target-blood-glucose-range-during-labour-and-delivery" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Screening" ;
    dmo:statement "A slightly relaxed target of 5.0 - 8.0 mmol/L is not associated with subsequent neonatal hypoglycaemia, and can be advocated as a safer blood glucose target range during delivery." ;
    dmo:evidenceQuote "A high quality systematic review of intrapartum glucose levels in pregnancies complicated by diabetes found no association between maternal intrapartum glucose level and neonatal hypoglycaemia in half of the 23 studies which included 2,835 women with diabetes (31). These studies have therefore contributed to the argument that a slightly relaxed target of 5.0 - 8.0 mmol/L is not associated with subsequent neonatal hypoglycaemia, and can be advocated as a safer blood glucose target range during delivery." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

