    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/device/variable-rate-intravenous-insulin-infusion> a dmo:Device ;
    rdfs:label "Variable Rate Intravenous Insulin Infusion" ;
    dmo:deviceCode "variable-rate-intravenous-insulin-infusion" ;
    dmo:deviceType "ArtificialPancreas" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Variable Rate Intravenous Insulin Infusion" ;
    dmo:evidenceQuote "Variable Rate Intravenous Insulin Infusion      VRIII" ;
    dmo:evidenceQuote "If optimal glycaemia cannot be achieved (e.g. 2 consecutive blood glucose (BG) readings >7.8 mmol/L), a variable rate intravenous insulin infusion (VRIII) can be considered." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/device/vriii> a dmo:Device ;
    rdfs:label "VRIII" ;
    dmo:deviceCode "vriii" ;
    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "VRIII" ;
    dmo:evidenceQuote "The rate of VRIII (if and when used) should be reduced by 50% immediately after delivery." ;
    dmo:evidenceQuote "Observational data in 161 pregnant women with type 1 diabetes using insulin pumps or VRIII demonstrated that women who continued to self-manage their diabetes using CSII achieved lower glucose levels during delivery than those who were switched to IV insulin (38)." ;
    dmo:evidenceQuote "Percentage of women with diabetes during pregnancy who required VRIII during delivery" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/diabetesType/diabetes-mellitus> a dmo:DiabetesType ;
    rdfs:label "Diabetes mellitus" ;
    dmo:definition "Diabetes mellitus (of any kind, DKA can occur in pregnancy in a woman with known diabetes with a normal blood glucose level)" ;
    dmo:diabetesTypeCode "diabetes-mellitus" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:name "Diabetes mellitus" ;
    dmo:prevalenceShare "0"^^xsd:integer ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "1. Presence of Diabetes mellitus (of any kind, DKA can occur in pregnancy in a woman with known diabetes with a normal blood glucose level) AND:" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/diabetesType/gdm> a dmo:DiabetesType ;
    rdfs:label "GDM" ;
    dmo:definition "Gestational diabetes mellitus (GDM) is a form of diabetes that develops during pregnancy and usually resolves after delivery." ;
    dmo:diabetesTypeCode "gdm" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "GDM" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "Pregnancy" ;
    dmo:evidenceQuote "Recent studies using automated closed-loop insulin delivery show wide intra-individual variation in total daily insulin doses but on average a 50% increase in insulin dose in the 48 hours after the first dose of corticosteroids (36)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/diabetesType/gestational-diabetes> a dmo:DiabetesType ;
    rdfs:label "gestational diabetes" ;
    dmo:definition "This guideline provides guidance on the management of women with pre-existing diabetes (type 1 or type 2), or gestational diabetes when admitted to maternity units in the following situations" ;
    dmo:diabetesTypeCode "gestational-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "gestational diabetes" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "Pregnancy" ;
    dmo:evidenceQuote "This guideline provides guidance on the management of women with pre-existing diabetes (type 1 or type 2), or gestational diabetes when admitted to maternity units in the following situations" ;
    dmo:evidenceQuote "Gestational Diabetes        GDM" ;
    dmo:evidenceQuote "different types of diabetes (type 1, type 2 or gestational) would require different approaches depending upon the risk factors, antenatal treatment (diet, metformin, insulin), risk of hypoglycaemia, risk of anaesthesia and the presence of obstetric complications." ;
    dmo:evidenceQuote "Women with GDM should be informed that all glucose lowering therapies will be stopped after the delivery of placenta" ;
    dmo:evidenceQuote "In women with gestational diabetes (GDM), all glucose lowering medications should be stopped after the placenta is delivered." ;
    dmo:evidenceQuote "Women with gestational diabetes have a ten times increased risk of developing type 2 diabetes within 5 years" ;
    dmo:evidenceQuote "Neonatal hypoglycaemia results from excessive fetal insulin production as a consequence of the sudden cessation of maternal-fetal glucose transfer after birth." ;
    dmo:evidenceQuote "The average duration of hyperglycaemia was 3 days with almost all women (>90%) experiencing hyperglycaemia >7.0 mmol/L, and over 50% with hyperglycaemia >10.0 mmol/L. Rates of maternal hypoglycaemia before and after corticosteroid administration were high (49% and 58% of mothers with type 1 diabetes); further emphasising the importance of weighing up both the maternal and neonatal consequences (49)." ;
    dmo:evidenceQuote "Percentage of women with gestational diabetes whose treatment was stopped after the placenta was delivered 100%" ;
    dmo:evidenceQuote "Progression to type 2 diabetes in women with a known history of gestational diabetes: systematic review and meta-analysis." ;
    dmo:evidenceQuote "Severe neonatal hypoglycaemia and intrapartum glycaemic control in pregnancies complicated by type 1, type 2 and gestational diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/diabetesType/gestational-diabetes-gdm-i-e-diabetes-first-detected-in-pregnancy-this-may-include-women-with-pre-gestational-pre-existing-diabetes> a dmo:DiabetesType ;
    rdfs:label "Gestational diabetes (GDM) i.e. diabetes first detected in pregnancy. This may include women with pre-gestational (pre-existing) diabetes" ;
