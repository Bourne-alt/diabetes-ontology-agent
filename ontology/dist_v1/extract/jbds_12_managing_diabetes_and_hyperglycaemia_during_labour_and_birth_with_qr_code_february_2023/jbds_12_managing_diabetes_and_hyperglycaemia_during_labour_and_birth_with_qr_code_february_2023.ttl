<https://example.org/dmo/id/recommendation/if-the-woman-is-unable-to-manage-or-her-glucose-control-is-unstable-or-deteriorates-i-e-blood-glucose-7-0-or-8-0-mmol-l-on-two-consecutive-occasions-or-has-urinary-ketones-or-more-or-high-ketones-1-5-mmol-l-then-vriii-in-hyperglycaemia-or-friii-in-ketoacidosis-should-be-immediately-commenced> a dmo:Recommendation ;
    rdfs:label "If the woman is unable to manage, or her glucose control is unstable or deteriorates, i.e. blood glucose >7.0 or 8.0 mmol/L on two consecutive occasions, or has urinary ketones ++ or more, or high ketones (>1.5 mmol/L), then VRIII (in hyperglycaemia) or FRIII (in ketoacidosis) should be immediately commenced" ;
    dmo:recommendationId "if-the-woman-is-unable-to-manage-or-her-glucose-control-is-unstable-or-deteriorates-i-e-blood-glucose-7-0-or-8-0-mmol-l-on-two-consecutive-occasions-or-has-urinary-ketones-or-more-or-high-ketones-1-5-mmol-l-then-vriii-in-hyperglycaemia-or-friii-in-ketoacidosis-should-be-immediately-commenced" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If the woman is unable to manage, or her glucose control is unstable or deteriorates, i.e. blood glucose >7.0 or 8.0 mmol/L on two consecutive occasions, or has urinary ketones ++ or more, or high ketones (>1.5 mmol/L), then VRIII (in hyperglycaemia) or FRIII (in ketoacidosis) should be immediately commenced" ;
    dmo:evidenceQuote "If the woman is unable to manage, or her glucose control is unstable or deteriorates, i.e. blood glucose >7.0 or 8.0 mmol/L on two consecutive occasions, or has urinary ketones ++ or more, or high ketones (>1.5 mmol/L), then VRIII (in hyperglycaemia) or FRIII (in ketoacidosis) should be immediately commenced" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

