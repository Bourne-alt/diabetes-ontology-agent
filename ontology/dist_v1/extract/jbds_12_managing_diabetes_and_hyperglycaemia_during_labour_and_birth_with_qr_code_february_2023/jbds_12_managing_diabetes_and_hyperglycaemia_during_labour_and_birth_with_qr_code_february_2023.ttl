<https://example.org/dmo/id/recommendation/administration-of-0-9-saline-with-5-dextrose-and-0-15-potassium-chloride-with-vriii> a dmo:Recommendation ;
    rdfs:label "Administration of 0.9% Saline with 5% Dextrose and 0.15% Potassium Chloride with VRIII" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "pregnant women with diabetes" ;
    dmo:recommendationId "administration-of-0-9-saline-with-5-dextrose-and-0-15-potassium-chloride-with-vriii" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "this updated JBDS guideline recommends administering 0.9% saline with 5% dextrose and 0.15% potassium chloride alongside a VRIII. This is in accordance with NICE guidance on prevention of inpatient hyponatraemia in hospitalised children and young people. To avoid fluid overload, the rate of this fluid should not exceed 50 mL/h" ;
    dmo:evidenceQuote "this updated JBDS guideline recommends administering 0.9% saline with 5% dextrose and 0.15% potassium chloride alongside a VRIII. This is in accordance with NICE guidance on prevention of inpatient hyponatraemia in hospitalised children and young people. To avoid fluid overload, the rate of this fluid should not exceed 50 mL/h" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

