<https://example.org/dmo/id/diabetesType/specific-types-of-diabetes-due-to-other-causes-this-may-include-women-with-monogenic-diabetes-or-maturity-onset-diabetes-of-the-young-mody-cystic-fibrosis-pancreatitis-related-diabetes-and-chemical-or-drug-induced-diabetes> a dmo:DiabetesType ;
    rdfs:label "Specific types of diabetes due to other causes. This may include women with monogenic diabetes or maturity-onset diabetes of the young (MODY), cystic fibrosis, pancreatitis related diabetes and chemical or drug induced diabetes." ;
    dmo:definition "Specific types of diabetes due to other causes. This may include women with monogenic diabetes or maturity-onset diabetes of the young (MODY), cystic fibrosis, pancreatitis related diabetes and chemical or drug induced diabetes." ;
    dmo:diabetesTypeCode "specific-types-of-diabetes-due-to-other-causes-this-may-include-women-with-monogenic-diabetes-or-maturity-onset-diabetes-of-the-young-mody-cystic-fibrosis-pancreatitis-related-diabetes-and-chemical-or-drug-induced-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
