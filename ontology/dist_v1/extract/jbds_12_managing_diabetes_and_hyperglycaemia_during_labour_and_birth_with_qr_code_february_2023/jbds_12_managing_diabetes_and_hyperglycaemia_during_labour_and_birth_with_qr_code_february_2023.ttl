<https://example.org/dmo/id/riskFactor/failure-to-stop-vriii-30-60-minutes-after-first-subcutaneous-pre-meal-insulin-injection> a dmo:RiskFactor ;
    rdfs:label "Failure to stop VRIII 30 - 60 minutes after first subcutaneous pre-meal insulin injection" ;
    dmo:evidenceNote "VRIII should be stopped 30 - 60 minutes after the first subcutaneous pre-meal insulin injection" ;
    dmo:name "Failure to stop VRIII 30 - 60 minutes after first subcutaneous pre-meal insulin injection" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "failure-to-stop-vriii-30-60-minutes-after-first-subcutaneous-pre-meal-insulin-injection" ;
    dmo:evidenceQuote "VRIII should be stopped 30 - 60 minutes after the first subcutaneous pre-meal insulin injection" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/riskFactor/gestational-diabetes> a dmo:RiskFactor ;
    rdfs:label "Gestational Diabetes" ;
    dmo:evidenceNote "文档明确指出妊娠期糖尿病是产科病房中常见的糖尿病类型之一，且其管理属于本指南范围。" ;
    dmo:name "Gestational Diabetes" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "gestational-diabetes" ;
    dmo:evidenceQuote "The main types of diabetes likely to be encountered on the obstetric wards are as follows (34): • Type 1 diabetes • Type 2 diabetes • Gestational diabetes (GDM) i.e. diabetes first detected in pregnancy. This may include women with pre-gestational (pre-existing) diabetes" ;
    dmo:evidenceQuote "Recent data suggest approximate prevalence of clinically relevant neonatal hypoglycaemia, defined as requiring treatment with intravenous dextrose, of ~5% in gestational diabetes, ~20% in type 2 diabetes and ~30% in type 1 diabetes pregnancy (31)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/riskFactor/gestational-diabetes-mellitus> a dmo:RiskFactor ;
    rdfs:label "Gestational Diabetes Mellitus" ;
    dmo:evidenceNote "Some women with type 1 diabetes, type 2 diabetes or GDM may require VRIII to achieve target glucose levels." ;
    dmo:name "Gestational Diabetes Mellitus" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "gestational-diabetes-mellitus" ;
    dmo:evidenceQuote "Some women with type 1 diabetes, type 2 diabetes or GDM may require VRIII to achieve target glucose levels." ;
    dmo:evidenceQuote "Women with gestational diabetes have a ten times increased risk of developing type 2 diabetes within 5 years (23)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/riskFactor/history-of-gestational-diabetes-mellitus> a dmo:RiskFactor ;
    rdfs:label "History of Gestational Diabetes Mellitus" ;
    dmo:evidenceNote "A history of gestational diabetes is a past medical condition that cannot be changed." ;
    dmo:name "History of Gestational Diabetes Mellitus" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "history-of-gestational-diabetes-mellitus" ;
    dmo:evidenceQuote "Women with gestational diabetes have a ten times increased risk of developing type 2 diabetes within 5 years (23)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/riskFactor/inadequate-carbohydrate-intake-during-breastfeeding> a dmo:RiskFactor ;
    rdfs:label "Inadequate carbohydrate intake during breastfeeding" ;
    dmo:evidenceNote "Women should be advised to snack (10 - 15 g carbohydrate) and drink each time they feed or express milk (including night feeds)" ;
    dmo:name "Inadequate carbohydrate intake during breastfeeding" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "inadequate-carbohydrate-intake-during-breastfeeding" ;
