<https://example.org/dmo/id/contraindication/tight-glycaemic-control-during-labour> a dmo:Contraindication ;
    rdfs:label "Tight glycaemic control during labour" ;
    dmo:contraCode "tight-glycaemic-control-during-labour" ;
    dmo:rationale "May inadvertently cause harm from hospital acquired hypoglycaemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Striving for tight glycaemic control for hospitalised patients with glucose lowering medication (including insulin infusions)" ;
    dmo:evidenceQuote "It for this reason that recent national and international guidelines suggest that the lowest BG whilst a hospitalised person is on glucose lowering medication should be 6.0 mmol/L (21; 22; 47). Having this slightly higher lowest acceptable blood glucose reduces the risk of hospital acquired hypoglycaemia, may also reduce the use of the VRIII and all of the intrinsic complications associated with its use." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/contraindication/use-of-vriii-with-no-accompanying-fluid> a dmo:Contraindication ;
    rdfs:label "Use of VRIII with no accompanying fluid" ;
    dmo:contraCode "use-of-vriii-with-no-accompanying-fluid" ;
    dmo:rationale "This may increase the risk of maternal hypoglycaemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in pregnant women with renal disorders and pre-eclampsia" ;
    dmo:evidenceQuote "but this may increase the risk of maternal hypoglycaemia. Consequently, this updated JBDS guideline recommends administering 0.9% saline with 5% dextrose and 0.15% potassium chloride alongside a VRIII." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/contraindication/vriii-without-substrate-fluids> a dmo:Contraindication ;
    rdfs:label "VRIII without substrate fluids" ;
    dmo:contraCode "vriii-without-substrate-fluids" ;
    dmo:rationale "VRIII without substrate fluids may be required in some cases (e.g. fluid overload, hyponatraemia and pre-eclampsia)" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in some cases (e.g. fluid overload, hyponatraemia and pre-eclampsia)" ;
    dmo:evidenceQuote "VRIII without substrate fluids may be required in some cases (e.g. fluid overload, hyponatraemia and pre-eclampsia)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/device/automated-insulin-delivery-systems> a dmo:Device ;
    rdfs:label "automated insulin delivery systems" ;
    dmo:deviceCode "automated-insulin-delivery-systems" ;
    dmo:deviceType "ArtificialPancreas" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "automated insulin delivery systems" ;
    dmo:evidenceQuote "Women who are on insulin pump therapy or automated insulin delivery systems may choose to remain on insulin pump therapy or automated closed-loop systems (an insulin pump system which delivers basal insulin according to CGM glucose levels) after steroids and during the intrapartum and post-natal periods" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

