    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "metformin" ;
    dmo:name "metformin" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:rxNormCode "162060" ;
    dmo:evidenceQuote "Women with pre-existing type 2 diabetes who are breastfeeding can take metformin after birth, but should avoid other oral glucose lowering treatments" ;
    dmo:evidenceQuote "Prandial insulin (and metformin if taken) should be stopped if VRIII is started" ;
    dmo:evidenceQuote "Because metformin does not cause hypoglycaemia, a target glucose range of 4.0 - 10.0 mmol/L is acceptable." ;
    dmo:evidenceQuote "Women who are breast feeding with pre-existing type 2 diabetes can take metformin after birth but should avoid other oral glucose lowering drugs." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

