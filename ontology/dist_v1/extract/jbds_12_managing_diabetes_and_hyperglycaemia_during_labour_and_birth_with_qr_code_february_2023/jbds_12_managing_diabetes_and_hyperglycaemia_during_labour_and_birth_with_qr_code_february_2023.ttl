    dmo:diabetesTypeCode "gestational-diabetes-gdm-i-e-diabetes-first-detected-in-pregnancy-this-may-include-women-with-pre-gestational-pre-existing-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005149" ;
    dmo:name "Gestational diabetes (GDM) i.e. diabetes first detected in pregnancy. This may include women with pre-gestational (pre-existing) diabetes" ;
    dmo:prevalenceShare "0.1"^^xsd:decimal ;
    dmo:typicalOnset "Pregnancy" ;
    dmo:evidenceQuote "• Gestational diabetes (GDM) i.e. diabetes first detected in pregnancy. This may include women with pre-gestational (pre-existing) diabetes" ;
