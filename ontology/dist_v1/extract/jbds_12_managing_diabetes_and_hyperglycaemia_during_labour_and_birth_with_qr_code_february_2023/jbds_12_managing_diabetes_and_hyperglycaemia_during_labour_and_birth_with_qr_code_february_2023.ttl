    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Women should continue to avoid medicines for their diabetes complications that were stopped for safety reason during pre-conception period or when pregnancy was identified." ;
