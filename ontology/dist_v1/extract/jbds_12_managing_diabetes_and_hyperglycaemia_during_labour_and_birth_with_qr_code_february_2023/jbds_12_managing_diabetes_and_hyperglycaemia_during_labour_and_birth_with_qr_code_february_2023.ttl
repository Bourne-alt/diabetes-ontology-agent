<https://example.org/dmo/id/recommendation/use-of-continuous-glucose-monitoring-cgm-in-type-1-diabetes-pregnancy> a dmo:Recommendation ;
    rdfs:label "Use of continuous glucose monitoring (CGM) in type 1 diabetes pregnancy" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
