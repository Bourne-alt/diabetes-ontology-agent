<https://example.org/dmo/id/riskFactor/increased-deprivation> a dmo:RiskFactor ;
    rdfs:label "Increased Deprivation" ;
    dmo:evidenceNote "Risk factors for DKA in pregnancy include increased deprivation, mental health problems and poor long term glycaemic control." ;
