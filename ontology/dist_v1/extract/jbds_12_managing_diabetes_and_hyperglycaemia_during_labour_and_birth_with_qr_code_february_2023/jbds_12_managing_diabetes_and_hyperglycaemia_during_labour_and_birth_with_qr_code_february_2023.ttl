    dmo:recommendationType "Safety" ;
    dmo:statement "An insulin pen is always used to measure and prepare insulin for an intravenous infusion" ;
    dmo:evidenceQuote "An insulin pen is always used to measure and prepare insulin for an intravenous infusion" ;
