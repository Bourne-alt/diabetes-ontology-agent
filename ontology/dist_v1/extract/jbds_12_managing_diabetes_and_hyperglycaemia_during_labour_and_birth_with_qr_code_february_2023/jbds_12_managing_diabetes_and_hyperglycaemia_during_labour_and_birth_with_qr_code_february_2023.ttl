<https://example.org/dmo/id/recommendation/consideration-of-vriii-for-suboptimal-glycaemia-in-women-on-csii-receiving-steroids> a dmo:Recommendation ;
    rdfs:label "Consideration of VRIII for Suboptimal Glycaemia in Women on CSII Receiving Steroids" ;
    dmo:populationScope "Women on insulin pump therapy receiving steroids with suboptimal glycaemia" ;
    dmo:recommendationId "consideration-of-vriii-for-suboptimal-glycaemia-in-women-on-csii-receiving-steroids" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If optimal glycaemia cannot be achieved (e.g. 2 consecutive blood glucose (BG) readings >7.8 mmol/L), a variable rate intravenous insulin infusion (VRIII) can be considered. The insulin pump should be disconnected, labelled and stored securely for future use" ;
    dmo:evidenceQuote "If optimal glycaemia cannot be achieved (e.g. 2 consecutive blood glucose (BG) readings >7.8 mmol/L), a variable rate intravenous insulin infusion (VRIII) can be considered. The insulin pump should be disconnected, labelled and stored securely for future use" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/recommendation/consideration-of-vriii-if-two-consecutive-blood-glucose-levels-are-above-the-target-range> a dmo:Recommendation ;
    rdfs:label "Consideration of VRIII if two consecutive blood glucose levels are above the target range" ;
    dmo:recommendationId "consideration-of-vriii-if-two-consecutive-blood-glucose-levels-are-above-the-target-range" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "VRIII should be considered if two consecutive blood glucose levels are above the target range (7.0 or 8.0 mmol/L). The second blood glucose should be checked within an hour to prevent any delay in starting VRIII." ;
    dmo:evidenceQuote "VRIII should be considered if two consecutive blood glucose levels are above the target range (7.0 or 8.0 mmol/L). The second blood glucose should be checked within an hour to prevent any delay in starting VRIII." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

