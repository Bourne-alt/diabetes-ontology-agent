<https://example.org/dmo/id/riskFactor/acute-hyperglycaemia-exposure-during-labour-and-birth> a dmo:RiskFactor ;
    rdfs:label "Acute Hyperglycaemia Exposure During Labour And Birth" ;
    dmo:evidenceNote "文档指出，急性高血糖暴露在分娩期间和之后对新生儿低血糖风险的影响存在不确定性。" ;
    dmo:name "Acute Hyperglycaemia Exposure During Labour And Birth" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "acute-hyperglycaemia-exposure-during-labour-and-birth" ;
    dmo:evidenceQuote "There is more uncertainty regarding the impact of acute hyperglycaemia exposure during and following corticosteroid administration or during labour and birth on risk of neonatal hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/riskFactor/breastfeeding> a dmo:RiskFactor ;
