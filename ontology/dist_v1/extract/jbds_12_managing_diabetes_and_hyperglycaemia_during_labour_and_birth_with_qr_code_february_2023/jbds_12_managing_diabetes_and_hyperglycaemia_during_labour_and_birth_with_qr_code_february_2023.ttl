<https://example.org/dmo/id/symptom/polyuria> a dmo:Symptom ;
    rdfs:label "Polyuria" ;
    dmo:name "Polyuria" ;
    dmo:symptomCode "polyuria" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Symptoms include nausea and/or vomiting, abdominal pain, polyuria and polydipsia, and leg cramps." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/symptom/rapid-pulse> a dmo:Symptom ;
    rdfs:label "Rapid Pulse" ;
    dmo:name "Rapid Pulse" ;
    dmo:symptomCode "rapid-pulse" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "Later signs/symptoms include dehydration (manifesting as dry skin and mouth), blurred eyesight, tachypnoea, rapid pulse, a distinct smell on the breath (sometimes described as 'pear drops') and coma." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/symptom/tachypnoea> a dmo:Symptom ;
    rdfs:label "Tachypnoea" ;
    dmo:name "Tachypnoea" ;
    dmo:symptomCode "tachypnoea" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "Later signs/symptoms include dehydration (manifesting as dry skin and mouth), blurred eyesight, tachypnoea, rapid pulse, a distinct smell on the breath (sometimes described as 'pear drops') and coma." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/symptom/vomiting> a dmo:Symptom ;
    rdfs:label "Vomiting" ;
    dmo:name "Vomiting" ;
    dmo:symptomCode "vomiting" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Encourage women to contact the obstetric team if not well or vomiting – may need hospital admission for intravenous insulin regime." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

