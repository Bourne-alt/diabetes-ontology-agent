<https://example.org/dmo/id/recommendation/target-glucose-levels-during-labour> a dmo:Recommendation ;
    rdfs:label "Target glucose levels during labour" ;
    dmo:recommendationId "target-glucose-levels-during-labour" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Aim to maintain glucose levels (capillary, Flash or CGM) during labour in either the target range advocated in the NICE guidelines (4.0 – 7.0 mmol/L) or in the more liberal range of 5.0 – 8.0 mmol/L due to lack of RCT evidence for either target" ;
    dmo:evidenceQuote "Aim to maintain glucose levels (capillary, Flash or CGM) during labour in either the target range advocated in the NICE guidelines (4.0 – 7.0 mmol/L) or in the more liberal range of 5.0 – 8.0 mmol/L due to lack of RCT evidence for either target" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

