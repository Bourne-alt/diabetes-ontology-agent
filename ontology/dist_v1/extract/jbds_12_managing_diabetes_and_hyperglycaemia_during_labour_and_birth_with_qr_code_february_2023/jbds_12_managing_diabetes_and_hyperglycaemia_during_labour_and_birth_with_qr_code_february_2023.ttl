<https://example.org/dmo/id/recommendation/use-0-9-nacl-with-5-glucose-and-0-15-kcl-or-0-3-kcl-as-substrate-fluid-with-i-v-insulin> a dmo:Recommendation ;
    rdfs:label "Use 0.9% NaCl with 5% glucose and 0.15% KCl or 0.3% KCl as substrate fluid with i.v. insulin" ;
    dmo:populationScope "Women on diet control/oral treatment and/or single or multiple dose insulin therapy receiving antenatal steroids" ;
    dmo:recommendationId "use-0-9-nacl-with-5-glucose-and-0-15-kcl-or-0-3-kcl-as-substrate-fluid-with-i-v-insulin" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "We recommend 0.9% NaCl with 5% glucose and 0.15% KCl (20 mmol/L) or 0.3% KCl (40 mmol/L) as the substrate fluid with i.v. insulin to avoid maternal and neonatal hypoglycaemia, hyponatraemia and hypokalaemia (5; 10; 11; 16; 18)." ;
    dmo:evidenceQuote "We recommend 0.9% NaCl with 5% glucose and 0.15% KCl (20 mmol/L) or 0.3% KCl (40 mmol/L) as the substrate fluid with i.v. insulin to avoid maternal and neonatal hypoglycaemia, hyponatraemia and hypokalaemia (5; 10; 11; 16; 18)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

