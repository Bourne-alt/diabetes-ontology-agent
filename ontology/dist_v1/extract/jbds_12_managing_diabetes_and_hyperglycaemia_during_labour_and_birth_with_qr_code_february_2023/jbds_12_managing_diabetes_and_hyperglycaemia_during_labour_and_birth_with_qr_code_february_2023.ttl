<https://example.org/dmo/id/monitoringSchedule/plasma-glucose-monitoring-during-labour-and-birth> a dmo:MonitoringSchedule ;
    rdfs:label "Plasma Glucose Monitoring During Labour and Birth" ;
    dmo:appliesTo "all women with diabetes" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Plasma Glucose Monitoring During Labour and Birth" ;
    dmo:scheduleId "plasma-glucose-monitoring-during-labour-and-birth" ;
    dmo:triggerWindow "during labour and birth" ;
    dmo:evidenceQuote "Monitoring of plasma glucose hourly during labour and birth in all women with diabetes, ensuring it is maintained between 4.0 and 7.0 mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/postnatal-blood-glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Postnatal Blood Glucose Monitoring" ;
    dmo:appliesTo "GDM: pre-meal and 1 hour post-meal" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Postnatal Blood Glucose Monitoring" ;
    dmo:scheduleId "postnatal-blood-glucose-monitoring" ;
    dmo:triggerWindow "up to 24 hours after delivery" ;
    dmo:evidenceQuote "GDM: pre-meal and 1 hour post-meal for up to 24 hours" ;
    dmo:evidenceQuote "Pre-existing diabetes: as per usual practice" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/potassium> a dmo:MonitoringSchedule ;
