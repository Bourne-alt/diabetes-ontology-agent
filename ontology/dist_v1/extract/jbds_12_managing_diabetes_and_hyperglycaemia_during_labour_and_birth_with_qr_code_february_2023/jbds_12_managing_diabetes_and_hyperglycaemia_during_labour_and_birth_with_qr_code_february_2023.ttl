    dmo:recommendationType "Monitoring" ;
    dmo:statement "The numbers of mothers needed to treat with CGM to prevent one clinically relevant neonatal hypoglycaemia was eight; strongly suggesting that neonatal hypoglycaemia was associated with sustained maternal hyperglycaemia throughout the second and third trimesters" ;
    dmo:evidenceQuote "The numbers of mothers needed to treat with CGM to prevent one clinically relevant neonatal hypoglycaemia was eight; strongly suggesting that neonatal hypoglycaemia was associated with sustained maternal hyperglycaemia throughout the second and third trimesters." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/recommendation/use-of-correction-boluses-and-temporary-basal-rate-increases-in-women-on-csii-receiving-steroids> a dmo:Recommendation ;
    rdfs:label "Use of Correction Boluses and Temporary Basal Rate Increases in Women on CSII Receiving Steroids" ;
    dmo:populationScope "Women on insulin pump therapy receiving steroids" ;
    dmo:recommendationId "use-of-correction-boluses-and-temporary-basal-rate-increases-in-women-on-csii-receiving-steroids" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Women on insulin pump therapy may be able to safely maintain glucose levels following steroid administration by use of correction boluses and temporary basal rate increases. In general approximately 50% increase in insulin doses may be needed" ;
    dmo:evidenceQuote "Women on insulin pump therapy may be able to safely maintain glucose levels following steroid administration by use of correction boluses and temporary basal rate increases. In general approximately 50% increase in insulin doses may be needed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/recommendation/use-of-fixed-rate-insulin-infusion-friii-for-dka-management> a dmo:Recommendation ;
    rdfs:label "Use of Fixed Rate Insulin Infusion (FRIII) for DKA Management" ;
    dmo:populationScope "Pregnant women with diabetic ketoacidosis (DKA)" ;
    dmo:recommendationId "use-of-fixed-rate-insulin-infusion-friii-for-dka-management" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "This protocol is based on national guidance (27) which uses a fixed rate of insulin infusion (FRIII) and a variable amount of intravenous glucose to prevent hypoglycaemia." ;
    dmo:evidenceQuote "This protocol is based on national guidance (27) which uses a fixed rate of insulin infusion (FRIII) and a variable amount of intravenous glucose to prevent hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/recommendation/use-of-insulin-algorithm-during-steroid-administration> a dmo:Recommendation ;
    rdfs:label "Use of insulin algorithm during steroid administration" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Women receiving betamethasone for fetal lung maturity" ;
    dmo:recommendationId "use-of-insulin-algorithm-during-steroid-administration" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "An insulin algorithm was used in a study where the night insulin dose was increased by 25% on Day 1, all insulin doses increased by 40% on Day 2 and Day 3, 20% on Day 4, 10–20% on Day 5, and reduced to pre-steroid doses by Days 6 and 7." ;
    dmo:evidenceQuote "Day 1 (the day on which the first betamethasone injection is given), the night insulin dose increased by 25% Day 2, all insulin doses increased by 40% Day 3, all insulin doses increased by 40% Day 4, all insulin doses increased by 20% Day 5, all insulin doses increased by 10–20% (all compared to pre-steroid doses) Days 6 and 7, insulin doses reduced to pre-steroid doses" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

