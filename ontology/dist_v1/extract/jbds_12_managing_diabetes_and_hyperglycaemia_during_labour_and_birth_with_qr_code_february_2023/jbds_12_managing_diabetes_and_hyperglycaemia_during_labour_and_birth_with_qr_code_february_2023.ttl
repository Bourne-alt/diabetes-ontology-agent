<https://example.org/dmo/id/recommendation/minimum-blood-glucose-level-for-hospitalised-patients-on-glucose-lowering-medication> a dmo:Recommendation ;
    rdfs:label "Minimum Blood Glucose Level for Hospitalised Patients on Glucose Lowering Medication" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Hospitalised patients on glucose lowering medication" ;
    dmo:recommendationId "minimum-blood-glucose-level-for-hospitalised-patients-on-glucose-lowering-medication" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "The lowest BG whilst a hospitalised person is on glucose lowering medication should be 6.0 mmol/L." ;
    dmo:evidenceQuote "It for this reason that recent national and international guidelines suggest that the lowest BG whilst a hospitalised person is on glucose lowering medication should be 6.0 mmol/L (21; 22; 47). Having this slightly higher lowest acceptable blood glucose reduces the risk of hospital acquired hypoglycaemia, may also reduce the use of the VRIII and all of the intrinsic complications associated with its use." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

