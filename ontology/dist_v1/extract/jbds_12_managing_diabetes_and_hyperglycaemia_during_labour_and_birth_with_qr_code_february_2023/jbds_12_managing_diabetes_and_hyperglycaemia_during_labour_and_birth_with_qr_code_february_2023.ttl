<https://example.org/dmo/id/diabetesType/insulin-treated-type-2-dm> a dmo:DiabetesType ;
    rdfs:label "INSULIN TREATED TYPE 2 DM" ;
    dmo:definition "TYPE 1 DM and INSULIN TREATED TYPE 2 DM" ;
    dmo:diabetesTypeCode "insulin-treated-type-2-dm" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "INSULIN TREATED TYPE 2 DM" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "TYPE 1 DM and INSULIN TREATED TYPE 2 DM" ;
    dmo:evidenceQuote "Reduce the rate of VRIII by HALF once placenta is delivered. Contact diabetes team to review on -going insulin requirements" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_12_managing_diabetes_and_hyperglycaemia_during_labour_and_birth_with_qr_code_february_2023> .

<https://example.org/dmo/id/diabetesType/pre-existing-diabetes> a dmo:DiabetesType ;
