    dmo:isEmergency "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005119" ;
    dmo:name "Central Pontine Myelinolysis" ;
    dmo:onsetPattern "Acute" ;
    dmo:evidenceQuote "Neurological complications, such as cerebral oedema and central pontine myelinolysis (CPM) / osmotic demyelination syndrome are uncommon but can be seen as a complication of the rapid changes in osmolality during treatment of HHS (5; 6)." ;
    dmo:evidenceQuote "prevention of: \n• arterial or venous thrombosis\n• other potential complications e.g. cerebral oedema/ central pontine myelinolysis / osmotic demyelination syndrome" ;
