    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/excessive-rate-of-change-of-serum-sodium> a dmo:Contraindication ;
    rdfs:label "Excessive Rate of Change of Serum Sodium" ;
    dmo:contraCode "excessive-rate-of-change-of-serum-sodium" ;
    dmo:rationale "to avoid sudden osmotic shifts and complications such as cerebral oedema and central pontine myelinolysis (CPM) / osmotic demyelination syndrome" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "the rate of change of serum sodium should not exceed 10 mmol in 24 hours" ;
    dmo:evidenceQuote "The rate of change of serum sodium should not exceed 10 mmol in 24 hours (8; 9)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/hypokalaemia-and-hyperkalaemia-in-hhs> a dmo:Contraindication ;
    rdfs:label "Hypokalaemia and hyperkalaemia in HHS" ;
    dmo:contraCode "hypokalaemia-and-hyperkalaemia-in-hhs" ;
    dmo:rationale "are life threatening conditions and warrant senior review" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "hypokalaemia (<3.5 mmol/L) and hyperkalaemia (>6.0 mmol/L)" ;
    dmo:evidenceQuote "Hypokalaemia (<3.5 mmol/L) and hyperkalaemia (>6.0 mmol/L) are life threatening conditions and warrant senior review. They are less common in HHS than DKA but monitoring and replacement are essential" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/initiation-of-friii-in-absence-of-significant-ketonaemia> a dmo:Contraindication ;
    rdfs:label "Initiation of FRIII in absence of significant ketonaemia" ;
    dmo:contraCode "initiation-of-friii-in-absence-of-significant-ketonaemia" ;
    dmo:rationale "The risk of adding insulin at the start of treatment is that this will lead to larger osmotic shifts leading to neurological complications. In addition, adding IV insulin too early will also potentially lead to circulatory collapse." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "unless significant ketonaemia is present – i.e. > 3.0 mmol/L or urine ketones > 2+" ;
    dmo:evidenceQuote "A FRIII should NOT be started as part of the initial treatment unless significant ketonaemia is present – i.e. > 3.0 mmol/L or urine ketones > 2+." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/intravenous-magnesium-replacement> a dmo:Contraindication ;
    rdfs:label "Intravenous Magnesium Replacement" ;
    dmo:contraCode "intravenous-magnesium-replacement" ;
    dmo:rationale "IV is associated with high urinary excretion therefore very little of the infusion remains in the circulation so should only be considered if severely deplete and symptomatic" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "severely deplete and symptomatic e.g. ECG changes or neurological manifestations" ;
    dmo:evidenceQuote "IV is associated with high urinary excretion therefore very little of the infusion remains in the circulation so should only be considered if severely deplete and symptomatic e.g. ECG changes or neurological manifestations" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/osmolality-falling-at-rate-exceeding-8-0-mosm-kg-hr> a dmo:Contraindication ;
    rdfs:label "Osmolality falling at rate exceeding 8.0 mOsm/kg/hr" ;
    dmo:contraCode "osmolality-falling-at-rate-exceeding-8-0-mosm-kg-hr" ;
    dmo:rationale "consider reducing infusion rate of IV fluids and/or insulin (if already commenced)" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "if osmolality is falling at rate exceeding 8.0 mOsm/kg/hr" ;
    dmo:evidenceQuote "If osmolality falling at rate exceeding 8.0 mOsm/kg/hr consider reducing infusion rate of IV fluids and/or insulin (if already commenced)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/rapid-changes-in-osmolality> a dmo:Contraindication ;
    rdfs:label "Rapid changes in osmolality" ;
    dmo:contraCode "rapid-changes-in-osmolality" ;
    dmo:rationale "Because these parameters are inter-related we advise that they are plotted on a graph or tabulated to permit appreciation of the rate of change" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "too rapid changes are dangerous because large fluid shifts can lead to neurological complications, in particular cerebral oedema and CPM/osmotic demyelination" ;
    dmo:evidenceQuote "too rapid changes are dangerous because large fluid shifts can lead to neurological complications, in particular cerebral oedema and CPM/osmotic demyelination." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/rapid-rehydration-in-the-elderly> a dmo:Contraindication ;
    rdfs:label "Rapid Rehydration in the Elderly" ;
    dmo:contraCode "rapid-rehydration-in-the-elderly" ;
    dmo:rationale "too rapid rehydration may precipitate heart failure" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "in the elderly, where too rapid rehydration may precipitate heart failure" ;
    dmo:evidenceQuote "Caution is needed, particularly in the elderly, where too rapid rehydration may precipitate heart failure but insufficient may fail to reverse acute kidney injury." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/rate-of-fall-of-plasma-glucose-exceeding-6-0-mmol-hr> a dmo:Contraindication ;
    rdfs:label "Rate of fall of plasma glucose exceeding 6.0 mmol/hr" ;
    dmo:contraCode "rate-of-fall-of-plasma-glucose-exceeding-6-0-mmol-hr" ;
    dmo:rationale "If the rate is faster than this, it increases the risk of neurological complications such as cerebral oedema and CPM/osmotic demyelination" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "a safe rate of fall of plasma glucose is between 4.0 and 6.0 mmol/hr" ;
    dmo:evidenceQuote "a safe rate of fall of plasma glucose is between 4.0 and 6.0 mmol/hr" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/rate-of-fall-of-serum-sodium-exceeding-10-mmol-l-in-24-hours> a dmo:Contraindication ;
    rdfs:label "Rate of fall of serum sodium exceeding 10 mmol/L in 24 hours" ;
    dmo:contraCode "rate-of-fall-of-serum-sodium-exceeding-10-mmol-l-in-24-hours" ;
    dmo:rationale "This is a safety threshold to prevent neurological complications" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "the rate of fall of serum sodium should not exceed 10 mmol/L in 24 hours" ;
    dmo:evidenceQuote "the rate of fall of serum sodium should not exceed 10 mmol/L in 24 hours (43)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/starting-iv-insulin-too-early> a dmo:Contraindication ;
    rdfs:label "Starting IV insulin too early" ;
    dmo:contraCode "starting-iv-insulin-too-early" ;
    dmo:rationale "Starting an IV insulin infusion too early could result in circulatory collapse" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "before fluid replacement is adequate and glucose concentrations have plateaued" ;
    dmo:evidenceQuote "ONLY start IV insulin once fluid replacement is adequate and glucose concentrations have plateaued. Starting an IV insulin infusion too early could result in circulatory collapse" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/therapeutic-anticoagulation> a dmo:Contraindication ;
    rdfs:label "Therapeutic Anticoagulation" ;
    dmo:contraCode "therapeutic-anticoagulation" ;
    dmo:rationale "Full, therapeutic anticoagulation should only be considered in those with suspected thrombosis or acute coronary syndrome." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in those with suspected thrombosis or acute coronary syndrome" ;
    dmo:evidenceQuote "Full, therapeutic anticoagulation should only be considered in those with suspected thrombosis or acute coronary syndrome." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/use-of-0-45-n-saline-when-osmolality-is-not-falling-despite-adequate-fluids> a dmo:Contraindication ;
    rdfs:label "Use of 0.45% N/Saline when osmolality is not falling despite adequate fluids" ;
    dmo:contraCode "use-of-0-45-n-saline-when-osmolality-is-not-falling-despite-adequate-fluids" ;
    dmo:rationale "ONLY Use 0.45% N/Saline if osmolality is not falling despite adequate fluids" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Use of 0.45% N/Saline if osmolality is not falling despite adequate fluids" ;
    dmo:evidenceQuote "ONLY Use 0.45% N/Saline if osmolality is not falling despite adequate fluids" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/use-of-glucose-regime-before-cbg-14-0-mmol-l> a dmo:Contraindication ;
    rdfs:label "Use of glucose regime before CBG <14.0 mmol/L" ;
    dmo:contraCode "use-of-glucose-regime-before-cbg-14-0-mmol-l" ;
    dmo:rationale "ACTION 2: INTRAVENOUS FLUID MANAGEMENT (Glucose regime) Once CBG<14.0 mmol/L" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "Use of glucose regime before capillary blood glucose (CBG) <14.0 mmol/L" ;
    dmo:evidenceQuote "ACTION 2: INTRAVENOUS FLUID MANAGEMENT (Glucose regime) Once CBG<14.0 mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/use-of-hypotonic-fluids-less-than-0-45-sodium-chloride-solution> a dmo:Contraindication ;
    rdfs:label "Use of hypotonic fluids less than 0.45% sodium chloride solution" ;
    dmo:contraCode "use-of-hypotonic-fluids-less-than-0-45-sodium-chloride-solution" ;
    dmo:rationale "No evidence supports the use of fluids less hypotonic than 0.45% NaCl" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "there are no data to justify using fluids that are less hypotonic than 0.45% sodium chloride solution" ;
    dmo:evidenceQuote "There are no data to justify using fluids that are less hypotonic than 0.45% sodium chloride solution." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/use-of-iv-syringe-to-draw-up-insulin> a dmo:Contraindication ;
    rdfs:label "Use of IV syringe to draw up insulin" ;
    dmo:contraCode "use-of-iv-syringe-to-draw-up-insulin" ;
    dmo:rationale "NEVER use an IV syringe to draw up insulin" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "Use of an IV syringe to draw up insulin" ;
    dmo:evidenceQuote "NEVER use an IV syringe to draw up insulin" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/contraindication/use-of-potassium-replacement-in-the-first-saline-1-hour-bag> a dmo:Contraindication ;
    rdfs:label "Use of potassium replacement in the first Saline (1 hour) bag" ;
    dmo:contraCode "use-of-potassium-replacement-in-the-first-saline-1-hour-bag" ;
    dmo:rationale "EXCEPT for the first Saline (1 hour) bag" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "Add potassium in the first Saline (1 hour) bag" ;
    dmo:evidenceQuote "EXCEPT for the first Saline (1 hour) bag" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/device/blood-gas-machine> a dmo:Device ;
    rdfs:label "Blood gas machine" ;
    dmo:deviceCode "blood-gas-machine" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Blood gas machine" ;
    dmo:evidenceQuote "Blood gas machines are readily available in almost all UK emergency departments. These are able to produce reliable measurements of pH, electrolytes, glucose etc., and should be used to frequently monitor progress and calculation of osmolality." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/device/blood-ketones> a dmo:Device ;
    rdfs:label "blood ketones" ;
    dmo:deviceCode "blood-ketones" ;
    dmo:deviceType "KetoneTestKit" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "blood ketones" ;
    dmo:evidenceQuote "Continue to monitor capillary ketones hourly" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/device/capillary-blood-ketone> a dmo:Device ;
    rdfs:label "Capillary Blood Ketone" ;
    dmo:deviceCode "capillary-blood-ketone" ;
    dmo:deviceType "KetoneTestKit" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Capillary Blood Ketone" ;
    dmo:evidenceQuote "Check capillary blood ketone hourly until HHS resolved" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/device/capillary-blood-ketones-finger-prick-point-of-care> a dmo:Device ;
    rdfs:label "Capillary blood ketones (finger prick point of care)" ;
    dmo:deviceCode "capillary-blood-ketones-finger-prick-point-of-care" ;
    dmo:deviceType "KetoneTestKit" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Capillary blood ketones (finger prick point of care)" ;
    dmo:evidenceQuote "Capillary blood ketones (finger prick point of care)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/device/capillary-glucose> a dmo:Device ;
    rdfs:label "capillary glucose" ;
    dmo:deviceCode "capillary-glucose" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "capillary glucose" ;
    dmo:evidenceQuote "Continue to monitor hourly capillary glucose during IV fluid replacement (use laboratory venous glucose if capillary reading ‘>28 mmol/L’ or ‘Hi’)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/device/continuous-cardiac-monitoring> a dmo:Device ;
    rdfs:label "Continuous cardiac monitoring" ;
    dmo:deviceCode "continuous-cardiac-monitoring" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Continuous cardiac monitoring" ;
    dmo:evidenceQuote "Consider continuous cardiac monitoring" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/device/continuous-pulse-oximetry> a dmo:Device ;
    rdfs:label "Continuous pulse oximetry" ;
    dmo:deviceCode "continuous-pulse-oximetry" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Continuous pulse oximetry" ;
    dmo:evidenceQuote "Continuous pulse oximetry" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/device/point-of-care-testing> a dmo:Device ;
    rdfs:label "Point of care testing" ;
    dmo:deviceCode "point-of-care-testing" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Point of care testing" ;
    dmo:evidenceQuote "Serum lactate and ketones must also be checked, usually using VBG and point of care testing. The former can indicate lactic acidosis related to e.g. sepsis, and the latter will exclude significant ketonaemia (ß-hydroxybutyrate <1.0 mmol/L)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/diabetesType/t1-dm> a dmo:DiabetesType ;
    rdfs:label "T1 DM" ;
    dmo:definition "Type 1 diabetes mellitus" ;
    dmo:diabetesTypeCode "t1-dm" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "T1 DM" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "T1 DM   Type 1 diabetes mellitus" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/diabetesType/t2-dm> a dmo:DiabetesType ;
    rdfs:label "T2 DM" ;
    dmo:definition "Type 2 diabetes mellitus" ;
    dmo:diabetesTypeCode "t2-dm" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0001524" ;
    dmo:name "T2 DM" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "T2 DM   Type 2 diabetes mellitus" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:definition "HHS often develops over many days, and consequently the dehydration and metabolic disturbances are usually more extreme. Many people with diabetes have severe but transient elevations of BG – the difference between this and HHS, being the duration of hyperglycaemia and the accompanying dehydration." ;
    dmo:diabetesTypeCode "type-2-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 2 Diabetes" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "HHS often develops over many days, and consequently the dehydration and metabolic disturbances are usually more extreme. Many people with diabetes have severe but transient elevations of BG – the difference between this and HHS, being the duration of hyperglycaemia and the accompanying dehydration." ;
    dmo:evidenceQuote "Hypercoagulability in patients with type 2 diabetes mellitus detected by a thrombin generation assay." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes-mellitus> a dmo:DiabetesType ;
    rdfs:label "Type 2 diabetes mellitus" ;
    dmo:definition "Hypercoagulability in patients with type 2 diabetes mellitus detected by a thrombin generation assay." ;
    dmo:diabetesTypeCode "type-2-diabetes-mellitus" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 2 diabetes mellitus" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "Hypercoagulability in patients with type 2 diabetes mellitus detected by a thrombin generation assay." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Intravenous" ;
    dmo:atcCode "A10AE01" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin is a hormone that lowers blood glucose by promoting glucose uptake into cells and inhibiting glucose production in the liver." ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "ONLY start IV insulin once fluid replacement is adequate and glucose concentrations have plateaued. Starting an IV insulin infusion too early could result in circulatory collapse" ;
    dmo:evidenceQuote "insulin treatment prior to adequate fluid replacement may result in cardiovascular collapse because water will move out of the intravascular space, resulting in a reduction in intravascular volume (a consequence of insulin-mediated glucose uptake and a diuresis from urinary glucose excretion) (see Figure 1)" ;
    dmo:evidenceQuote "ONLY commence intravenous insulin therapy IF patient has significant ketonaemia (blood ketones >3.0 mmol/L or ketonuria (urine ketones >2+) (see ACTION 3)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/drugClass/oral-glucose-lowering-drugs> a dmo:DrugClass ;
    rdfs:label "Oral Glucose Lowering Drugs" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA" ;
    dmo:drugClassCode "oral-glucose-lowering-drugs" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Oral glucose lowering drugs reduce blood glucose through various mechanisms including increasing insulin secretion, improving insulin sensitivity, or reducing glucose production." ;
    dmo:name "Oral Glucose Lowering Drugs" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "For those with previously undiagnosed diabetes or who were well controlled on oral agents, switching from insulin to the appropriate oral or subcutaneous glucose lowering drugs should be considered after a period of stability." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/drugClass/subcutaneous-insulin> a dmo:DrugClass ;
    rdfs:label "Subcutaneous Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE01" ;
    dmo:drugClassCode "subcutaneous-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin is a hormone that lowers blood glucose by promoting glucose uptake into cells and inhibiting glucose production in the liver." ;
    dmo:name "Subcutaneous Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Most people should be transferred to subcutaneous insulin (the regimen being determined by their circumstances)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/3ß-hydroxybutyrate> a dmo:LabTest ;
    rdfs:label "3ß-hydroxybutyrate" ;
    dmo:definition "A ketone body used to assess the severity of ketonaemia in hyperosmolar hyperglycemic state (HHS) and diabetic ketoacidosis (DKA)." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "3ß-hydroxybutyrate" ;
    dmo:loincCode "27020-0" ;
    dmo:name "3ß-hydroxybutyrate" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "If there is HHS and ketonaemia (blood ketones 3ß-hydroxybutyrate >1.0 - ≤3.0 mmol/L or urine ketones < 2+) and not acidotic (venous pH >7.3 and bicarbonate >15.0 mmol/L) then use 0.05 units/kg/hr" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/bicarbonate> a dmo:LabTest ;
    rdfs:label "Bicarbonate" ;
    dmo:definition "A measure of the bicarbonate concentration in the blood, used to assess metabolic acidosis or alkalosis." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "bicarbonate" ;
    dmo:loincCode "20757-4" ;
    dmo:name "Bicarbonate" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "bicarbonate >15.0 mmol/L" ;
    dmo:evidenceQuote "If there is HHS and ketonaemia (blood ketones 3ß-hydroxybutyrate >1.0 - ≤3.0 mmol/L or urine ketones < 2+) and not acidotic (venous pH >7.3 and bicarbonate >15.0 mmol/L) then use 0.05 units/kg/hr" ;
    dmo:evidenceQuote "venous pH >7.3 and bicarbonate >15.0 mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/blood-glucose> a dmo:LabTest ;
    rdfs:label "Blood Glucose" ;
    dmo:definition "The concentration of glucose in the blood, used to assess hyperglycaemia." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-glucose" ;
    dmo:loincCode "15540-5" ;
    dmo:name "Blood Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "marked hyperglycaemia (≥30 mmol/L)" ;
    dmo:evidenceQuote "Adjust insulin infusion rate hourly by 1 unit/hr increments or decrements to achieve desired BG" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/blood-ketones> a dmo:LabTest ;
    rdfs:label "Blood Ketones" ;
    dmo:definition "Blood ketones are measured to assess the presence of ketosis, particularly in distinguishing between hyperosmolar hyperglycemic state (HHS) and diabetic ketoacidosis (DKA)." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-ketones" ;
    dmo:loincCode "27012-1" ;
    dmo:name "Blood Ketones" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Scenario 1 - HHS and blood ketones <3.0 mmol/L and not acidotic" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/calculated-osmolality> a dmo:LabTest ;
    rdfs:label "Calculated Osmolality" ;
    dmo:definition "Calculated osmolality is determined using the formula [(2xNa+) + glucose + urea] and monitored hourly for the first 6 hours, then 2 hourly if response is satisfactory. The target rate of decline is 3.0-8.0 mOsm/kg/hr." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "calculated-osmolality" ;
    dmo:name "Calculated Osmolality" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mOsm/kg" ;
    dmo:evidenceQuote "monitoring regime appropriate to the individual – generally hourly blood glucose, Na+, K+, urea and calculated osmolality [(2xNa+) + glucose + urea] for the first 6 hours, then 2 hourly osmolality if the response is satisfactory (i.e. a fall of 3.0-8.0 mOsm/kg/hr)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/capillary-blood-glucose> a dmo:LabTest ;
    rdfs:label "Capillary Blood Glucose" ;
    dmo:definition "Capillary blood glucose (finger prick point of care)" ;
    dmo:labTestCode "capillary-blood-glucose" ;
    dmo:name "Capillary Blood Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "• Capillary blood glucose (BG) (finger prick point of care)" ;
    dmo:evidenceQuote "ACTION 2: INTRAVENOUS FLUID MANAGEMENT (Glucose regime) Once CBG<14.0 mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/capillary-blood-ketones> a dmo:LabTest ;
    rdfs:label "Capillary Blood Ketones" ;
    dmo:definition "Capillary blood ketones (finger prick point of care)" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "capillary-blood-ketones" ;
    dmo:name "Capillary Blood Ketones" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "• Capillary blood ketones (finger prick point of care)" ;
    dmo:evidenceQuote "Check capillary blood ketone hourly until HHS resolved" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/capillary-glucose> a dmo:LabTest ;
    rdfs:label "Capillary Glucose" ;
    dmo:definition "Capillary glucose is monitored hourly during intravenous fluid replacement to guide insulin therapy in hyperosmolar hyperglycemic state (HHS)." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "capillary-glucose" ;
    dmo:loincCode "15577-6" ;
    dmo:name "Capillary Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Continue to monitor hourly capillary glucose during IV fluid replacement" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/creatinine> a dmo:LabTest ;
    rdfs:label "Creatinine" ;
    dmo:definition "Check creatinine, electrolyte and venous bicarbonate and pH at 1-2 hours then 2 to 4 hourly until osmolality normalised" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "creatinine" ;
    dmo:name "Creatinine" ;
    dmo:unitOfMeasure "μmol/L" ;
    dmo:evidenceQuote "Check creatinine, electrolyte and venous bicarbonate and pH at 1-2 hours then 2 to 4 hourly until osmolality normalised" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/electrolyte> a dmo:LabTest ;
    rdfs:label "Electrolyte" ;
    dmo:definition "Check creatinine, electrolyte and venous bicarbonate and pH at 1-2 hours then 2 to 4 hourly until osmolality normalised" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "electrolyte" ;
    dmo:name "Electrolyte" ;
    dmo:evidenceQuote "Check creatinine, electrolyte and venous bicarbonate and pH at 1-2 hours then 2 to 4 hourly until osmolality normalised" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/glucose> a dmo:LabTest ;
    rdfs:label "Glucose" ;
    dmo:definition "Blood glucose concentration is monitored hourly to guide fluid and insulin therapy in HHS. The target is to maintain glucose between 10-15 mmol/L in the first 24 hours and avoid falling below 14 mmol/L, which triggers glucose infusion." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "glucose" ;
    dmo:name "Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Measure glucose, urea and electrolytes hourly and calculate osmolality [(2xNa+) + glucose + urea]" ;
    dmo:evidenceQuote "Marked hyperglcaemia (>30.0 mmol/L)" ;
    dmo:evidenceQuote "ACTION 2: INTRAVENOUS FLUID MANAGEMENT (Glucose regime) Once CBG<14.0 mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/ketone> a dmo:LabTest ;
    rdfs:label "Ketone" ;
    dmo:definition "Without significant hyperketonaemia (<3.0 mmol/L)" ;
    dmo:labTestCode "ketone" ;
    dmo:name "Ketone" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Without significant hyperketonaemia (<3.0 mmol/L)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/ketone-concentrations> a dmo:LabTest ;
    rdfs:label "Ketone Concentrations" ;
    dmo:definition "Ketone concentrations are checked hourly until HHS resolution to monitor for the presence of ketosis, which is less common in HHS than DKA but still requires monitoring." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "ketone-concentrations" ;
    dmo:name "Ketone Concentrations" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Check ketone concentrations hourly until HHS resolution" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/measured-or-calculated-serum-osmolality> a dmo:LabTest ;
    rdfs:label "Measured or Calculated Serum Osmolality" ;
    dmo:definition "Measured or calculated serum osmolality [(2xNa+) + glucose + urea]. Until the urea is available, calculate using (2xNa+ + glucose). Recalculate osmolality once urea is available, and then use (2xNa+ + glucose + urea)." ;
    dmo:labTestCode "measured-or-calculated-serum-osmolality" ;
    dmo:name "Measured or Calculated Serum Osmolality" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mOsm/kg" ;
    dmo:evidenceQuote "• Measured or calculated serum osmolality [(2xNa+) + glucose + urea]. Until the urea is available, calculate using (2xNa+ + glucose). Recalculate osmolality once urea is available, and then use (2xNa+ + glucose + urea)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/osmolality> a dmo:LabTest ;
    rdfs:label "Osmolality" ;
    dmo:definition "A measure of the concentration of solutes in the blood, calculated as (2Na+) + glucose + urea, used to monitor the response to treatment and avoid sudden osmotic shifts in HHS." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "osmolality" ;
    dmo:loincCode "1751-7" ;
    dmo:name "Osmolality" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mOsm/kg" ;
    dmo:evidenceQuote "measure or calculate osmolality [(2Na+) + glucose + urea] every hour for the first 6 hours, then 2 hourly for the next 6 hours to monitor the response to treatment and to avoid sudden osmotic shifts" ;
    dmo:evidenceQuote "Osmolality (mOsm/kg) = (2xNa+) + glucose + urea" ;
    dmo:evidenceQuote "Check creatinine, electrolyte and venous bicarbonate and pH at 1-2 hours then 2 to 4 hourly until osmolality normalised" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/ph> a dmo:LabTest ;
    rdfs:label "pH" ;
    dmo:definition "Without significant acidosis (pH>7.3)" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "ph" ;
    dmo:name "pH" ;
    dmo:evidenceQuote "Without significant acidosis (pH>7.3)" ;
    dmo:evidenceQuote "Check creatinine, electrolyte and venous bicarbonate and pH at 1-2 hours then 2 to 4 hourly until osmolality normalised" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/potassium> a dmo:LabTest ;
    rdfs:label "Potassium" ;
    dmo:definition "Potassium concentration is monitored to maintain normal range. Hypokalaemia (<3.5 mmol/L) and hyperkalaemia (>6.0 mmol/L) are life-threatening and require senior review. Potassium replacement is adjusted based on serum levels." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "potassium" ;
    dmo:name "Potassium" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Maintain potassium in the normal range o Hypokalaemia (<3.5 mmol/L) and hyperkalaemia (>6.0 mmol/L) are life threatening conditions and warrant senior review." ;
    dmo:evidenceQuote "People with HHS are usually potassium depleted but potassium shifts are less pronounced than those with DKA because they are less acidotic. The differences are driven largely by the lack of insulin in DKA. In addition, the FRIII rate is lower, and there is often co-existing renal impairment." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/serum-lactate> a dmo:LabTest ;
    rdfs:label "Serum Lactate" ;
    dmo:definition "A marker that can indicate lactic acidosis related to conditions such as sepsis, often checked in the context of HHS." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "serum-lactate" ;
    dmo:loincCode "15543-5" ;
    dmo:name "Serum Lactate" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Serum lactate and ketones must also be checked, usually using VBG and point of care testing. The former can indicate lactic acidosis related to e.g. sepsis, and the latter will exclude significant ketonaemia (ß-hydroxybutyrate <1.0 mmol/L)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/serum-osmolality> a dmo:LabTest ;
    rdfs:label "Serum Osmolality" ;
    dmo:definition "A measure of the concentration of solutes in the blood, used to assess the osmotic balance in the body." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "serum-osmolality" ;
    dmo:loincCode "20754-1" ;
    dmo:name "Serum Osmolality" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mOsm/kg" ;
    dmo:evidenceQuote "measured or calculated serum osmolality usually ≥320 mOsm/kg" ;
    dmo:evidenceQuote "Serum osmolality is often provided in biochemistry reports, either calculated or measured, but can be calculated using the formula [(2xNa+) + glucose + urea]." ;
    dmo:evidenceQuote "The key parameter in HHS that needs to be taken into account is osmolality. Sodium and glucose are the main contributors to this, and too rapid changes are dangerous because large fluid shifts can lead to neurological complications, in particular cerebral oedema and CPM/osmotic demyelination." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/serum-sodium> a dmo:LabTest ;
    rdfs:label "Serum Sodium" ;
    dmo:definition "Serum sodium concentration, used in osmolality calculation and monitoring during HHS management." ;
    dmo:labTestCode "serum-sodium" ;
    dmo:name "Serum Sodium" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Elevated osmolality ≥320 mOsm/kg - Calculate osmolality using the equation: (2xNa+) + glucose + urea" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/sodium> a dmo:LabTest ;
    rdfs:label "Sodium" ;
    dmo:definition "Plasma sodium concentration is monitored to assess the rate of osmolality change and guide fluid therapy. Sodium is measured hourly in the first 6 hours and 2 hourly thereafter." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "sodium" ;
    dmo:name "Sodium" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Measure glucose, urea and electrolytes hourly and calculate osmolality [(2xNa+) + glucose + urea]" ;
    dmo:evidenceQuote "Osmolality (mOsm/kg) = (2xNa+) + glucose + urea" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/urea> a dmo:LabTest ;
    rdfs:label "Urea" ;
    dmo:definition "Urea concentration is measured hourly in the first 6 hours and used in the calculation of serum osmolality [(2xNa+) + glucose + urea]." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urea" ;
    dmo:name "Urea" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Measure glucose, urea and electrolytes hourly and calculate osmolality [(2xNa+) + glucose + urea]" ;
    dmo:evidenceQuote "Osmolality (mOsm/kg) = (2xNa+) + glucose + urea" ;
    dmo:evidenceQuote "Elevated osmolality ≥320 mOsm/kg - Calculate osmolality using the equation: (2xNa+) + glucose + urea" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/urea-and-electrolytes> a dmo:LabTest ;
    rdfs:label "Urea and Electrolytes" ;
    dmo:definition "Daily assessment of urea and electrolytes is recommended to monitor renal function and electrolyte balance." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urea-and-electrolytes" ;
    dmo:name "Urea and Electrolytes" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "Daily urea and electrolytes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/urinalysis-and-culture> a dmo:LabTest ;
    rdfs:label "Urinalysis and Culture" ;
    dmo:definition "Urinalysis and culture" ;
    dmo:labTestCode "urinalysis-and-culture" ;
    dmo:name "Urinalysis and Culture" ;
    dmo:specimen "Urine" ;
    dmo:evidenceQuote "• Urinalysis and culture" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/urine-ketones> a dmo:LabTest ;
    rdfs:label "Urine Ketones" ;
    dmo:definition "A test used to exclude significant ketonaemia, particularly in the context of HHS, where ketone levels should be below 1.0 mmol/L (as ß-hydroxybutyrate)." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-ketones" ;
    dmo:loincCode "15544-3" ;
    dmo:name "Urine Ketones" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "trace to 4+" ;
    dmo:evidenceQuote "Serum lactate and ketones must also be checked, usually using VBG and point of care testing. The former can indicate lactic acidosis related to e.g. sepsis, and the latter will exclude significant ketonaemia (ß-hydroxybutyrate <1.0 mmol/L)." ;
    dmo:evidenceQuote "FRIII should NOT be started as part of the initial treatment unless significant ketonaemia is present – i.e. > 3.0 mmol/L or urine ketones > 2+." ;
    dmo:evidenceQuote "If there is HHS and ketonaemia (blood ketones 3ß-hydroxybutyrate >1.0 - ≤3.0 mmol/L or urine ketones < 2+) and not acidotic (venous pH >7.3 and bicarbonate >15.0 mmol/L) then use 0.05 units/kg/hr" ;
    dmo:evidenceQuote "Scenario 2 – HHS and blood ketones >1.0 mmol/L (urine ketones >2+)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/venous-bicarbonate> a dmo:LabTest ;
    rdfs:label "Venous Bicarbonate" ;
    dmo:definition "Check creatinine, electrolyte and venous bicarbonate and pH at 1-2 hours then 2 to 4 hourly until osmolality normalised" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-bicarbonate" ;
    dmo:name "Venous Bicarbonate" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Check creatinine, electrolyte and venous bicarbonate and pH at 1-2 hours then 2 to 4 hourly until osmolality normalised" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/venous-blood-gas> a dmo:LabTest ;
    rdfs:label "Venous Blood Gas" ;
    dmo:definition "Venous blood gas (VBG) for: pH, bicarbonate, lactate, and electrolytes" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-blood-gas" ;
    dmo:loincCode "15542-7" ;
    dmo:name "Venous Blood Gas" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "• Venous blood gas (VBG) for: pH, bicarbonate, lactate, and electrolytes" ;
    dmo:evidenceQuote "Blood gas machines are readily available in almost all UK emergency departments. These are able to produce reliable measurements of pH, electrolytes, glucose etc., and should be used to frequently monitor progress and calculation of osmolality." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/venous-glucose> a dmo:LabTest ;
    rdfs:label "Venous Glucose" ;
    dmo:definition "Venous glucose is used as a reference when capillary glucose readings are ' >28 mmol/L' or 'Hi'." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-glucose" ;
    dmo:loincCode "15578-4" ;
    dmo:name "Venous Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "use laboratory venous glucose if capillary reading ‘>28 mmol/L’ or ‘Hi’" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/venous-ph> a dmo:LabTest ;
    rdfs:label "Venous pH" ;
    dmo:definition "The acidity or alkalinity of venous blood, used to assess acid-base balance." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-ph" ;
    dmo:loincCode "20756-6" ;
    dmo:name "Venous pH" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "dimensionless" ;
    dmo:evidenceQuote "venous pH >7.3 and bicarbonate >15.0 mmol/L" ;
    dmo:evidenceQuote "If there is HHS and ketonaemia (blood ketones 3ß-hydroxybutyrate >1.0 - ≤3.0 mmol/L or urine ketones < 2+) and not acidotic (venous pH >7.3 and bicarbonate >15.0 mmol/L) then use 0.05 units/kg/hr" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/labTest/venous-plasma-glucose> a dmo:LabTest ;
