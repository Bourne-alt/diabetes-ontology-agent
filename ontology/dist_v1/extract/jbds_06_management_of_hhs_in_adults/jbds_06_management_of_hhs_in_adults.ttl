<https://example.org/dmo/id/recommendation/discharge-hhs-patients-with-a-written-care-plan> a dmo:Recommendation ;
    rdfs:label "Discharge HHS Patients with a Written Care Plan" ;
    dmo:populationScope "Adults admitted with HHS" ;
    dmo:recommendationId "discharge-hhs-patients-with-a-written-care-plan" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "People admitted to hospital with HHS should be discharged with a written care plan: a process that allows the person with diabetes to have active involvement in deciding, agreeing and owning how their diabetes is managed. This should be copied to the GP" ;
    dmo:evidenceQuote "People admitted to hospital with HHS should be discharged with a written care plan: a process that allows the person with diabetes to have active involvement in deciding, agreeing and owning how their diabetes is managed. This should be copied to the GP" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/recommendation/do-not-start-friii-at-initial-treatment-unless-significant-ketonaemia-is-present> a dmo:Recommendation ;
    rdfs:label "Do not start FRIII at initial treatment unless significant ketonaemia is present" ;
    dmo:recommendationId "do-not-start-friii-at-initial-treatment-unless-significant-ketonaemia-is-present" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "A FRIII should NOT be started as part of the initial treatment unless significant ketonaemia is present – i.e. > 3.0 mmol/L or urine ketones > 2+." ;
    dmo:evidenceQuote "A FRIII should NOT be started as part of the initial treatment unless significant ketonaemia is present – i.e. > 3.0 mmol/L or urine ketones > 2+." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/recommendation/do-not-start-iv-insulin-until-fluid-replacement-is-adequate> a dmo:Recommendation ;
