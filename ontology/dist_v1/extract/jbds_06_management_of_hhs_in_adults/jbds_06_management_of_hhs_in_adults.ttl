<https://example.org/dmo/id/complication/acute-kidney-injury> a dmo:Complication ;
    rdfs:label "Acute Kidney Injury" ;
    dmo:affectedOrgan "Kidney" ;
    dmo:complicationCode "acute-kidney-injury" ;
    dmo:definition "acute kidney injury" ;
    dmo:isEmergency "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005074" ;
    dmo:name "Acute Kidney Injury" ;
    dmo:onsetPattern "Acute" ;
    dmo:evidenceQuote "This may be due to a number of things, including but not limited to: cerebral oedema in severe cases, presence of significant electrolyte disturbances, acute changes in osmolality, dehydration, infection/sepsis, hypoglycaemia during treatment, or kidney injury." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/complication/central-extra-pontine-myelinolysis> a dmo:Complication ;
    rdfs:label "Central/Extra Pontine Myelinolysis" ;
    dmo:affectedOrgan "Brain" ;
    dmo:complicationCode "central-extra-pontine-myelinolysis" ;
    dmo:definition "A neurological disorder characterized by demyelination of the central and extra-pontine regions of the brain, often associated with rapid correction of serum sodium in hyperosmolar states." ;
    dmo:isEmergency "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005071" ;
    dmo:name "Central/Extra Pontine Myelinolysis" ;
    dmo:onsetPattern "Acute" ;
    dmo:evidenceQuote "Assess for complications of treatment e.g. fluid overload, cerebral oedema, cerebral pontine myelinolysis (e.g. deteriorating conscious level)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/complication/central-pontine-myelinolysis> a dmo:Complication ;
    rdfs:label "Central Pontine Myelinolysis" ;
    dmo:affectedOrgan "Brain" ;
    dmo:complicationCode "central-pontine-myelinolysis" ;
