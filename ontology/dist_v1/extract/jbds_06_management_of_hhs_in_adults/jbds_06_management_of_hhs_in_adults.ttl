<https://example.org/dmo/id/recommendation/use-of-crystalloid-fluids-over-colloid-in-critically-ill-individuals> a dmo:Recommendation ;
    rdfs:label "Use of crystalloid fluids over colloid in critically ill individuals" ;
    dmo:gradingSystem "Cochrane review" ;
    dmo:nativeEvidenceGrade "39" ;
    dmo:populationScope "critically ill individuals" ;
    dmo:recommendationId "use-of-crystalloid-fluids-over-colloid-in-critically-ill-individuals" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "A Cochrane review recommended use of crystalloid fluids rather than colloid in critically ill individuals because use of crystalloids is associated with less need for further interventions." ;
    dmo:evidenceQuote "However, a Cochrane review recommended use of crystalloid fluids rather than colloid in critically ill individuals because use of crystalloids is associated with less need for further interventions (39)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/recommendation/use-of-point-of-care-testing-in-hhs> a dmo:Recommendation ;
    rdfs:label "Use of Point of Care Testing in HHS" ;
    dmo:gradingSystem "Unknown" ;
    dmo:populationScope "People with HHS in UK emergency departments" ;
    dmo:recommendationId "use-of-point-of-care-testing-in-hhs" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Blood gas machines are readily available in almost all UK emergency departments. These are able to produce reliable measurements of pH, electrolytes, glucose etc., and should be used to frequently monitor progress and calculation of osmolality." ;
    dmo:evidenceQuote "Blood gas machines are readily available in almost all UK emergency departments. These are able to produce reliable measurements of pH, electrolytes, glucose etc., and should be used to frequently monitor progress and calculation of osmolality." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/recommendation/use-of-venous-samples-in-hhs-monitoring> a dmo:Recommendation ;
    rdfs:label "Use of Venous Samples in HHS Monitoring" ;
    dmo:gradingSystem "Unknown" ;
    dmo:populationScope "People with HHS in UK emergency departments" ;
    dmo:recommendationId "use-of-venous-samples-in-hhs-monitoring" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Unless it is necessary to also measure oxygen saturation, venous rather than arterial samples are sufficient." ;
    dmo:evidenceQuote "Unless it is necessary to also measure oxygen saturation, venous rather than arterial samples are sufficient." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/riskFactor/diabetes> a dmo:RiskFactor ;
    rdfs:label "Diabetes" ;
    dmo:evidenceNote "糖尿病是HHS的基础疾病，属于不可干预的固有风险因素。" ;
    dmo:name "Diabetes" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "diabetes" ;
    dmo:evidenceQuote "Having diabetes is associated with an increased risk of developing venous thromboembolic disease (VTE) (44)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/riskFactor/hyperglycaemia> a dmo:RiskFactor ;
    rdfs:label "Hyperglycaemia" ;
    dmo:evidenceNote "文档中提到高血糖与HHS相关，且HHS患者有高风险发生静脉血栓栓塞症（VTE），提示高血糖是可干预的风险因素。" ;
    dmo:name "Hyperglycaemia" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "hyperglycaemia" ;
    dmo:evidenceQuote "Having diabetes is associated with an increased risk of developing venous thromboembolic disease (VTE) (44). People with HHS have an increased risk of arterial and VTE (45; 46). A study of hyperglycaemia (not necessarily with HHS) during COVID-19 admissions suggested that the risk of arterial and VTE was three times higher than those without hyperglycaemia (47)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/riskFactor/hypernatraemia> a dmo:RiskFactor ;
    rdfs:label "Hypernatraemia" ;
    dmo:evidenceNote "高钠血症可促进血栓形成，是HHS患者中可干预的危险因素。" ;
    dmo:name "Hypernatraemia" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "hypernatraemia" ;
    dmo:evidenceQuote "Other factors, such as hypernatraemia and increasing vasopressin concentrations can promote thrombogenesis by producing changes in haemostatic function consistent with a hypercoagulable state (52)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/riskFactor/hyperosmolality> a dmo:RiskFactor ;
    rdfs:label "Hyperosmolality" ;
    dmo:evidenceNote "高渗透压是HHS的核心特征，与糖尿病相关，可通过纠正高血糖和脱水来干预。" ;
    dmo:name "Hyperosmolality" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "hyperosmolality" ;
    dmo:evidenceQuote "Other work has estimated that people with diabetes and hyperosmolality have a risk of VTE similar, or only marginally above those with acute renal failure, acute sepsis or acute connective tissue disease (48; 49)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

<https://example.org/dmo/id/riskFactor/increasing-vasopressin-concentrations> a dmo:RiskFactor ;
    rdfs:label "Increasing Vasopressin Concentrations" ;
    dmo:evidenceNote "血管加压素浓度升高可促进血栓形成，是HHS患者中可干预的危险因素。" ;
    dmo:name "Increasing Vasopressin Concentrations" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "increasing-vasopressin-concentrations" ;
    dmo:evidenceQuote "Other factors, such as hypernatraemia and increasing vasopressin concentrations can promote thrombogenesis by producing changes in haemostatic function consistent with a hypercoagulable state (52)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

