<https://example.org/dmo/id/recommendation/potassium-replacement-based-on-concentration> a dmo:Recommendation ;
    rdfs:label "Potassium replacement based on concentration" ;
    dmo:recommendationId "potassium-replacement-based-on-concentration" ;
