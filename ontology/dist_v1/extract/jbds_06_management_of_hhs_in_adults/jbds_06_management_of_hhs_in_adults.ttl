<https://example.org/dmo/id/recommendation/only-commence-insulin-infusion-quickly-in-the-following-circumstances> a dmo:Recommendation ;
    rdfs:label "Only commence insulin infusion quickly in the following circumstances" ;
    dmo:recommendationId "only-commence-insulin-infusion-quickly-in-the-following-circumstances" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "ONLY commence insulin infusion quickly in the following circumstances: If there is HHS and ketonaemia (blood ketones 3ß-hydroxybutyrate >1.0 - ≤3.0 mmol/L or urine ketones < 2+) and not acidotic (venous pH >7.3 and bicarbonate >15.0 mmol/L) then use 0.05 units/kg/hr OR If there is significant ketonaemia (3ß-hydroxybutyrate >3.0 mmol/L) or ketonuria (≥ 2+) with a pH <7.3 and bicarbonate <15 mmol/L (i.e. mixed DKA and HHS) then use the DKA guidelines at 0.1 units/kg/hr" ;
    dmo:evidenceQuote "ONLY commence insulin infusion quickly in the following circumstances: o If there is HHS and ketonaemia (blood ketones 3ß-hydroxybutyrate >1.0 - ≤3.0 mmol/L or urine ketones < 2+) and not acidotic (venous pH >7.3 and bicarbonate >15.0 mmol/L) then use 0.05 units/kg/hr OR o If there is significant ketonaemia (3ß-hydroxybutyrate >3.0 mmol/L) or ketonuria (≥ 2+) with a pH <7.3 and bicarbonate <15 mmol/L (i.e. mixed DKA and HHS) then use the DKA guidelines at 0.1 units/kg/hr" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_06_management_of_hhs_in_adults> .

