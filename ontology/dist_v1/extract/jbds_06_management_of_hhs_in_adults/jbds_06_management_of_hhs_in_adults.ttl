    dmo:contraCode "excessive-fluid-replacement-in-patients-with-pre-existing-heart-and-renal-disease" ;
    dmo:rationale "More cautious fluid replacement is necessary e.g. 0.25 ml/kg/hr as recommended by NICE (13)" ;
