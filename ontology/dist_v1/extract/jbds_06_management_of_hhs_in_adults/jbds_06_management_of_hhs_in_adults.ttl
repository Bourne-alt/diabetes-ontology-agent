    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "ALL ADULT (over 18 years) patients with a diagnosis of HHS" ;
    dmo:recommendationId "use-of-0-45-n-saline-in-hhs" ;
