<https://example.org/dmo/id/recommendation/rise-in-serum-sodium-due-to-fall-in-glucose-is-not-necessarily-an-indication-to-give-hypotonic-solutions> a dmo:Recommendation ;
    rdfs:label "Rise in serum sodium due to fall in glucose is not necessarily an indication to give hypotonic solutions" ;
