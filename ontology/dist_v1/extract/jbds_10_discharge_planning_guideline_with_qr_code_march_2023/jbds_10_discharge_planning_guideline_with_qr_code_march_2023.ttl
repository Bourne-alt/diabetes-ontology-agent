<https://example.org/dmo/id/diabetesType/type-1-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 1 Diabetes" ;
    dmo:definition "People who have been living with type 1 diabetes for many years and are becoming increasingly frail, (particularly if admission is related to struggles with diabetes management at home)." ;
    dmo:diabetesTypeCode "type-1-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 1 Diabetes" ;
    dmo:prevalenceShare "0.1"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "People who have been living with type 1 diabetes for many years and are becoming increasingly frail, (particularly if admission is related to struggles with diabetes management at home)." ;
    dmo:evidenceQuote "COVID-19 disease can: \n  Cause severe insulin resistance and insulin deficiency precipitating DKA in people with type 1 diabetes and unusually also in those with type 2 diabetes" ;
    dmo:evidenceQuote "all people with type 1 diabetes; people with type 2 diabetes and history of DKA" ;
    dmo:evidenceQuote "safe management of diabetes during intercurrent illness, insulin dose adjustment, monitoring, blood ketone testing for patients with type 1 diabetes or ketosis-prone type 2 diabetes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:definition "Type 2 Diabetes is characterized by insulin resistance and relative insulin deficiency. It is the most common form of diabetes, typically developing in adults, although it is increasingly seen in younger populations due to rising obesity rates." ;
    dmo:diabetesTypeCode "type-2-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "Type 2 Diabetes" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "COVID-19 disease can: \n  Cause severe insulin resistance and insulin deficiency precipitating DKA in people with type 1 diabetes and unusually also in those with type 2 diabetes" ;
    dmo:evidenceQuote "all people with type 1 diabetes; people with type 2 diabetes and history of DKA" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/drugClass/dpp-4-inhibitors> a dmo:DrugClass ;
    rdfs:label "DPP-4 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BH" ;
    dmo:drugClassCode "dpp-4-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibits the enzyme DPP-4, increasing levels of incretin hormones that stimulate insulin release" ;
    dmo:name "DPP-4 inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "› Other diabetes medications, including DPP-4 inhibitors, GLP-1 agonists and pioglitazone should be reviewed prior to discharge (where possible discuss with the diabetes team) or as soon as possible following discharge (by GP or usual care provider)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/drugClass/glp-1-agonists> a dmo:DrugClass ;
    rdfs:label "GLP-1 agonists" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10BX" ;
    dmo:drugClassCode "glp-1-agonists" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Activates GLP-1 receptors, enhancing glucose-dependent insulin secretion and suppressing glucagon release" ;
    dmo:name "GLP-1 agonists" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "› Other diabetes medications, including DPP-4 inhibitors, GLP-1 agonists and pioglitazone should be reviewed prior to discharge (where possible discuss with the diabetes team) or as soon as possible following discharge (by GP or usual care provider)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/drugClass/glucagon-like-peptide-1-glp-1-injectable> a dmo:DrugClass ;
    rdfs:label "Glucagon-like peptide 1 (GLP 1) injectable" ;
    dmo:drugClassCode "glucagon-like-peptide-1-glp-1-injectable" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Mode of action, dosing, frequency, injection technique, injection sites, side-effects, timing" ;
    dmo:name "Glucagon-like peptide 1 (GLP 1) injectable" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "Glucagon-like peptide 1 (GLP 1) injectable - mode of action, dosing, frequency, injection technique, injection sites, side-effects, timing" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10A" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin is a hormone that lowers blood glucose levels by promoting glucose uptake into cells and inhibiting glucose production in the liver." ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Hypoglycaemia avoidance (For people taking Insulin or sulphonylureas)" ;
    dmo:evidenceQuote "Person is unable to self-administer insulin safely as they: \n › Have a cognitive impairment e.g. learning disability, dementia\n › Have a risk issue e.g. recent self-harm, suicidal intent, severe \n mental health issues\n › Have visual impairment or dexterity issues" ;
    dmo:evidenceQuote "Insulin action – endogenous and exogenous effects on blood glucose, injection technique, storage of insulin, getting supplies of insulin, carbohydrate counting in relation to dose adjustments if appropriate" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/drugClass/metformin> a dmo:DrugClass ;
    rdfs:label "Metformin" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA01" ;
    dmo:drugClassCode "metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Decreases hepatic glucose production and improves insulin sensitivity" ;
    dmo:name "Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "› Metformin – can be reintroduced when person is clinically well, eGFR >30ml/min and lactate normal." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

