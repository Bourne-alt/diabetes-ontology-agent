<https://example.org/dmo/id/drugClass/pioglitazone> a dmo:DrugClass ;
    rdfs:label "Pioglitazone" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA02" ;
    dmo:drugClassCode "pioglitazone" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Improves insulin sensitivity in peripheral tissues by activating PPAR-gamma receptors" ;
    dmo:name "Pioglitazone" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "› Other diabetes medications, including DPP-4 inhibitors, GLP-1 agonists and pioglitazone should be reviewed prior to discharge (where possible discuss with the diabetes team) or as soon as possible following discharge (by GP or usual care provider)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/drugClass/sglt-2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT-2 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "sglt-2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibits sodium-glucose co-transporter 2 in the kidneys, leading to increased urinary glucose excretion and lower blood glucose levels." ;
    dmo:name "SGLT-2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "SGLT-2 inhibitors – advise people to stop this class of drugs which include dapagliflozin, canagliflozin, empagliflozin and ertugliflozin or their combination tablets, as soon as they become unwell for whatever reason and seek urgent support from the GP , Practice Nurse or Diabetes Specialist Team (18). Ensure these medications are either recommenced on discharge or that both the person with diabetes and the usual diabetes care provider have written information about when/how to reintroduce the SGLT-2 inhibitor." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/drugClass/sglt2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT2 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BJ" ;
    dmo:drugClassCode "sglt2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibits glucose reabsorption in the kidneys, leading to increased urinary glucose excretion" ;
    dmo:name "SGLT2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "› SGLT2 inhibitors - drugs ending in “-flozin” – do NOT use if person has had DKA. Ensure person is eating and drinking before restarting and remind the person of ‘Sick day rules’ as SGLT2 inhibitors should be temporarily stopped during any illness causing dehydration." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/drugClass/sulphonylureas> a dmo:DrugClass ;
    rdfs:label "Sulphonylureas" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10B" ;
    dmo:drugClassCode "sulphonylureas" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Sulphonylureas stimulate insulin secretion from pancreatic beta cells, thereby lowering blood glucose levels." ;
    dmo:name "Sulphonylureas" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Hypoglycaemia avoidance (For people taking Insulin or sulphonylureas)" ;
    dmo:evidenceQuote "› Sulphonylureas e.g. Gliclazide, Glimepiride – may have been stopped temporarily during acute illness because of risk of hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/labTest/blood-ketone-test-strips> a dmo:LabTest ;
