<https://example.org/dmo/id/contraindication/sglt-2-inhibitors-during-illness> a dmo:Contraindication ;
    rdfs:label "SGLT-2 inhibitors during illness" ;
    dmo:contraCode "sglt-2-inhibitors-during-illness" ;
    dmo:rationale "to prevent development of any diabetes crises such as diabetic ketoacidosis (DKA) or hyperosmolar hyperglycaemic state (HHS) secondary to hyperglycaemia" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "as soon as they become unwell for whatever reason" ;
    dmo:evidenceQuote "SGLT-2 inhibitors – advise people to stop this class of drugs which include dapagliflozin, canagliflozin, empagliflozin and ertugliflozin or their combination tablets, as soon as they become unwell for whatever reason and seek urgent support from the GP , Practice Nurse or Diabetes Specialist Team (18)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

<https://example.org/dmo/id/contraindication/sglt2-inhibitors-drugs-ending-in-flozin> a dmo:Contraindication ;
    rdfs:label "SGLT2 inhibitors - drugs ending in “-flozin”" ;
    dmo:contraCode "sglt2-inhibitors-drugs-ending-in-flozin" ;
    dmo:rationale "SGLT2 inhibitors should be temporarily stopped during any illness causing dehydration" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "if person has had DKA" ;
    dmo:evidenceQuote "SGLT2 inhibitors - drugs ending in “-flozin” – do NOT use if person has had DKA." ;
    dmo:evidenceQuote "Be cautious when eGFR is persistently below 45ml/min, and seek specialist advice when unsure." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_10_discharge_planning_guideline_with_qr_code_march_2023> .

