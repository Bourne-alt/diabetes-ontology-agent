<https://example.org/dmo/id/complication/diabetic-ketoacidosis> a dmo:Complication ;
    rdfs:label "Diabetic Ketoacidosis" ;
    dmo:affectedOrgan "Systemic" ;
    dmo:complicationCode "diabetic-ketoacidosis" ;
    dmo:definition "DKA is a serious complication of diabetes that can be life-threatening. DKA is most common among people with type 1 diabetes. People with type 2 diabetes can also develop DKA." ;
    dmo:isEmergency "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005040" ;
    dmo:name "Diabetic Ketoacidosis" ;
    dmo:onsetPattern "Acute" ;
    dmo:evidenceQuote "DKA is a serious complication of diabetes that can be life-threatening. DKA is most common among people with type 1 diabetes. People with type 2 diabetes can also develop DKA." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/cdc-diabetic-ketoacidosis> .

