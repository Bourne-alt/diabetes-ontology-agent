<https://example.org/dmo/id/recommendation/use-of-cgm-or-smbg-to-prevent-hypoglycemia-and-improve-glycemic-control-when-using-hypoglycemia-risk-therapies> a dmo:Recommendation ;
    rdfs:label "Use of CGM or SMBG to prevent hypoglycemia and improve glycemic control when using hypoglycemia-risk therapies" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "people with diabetes and CKD, especially those with T1D and those treated with CKD G4–G5 including treatment by dialysis or kidney transplant" ;
    dmo:recommendationId "use-of-cgm-or-smbg-to-prevent-hypoglycemia-and-improve-glycemic-control-when-using-hypoglycemia-risk-therapies" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Daily glycemic monitoring with CGM or self-monitoring of blood glucose (SMBG) may help prevent hypoglycemia and improve glycemic control when glucose-lowering therapies associated with risk of hypoglycemia are used." ;
    dmo:evidenceQuote "Daily glycemic monitoring with CGM or self-monitoring of blood glucose (SMBG) may help prevent hypoglycemia and improve glycemic control when glucose-lowering therapies associated with risk of hypoglycemia are used." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/recommendation/use-of-glucose-management-indicator-gmi-from-cgm-data-when-hba1c-is-not-concordant-with-blood-glucose-or-symptoms> a dmo:Recommendation ;
