<https://example.org/dmo/id/lifestyleIntervention/physical-activity> a dmo:LifestyleIntervention ;
    rdfs:label "Physical activity" ;
    dmo:activityTarget "low-intensity activity and increase intensity as tolerated" ;
    dmo:expectedBenefit "reduce risk of CKD progression and major CVD events, especially heart failure" ;
