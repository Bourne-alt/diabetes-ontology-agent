<https://example.org/dmo/id/contraindication/glp-1-ra-not-used-in-combination-with-dpp-4-inhibitors> a dmo:Contraindication ;
    rdfs:label "GLP-1 RA not used in combination with DPP-4 inhibitors" ;
    dmo:contraCode "glp-1-ra-not-used-in-combination-with-dpp-4-inhibitors" ;
