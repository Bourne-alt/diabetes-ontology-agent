<https://example.org/dmo/id/lifestyleIntervention/moderate-intensity-physical-activity> a dmo:LifestyleIntervention ;
    rdfs:label "Moderate-intensity physical activity" ;
    dmo:activityTarget "a cumulative duration of at least 150 minutes per week, or to a level compatible with their cardiovascular and physical tolerance" ;
    dmo:expectedBenefit "cardiometabolic, kidney, and cognitive benefits; better overall well-being and quality of life" ;
    dmo:interventionCode "moderate-intensity-physical-activity" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "Moderate-intensity physical activity" ;
    dmo:evidenceQuote "We recommend that patients with diabetes and CKD be advised to undertake moderate-intensity physical activity for a cumulative duration of at least 150 minutes per week, or to a level compatible with their cardiovascular and physical tolerance (1D)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

