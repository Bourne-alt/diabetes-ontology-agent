<https://example.org/dmo/id/lifestyleIntervention/protein-intake-between-1-0-and-1-2-g-protein-kg-weight-d-for-patients-on-dialysis> a dmo:LifestyleIntervention ;
    rdfs:label "Protein intake between 1.0 and 1.2 g protein/kg (weight)/d for patients on dialysis" ;
    dmo:activityTarget "1.0 and 1.2 g protein/kg (weight)/d" ;
    dmo:expectedBenefit "Helps avoid hypoglycemia and addresses amino acid losses during dialysis" ;
