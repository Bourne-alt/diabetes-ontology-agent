    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/high-protein-intake-increasing-acid-load> a dmo:Contraindication ;
    rdfs:label "High protein intake increasing acid load" ;
    dmo:contraCode "high-protein-intake-increasing-acid-load" ;
    dmo:rationale "A high protein intake could also increase acid load and precipitate or worsen metabolic acidosis, particularly in those with lower levels of kidney function." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "High protein intake increasing acid load" ;
    dmo:evidenceQuote "A high protein intake could also increase acid load and precipitate or worsen metabolic acidosis, particularly in those with lower levels of kidney function." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/history-of-acute-pancreatitis> a dmo:Contraindication ;
    rdfs:label "History of Acute Pancreatitis" ;
    dmo:contraCode "history-of-acute-pancreatitis" ;
    dmo:rationale "GLP-1 RA are contraindicated for patients with a history of medullary thyroid cancer or with multiple endocrine neoplasia 2 (MEN-2), although these are rare conditions, and for patients with a history of acute pancreatitis." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "history of acute pancreatitis" ;
    dmo:evidenceQuote "GLP-1 RA are contraindicated for patients with a history of medullary thyroid cancer or with multiple endocrine neoplasia 2 (MEN-2), although these are rare conditions, and for patients with a history of acute pancreatitis." ;
    dmo:evidenceQuote "for patients with a history of acute pancreatitis." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/history-of-aki> a dmo:Contraindication ;
