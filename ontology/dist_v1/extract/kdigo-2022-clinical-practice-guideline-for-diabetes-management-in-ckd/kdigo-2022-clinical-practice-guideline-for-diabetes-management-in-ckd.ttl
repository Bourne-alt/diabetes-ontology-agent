<https://example.org/dmo/id/lifestyleIntervention/weight-loss> a dmo:LifestyleIntervention ;
    rdfs:label "Weight loss" ;
    dmo:activityTarget "nearly 4 kg over 1 year" ;
    dmo:expectedBenefit "clinically meaningful from the perspectives of improving cardiovascular and CKD risk factors and for kidney and heart protection" ;
    dmo:interventionCode "weight-loss" ;
    dmo:interventionType "WeightManagement" ;
    dmo:name "Weight loss" ;
    dmo:evidenceQuote "whether intentional weight loss offers health benefits is unclear in this population. 345 Therefore, depending on individual context, recommending intentional weight loss may not be appropriate for some patients with advanced CKD." ;
    dmo:evidenceQuote "dulaglutide treatment (1.5 mg weekly) produced a mean weight loss of nearly 4 kg over 1 year" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

