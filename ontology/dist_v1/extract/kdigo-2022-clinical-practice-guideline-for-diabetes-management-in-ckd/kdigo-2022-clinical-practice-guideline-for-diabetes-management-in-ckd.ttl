    dmo:stageCode "egfr-20-ml-min-per-1-73-m2" ;
    dmo:stageCriteria "eGFR ≥20 ml/min per 1.73 m 2" ;
    dmo:stageOrder "3"^^xsd:integer ;
    dmo:evidenceQuote "eGFR ≥20 ml/min per 1.73 m 2  in EMPEROR-Reduced and EMPEROR-Preserved" ;
    dmo:evidenceQuote "Studies examining the safety and bene ﬁt of SGL T2i for patients with CKD and eGFR <20 ml/min per 1.73 m 2 or receiving dialysis." ;
