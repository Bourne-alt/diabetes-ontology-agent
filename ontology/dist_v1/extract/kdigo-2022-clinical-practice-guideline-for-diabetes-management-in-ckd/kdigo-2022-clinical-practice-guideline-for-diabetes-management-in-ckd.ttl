    dmo:contraCode "egfr-30-ml-min-per-1-73-m2" ;
    dmo:rationale "Stop metformin; do not initiate metformin" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "eGFR < 30 ml/min per 1.73 m²" ;
