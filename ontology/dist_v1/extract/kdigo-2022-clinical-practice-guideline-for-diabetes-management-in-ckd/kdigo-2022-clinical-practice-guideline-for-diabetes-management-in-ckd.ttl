<https://example.org/dmo/id/drugClass/metformin> a dmo:DrugClass ;
    rdfs:label "Metformin" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA01" ;
    dmo:drugClassCode "metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Decreases hepatic glucose production and improves insulin sensitivity" ;
    dmo:name "Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "We recommend treating patients with T2D, CKD, and an eGFR ‡30 ml/min per 1.73 m 2 with metformin (1B)." ;
    dmo:evidenceQuote "metformin, SGL T2i, GLP-1 RA, dipeptidyl peptidase-4 [DPP-4] inhibitors)." ;
    dmo:evidenceQuote "eGFR < 30 Stop metformin; do not initiate metformin" ;
    dmo:evidenceQuote "Older therapies —metformin, sulfonylureas, or thiazolidinediones" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/nonsteroidal-mineralocorticoid-receptor-antagonist> a dmo:DrugClass ;
    rdfs:label "Nonsteroidal mineralocorticoid receptor antagonist" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "C02DX01" ;
    dmo:drugClassCode "nonsteroidal-mineralocorticoid-receptor-antagonist" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Blocks mineralocorticoid receptors in the distal nephron, reducing sodium reabsorption and lowering blood pressure." ;
    dmo:name "Nonsteroidal mineralocorticoid receptor antagonist" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "A nonsteroidal mineralocorticoid receptor antagonist (ns-MRA) can be added to first-line therapy for patients with T2D and high residual risks of kidney disease progression and cardiovascular events, as evidenced by persistent albuminuria ( >30 mg/g [ >3 mg/mmol])." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/nonsteroidal-mra> a dmo:DrugClass ;
    rdfs:label "nonsteroidal MRA" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "nonsteroidal-mra" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Nonsteroidal mineralocorticoid receptor antagonist; blocks the mineralocorticoid receptor to reduce albuminuria and slow CKD progression." ;
    dmo:name "nonsteroidal MRA" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Steroidal and nonsteroidal MRA should not be combined due to risk of hyperkalemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/sglt2-inhibitor> a dmo:DrugClass ;
    rdfs:label "SGLT2 inhibitor" ;
    dmo:drugClassCode "sglt2-inhibitor" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibits sodium-glucose cotransporter-2 in the proximal tubule, leading to increased urinary glucose excretion and lower blood glucose levels." ;
    dmo:name "SGLT2 inhibitor" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Potential contraindications: \n Genital infection risk\n Diabetic ketoacidosis\n Foot ulcers\n Immunosuppression" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/sglt2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT2 inhibitors" ;
    dmo:drugClassCode "sglt2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Sodium –glucose cotransporter-2 inhibitors" ;
    dmo:name "SGLT2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "metformin, SGL T2i, GLP-1 RA, dipeptidyl peptidase-4 [DPP-4] inhibitors)." ;
    dmo:evidenceQuote "Genital mycotic infections, DKA\nGenital and urinary tract infections, hypotension\nGenital tract infections" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/sglt2i> a dmo:DrugClass ;
    rdfs:label "SGLT2i" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "sglt2i" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Sodium-glucose co-transporter 2 inhibitor" ;
    dmo:name "SGLT2i" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "Table S32. SoF table: Low-dose SGLT2i versus standard-dose SGLT2i" ;
    dmo:evidenceQuote "SGLT2i (Initiate eGFR ≥20; continue until dialysis or transplant)" ;
    dmo:evidenceQuote "patients at increased risk of volume depletion, genital infections, or lower-limb amputation due to foot ulcerations. People with a history of urinary tract infections also may not prefer this class of medications." ;
    dmo:evidenceQuote "Therefore, this recommendation does not apply to kidney transplant recipients (see Practice Point 1.3.7)." ;
    dmo:evidenceQuote "During the time between initiation and completion of the FIDELIO-DKD and FIGARO-DKD trials, numerous rigorous clinical trials demonstrated large kidney and cardiovascular benefits of SGL T2i ( Section 1.3 above), and SGL T2i became an established first-line treatment for T2D with CKD." ;
    dmo:evidenceQuote "In patients with T2D and CKD, what are the effects of SGLT2i on clinically relevant outcomes and clinically relevant harms?" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/sodium-glucose-cotransporter-2-inhibitors> a dmo:DrugClass ;
    rdfs:label "Sodium –glucose cotransporter-2 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "sodium-glucose-cotransporter-2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibit the reabsorption of glucose in the proximal tubule of the kidneys, leading to increased urinary glucose excretion and lower blood glucose levels." ;
    dmo:name "Sodium –glucose cotransporter-2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "Patients with T2D and CKD are at increased risk of both cardiovascular events and progression to kidne" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/sulfonylurea> a dmo:DrugClass ;
    rdfs:label "Sulfonylurea" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BB" ;
    dmo:drugClassCode "sulfonylurea" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Stimulates insulin secretion from pancreatic beta cells by closing ATP-sensitive potassium channels." ;
    dmo:name "Sulfonylurea" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "DPP-4 inhibitor Insulin Sulfonylurea TZD Alpha-glucosidase inhibitor" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/sulfonylureas> a dmo:DrugClass ;
    rdfs:label "Sulfonylureas" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BB01" ;
    dmo:drugClassCode "sulfonylureas" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Sulfonylureas stimulate insulin secretion from pancreatic beta cells." ;
    dmo:name "Sulfonylureas" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Risk of hypoglycemia is high in patients with advanced CKD who are treated by glucose-lowering agents that raise blood insulin levels (exogenous insulin, sulfonylureas, meglitinides)." ;
    dmo:evidenceQuote "The risk of hypoglycemia is generally low with GLP-1 RA when used alone, but risk is increased when GLP-1 RA is used concomitantly with other medications such as sulfonylureas or insulin." ;
    dmo:evidenceQuote "Older therapies —metformin, sulfonylureas, or thiazolidinediones" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/thiazolidinedione> a dmo:DrugClass ;
    rdfs:label "Thiazolidinedione" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BD" ;
    dmo:drugClassCode "thiazolidinedione" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Activates PPAR-gamma receptors, improving insulin sensitivity in adipose tissue, muscle, and liver." ;
    dmo:name "Thiazolidinedione" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "DPP-4 inhibitor Insulin Sulfonylurea TZD Alpha-glucosidase inhibitor" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/thiazolidinediones> a dmo:DrugClass ;
    rdfs:label "Thiazolidinediones" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BD01" ;
    dmo:drugClassCode "thiazolidinediones" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Improve insulin sensitivity in peripheral tissues by activating PPAR-gamma receptors." ;
    dmo:name "Thiazolidinediones" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Older therapies —metformin, sulfonylureas, or thiazolidinediones" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/tzd> a dmo:DrugClass ;
    rdfs:label "TZD" ;
    dmo:drugClassCode "tzd" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Thiazolidinedione" ;
    dmo:name "TZD" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Table S62. SoF table: T2D and CKD (G1 –G2)—thiazolidinedione versus placebo/standard of care" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/acr> a dmo:LabTest ;
    rdfs:label "ACR" ;
    dmo:definition "albumin-creatinine ratio" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "acr" ;
    dmo:loincCode "29515-2" ;
    dmo:name "ACR" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg/g [mg/mmol]" ;
    dmo:evidenceQuote "albuminuria ( ‡30 mg/g [ ‡3 mg/mmol])" ;
    dmo:evidenceQuote "ACR <30 mg/g [<3 mg/mmol] in 60%; 30–300 mg/g [3–30 mg/mmol] in 30%; >300 mg/g [>30 mg/mmol] in 10%" ;
    dmo:evidenceQuote "progression to severely increased albuminuria (ACR >300 mg/g [ >30 mg/mmol])" ;
    dmo:evidenceQuote "The CREDENCE trial enrolled patients with T2D (with an HbA1c level of 6.5% –12.0%) and CKD, defined by an eGFR of 30 –90 ml/min per 1.73 m 2 with albuminuria (ACR of 300 –5000 mg/g [30 –500 mg/mmol]), who were receiving standard of care including a maximum tolerated dose of an ACEi or an ARB." ;
    dmo:evidenceQuote "ACR 30 –<300 mg/g [3 –<30 mg/mmol]" ;
    dmo:evidenceQuote "CREDENCE eGFR ≥30 ml/min per 1.73 m 2 ACR >300 mg/g [>30 mg/mmol] and eGFR 30–90 ml/min per 1.73 m2" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/albumin-to-creatinine-ratio> a dmo:LabTest ;
    rdfs:label "Albumin-to-Creatinine Ratio" ;
    dmo:definition "Albumin excretion rate (AER) in urine, expressed as the ratio of albumin to creatinine in a spot urine sample, used to classify albuminuria in chronic kidney disease (CKD)." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "albumin-to-creatinine-ratio" ;
    dmo:loincCode "29515-2" ;
    dmo:name "Albumin-to-Creatinine Ratio" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg/g" ;
    dmo:evidenceQuote "ACR, albumin-creatinine ratio; AER, albumin excretion rate; CKD, chronic kidney disease." ;
    dmo:evidenceQuote "Nonsteroidal MRA† if ACR ≥30 mg/g [≥3 mg/mmol] and normal potassium" ;
    dmo:evidenceQuote "In the FIGARO-DKD trial, patients with ACR 30 –<300 mg/g [3 –<30 mg/mmol] and eGFR 25 –90 ml/min per 1.73 m 2 or ACR 300 –5000 mg/g [30 –500 mg/mmol] and eGFR $60 ml/min per 1.73 m 2 were included ( Figure 8 )." ;
    dmo:evidenceQuote "Assess kidney function (e.g., eGFR and ACR) every 3 –12 months." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/albuminuria> a dmo:LabTest ;
    rdfs:label "albuminuria" ;
    dmo:definition "The presence of albumin in the urine, indicating kidney damage, especially in patients with diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "albuminuria" ;
    dmo:loincCode "2161-8" ;
    dmo:name "albuminuria" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg-per-g" ;
    dmo:evidenceQuote "A nonsteroidal mineralocorticoid receptor antagonist (ns-MRA) can be added to first-line therapy for patients with T2D and high residual risks of kidney disease progression and cardiovascular events, as evidenced by persistent albuminuria ( >30 mg/g [ >3 mg/mmol])." ;
    dmo:evidenceQuote "Moderately or severely increased albuminuria is related to increased kidney and cardiovascular risk compared to normal albumin excretion." ;
    dmo:evidenceQuote "The presence of albuminuria is associated with an increased risk of progression of CKD and the development of kidney failure in patients with CKD and diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/albuminuria-progression> a dmo:LabTest ;
    rdfs:label "Albuminuria progression" ;
    dmo:definition "Progression of albuminuria from onset to moderately increased or severely increased levels; a marker of kidney disease progression." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "albuminuria-progression" ;
    dmo:loincCode "51849-6" ;
    dmo:name "Albuminuria progression" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg-per-g" ;
    dmo:evidenceQuote "Albuminuria progression (onset of albuminuria, moderately increased to severely increased albuminuria)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/blood-ketone-levels> a dmo:LabTest ;
    rdfs:label "blood ketone levels" ;
    dmo:definition "blood ketone levels" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-ketone-levels" ;
    dmo:loincCode "57690-0" ;
    dmo:name "blood ketone levels" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/l" ;
    dmo:evidenceQuote "measure both blood glucose and blood ketone levels on hospital admission" ;
    dmo:evidenceQuote "check blood glucose and blood ketone levels more often, and seek medical help early." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/bmi> a dmo:LabTest ;
    rdfs:label "BMI" ;
    dmo:definition "body mass index, a measure of body fat based on height and weight" ;
    dmo:labTestCode "bmi" ;
    dmo:name "BMI" ;
    dmo:unitOfMeasure "kg/m²" ;
    dmo:evidenceQuote "Obesity (deﬁned by body mass index [BMI] >30 kg/m2)i s an independent risk factor for kidney disease progression and CVD." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/carbamylated-albumin> a dmo:LabTest ;
    rdfs:label "Carbamylated Albumin" ;
    dmo:definition "A measure of glycemic control that is less affected by uremia and altered red blood cell turnover, potentially useful in patients with CKD." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "carbamylated-albumin" ;
    dmo:loincCode "51758-3" ;
    dmo:name "Carbamylated Albumin" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "In adults with diabetes and CKD, compared to HbA1c, do alternative biomarkers improve clinically relevant outcomes and decrease clinically relevant harms?" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/cgm> a dmo:LabTest ;
    rdfs:label "CGM" ;
    dmo:definition "Continuous glucose monitoring, a method for tracking blood glucose levels in real time over extended periods." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "cgm" ;
    dmo:loincCode "58466-2" ;
    dmo:name "CGM" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "In adults with diabetes and CKD, compared to HbA1c, does blood glucose monitoring (CGM, SMBG) improve clinically relevant outcomes and decrease clinically relevant harms?" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/continuous-glucose-monitoring> a dmo:LabTest ;
    rdfs:label "Continuous Glucose Monitoring" ;
    dmo:definition "A method of monitoring glucose levels in real time, used to guide glycemic management and assess time in range and time in hypoglycemia." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "continuous-glucose-monitoring" ;
    dmo:loincCode "94577-5" ;
    dmo:name "Continuous Glucose Monitoring" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "Daily glycemic monitoring with CGM or self-monitoring of blood glucose (SMBG) may help prevent hypoglycemia and improve glycemic control when glucose-lowering therapies associated with risk of hypoglycemia are used." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/crcl> a dmo:LabTest ;
    rdfs:label "CrCl" ;
    dmo:definition "creatinine clearance" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "crcl" ;
    dmo:loincCode "2161-8" ;
    dmo:name "CrCl" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mL-per-min" ;
    dmo:evidenceQuote "Use with CrCl >30 ml/min" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/egfr> a dmo:LabTest ;
    rdfs:label "eGFR" ;
    dmo:definition "estimated glomerular filtration rate" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "egfr" ;
    dmo:loincCode "2160-0" ;
    dmo:name "eGFR" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "ml/min per 1.73 m2" ;
    dmo:evidenceQuote "eGFR ‡25 ml/min per 1.73 m 2, normal serum potassium concentration, and albuminuria" ;
    dmo:evidenceQuote "Mean eGFR at enrollment (ml/min per 1.73 m2)" ;
    dmo:evidenceQuote "with an eGFR $30 ml/min per 1.73 m 2 (mean eGFR 66 ml/min per 1.73 m 2)" ;
    dmo:evidenceQuote "including those with an eGFR of 30 –45 ml/min per 1.73 m 2." ;
    dmo:evidenceQuote "eGFR ≥30 ml/min per 1.73 m 2  in DAPA-HF" ;
    dmo:evidenceQuote "Kidney icon indicates estimated glomerular ﬁltration rate (eGFR; ml/min per 1.73 m 2); dialysis machine icon indicates dialysis." ;
    dmo:evidenceQuote "eGFR, estimated glomerular ﬁltration rate (in ml/min per 1.73 m 2); GI, gastrointestinal." ;
    dmo:evidenceQuote "eGFR, ACR eGFR did not (–0.7 ml/min per 1.73 m2) with dulaglutide 1.5 mg or dulaglutide 0.75 mg, wherea" ;
    dmo:evidenceQuote "the updated Cochrane review that focused on people with diabetes and CKD found unclear reporting of allocation concealment and blinding in other included trials which downgraded the evidence for hypoglycemia requiring third-party assistance, hyperkalemia, HbA1c, eGFR loss, change in body weight, and body mass index." ;
    dmo:evidenceQuote "eGFR Number of studies ES (95% Cl) Weight (%)" ;
    dmo:evidenceQuote "eGFR, estimated glomerular ﬁltration rate; HbA1c, glycated hemoglobin; MACE, major cardiovascular events." ;
    dmo:evidenceQuote "eGFR, estimated glomerular filtration rate; HbA1c, glycated hemoglobin; MACE, major cardiovascular events." ;
    dmo:evidenceQuote "CKD progression —doubling of SCr, $40% decline in eGFR, mean blood glucose (HbA1c)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/ejection-fraction> a dmo:LabTest ;
    rdfs:label "ejection fraction" ;
    dmo:definition "a measure of the percentage of blood pumped out of the heart with each contraction" ;
    dmo:labTestCode "ejection-fraction" ;
    dmo:name "ejection fraction" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "%" ;
    dmo:evidenceQuote "defined as ejection fraction #40%" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/estimated-glomerular-filtration-rate> a dmo:LabTest ;
    rdfs:label "Estimated Glomerular Filtration Rate" ;
    dmo:definition "A calculated estimate of kidney function based on serum creatinine, age, sex, and race, used to stage chronic kidney disease." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "estimated-glomerular-filtration-rate" ;
    dmo:loincCode "21600-0" ;
    dmo:name "Estimated Glomerular Filtration Rate" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mL-per-min" ;
    dmo:evidenceQuote "SGLT2i (Initiate eGFR ≥20; continue until dialysis or transplant)" ;
    dmo:evidenceQuote "eGFR <15 ml/min per 1.73 m²" ;
    dmo:evidenceQuote "CKD, chronic kidney disease; G1, estimated glomerular ﬁltration rate (eGFR) $90 ml/min per 1.73 m 2; G5, eGFR <15 ml/min per 1.73 m 2." ;
    dmo:evidenceQuote "eGFR, estimated glomerular ﬁltration rate; GLP1RA, glucagon-like peptide-1 receptor agonist; SU, sulfonylurea; TZD, thiazolidinedione." ;
    dmo:evidenceQuote "Monitor eGFR in patients treated with metformin. Increase the frequency of monitoring when the eGFR is <60 ml/min per 1.73 m 2 (Figure 27 )." ;
    dmo:evidenceQuote "Adjust the dose of metformin when the eGFR is <45 ml/min per 1.73 m 2, and for some patients when the eGFR is 45 –59 ml/min per 1.73 m 2 (Figure 27 )." ;
    dmo:evidenceQuote "eGFR < 30 Stop metformin; do not initiate metformin" ;
    dmo:evidenceQuote "eGFR ≥ 60 eGFR 45–59 eGFR 30–44" ;
    dmo:evidenceQuote "Use with eGFR >45 ml/min per 1.73 m2" ;
    dmo:evidenceQuote "Not recommended with eGFR <15 ml/min per 1.73 m2" ;
    dmo:evidenceQuote "CKD is de ﬁned as persistently elevated urine albumin excretion ( $30 mg/g [ $3 mg/mmol]), persistently reduced eGFR (eGFR <60 ml/min per 1.73 m 2), or both, for more than 3 months, in accordance with current KDIGO guidelines." ;
    dmo:evidenceQuote "In the FIGARO-DKD trial, patients with ACR 30 –<300 mg/g [3 –<30 mg/mmol] and eGFR 25 –90 ml/min per 1.73 m 2 or ACR 300 –5000 mg/g [30 –500 mg/mmol] and eGFR $60 ml/min per 1.73 m 2 were included ( Figure 8 )." ;
    dmo:evidenceQuote "Serum creatinine/estimated glomerular filtration rate (eGFR) should be monitored concurrently with serum potassium." ;
    dmo:evidenceQuote "eGFR < 30 Stop metformin; do not initiate metformin eGFR ≥ 60 eGFR 45–59 eGFR 30–44" ;
    dmo:evidenceQuote "eGFR, estimated glomerular filtration rate (ml/min per 1.73 m 2); G, glomerular filtration rate category; G3a –G4, estimated glomerular filtration rate 15 –59 ml/min per 1.73 m 2;" ;
    dmo:evidenceQuote "Figure 32 | Forest plots showing outcomes for people with diabetes and chronic kidney disease (CKD) undergoing self-management (SM) education programs. 409,412,414–420 (a) Systolic blood pressure (SBP), (b) diastolic blood pressure (DBP), (c) estimated glomerular ﬁltration rate (eGFR), (d) glycated hemoglobin (HbA1c; %), (e) SM activity, and (f) health-related quality of life (HRQOL)." ;
    dmo:evidenceQuote "Assess kidney function (e.g., eGFR and ACR) every 3 –12 months." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/fasting-glucose> a dmo:LabTest ;
    rdfs:label "Fasting Glucose" ;
    dmo:definition "Blood glucose level measured after an overnight fast, used to assess glycemic status in patients with diabetes." ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "fasting-glucose" ;
    dmo:loincCode "15577-6" ;
    dmo:name "Fasting Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Tight glycemic control ( <7% HbA1c target or fasting glucose levels <120 mg/dl [6.7 mmol/l]), <6.5% HbA1c target, or <6.0% HbA1c target)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/fructosamine> a dmo:LabTest ;
    rdfs:label "Fructosamine" ;
    dmo:definition "A biomarker reflecting glycemia over a shorter timeframe (2–4 weeks) than HbA1c, proposed as an alternative for long-term glycemic monitoring, though it may be biased by hypoalbuminemia and other factors." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "fructosamine" ;
    dmo:loincCode "2339-0" ;
    dmo:name "Fructosamine" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "micromole-per-liter" ;
    dmo:evidenceQuote "Glycated albumin and fructosamine have been proposed as candidates for alternative long-term glycemic monitoring." ;
    dmo:evidenceQuote "In adults with diabetes and CKD, compared to HbA1c, do alternative biomarkers improve clinically relevant outcomes and decrease clinically relevant harms?" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/glucose-management-indicator> a dmo:LabTest ;
    rdfs:label "Glucose Management Indicator" ;
    dmo:definition "A glycemic index derived from continuous glucose monitoring (CGM) data, used when HbA1c is not concordant with directly measured blood glucose levels or clinical symptoms." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "glucose-management-indicator" ;
    dmo:loincCode "94577-5" ;
    dmo:name "Glucose Management Indicator" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "A glucose management indicator (GMI) derived from continuous glucose monitoring (CGM) data can be used to index glycemia for individuals in whom HbA1c is not concordant with directly measured blood glucose levels or clinical symptoms." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/glycated-albumin> a dmo:LabTest ;
    rdfs:label "Glycated albumin" ;
    dmo:definition "A biomarker reflecting glycemia over a shorter timeframe (2–4 weeks) than HbA1c, proposed as an alternative for long-term glycemic monitoring in patients with CKD." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "glycated-albumin" ;
    dmo:loincCode "51857-5" ;
    dmo:name "Glycated albumin" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "Glycated albumin and fructosamine have been proposed as candidates for alternative long-term glycemic monitoring." ;
    dmo:evidenceQuote "In adults with diabetes and CKD, compared to HbA1c, do alternative biomarkers improve clinically relevant outcomes and decrease clinically relevant harms?" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/glycated-hemoglobin> a dmo:LabTest ;
    rdfs:label "Glycated Hemoglobin" ;
    dmo:definition "A measure of average blood glucose levels over the past 2–3 months, used to assess long-term glycemic control in diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "glycated-hemoglobin" ;
    dmo:loincCode "4548-4" ;
    dmo:name "Glycated Hemoglobin" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "DCCT (%)\nIFCC\n(mmol/mol) DCCT (%)\nIFCC\n(mmol/mol) DCCT (%)\nIFCC\n(mmol/mol) DCCT (%)\nIFCC\n(mmol/mol) DCCT (%)\nIFCC\n(mmol/mol)\n5.0 31 6.0 42 7.0 53 8.0 64 9.0 75" ;
    dmo:evidenceQuote "Figure 14 | Factors guiding decisions on individual glycated hemoglobin (HbA1c) targets. CKD, chronic kidney disease; G1, estimated glomerular ﬁltration rate (eGFR) $90 ml/min per 1.73 m 2; G5, eGFR <15 ml/min per 1.73 m 2." ;
    dmo:evidenceQuote "Assess cardiometabolic risk factors (e.g., blood pressure, glycated hemoglobin, body weight) every 2 –3 months." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/glycated-hemoglobin-hba1c> a dmo:LabTest ;
    rdfs:label "Glycated Hemoglobin (HbA1c; %)" ;
    dmo:definition "Glycated hemoglobin (HbA1c) is a measure of average blood glucose levels over the past 2-3 months, commonly used to monitor long-term glycemic control in people with diabetes." ;
    dmo:labTestCode "glycated-hemoglobin-hba1c" ;
    dmo:name "Glycated Hemoglobin (HbA1c; %)" ;
    dmo:unitOfMeasure "%" ;
    dmo:evidenceQuote "Figure 32 | Forest plots showing outcomes for people with diabetes and chronic kidney disease (CKD) undergoing self-management (SM) education programs. 409,412,414–420 (a) Systolic blood pressure (SBP), (b) diastolic blood pressure (DBP), (c) estimated glomerular ﬁltration rate (eGFR), (d) glycated hemoglobin (HbA1c; %), (e) SM activity, and (f) health-related quality of life (HRQOL)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/gmi> a dmo:LabTest ;
    rdfs:label "GMI" ;
    dmo:definition "GMI (Glucose Management Indicator) is a proxy for long-term glycemia derived from continuous glucose monitoring (CGM) data, used to estimate HbA1c." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "gmi" ;
    dmo:loincCode "94727-0" ;
    dmo:name "GMI" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "A GMI may be generated as a proxy for long-term glycemia in conjunction with the HbA1c measurement in individual patients, allowing adjustment of glycemic goals accordingly." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/hba1c> a dmo:LabTest ;
    rdfs:label "HbA1c" ;
    dmo:definition "glycated hemoglobin" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "HbA1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "baseline glycated hemoglobin (HbA1c) of 7% –10%" ;
    dmo:evidenceQuote "HbA1c is an advanced glycation end-product of hemoglobin, a princi- ple protein in red blood cells ( Figure 10). As such, HbA1c is a long-term biomarker that re ﬂects glycemia over the lifespan of red blood cells." ;
    dmo:evidenceQuote "We recommend an individualized HbA1c target ranging from <6.5% to <8.0% in patients with diabetes and CKD not treated with dialysis" ;
    dmo:evidenceQuote "HbA1c <7.0% decreased the incidence of nonfatal myocardial infarction and onset and progression of moderately increased albuminuria, but the quality of the evidence was downgraded because of study limitations and inconsistency in effect esti- mates." ;
    dmo:evidenceQuote "HbA1c targets #6.0% were associated with greater risk of hypoglycemia and increased mortality in patients with T2D and increased cardiovascular risk." ;
    dmo:evidenceQuote "SGL T2i do also lower blood glucose, with improvements in HbA1c that are modest and diminished at low eGFR." ;
    dmo:evidenceQuote "the updated Cochrane review that focused on people with diabetes and CKD found unclear reporting of allocation concealment and blinding in other included trials which downgraded the evidence for hypoglycemia requiring third-party assistance, hyperkalemia, HbA1c, eGFR loss, change in body weight, and body mass index." ;
    dmo:evidenceQuote "among individuals with a history of T2D and CKD who now have controlled HbA1c <6.5%" ;
    dmo:evidenceQuote "HbA1c Number of studies ES (95% Cl) Weight (%)" ;
    dmo:evidenceQuote "Attaining HbA1c\n/C15 Change in HbA1c" ;
    dmo:evidenceQuote "eGFR, estimated glomerular filtration rate; HbA1c, glycated hemoglobin; MACE, major cardiovascular events." ;
    dmo:evidenceQuote "In adults with diabetes and CKD, compared to HbA1c, do alternative biomarkers improve clinically relevant outcomes and decrease clinically relevant harms?" ;
    dmo:evidenceQuote "Tight glycemic control ( <7% HbA1c target or fasting glucose levels <120 mg/dl [6.7 mmol/l]), <6.5% HbA1c target, or <6.0% HbA1c target)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/hba1c-7-0> a dmo:LabTest ;
    rdfs:label "HbA1c <7.0%" ;
    dmo:definition "An HbA1c target of less than 7.0% is associated with reduced incidence of nonfatal myocardial infarction and progression of moderately increased albuminuria, though evidence quality is low to moderate." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c-7-0" ;
    dmo:loincCode "4548-4" ;
    dmo:name "HbA1c <7.0%" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "HbA1c <7.0% decreased the incidence of nonfatal myocardial infarction and onset and progression of moderately increased albuminuria, but the quality of the evidence was downgraded because of study limitations and inconsistency in effect esti- mates." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/hba1c-level> a dmo:LabTest ;
    rdfs:label "HbA1c level" ;
    dmo:definition "HbA1c level is a measure of average blood glucose levels over the past 2-3 months, used to assess long-term glycemic control in diabetes." ;
    dmo:labTestCode "hba1c-level" ;
    dmo:name "HbA1c level" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "fractures, and HbA1c level, due to imprecision or study limitations" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/hemoglobin-a1c> a dmo:LabTest ;
    rdfs:label "Hemoglobin A1c" ;
    dmo:definition "A measure of long-term glycemic control, used to monitor diabetes management in patients with chronic kidney disease." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hemoglobin-a1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "Hemoglobin A1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "We recommend using hemoglobin A1c (HbA1c) to monitor glycemic control in patients with diabetes and CKD (1C)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/potassium> a dmo:LabTest ;
    rdfs:label "Potassium" ;
    dmo:definition "An electrolyte essential for nerve and muscle function; elevated levels (hyperkalemia) can be dangerous in patients with kidney disease." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "potassium" ;
    dmo:loincCode "2085-9" ;
    dmo:name "Potassium" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Monitor serum creatinine and potassium (within 2–4 weeks after starting or changing dose)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/scr> a dmo:LabTest ;
    rdfs:label "SCr" ;
    dmo:definition "Serum creatinine, a marker of kidney function." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "scr" ;
    dmo:loincCode "2160-0" ;
    dmo:name "SCr" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Composite kidney outcome: HR: 0.71; 95% CI: 0.44–1.16" ;
    dmo:evidenceQuote "CKD progression —doubling of SCr, $40% decline in eGFR, mean blood glucose (HbA1c)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/self-monitoring-of-blood-glucose> a dmo:LabTest ;
    rdfs:label "Self-Monitoring of Blood Glucose" ;
    dmo:definition "A method of measuring blood glucose levels at home, used to monitor glycemic control and prevent hypoglycemia." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "self-monitoring-of-blood-glucose" ;
    dmo:loincCode "94577-5" ;
    dmo:name "Self-Monitoring of Blood Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Daily glycemic monitoring with CGM or self-monitoring of blood glucose (SMBG) may help prevent hypoglycemia and improve glycemic control when glucose-lowering therapies associated with risk of hypoglycemia are used." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/serum-creatinine> a dmo:LabTest ;
    rdfs:label "Serum Creatinine" ;
    dmo:definition "A waste product filtered by the kidneys; elevated levels indicate reduced kidney function." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "serum-creatinine" ;
    dmo:loincCode "2160-0" ;
    dmo:name "Serum Creatinine" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Monitor for changes in blood pressure, serum creatinine, and serum potassium within 2 –4 weeks of initiation or increase in the dose of an ACEi or ARB" ;
    dmo:evidenceQuote "Monitor serum creatinine and potassium (within 2–4 weeks after starting or changing dose)" ;
    dmo:evidenceQuote "The most common cause of an acute rise in serum creatinine following the use of a RAS blockade agent results from a decreased effective arterial blood volume, which often occurs in the setting of volume depletion with aggressive diuretic use and low cardiac output seen in heart failure, or with the use of nonsteroidal anti-in ﬂammatory drugs." ;
    dmo:evidenceQuote "Serum creatinine/estimated glomerular filtration rate (eGFR) should be monitored concurrently with serum potassium." ;
    dmo:evidenceQuote "doubling of serum creatinine, kidney failure, or death from kidney disease" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/serum-potassium> a dmo:LabTest ;
    rdfs:label "Serum Potassium" ;
    dmo:definition "An electrolyte essential for nerve and muscle function; elevated levels can be a side effect of RAS blockade." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "serum-potassium" ;
    dmo:loincCode "2002-8" ;
    dmo:name "Serum Potassium" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol-per-L" ;
    dmo:evidenceQuote "Monitor for changes in blood pressure, serum creatinine, and serum potassium within 2 –4 weeks of initiation or increase in the dose of an ACEi or ARB" ;
    dmo:evidenceQuote "Treatment should not be initiated if serum potassium is elevated (4.8 mmol/l was the threshold at screening in the finerenone trials, but per FDA label, serum potassium should not be >5 mmol/l)." ;
    dmo:evidenceQuote "In the FIDELIO-DKD and FIGARO-DKD trials, serum potassium was checked 1 month after drug initiation, 4 months after drug initiation, and every 4 months thereafter." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/serum-potassium-concentration> a dmo:LabTest ;
    rdfs:label "serum potassium concentration" ;
    dmo:definition "serum potassium concentration" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "serum-potassium-concentration" ;
    dmo:loincCode "2002-8" ;
    dmo:name "serum potassium concentration" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "normal serum potassium concentration" ;
    dmo:evidenceQuote "patients with normal serum potassium concentration (after maximizing RASi) and implemented a standardized potassium-monitoring protocol" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/serum-potassium-level> a dmo:LabTest ;
    rdfs:label "serum potassium level" ;
    dmo:definition "A measure of the concentration of potassium in the blood, used to assess electrolyte balance and kidney function." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "serum-potassium-level" ;
    dmo:loincCode "2002-8" ;
    dmo:name "serum potassium level" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol-per-L" ;
    dmo:evidenceQuote "close monitoring of serum potassium level is required." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/serum-potassium-levels> a dmo:LabTest ;
    rdfs:label "serum potassium levels" ;
    dmo:definition "serum potassium levels are measured to monitor for hyperkalemia, a risk associated with mineralocorticoid receptor antagonist therapy." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "serum-potassium-levels" ;
    dmo:loincCode "2002-8" ;
    dmo:name "serum potassium levels" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol-per-l" ;
    dmo:evidenceQuote "enrolling patients with serum potassium levels less than 4.8 mmol/l at screening" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/smbg> a dmo:LabTest ;
    rdfs:label "SMBG" ;
    dmo:definition "Self-monitoring of blood glucose, a method for patients to measure their blood glucose levels at home using a glucometer." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "smbg" ;
    dmo:loincCode "58467-0" ;
    dmo:name "SMBG" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "In adults with diabetes and CKD, compared to HbA1c, does blood glucose monitoring (CGM, SMBG) improve clinically relevant outcomes and decrease clinically relevant harms?" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/uacr> a dmo:LabTest ;
    rdfs:label "UACR" ;
    dmo:definition "urine albumin-to-creatinine ratio" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "uacr" ;
    dmo:loincCode "29515-1" ;
    dmo:name "UACR" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg-per-g" ;
    dmo:evidenceQuote "tant outcomes /C15 Albuminuria progression (onset of albuminuria, moderately increased to severely increased albuminuria)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/urine-albumin-excretion> a dmo:LabTest ;
    rdfs:label "Urine Albumin Excretion" ;
    dmo:definition "Urine albumin excretion is used to classify patients with diabetes and albuminuria, with normal levels defined as <30 mg/g [ <3 mg/mmol]." ;
    dmo:labTestCode "urine-albumin-excretion" ;
    dmo:name "Urine Albumin Excretion" ;
    dmo:unitOfMeasure "mg-per-g" ;
    dmo:evidenceQuote "Patients with diabetes and hypertension are at lower risk of CKD progression when urine albumin excretion is normal (<30 mg/g [ <3 mg/mmol]), and existing evidence does not demonstrate clear clinical bene ﬁt of RAS inhibition for CKD progression in this population." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/urine-albumin-to-creatinine-ratio> a dmo:LabTest ;
    rdfs:label "Urine Albumin-to-Creatinine Ratio" ;
    dmo:definition "A measure of albumin in the urine relative to creatinine, used to assess kidney damage in diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-albumin-to-creatinine-ratio" ;
    dmo:loincCode "29515-2" ;
    dmo:name "Urine Albumin-to-Creatinine Ratio" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg/g" ;
    dmo:evidenceQuote "persistently elevated urine albumin excretion ( $30 mg/g [ $3 mg/mmol])" ;
    dmo:evidenceQuote "Figure 14 | Factors guiding decisions on individual glycated hemoglobin (HbA1c) targets. CKD, chronic kidney disease; G1, estimated glomerular ﬁltration rate (eGFR) $90 ml/min per 1.73 m 2; G5, eGFR <15 ml/min per 1.73 m 2." ;
    dmo:evidenceQuote "CKD is de ﬁned as persistently elevated urine albumin excretion ( $30 mg/g [ $3 mg/mmol]), persistently reduced eGFR (eGFR <60 ml/min per 1.73 m 2), or both, for more than 3 months, in accordance with current KDIGO guidelines." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/vitamin-b12> a dmo:LabTest ;
    rdfs:label "Vitamin B12" ;
    dmo:definition "A water-soluble vitamin essential for nerve function and the production of red blood cells; deficiency can lead to anemia and neurological symptoms." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "vitamin-b12" ;
    dmo:loincCode "18770-1" ;
    dmo:name "Vitamin B12" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "pmol-per-L" ;
    dmo:evidenceQuote "Monitoring of vitamin B12 levels should be considered in patients who have been on long-term metformin treatment (e.g., >4 years) or in those who are at risk of low vitamin B12 levels (e.g., patients with malabsorption syndrome, or reduced dietary intake [vegans])." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/waist-circumference> a dmo:LabTest ;
    rdfs:label "waist circumference" ;
    dmo:definition "a measure of abdominal fat, used as a risk factor for kidney function decline and death" ;
    dmo:labTestCode "waist-circumference" ;
    dmo:name "waist circumference" ;
    dmo:unitOfMeasure "cm" ;
    dmo:evidenceQuote "higher BMI, waist circumference, and waist-to-height ratio are independent risk factors for kidney function decline and death in individuals who have normal or reduced levels of eGFR." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/labTest/waist-to-height-ratio> a dmo:LabTest ;
    rdfs:label "waist-to-height ratio" ;
    dmo:definition "a measure of central adiposity, used as a risk factor for kidney function decline and death" ;
    dmo:labTestCode "waist-to-height-ratio" ;
    dmo:name "waist-to-height ratio" ;
    dmo:unitOfMeasure "dimensionless" ;
    dmo:evidenceQuote "higher BMI, waist circumference, and waist-to-height ratio are independent risk factors for kidney function decline and death in individuals who have normal or reduced levels of eGFR." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/advising-encouraging-weight-loss-for-patients-with-obesity-diabetes-and-ckd> a dmo:LifestyleIntervention ;
    rdfs:label "Advising/encouraging weight loss for patients with obesity, diabetes, and CKD" ;
    dmo:interventionCode "advising-encouraging-weight-loss-for-patients-with-obesity-diabetes-and-ckd" ;
    dmo:interventionType "WeightManagement" ;
    dmo:name "Advising/encouraging weight loss for patients with obesity, diabetes, and CKD" ;
    dmo:evidenceQuote "Physicians should consider advising/encouraging patients with obesity, diabetes, and CKD to lose weight, particularly patients with eGFR ‡30 ml/min per 1.73 m 2." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/advising-on-intensity-and-type-of-exercises-for-patients-at-higher-risk-of-falls> a dmo:LifestyleIntervention ;
    rdfs:label "Advising on intensity and type of exercises for patients at higher risk of falls" ;
    dmo:interventionCode "advising-on-intensity-and-type-of-exercises-for-patients-at-higher-risk-of-falls" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "Advising on intensity and type of exercises for patients at higher risk of falls" ;
    dmo:evidenceQuote "For patients at higher risk of falls, healthcare providers should provide advice on the intensity of physical activity (low, moderate, or vigorous) and the type of exercises (aerobic vs. resistance, or both)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/aerobic-exercise-and-medical-management-versus-medical-management-only> a dmo:LifestyleIntervention ;
    rdfs:label "Aerobic exercise and medical management versus medical management only" ;
    dmo:interventionCode "aerobic-exercise-and-medical-management-versus-medical-management-only" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "Aerobic exercise and medical management versus medical management only" ;
    dmo:evidenceQuote "Table S22. SoF table: Obese patients —aerobic exercise and medical management versus medical management only" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/aerobic-exercise-and-resistance-training> a dmo:LifestyleIntervention ;
    rdfs:label "Aerobic exercise and resistance training" ;
    dmo:activityTarget "12-week program of aerobic and resistance training, followed by 40 weeks of home exercise" ;
    dmo:interventionCode "aerobic-exercise-and-resistance-training" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "Aerobic exercise and resistance training" ;
    dmo:evidenceQuote "exercise (12-week program of aerobic and resistance training, followed by 40 weeks of home exercise) and diet versus diet alone" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/aerobic-exercise-in-obese-diabetic-patients-with-chronic-kidney-disease> a dmo:LifestyleIntervention ;
    rdfs:label "Aerobic exercise in obese diabetic patients with chronic kidney disease" ;
    dmo:interventionCode "aerobic-exercise-in-obese-diabetic-patients-with-chronic-kidney-disease" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "Aerobic exercise in obese diabetic patients with chronic kidney disease" ;
    dmo:evidenceQuote "Aerobic exercise in obese diabetic patients with chronic kidney disease: a randomized and controlled pilot study." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/avoiding-high-sodium-foods> a dmo:LifestyleIntervention ;
    rdfs:label "Avoiding High-Sodium Foods" ;
    dmo:activityTarget "Avoid foods with more than 400 mg sodium per serving" ;
    dmo:expectedBenefit "Reduce overall sodium intake" ;
    dmo:interventionCode "avoiding-high-sodium-foods" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Avoiding High-Sodium Foods" ;
    dmo:evidenceQuote "Avoid foods with more than 400 mg sodium per serving" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/avoiding-salty-processed-meats> a dmo:LifestyleIntervention ;
    rdfs:label "Avoiding Salty Processed Meats" ;
    dmo:activityTarget "Avoid salty processed meats. Use fresh meat, poultry and eggs or plant proteins instead" ;
    dmo:expectedBenefit "Reduce sodium intake" ;
    dmo:interventionCode "avoiding-salty-processed-meats" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Avoiding Salty Processed Meats" ;
    dmo:evidenceQuote "Avoid salty processed meats. Use fresh meat, poultry and eggs or plant proteins instead" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/avoiding-salty-sauces-and-condiments> a dmo:LifestyleIntervention ;
    rdfs:label "Avoiding Salty Sauces and Condiments" ;
    dmo:activityTarget "Cut salty sauces like soy sauce (e.g., replace with pineapple juice or unseasoned rice vinegar)" ;
    dmo:expectedBenefit "Reduce sodium intake from condiments" ;
    dmo:interventionCode "avoiding-salty-sauces-and-condiments" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Avoiding Salty Sauces and Condiments" ;
    dmo:evidenceQuote "Cut salty sauces like soy sauce (e.g., replace with pineapple juice or unseasoned rice vinegar)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/avoiding-sedentary-behavior> a dmo:LifestyleIntervention ;
    rdfs:label "Avoiding sedentary behavior" ;
    dmo:interventionCode "avoiding-sedentary-behavior" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "Avoiding sedentary behavior" ;
    dmo:evidenceQuote "Patients should be advised to avoid sedentary behavior." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/bariatric-surgery> a dmo:LifestyleIntervention ;
    rdfs:label "Bariatric surgery" ;
    dmo:interventionCode "bariatric-surgery" ;
