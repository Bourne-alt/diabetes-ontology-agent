<https://example.org/dmo/id/drugClass/dipeptidyl-peptidase-4-inhibitor> a dmo:DrugClass ;
    rdfs:label "Dipeptidyl Peptidase-4 Inhibitor" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BG" ;
    dmo:drugClassCode "dipeptidyl-peptidase-4-inhibitor" ;
    dmo:hypoglycemiaRisk "Low" ;
