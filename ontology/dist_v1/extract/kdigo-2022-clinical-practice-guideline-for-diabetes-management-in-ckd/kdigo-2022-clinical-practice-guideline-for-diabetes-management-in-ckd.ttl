<https://example.org/dmo/id/medication/metformin> a dmo:Medication ;
    rdfs:label "Metformin" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "metformin" ;
    dmo:name "Metformin" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Metformin may be given when estimated glomerular filtration rate (eGFR) $30 ml/min per 1.73 m 2, and SGLT2i should be initiated when eGFR is $20 ml/min per 1.73 m 2 and continued as tolerated, until dialysis or transplantation is initiated." ;
    dmo:evidenceQuote "We recommend treating patients with T2D, CKD, and an eGFR ‡30 ml/min per 1.73 m 2 with metformin (1B)." ;
    dmo:evidenceQuote "metformin, SGL T2i, GLP-1 RA, dipeptidyl peptidase-4 [DPP-4] inhibitors" ;
    dmo:evidenceQuote "In addition, metformin and SGL T2i should be used in combination as ﬁrst-line treatment for most patients with suitable eGFR ( Figures 23 and 25)." ;
    dmo:evidenceQuote "Metformin should be initiated in patients with T2D and an eGFR $30 ml/min per 1.73 m 2 and should be discontinued when eGFR falls below 30 ml/min per 1.73 m 2 to reduce risk of lactic acidosis" ;
    dmo:evidenceQuote "In addition to its ef ﬁcacy as an antiglycemic agent, studies have demonstrated that treatment with metformin is effective in preventing weight gain and may achieve weight reduction" ;
    dmo:evidenceQuote "Metformin is not metabolized and is excreted unchanged in the urine, with a half-life of about 5 hours." ;
    dmo:evidenceQuote "Metformin, Extended Release Tablet, Oral: 500 mg, 750 mg, 1000 mg" ;
    dmo:evidenceQuote "360. Bailey CJ, Turner RC. Metformin. N Engl J Med . 1996;334:574 –579." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

