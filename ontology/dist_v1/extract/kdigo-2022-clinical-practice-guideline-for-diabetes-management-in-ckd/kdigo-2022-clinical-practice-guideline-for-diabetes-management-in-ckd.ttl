<https://example.org/dmo/id/contraindication/serum-potassium-5-5-mmol-l> a dmo:Contraindication ;
    rdfs:label "Serum potassium #5.5 mmol/l" ;
    dmo:contraCode "serum-potassium-5-5-mmol-l" ;
    dmo:rationale "Finerenone was continued with serum potassium #5.5 mmol/l." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "serum potassium #5.5 mmol/l" ;
    dmo:evidenceQuote "Finerenone was continued with serum potassium #5.5 mmol/l." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/serum-potassium-5-mmol-l> a dmo:Contraindication ;
    rdfs:label "Serum potassium >5 mmol/l" ;
    dmo:contraCode "serum-potassium-5-mmol-l" ;
    dmo:rationale "Treatment should not be initiated if serum potassium is elevated (4.8 mmol/l was the threshold at screening in the finerenone trials, but per FDA label, serum potassium should not be >5 mmol/l)" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "Serum potassium is elevated (4.8 mmol/l was the threshold at screening in the finerenone trials, but per FDA label, serum potassium should not be >5 mmol/l)" ;
    dmo:evidenceQuote "Treatment should not be initiated if serum potassium is elevated (4.8 mmol/l was the threshold at screening in the finerenone trials, but per FDA label, serum potassium should not be >5 mmol/l)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/severe-volume-depletion> a dmo:Contraindication ;
    rdfs:label "Severe Volume Depletion" ;
    dmo:contraCode "severe-volume-depletion" ;
    dmo:rationale "routine preventive foot care and adequate hydration may reduce risk of foot complications" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "patients with severe volume depletion" ;
    dmo:evidenceQuote "adequate hydration may reduce risk of foot complications" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/steroidal-mra-in-pregnancy> a dmo:Contraindication ;
    rdfs:label "Steroidal MRA in pregnancy" ;
    dmo:contraCode "steroidal-mra-in-pregnancy" ;
    dmo:rationale "Steroidal MRA are currently contraindicated in pregnancy." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "pregnancy" ;
    dmo:evidenceQuote "Steroidal MRA are currently contraindicated in pregnancy." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/symptomatic-hypotension> a dmo:Contraindication ;
    rdfs:label "Symptomatic Hypotension" ;
    dmo:contraCode "symptomatic-hypotension" ;
    dmo:rationale "The dose of an ACEi or ARB should be reduced or discontinued only as a last resort in patients with hyperkalemia after the measures outlined above have failed to achieve a normal serum potassium level. Similar efforts should be made to discontinue other concurrent blood pressure medication before attempting to reduce the ACEi or ARB dose in patients who experience symptomatic hypotension." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "symptomatic hypotension" ;
    dmo:evidenceQuote "Similar efforts should be made to discontinue other concurrent blood pressure medication before attempting to reduce the ACEi or ARB dose in patients who experience symptomatic hypotension." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/use-of-glucose-lowering-agents-associated-with-hypoglycemia-in-patients-with-diabetes-and-ckd> a dmo:Contraindication ;
    rdfs:label "Use of glucose-lowering agents associated with hypoglycemia in patients with diabetes and CKD" ;
    dmo:contraCode "use-of-glucose-lowering-agents-associated-with-hypoglycemia-in-patients-with-diabetes-and-ckd" ;
    dmo:rationale "Patients with diabetes and CKD are at higher risk of hypoglycemia with traditional glucose-lowering drugs" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "patients treated with drugs associated with hypoglycemia, such as insulin or sulfonylureas" ;
    dmo:evidenceQuote "Patients with diabetes and CKD are at higher risk of hypoglycemia with traditional glucose-lowering drugs, and thus a single stringent target may not be appropriate for many patients" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/use-of-perindopril-when-crcl-30-ml-min> a dmo:Contraindication ;
    rdfs:label "Use of Perindopril when CrCl <30 ml/min" ;
    dmo:contraCode "use-of-perindopril-when-crcl-30-ml-min" ;
    dmo:rationale "Perindopril and its metabolites are removed by hemodialysis" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "Use is not recommended when CrCl <30 ml/min" ;
    dmo:evidenceQuote "Use is not recommended when CrCl <30 ml/min" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/use-of-salt-substitutes-rich-in-potassium-in-advanced-ckd> a dmo:Contraindication ;
    rdfs:label "Use of salt substitutes rich in potassium in advanced CKD" ;
    dmo:contraCode "use-of-salt-substitutes-rich-in-potassium-in-advanced-ckd" ;
    dmo:rationale "The DASH-type diet or use of salt substitutes, which are rich in potassium, may not be appropriate for patients with advanced CKD." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "advanced CKD" ;
    dmo:evidenceQuote "However, certain strategies may require tailoring. For example, the DASH-type diet or use of salt substitutes, which are rich in potassium, may not be appropriate for patients with advanced CKD." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/blood-glucose-and-blood-ketone-levels> a dmo:Device ;
    rdfs:label "Blood glucose and blood ketone levels" ;
    dmo:deviceCode "blood-glucose-and-blood-ketone-levels" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Blood glucose and blood ketone levels" ;
    dmo:evidenceQuote "check blood glucose and blood ketone levels more often, and seek medical help early." ;
    dmo:evidenceQuote "measure both blood glucose and blood ketone levels on hospital admission (proceed with procedure/surgery if the patient is clinically well and ketones are <1.0 mmol/l)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/blood-ketone-levels> a dmo:Device ;
    rdfs:label "Blood ketone levels" ;
    dmo:deviceCode "blood-ketone-levels" ;
    dmo:deviceType "KetoneTestKit" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Blood ketone levels" ;
    dmo:evidenceQuote "check blood glucose and blood ketone levels more often, and seek medical help early." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/cgm> a dmo:Device ;
    rdfs:label "CGM" ;
    dmo:deviceCode "cgm" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "CGM" ;
    dmo:evidenceQuote "Glucose monitoring strategies that may aid in safe achievement of lower HbA1c targets include use of CGM" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/closed-loop-insulin-system> a dmo:Device ;
    rdfs:label "Closed-loop insulin system" ;
    dmo:deviceCode "closed-loop-insulin-system" ;
    dmo:deviceType "ArtificialPancreas" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Closed-loop insulin system" ;
    dmo:evidenceQuote "Table S51. SoF table: Closed-loop insulin system versus standard insulin" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/continuous-glucose-monitoring> a dmo:Device ;
    rdfs:label "Continuous glucose monitoring" ;
    dmo:deviceCode "continuous-glucose-monitoring" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Continuous glucose monitoring" ;
    dmo:evidenceQuote "Table S50. SoF table: Continuous glucose monitoring versus self-monitoring" ;
    dmo:evidenceQuote "CGM continuous glucose monitoring" ;
    dmo:evidenceQuote "A glucose management indicator (GMI) derived from continuous glucose monitoring (CGM) data can be used to index glycemia for individuals in whom HbA1c is not concordant with directly measured blood glucose levels or clinical symptoms." ;
    dmo:evidenceQuote "CGM devices are rapidly evolving with multiple functionalities (e.g., real-time and intermittently scanned CGM)." ;
    dmo:evidenceQuote "rationale for using continuous glucose monitoring (CGM) or self-monitoring of blood glucose (SMBG)." ;
    dmo:evidenceQuote "In adults with diabetes and CKD, compared to HbA1c, does blood glucose monitoring (CGM, SMBG) improve clinically relevant outcomes and decrease clinically relevant harms?" ;
    dmo:evidenceQuote "International consensus on use of continuous glucose monitoring." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/continuous-glucose-monitoring-cgm> a dmo:Device ;
    rdfs:label "Continuous glucose monitoring (CGM)" ;
    dmo:deviceCode "continuous-glucose-monitoring-cgm" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Continuous glucose monitoring (CGM)" ;
    dmo:evidenceQuote "Minimally invasive subcutaneous sensors which sample interstitial glucose at regular intervals (e.g., every 5–15 min)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/continuous-glucose-monitoring-system> a dmo:Device ;
    rdfs:label "Continuous Glucose Monitoring System" ;
    dmo:deviceCode "continuous-glucose-monitoring-system" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Continuous Glucose Monitoring System" ;
    dmo:evidenceQuote "Glycaemic control in type 2 diabetic patients on chronic haemodialysis: use of a continuous glucose monitoring system." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/intermittently-scanned-cgm> a dmo:Device ;
    rdfs:label "Intermittently scanned CGM" ;
    dmo:deviceCode "intermittently-scanned-cgm" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Intermittently scanned CGM" ;
    dmo:evidenceQuote "Glucose levels can be seen while the device is worn when they are queried" ;
    dmo:evidenceQuote "CGM devices are rapidly evolving with multiple functionalities (e.g., real-time and intermittently scanned CGM)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/real-time-cgm-rtcgm> a dmo:Device ;
    rdfs:label "Real-time CGM (rtCGM)" ;
    dmo:deviceCode "real-time-cgm-rtcgm" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Real-time CGM (rtCGM)" ;
    dmo:evidenceQuote "Refers to sensors transmitting and/or displaying the data automatically throughout the day, so that the patient can review glucose levels and adjust treatment as needed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/retrospective-cgm> a dmo:Device ;
    rdfs:label "Retrospective CGM" ;
    dmo:deviceCode "retrospective-cgm" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Retrospective CGM" ;
    dmo:evidenceQuote "Glucose levels are not visible while the device is worn. Instead, a report is generated for evaluation after the CGM is removed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/self-monitoring-of-blood-glucose> a dmo:Device ;
    rdfs:label "self-monitoring of blood glucose" ;
    dmo:deviceCode "self-monitoring-of-blood-glucose" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "self-monitoring of blood glucose" ;
    dmo:evidenceQuote "Daily glycemic monitoring with CGM or self-monitoring of blood glucose (SMBG) may help prevent hypoglycemia and improve glycemic control when glucose-lowering therapies associated with risk of hypoglycemia are used." ;
    dmo:evidenceQuote "rationale for using continuous glucose monitoring (CGM) or self-monitoring of blood glucose (SMBG)." ;
    dmo:evidenceQuote "In adults with diabetes and CKD, compared to HbA1c, does blood glucose monitoring (CGM, SMBG) improve clinically relevant outcomes and decrease clinically relevant harms?" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/device/self-monitoring-of-blood-glucose-smbg> a dmo:Device ;
    rdfs:label "Self-monitoring of blood glucose (SMBG)" ;
    dmo:deviceCode "self-monitoring-of-blood-glucose-smbg" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Self-monitoring of blood glucose (SMBG)" ;
    dmo:evidenceQuote "Since sampling is performed intermittently, episodes of hypoglycemia or hyperglycemia are often harder to detect" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/diabetesType/t1d> a dmo:DiabetesType ;
