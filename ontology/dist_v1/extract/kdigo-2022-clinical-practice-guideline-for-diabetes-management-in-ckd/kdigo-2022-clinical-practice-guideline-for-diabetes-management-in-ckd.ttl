<https://example.org/dmo/id/recommendation/sglt2i-with-proven-benefits> a dmo:Recommendation ;
    rdfs:label "SGLT2i with proven benefits" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients with T2D" ;
    dmo:recommendationId "sglt2i-with-proven-benefits" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "It is reasonable to withhold SGLT2i during times of prolonged fasting, surgery, or critical medical illness (when patients may be at greater risk for ketosis)." ;
    dmo:evidenceQuote "It is reasonable to withhold SGLT2i during times of prolonged fasting, surgery, or critical medical illness (when patients may be at greater risk for ketosis)." ;
    dmo:evidenceQuote "For patients not attaining glycemic targets, see Chapter 4 on the management of hyperglycemia." ;
    dmo:evidenceQuote "If a patient is at risk for hypovolemia, consider decreasing thiazide or loop diuretic dosages before commencement of SGLT2i treatment, advise patients about symptoms of volume depletion and low blood pressure, and follow up on volume status after drug initiation." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

