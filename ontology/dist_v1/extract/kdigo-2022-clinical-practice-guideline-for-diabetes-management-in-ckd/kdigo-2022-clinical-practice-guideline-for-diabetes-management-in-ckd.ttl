<https://example.org/dmo/id/recommendation/ras-blockade-with-acei-or-arb-for-kidney-protection> a dmo:Recommendation ;
    rdfs:label "RAS blockade with ACEi or ARB for kidney protection" ;
    dmo:gradingSystem "GRADE" ;
    dmo:nativeEvidenceGrade "Moderate" ;
    dmo:populationScope "Patients with either T1D and T2D, as well as kidney transplant recipients; however, this recommendation does not apply to patients on dialysis." ;
    dmo:recommendationId "ras-blockade-with-acei-or-arb-for-kidney-protection" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "The Work Group, therefore, judged that most, if not all, patients would choose to receive RAS blockade treatment with either an ACEi or ARB for kidney protection effects, compared to receiving no treatment." ;
    dmo:evidenceQuote "The Work Group, therefore, judged that most, if not all, patients would choose to receive RAS blockade treatment with either an ACEi or ARB for kidney protection effects, compared to receiving no treatment." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

