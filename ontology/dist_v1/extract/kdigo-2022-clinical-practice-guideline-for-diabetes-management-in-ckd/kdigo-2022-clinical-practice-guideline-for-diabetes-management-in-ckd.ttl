    dmo:gradingSystem "GRADE" ;
    dmo:nativeEvidenceGrade "Moderate" ;
    dmo:populationScope "People with T2D and lower levels of albuminuria (ACR 30 –299 mg/g [3–29.9 mg/mmol])" ;
