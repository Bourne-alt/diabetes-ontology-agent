<https://example.org/dmo/id/complicationStage/persistent-albuminuria> a dmo:ComplicationStage ;
    rdfs:label "Persistent Albuminuria" ;
    dmo:name "Persistent Albuminuria" ;
    dmo:stageCode "persistent-albuminuria" ;
    dmo:stageCriteria "persistently elevated urine albumin excretion ( $30 mg/g [ $3 mg/mmol])" ;
    dmo:stageOrder "1"^^xsd:integer ;
    dmo:evidenceQuote "CKD is de ﬁned as persistently elevated urine albumin excretion ( $30 mg/g [ $3 mg/mmol]), persistently reduced eGFR (eGFR <60 ml/min per 1.73 m 2), or both, for more than 3 months, in accordance with current KDIGO guidelines." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/complicationStage/reduced-egfr> a dmo:ComplicationStage ;
    rdfs:label "Reduced eGFR" ;
    dmo:name "Reduced eGFR" ;
    dmo:stageCode "reduced-egfr" ;
    dmo:stageCriteria "persistently reduced eGFR (eGFR <60 ml/min per 1.73 m 2)" ;
    dmo:stageOrder "2"^^xsd:integer ;
    dmo:evidenceQuote "CKD is de ﬁned as persistently elevated urine albumin excretion ( $30 mg/g [ $3 mg/mmol]), persistently reduced eGFR (eGFR <60 ml/min per 1.73 m 2), or both, for more than 3 months, in accordance with current KDIGO guidelines." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/acei-or-arb-therapy-in-women-considering-pregnancy-or-who-become-pregnant> a dmo:Contraindication ;
    rdfs:label "ACEi or ARB therapy in women considering pregnancy or who become pregnant" ;
    dmo:contraCode "acei-or-arb-therapy-in-women-considering-pregnancy-or-who-become-pregnant" ;
    dmo:rationale "Discontinue these agents in women who are considering pregnancy or who become pregnant." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "women who are considering pregnancy or who become pregnant" ;
    dmo:evidenceQuote "discontinue these agents in women who are considering pregnancy or who become pregnant." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/advanced-ckd-with-uremic-symptoms> a dmo:Contraindication ;
    rdfs:label "Advanced CKD with Uremic Symptoms" ;
    dmo:contraCode "advanced-ckd-with-uremic-symptoms" ;
    dmo:rationale "However, in patients with advanced CKD who are experiencing uremic symptoms or dangerously high serum potassium levels, it is reasonable to discontinue ACEi and ARB treatment temporarily with the aim of resolving any hemodynamic reductions in eGFR and reducing symptoms to allow time for kidney replacement therapy preparation." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "advanced CKD who are experiencing uremic symptoms" ;
    dmo:evidenceQuote "However, in patients with advanced CKD who are experiencing uremic symptoms or dangerously high serum potassium levels, it is reasonable to discontinue ACEi and ARB treatment temporarily with the aim of resolving any hemodynamic reductions in eGFR and reducing symptoms to allow time for kidney replacement therapy preparation." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/anemia> a dmo:Contraindication ;
    rdfs:label "Anemia" ;
    dmo:contraCode "anemia" ;
    dmo:rationale "HbA1c is lowered by shortened survival or age of erythrocytes from anemia, transfusions, and use of erythropoiesis-stimulating agents or iron-replacement therapies." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "anemia" ;
    dmo:evidenceQuote "HbA1c is lowered by shortened survival or age of erythrocytes from anemia, transfusions, and use of erythropoiesis-stimulating agents or iron-replacement therapies." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/combination-of-steroidal-and-nonsteroidal-mra> a dmo:Contraindication ;
    rdfs:label "Combination of steroidal and nonsteroidal MRA" ;
    dmo:contraCode "combination-of-steroidal-and-nonsteroidal-mra" ;
    dmo:rationale "Steroidal and nonsteroidal MRA should not be combined due to risk of hyperkalemia." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "combination of steroidal and nonsteroidal MRA" ;
    dmo:evidenceQuote "Steroidal and nonsteroidal MRA should not be combined due to risk of hyperkalemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/concurrent-diuretic-use> a dmo:Contraindication ;
    rdfs:label "Concurrent diuretic use" ;
    dmo:contraCode "concurrent-diuretic-use" ;
    dmo:rationale "Theoretical concern for volume depletion and AKI" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "Patients treated concurrently with diuretics" ;
    dmo:evidenceQuote "particularly among patients treated concurrently with diuretics or who have tenuous volume status." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/dangerously-high-serum-potassium-levels> a dmo:Contraindication ;
    rdfs:label "Dangerously High Serum Potassium Levels" ;
    dmo:contraCode "dangerously-high-serum-potassium-levels" ;
    dmo:rationale "However, in patients with advanced CKD who are experiencing uremic symptoms or dangerously high serum potassium levels, it is reasonable to discontinue ACEi and ARB treatment temporarily with the aim of resolving any hemodynamic reductions in eGFR and reducing symptoms to allow time for kidney replacement therapy preparation." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "dangerously high serum potassium levels" ;
    dmo:evidenceQuote "However, in patients with advanced CKD who are experiencing uremic symptoms or dangerously high serum potassium levels, it is reasonable to discontinue ACEi and ARB treatment temporarily with the aim of resolving any hemodynamic reductions in eGFR and reducing symptoms to allow time for kidney replacement therapy preparation." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/diabetic-ketoacidosis> a dmo:Contraindication ;
    rdfs:label "Diabetic ketoacidosis" ;
    dmo:contraCode "diabetic-ketoacidosis" ;
    dmo:rationale "SGLT2i are associated with increased risk of diabetic ketoacidosis, especially in perioperative settings" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "Patients at risk for diabetic ketoacidosis" ;
    dmo:evidenceQuote "Potential contraindications: \n Genital infection risk\n Diabetic ketoacidosis\n Foot ulcers\n Immunosuppression" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/egfr-15-ml-min-per-1-73-m2-or-treatment-with-dialysis> a dmo:Contraindication ;
    rdfs:label "eGFR < 15 ml/min per 1.73 m2 or treatment with dialysis" ;
    dmo:contraCode "egfr-15-ml-min-per-1-73-m2-or-treatment-with-dialysis" ;
    dmo:rationale "Metformin is contraindicated in patients with severe renal impairment or on dialysis due to the risk of lactic acidosis." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "eGFR < 15 ml/min per 1.73 m2 or treatment with dialysis" ;
    dmo:evidenceQuote "eGFR < 15 ml/min per 1.73 m2 or treatment with dialysis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/egfr-30-ml-min-per-1-73-m2> a dmo:Contraindication ;
