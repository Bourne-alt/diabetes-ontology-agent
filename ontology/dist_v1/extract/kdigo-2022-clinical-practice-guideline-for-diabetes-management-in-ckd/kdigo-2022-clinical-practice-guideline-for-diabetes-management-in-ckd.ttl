<https://example.org/dmo/id/recommendation/avoiding-very-low-protein-diets-in-diabetes-and-ckd> a dmo:Recommendation ;
    rdfs:label "Avoiding Very Low-Protein Diets in Diabetes and CKD" ;
    dmo:gradingSystem "Cochrane systematic review" ;
    dmo:nativeEvidenceGrade "Moderate" ;
    dmo:populationScope "Patients with diabetes and CKD" ;
    dmo:recommendationId "avoiding-very-low-protein-diets-in-diabetes-and-ckd" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "A Cochrane systematic review on a very low –protein diet (0.3 – 0.4 g/kg/d) compared to a low-protein diet (0.5 –0.6 g/kg/d) or normal-protein diet ( $0.8 g/kg/d) for 12 months found that it likely had little or no effect on death and/or kidney failure (moderate-quality evidence)." ;
    dmo:evidenceQuote "A Cochrane systematic review on a very low –protein diet (0.3 – 0.4 g/kg/d) compared to a low-protein diet (0.5 –0.6 g/kg/d) or normal-protein diet ( $0.8 g/kg/d) for 12 months found that it likely had little or no effect on death and/or kidney failure (moderate-quality evidence)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/recommendation/cardiometabolic-risk-factor-assessment> a dmo:Recommendation ;
    rdfs:label "Cardiometabolic risk factor assessment" ;
    dmo:populationScope "Patients with CKD and diabetes" ;
    dmo:recommendationId "cardiometabolic-risk-factor-assessment" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Assess cardiometabolic risk factors (e.g., blood pressure, glycated hemoglobin, body weight) every 2–3 months." ;
