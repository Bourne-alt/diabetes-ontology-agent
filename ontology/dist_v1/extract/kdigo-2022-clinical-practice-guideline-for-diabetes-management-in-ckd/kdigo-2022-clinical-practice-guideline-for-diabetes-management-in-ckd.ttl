<https://example.org/dmo/id/drugClass/glucagon-like-peptide-1-receptor-agonist> a dmo:DrugClass ;
    rdfs:label "Glucagon-like peptide-1 receptor agonist" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "glucagon-like-peptide-1-receptor-agonist" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Enhances glucose-dependent insulin secretion, suppresses inappropriately elevated glucagon secretion, delays gastric emptying, and promotes satiety" ;
    dmo:name "Glucagon-like peptide-1 receptor agonist" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "In patients with T2D and CKD who have not achieved individualized glycemic targets despite use of metformin and SGLT2i treatment, or who are unable to use those medications, we recommend a long-acting GLP-1 RA (1B)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/glucagon-like-peptide-1-receptor-agonists> a dmo:DrugClass ;
    rdfs:label "Glucagon-like peptide-1 receptor agonists" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "glucagon-like-peptide-1-receptor-agonists" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Stimulates glucose-dependent insulin release from beta cells, suppresses glucagon release, slows gastric emptying, and decreases appetite" ;
    dmo:name "Glucagon-like peptide-1 receptor agonists" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "In patients with T2D and CKD who have not achieved individualized glycemic targets despite use of metformin and SGLT2i treatment, or who are unable to use those medications, we recommend a long-acting GLP-1 RA (1B)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10A" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin replacement therapy" ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Table S59. SoF table: T2D and CKD (G1 –G5)—insulin degludec versus insulin glargine" ;
    dmo:evidenceQuote "Glycemic control is based on insulin for type 1 diabetes (T1D) and a combination of metformin and sodium –glucose cotransporter-2 inhibitors (SGLT2i) for type 2 diabetes (T2D)." ;
    dmo:evidenceQuote "Risk of hypoglycemia is high in patients with advanced CKD who are treated by glucose-lowering agents that raise blood insulin levels (exogenous insulin, sulfonylureas, meglitinides)." ;
    dmo:evidenceQuote "DPP-4 inhibitor Insulin Sulfonylurea TZD Alpha-glucosidase inhibitor" ;
    dmo:evidenceQuote "The risk of hypoglycemia is generally low with GLP-1 RA when used alone, but risk is increased when GLP-1 RA is used concomitantly with other medications such as sulfonylureas or insulin." ;
    dmo:evidenceQuote "Insulin and glucose-lowering agents for treating people with diabetes and chronic kidney disease." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/drugClass/meglitinides> a dmo:DrugClass ;
