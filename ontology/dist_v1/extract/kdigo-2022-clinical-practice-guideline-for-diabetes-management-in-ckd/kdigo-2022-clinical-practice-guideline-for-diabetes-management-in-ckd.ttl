<https://example.org/dmo/id/contraindication/history-of-urinary-tract-infections> a dmo:Contraindication ;
    rdfs:label "History of urinary tract infections" ;
    dmo:contraCode "history-of-urinary-tract-infections" ;
    dmo:rationale "People with a history of urinary tract infections also may not prefer this class of medications." ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "People with a history of urinary tract infections" ;
    dmo:evidenceQuote "People with a history of urinary tract infections also may not prefer this class of medications." ;
