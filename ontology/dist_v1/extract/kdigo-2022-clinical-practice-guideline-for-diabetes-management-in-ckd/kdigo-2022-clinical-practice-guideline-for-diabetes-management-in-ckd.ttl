    dmo:rationale "Not recommended with eGFR <15 ml/min per 1.73 m2" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "eGFR <15 ml/min per 1.73 m2" ;
    dmo:evidenceQuote "Not recommended with eGFR <15 ml/min per 1.73 m2" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/semaglutide-oral-not-recommended-with-egfr-15-ml-min-per-1-73-m2> a dmo:Contraindication ;
    rdfs:label "Semaglutide (oral) not recommended with eGFR < 15 ml/min per 1.73 m²" ;
