    dmo:scheduleId "vitamin-b12-deficiency-monitoring" ;
    dmo:triggerWindow "when treated with metformin for more than 4 years" ;
    dmo:evidenceQuote "Monitor patients for vitamin B12 deficiency when they are treated with metformin for more than 4 years." ;
