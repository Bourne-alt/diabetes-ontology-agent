<https://example.org/dmo/id/lifestyleIntervention/sick-day-protocol> a dmo:LifestyleIntervention ;
    rdfs:label "Sick day protocol" ;
    dmo:activityTarget "temporarily withhold SGLT2i, keep drinking and eating (if possible), check blood glucose and blood ketone levels more often, and seek medical help early" ;
    dmo:expectedBenefit "reduce risk of diabetic ketoacidosis during illness or excessive exercise or alcohol intake" ;
    dmo:interventionCode "sick-day-protocol" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "Sick day protocol" ;
    dmo:evidenceQuote "Sick day protocol (for illness or excessive exercise or alcohol intake): temporarily withhold SGLT2i, keep drinking and eating (if possible), check blood glucose and blood ketone levels more often, and seek medical help early." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/lifestyleIntervention/smoking-cessation> a dmo:LifestyleIntervention ;
    rdfs:label "Smoking cessation" ;
