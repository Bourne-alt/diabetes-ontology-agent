<https://example.org/dmo/id/monitoringSchedule/vitamin-b12-deficiency-monitoring-in-patients-treated-with-metformin-for-more-than-4-years> a dmo:MonitoringSchedule ;
    rdfs:label "vitamin B12 deficiency monitoring in patients treated with metformin for more than 4 years" ;
    dmo:appliesTo "patients treated with metformin for more than 4 years" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "vitamin B12 deficiency monitoring in patients treated with metformin for more than 4 years" ;
    dmo:scheduleId "vitamin-b12-deficiency-monitoring-in-patients-treated-with-metformin-for-more-than-4-years" ;
    dmo:evidenceQuote "Monitor patients for vitamin B12 deficiency when they are treated with metformin for more than 4 years." ;
