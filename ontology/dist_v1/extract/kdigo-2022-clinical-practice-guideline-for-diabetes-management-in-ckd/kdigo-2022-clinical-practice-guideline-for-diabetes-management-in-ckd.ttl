<https://example.org/dmo/id/diabetesType/t2d> a dmo:DiabetesType ;
    rdfs:label "T2D" ;
    dmo:definition "Patients with T2D and albuminuria are known to be at high risk of CKD progression and cardiovascular events" ;
    dmo:diabetesTypeCode "t2d" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
