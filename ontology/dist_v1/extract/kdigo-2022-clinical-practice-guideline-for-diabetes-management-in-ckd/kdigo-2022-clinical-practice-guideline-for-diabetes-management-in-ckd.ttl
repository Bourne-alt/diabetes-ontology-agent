<https://example.org/dmo/id/monitoringSchedule/egfr-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "eGFR monitoring" ;
    dmo:appliesTo "patients treated with metformin" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "eGFR monitoring" ;
    dmo:scheduleId "egfr-monitoring" ;
    dmo:evidenceQuote "Given that metformin is excreted by the kidneys and there is concern for lactic acid accumulation with a decline in kidney function, it is important to monitor the eGFR at least annually when a patient is on metformin treatment." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/egfr-monitoring-in-patients-treated-with-metformin> a dmo:MonitoringSchedule ;
    rdfs:label "eGFR monitoring in patients treated with metformin" ;
    dmo:appliesTo "patients treated with metformin" ;
    dmo:frequencyMonths "6"^^xsd:integer ;
    dmo:name "eGFR monitoring in patients treated with metformin" ;
    dmo:scheduleId "egfr-monitoring-in-patients-treated-with-metformin" ;
    dmo:evidenceQuote "Monitor eGFR in patients treated with metformin. Increase the frequency of monitoring when the eGFR is <60 ml/min per 1.73 m 2 (Figure 27 )." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/estimated-glomerular-filtration-rate> a dmo:MonitoringSchedule ;
    rdfs:label "Estimated Glomerular Filtration Rate" ;
    dmo:appliesTo "patients with CKD and diabetes" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Estimated Glomerular Filtration Rate" ;
    dmo:scheduleId "estimated-glomerular-filtration-rate" ;
    dmo:evidenceQuote "Establish a register by performing comprehensive risk assessment, including blood/urine and eye/foot examination every 12–18 months, as recommended by practice guidelines." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/eye-examination> a dmo:MonitoringSchedule ;
    rdfs:label "Eye Examination" ;
    dmo:appliesTo "patients with CKD and diabetes" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Eye Examination" ;
    dmo:scheduleId "eye-examination" ;
    dmo:evidenceQuote "Establish a register by performing comprehensive risk assessment, including blood/urine and eye/foot examination every 12–18 months, as recommended by practice guidelines." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/foot-examination> a dmo:MonitoringSchedule ;
    rdfs:label "Foot Examination" ;
    dmo:appliesTo "patients with CKD and diabetes" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Foot Examination" ;
    dmo:scheduleId "foot-examination" ;
    dmo:evidenceQuote "Establish a register by performing comprehensive risk assessment, including blood/urine and eye/foot examination every 12–18 months, as recommended by practice guidelines." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/glycated-hemoglobin> a dmo:MonitoringSchedule ;
    rdfs:label "Glycated Hemoglobin" ;
    dmo:appliesTo "patients with CKD and diabetes" ;
    dmo:frequencyMonths "3"^^xsd:integer ;
    dmo:name "Glycated Hemoglobin" ;
    dmo:scheduleId "glycated-hemoglobin" ;
    dmo:evidenceQuote "Assess cardiometabolic risk factors (e.g., blood pressure, glycated hemoglobin, body weight) every 2 –3 months." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/hba1c> a dmo:MonitoringSchedule ;
    rdfs:label "HbA1c" ;
    dmo:appliesTo "patients with diabetes" ;
    dmo:frequencyMonths "6"^^xsd:integer ;
    dmo:name "HbA1c" ;
    dmo:scheduleId "hba1c" ;
    dmo:evidenceQuote "Monitoring long-term glycemic control by HbA1c twice per year is reasonable for patients with diabetes." ;
    dmo:evidenceQuote "HbA1c may be measured as often as 4 times per year if the glycemic target is not met or after a change in glucose-lowering therapy." ;
    dmo:evidenceQuote "Practice Point 2.1.1: Monitoring long-term glycemic con- trol by HbA1c twice per year is reasonable for patients with diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/hemoglobin-a1c> a dmo:MonitoringSchedule ;
    rdfs:label "Hemoglobin A1c" ;
    dmo:appliesTo "patients with T1D or T2D" ;
    dmo:frequencyMonths "3"^^xsd:integer ;
    dmo:name "Hemoglobin A1c" ;
    dmo:scheduleId "hemoglobin-a1c" ;
    dmo:evidenceQuote "We recommend using hemoglobin A1c (HbA1c) to monitor glycemic control in patients with diabetes and CKD (1C)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/monitoring-of-potassium-during-treatment> a dmo:MonitoringSchedule ;
    rdfs:label "Monitoring of potassium during treatment" ;
    dmo:appliesTo "patients with CKD treated with an ACEi or ARB" ;
    dmo:frequencyMonths "3"^^xsd:integer ;
    dmo:name "Monitoring of potassium during treatment" ;
    dmo:scheduleId "monitoring-of-potassium-during-treatment" ;
    dmo:evidenceQuote "Monitoring of potassium during treatment is already indicated for patients with CKD treated with an ACEi or ARB;" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/monitoring-of-serum-creatinine-and-potassium> a dmo:MonitoringSchedule ;
    rdfs:label "Monitoring of serum creatinine and potassium" ;
    dmo:appliesTo "patients on ACEi or ARB treatment" ;
    dmo:frequencyMonths "4"^^xsd:integer ;
    dmo:name "Monitoring of serum creatinine and potassium" ;
    dmo:scheduleId "monitoring-of-serum-creatinine-and-potassium" ;
    dmo:triggerWindow "within 2–4 weeks after starting or changing dose" ;
    dmo:evidenceQuote "Monitor serum creatinine and potassium (within 2–4 weeks after starting or changing dose)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/nutrition-education> a dmo:MonitoringSchedule ;
    rdfs:label "Nutrition Education" ;
    dmo:appliesTo "Patients with longstanding diabetes and CKD" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Nutrition Education" ;
    dmo:scheduleId "nutrition-education" ;
    dmo:evidenceQuote "Patients with longstanding diabetes and CKD should have access to nutrition education yearly, as well as at critical times to help build self-management skills." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/nutrition-education-at-diagnosis> a dmo:MonitoringSchedule ;
    rdfs:label "Nutrition Education at Diagnosis" ;
    dmo:appliesTo "Patients with newly diagnosed diabetes" ;
    dmo:name "Nutrition Education at Diagnosis" ;
    dmo:scheduleId "nutrition-education-at-diagnosis" ;
    dmo:triggerWindow "at diagnosis" ;
    dmo:evidenceQuote "Patients with newly diagnosed diabetes should be referred for individualized nutrition education at diagnosis." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/regular-reassessment-of-glycemia-albuminuria-bp-cvd-risk-and-lipids> a dmo:MonitoringSchedule ;
    rdfs:label "Regular reassessment of glycemia, albuminuria, BP, CVD risk, and lipids" ;
    dmo:appliesTo "All patients (T1D and T2D)" ;
    dmo:frequencyMonths "6"^^xsd:integer ;
    dmo:name "Regular reassessment of glycemia, albuminuria, BP, CVD risk, and lipids" ;
    dmo:scheduleId "regular-reassessment-of-glycemia-albuminuria-bp-cvd-risk-and-lipids" ;
    dmo:evidenceQuote "Regular reassessment of glycemia, albuminuria, BP , CVD risk, and lipids" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/regular-risk-factor-reassessment> a dmo:MonitoringSchedule ;
    rdfs:label "Regular risk factor reassessment" ;
    dmo:appliesTo "all patients with diabetes and CKD" ;
    dmo:frequencyMonths "6"^^xsd:integer ;
    dmo:name "Regular risk factor reassessment" ;
    dmo:scheduleId "regular-risk-factor-reassessment" ;
    dmo:evidenceQuote "Regular risk factor reassessment (every 3–6 months)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/serum-potassium-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Serum Potassium Monitoring" ;
    dmo:appliesTo "patients on finerenone therapy" ;
    dmo:frequencyMonths "4"^^xsd:integer ;
    dmo:name "Serum Potassium Monitoring" ;
    dmo:scheduleId "serum-potassium-monitoring" ;
    dmo:triggerWindow "1 month after drug initiation, 4 months after drug initiation, and every 4 months thereafter" ;
    dmo:evidenceQuote "In the FIDELIO-DKD and FIGARO-DKD trials, serum potassium was checked 1 month after drug initiation, 4 months after drug initiation, and every 4 months thereafter." ;
    dmo:evidenceQuote "Monitor K+ at 1 month after initiation and then every 4 months" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/monitoringSchedule/urine-albumin-to-creatinine-ratio> a dmo:MonitoringSchedule ;
    rdfs:label "Urine Albumin-to-Creatinine Ratio" ;
    dmo:appliesTo "patients with CKD and diabetes" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Urine Albumin-to-Creatinine Ratio" ;
    dmo:scheduleId "urine-albumin-to-creatinine-ratio" ;
    dmo:evidenceQuote "Establish a register by performing comprehensive risk assessment, including blood/urine and eye/foot examination every 12–18 months, as recommended by practice guidelines." ;
