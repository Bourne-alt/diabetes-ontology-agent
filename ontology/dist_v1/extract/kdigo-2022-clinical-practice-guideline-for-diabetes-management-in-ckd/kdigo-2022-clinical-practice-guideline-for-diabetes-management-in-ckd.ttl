    dmo:triggerCriteria "patients at increased risk of volume depletion" ;
    dmo:evidenceQuote "such as patients at increased risk of volume depletion, genital infections, or lower-limb amputation due to foot ulcerations." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/iron-supplements> a dmo:Contraindication ;
    rdfs:label "Iron Supplements" ;
    dmo:contraCode "iron-supplements" ;
    dmo:rationale "HbA1c is lowered by shortened survival or age of erythrocytes from anemia, transfusions, and use of erythropoiesis-stimulating agents or iron-replacement therapies." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "use of iron supplements" ;
    dmo:evidenceQuote "HbA1c is lowered by shortened survival or age of erythrocytes from anemia, transfusions, and use of erythropoiesis-stimulating agents or iron-replacement therapies." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/long-acting-or-renally-cleared-sulfonylureas-should-be-avoided-at-low-egfr> a dmo:Contraindication ;
    rdfs:label "Long-acting or renally cleared sulfonylureas should be avoided at low eGFR" ;
    dmo:contraCode "long-acting-or-renally-cleared-sulfonylureas-should-be-avoided-at-low-egfr" ;
    dmo:rationale "should be avoided at low eGFRs" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "low eGFR" ;
    dmo:evidenceQuote "For example, sulfonylureas that are long-acting or cleared by the kidney should be avoided at low eGFRs." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/metformin-not-initiated-with-egfr-30-ml-min-per-1-73-m2> a dmo:Contraindication ;
    rdfs:label "Metformin not initiated with eGFR < 30 ml/min per 1.73 m²" ;
    dmo:contraCode "metformin-not-initiated-with-egfr-30-ml-min-per-1-73-m2" ;
    dmo:rationale "Figure 27: eGFR < 30 Stop metformin; do not initiate metformin" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "eGFR < 30 Stop metformin; do not initiate metformin" ;
    dmo:evidenceQuote "eGFR < 30 Stop metformin; do not initiate metformin" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/multiple-endocrine-neoplasia-2> a dmo:Contraindication ;
    rdfs:label "Multiple Endocrine Neoplasia 2" ;
    dmo:contraCode "multiple-endocrine-neoplasia-2" ;
    dmo:rationale "GLP-1 RA are contraindicated for patients with a history of medullary thyroid cancer or with multiple endocrine neoplasia 2 (MEN-2), although these are rare conditions, and for patients with a history of acute pancreatitis." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "multiple endocrine neoplasia 2 (MEN-2)" ;
    dmo:evidenceQuote "GLP-1 RA are contraindicated for patients with a history of medullary thyroid cancer or with multiple endocrine neoplasia 2 (MEN-2), although these are rare conditions, and for patients with a history of acute pancreatitis." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/nonsteroidal-mra-in-women-planning-for-pregnancy-or-who-become-pregnant> a dmo:Contraindication ;
    rdfs:label "Nonsteroidal MRA in women planning for pregnancy or who become pregnant" ;
    dmo:contraCode "nonsteroidal-mra-in-women-planning-for-pregnancy-or-who-become-pregnant" ;
    dmo:rationale "For nonsteroidal MRA, there is no experience with pregnancy, so women who are planning for pregnancy or who become pregnant on treatment should have the drug discontinued." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "women who are planning for pregnancy or who become pregnant on treatment" ;
    dmo:evidenceQuote "For nonsteroidal MRA, there is no experience with pregnancy, so women who are planning for pregnancy or who become pregnant on treatment should have the drug discontinued." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/pregnancy> a dmo:Contraindication ;
    rdfs:label "Pregnancy" ;
    dmo:contraCode "pregnancy" ;
    dmo:rationale "The use of ACEi and ARB treatment has been associated with an increased risk of adverse effects to the fetus during pregnancy." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "Women who are planning for pregnancy or who are pregnant while on RAS blockade treatment" ;
    dmo:evidenceQuote "Women who are planning for pregnancy or who are pregnant while on RAS blockade treatment should have the drug discontinued (see Practice Point 1.2.4)." ;
    dmo:evidenceQuote "Practice Point 1.2.4: Advise contraception in women who are receiving ACEi or ARB therapy and discontinue these agents in women who are considering pregnancy or who become pregnant." ;
    dmo:evidenceQuote "Pregnancy outcome following exposure to angiotensin-converting enzyme inhibitors or angiotensin receptor antagonists: a systematic review. Hypertension . 2012;60:444 – 450." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/prolonged-fasting> a dmo:Contraindication ;
    rdfs:label "Prolonged fasting" ;
    dmo:contraCode "prolonged-fasting" ;
    dmo:rationale "Patients may be at greater risk for ketosis" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "During times of prolonged fasting, surgery, or critical medical illness" ;
    dmo:evidenceQuote "It is reasonable to withhold SGLT2i during times of prolonged fasting, surgery, or critical medical illness (when patients may be at greater risk for ketosis)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/red-blood-cell-transfusions> a dmo:Contraindication ;
    rdfs:label "Red Blood Cell Transfusions" ;
    dmo:contraCode "red-blood-cell-transfusions" ;
    dmo:rationale "HbA1c is lowered by shortened survival or age of erythrocytes from anemia, transfusions, and use of erythropoiesis-stimulating agents or iron-replacement therapies." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "treatment by red blood cell transfusions" ;
    dmo:evidenceQuote "HbA1c is lowered by shortened survival or age of erythrocytes from anemia, transfusions, and use of erythropoiesis-stimulating agents or iron-replacement therapies." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/kdigo-2022-clinical-practice-guideline-for-diabetes-management-in-ckd> .

<https://example.org/dmo/id/contraindication/semaglutide-injection-with-egfr-15-ml-min-per-1-73-m2> a dmo:Contraindication ;
    rdfs:label "Semaglutide (injection) with eGFR <15 ml/min per 1.73 m2" ;
