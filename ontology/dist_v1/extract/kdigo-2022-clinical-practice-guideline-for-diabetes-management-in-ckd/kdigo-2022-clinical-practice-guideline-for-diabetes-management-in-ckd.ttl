    dmo:recommendationId "advise-contraception-in-women-who-are-receiving-acei-or-arb-therapy-and-discontinue-these-agents-in-women-who-are-considering-pregnancy-or-who-become-pregnant" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "Advise contraception in women who are receiving ACEi or ARB therapy and discontinue these agents in women who are considering pregnancy or who become pregnant." ;
    dmo:evidenceQuote "Practice Point 1.2.4: Advise contraception in women who are receiving ACEi or ARB therapy and discontinue these agents in women who are considering pregnancy or who become pregnant." ;
