<https://example.org/dmo/id/complication/diabetic-ketoacidosis> a dmo:Complication ;
    rdfs:label "Diabetic Ketoacidosis" ;
    dmo:affectedOrgan "Systemic" ;
    dmo:complicationCode "diabetic-ketoacidosis" ;
    dmo:definition "Diabetic ketoacidosis (DKA) is a serious complication of diabetes characterized by hyperglycemia, ketonemia, and metabolic acidosis." ;
    dmo:isEmergency "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005070" ;
    dmo:name "Diabetic Ketoacidosis" ;
    dmo:onsetPattern "Acute" ;
    dmo:evidenceQuote "Diagnostic criteria: all three of the following must be present • capillary blood glucose above 11 mmol/L • capillary ketones above 3 mmol/L or urine ketones ++ or more • venous pH less than 7.3 and/or bicarbonate less than 15 mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_single_page_pathway_march_2023_updated> .

<https://example.org/dmo/id/contraindication/more-cautious-fluid-replacement-in-young-people-aged-18-25-years-elderly-pregnant-heart-or-renal-failure> a dmo:Contraindication ;
    rdfs:label "More cautious fluid replacement in young people aged 18-25 years, elderly, pregnant, heart or renal failure" ;
    dmo:contraCode "more-cautious-fluid-replacement-in-young-people-aged-18-25-years-elderly-pregnant-heart-or-renal-failure" ;
    dmo:rationale "More cautious fluid replacement in young people aged 18-25 years, elderly, pregnant, heart or renal failure. (Consider HDU and/or central line)" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "young people aged 18-25 years, elderly, pregnant, heart or renal failure" ;
    dmo:evidenceQuote "More cautious fluid replacement in young people aged 18-25 years, elderly, pregnant, heart or renal failure. (Consider HDU and/or central line)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_single_page_pathway_march_2023_updated> .

<https://example.org/dmo/id/drugClass/intravenous-insulin-infusion> a dmo:DrugClass ;
    rdfs:label "Intravenous Insulin Infusion" ;
    dmo:adminRoute "Intravenous" ;
    dmo:drugClassCode "intravenous-insulin-infusion" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin infusion to lower blood glucose and reduce ketone production in diabetic ketoacidosis" ;
    dmo:name "Intravenous Insulin Infusion" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Commence a fixed rate intravenous insulin infusion (FRIII). (0.1unit/kg/hr based on estimate of weight) 50 units human soluble insulin (Actrapid® or Humulin S®) made up to 50ml with 0.9% sodium chloride solution." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_single_page_pathway_march_2023_updated> .

<https://example.org/dmo/id/labTest/arterial-blood-gases> a dmo:LabTest ;
    rdfs:label "Arterial Blood Gases" ;
    dmo:definition "Arterial blood gases are measured if oxygen saturation is less than 92% to assess gas exchange." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "arterial-blood-gases" ;
    dmo:name "Arterial Blood Gases" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "• Measure arterial blood gases and repeat chest radiograph if oxygen saturation less than 92%" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_02_single_page_pathway_march_2023_updated> .

