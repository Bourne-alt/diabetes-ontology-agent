<https://example.org/dmo/id/recommendation/genetic-counseling-for-monogenic-diabetes> a dmo:Recommendation ;
    rdfs:label "Genetic counseling for monogenic diabetes" ;
    dmo:populationScope "People, partners, or family members who have monogenic diabetes" ;
    dmo:recommendationId "genetic-counseling-for-monogenic-diabetes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "If you, your partner, or family members have monogenic diabetes, you may want to consider genetic counseling. Genetic counseling can help you decide if you should get tested for monogenic diabetes. Genetic counseling can also help you understand the risk of your children developing this disease." ;
    dmo:evidenceQuote "If you, your partner, or family members have monogenic diabetes, you may want to consider genetic counseling NIH external link. Genetic counseling can help you decide if you should get tested for monogenic diabetes. Genetic counseling can also help you understand the risk of your children developing this disease." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-monogenic-diabetes> .

