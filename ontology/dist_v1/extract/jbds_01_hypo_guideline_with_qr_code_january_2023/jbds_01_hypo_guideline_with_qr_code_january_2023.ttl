    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "10-iv-glucose" ;
    dmo:name "10% IV glucose" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "10% IV glucose at 100ml/hr.  Volume should be determined by clinical circumstances (refer to Appendix 5 for administration details)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/20-glucose> a dmo:Medication ;
