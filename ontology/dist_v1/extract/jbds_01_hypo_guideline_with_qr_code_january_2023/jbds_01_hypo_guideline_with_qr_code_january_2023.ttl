    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/incorrect-type-of-insulin-or-oral-hypoglycaemia-therapy-prescribed-and-administered> a dmo:Contraindication ;
    rdfs:label "Incorrect type of insulin or oral hypoglycaemia therapy prescribed and administered" ;
    dmo:contraCode "incorrect-type-of-insulin-or-oral-hypoglycaemia-therapy-prescribed-and-administered" ;
    dmo:rationale "Administering the wrong type of insulin or oral hypoglycaemic agent can lead to hypoglycaemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Incorrect type of insulin or oral hypoglycaemia therapy prescribed and administered" ;
    dmo:evidenceQuote "Incorrect type of insulin or oral hypoglycaemia therapy prescribed and administered" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/intensive-glucose-control-in-critical-care> a dmo:Contraindication ;
    rdfs:label "Intensive glucose control in critical care" ;
    dmo:contraCode "intensive-glucose-control-in-critical-care" ;
    dmo:rationale "the NICE-SUGAR study of over 6000 people treated in intensive care reported an increased incidence of hypoglycaemia and 90-day mortality in people randomised to intensive glucose control (target glucose 4.5-6.0mmol/L)" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "people being treated in a critical care environment" ;
    dmo:evidenceQuote "The NICE-SUGAR study of over 6000 people treated in intensive care reported an increased incidence of hypoglycaemia and 90-day mortality in people randomised to intensive glucose control (target glucose 4.5-6.0mmol/L)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/iv-insulin-infusion-with-or-without-glucose-infusion> a dmo:Contraindication ;
    rdfs:label "IV insulin infusion with or without glucose infusion" ;
    dmo:contraCode "iv-insulin-infusion-with-or-without-glucose-infusion" ;
    dmo:rationale "IV insulin infusion, especially without adequate glucose, can cause rapid hypoglycaemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "IV insulin infusion with or without glucose infusion" ;
    dmo:evidenceQuote "IV insulin infusion with or without glucose infusion" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/major-amputation-of-a-limb> a dmo:Contraindication ;
    rdfs:label "Major amputation of a limb" ;
    dmo:contraCode "major-amputation-of-a-limb" ;
    dmo:rationale "Major amputation can lead to metabolic changes and increased risk of hypoglycaemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Major amputation of a limb" ;
    dmo:evidenceQuote "Major amputation of a limb" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/mobilisation-after-illness> a dmo:Contraindication ;
    rdfs:label "Mobilisation after illness" ;
    dmo:contraCode "mobilisation-after-illness" ;
    dmo:rationale "Mobilisation after illness can increase glucose utilization and precipitate hypoglycaemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Mobilisation after illness" ;
    dmo:evidenceQuote "Mobilisation after illness" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/omitting-insulin-injection-if-due> a dmo:Contraindication ;
    rdfs:label "Omitting insulin injection if due" ;
    dmo:contraCode "omitting-insulin-injection-if-due" ;
    dmo:rationale "DO NOT omit insulin injection if due. The insulin injection about to be given is unlikely to be the insulin dose that was active at the time of the hypoglycaemia episode and so should not be omitted." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "if due" ;
    dmo:evidenceQuote "DO NOT omit insulin injection if due. The insulin injection about to be given is unlikely to be the insulin dose that was active at the time of the hypoglycaemia episode and so should not be omitted." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/omitting-the-next-insulin-injection> a dmo:Contraindication ;
    rdfs:label "Omitting the next insulin injection" ;
    dmo:contraCode "omitting-the-next-insulin-injection" ;
    dmo:rationale "Please DO NOT omit the next insulin injection or start variable rate intravenous insulin infusion to ‘stabilise’ blood glucose." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "the next insulin injection" ;
    dmo:evidenceQuote "Please DO NOT omit the next insulin injection or start variable rate intravenous insulin infusion to ‘stabilise’ blood glucose." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/orange-juice-for-hypoglycaemia-treatment-in-chronic-kidney-disease-stage-4-or-5> a dmo:Contraindication ;
    rdfs:label "Orange Juice for Hypoglycaemia Treatment in Chronic Kidney Disease Stage 4 or 5" ;
    dmo:contraCode "orange-juice-for-hypoglycaemia-treatment-in-chronic-kidney-disease-stage-4-or-5" ;
    dmo:rationale "Caution should be exercised in people with chronic kidney disease (CKD) stage 4 or CKD stage 5 due to the potassium content" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Use of orange juice for treating hypoglycaemia in people with chronic kidney disease stage 4 or stage 5" ;
    dmo:evidenceQuote "Orange juice (which contains fructose) remains a popular treatment for hypoglycaemia although caution should be exercised in people with chronic kidney disease (CKD) stage 4 or CKD stage 5 due to the potassium content." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/recovery-from-acute-illness-stress> a dmo:Contraindication ;
    rdfs:label "Recovery from acute illness/stress" ;
    dmo:contraCode "recovery-from-acute-illness-stress" ;
    dmo:rationale "Recovery from acute illness or stress can lead to hypoglycaemia due to altered metabolic state" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Recovery from acute illness/stress" ;
