    dmo:evidenceQuote "use of web-linked glucose meters, an enhanced diabetes team and diabetes training for non-specialist medical staff" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/device/glucosemeter> a dmo:Device ;
    rdfs:label "GlucoseMeter" ;
    dmo:deviceCode "glucosemeter" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "GlucoseMeter" ;
    dmo:evidenceQuote "Repeat capillary blood glucose measurement 10-15 minutes later. If it is still less than 4.0mmol/L, repeat step 3 (no more than 3 treatments in total)." ;
    dmo:evidenceQuote "Ensure regular capillary blood glucose monitoring is continued for at least 24 to 48 hours." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/device/hypo-box> a dmo:Device ;
    rdfs:label "Hypo box" ;
    dmo:deviceCode "hypo-box" ;
    dmo:deviceType "KetoneTestKit" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Hypo box" ;
    dmo:evidenceQuote "These boxes are often in a prominent place e.g. on resuscitation trolleys and are brightly coloured for instant recognition.  They contain all the equipment required to treat hypoglycaemia from cartons of fruit juice to IV cannulas (70)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/device/insulin-pump> a dmo:Device ;
    rdfs:label "insulin pump" ;
    dmo:deviceCode "insulin-pump" ;
    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "insulin pump" ;
    dmo:evidenceQuote "For some people, especially those using insulin pumps and/or wearable glucose sensors, a range of 4-6mmol/L may be their normal when they are not eating." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/device/insulinpump> a dmo:Device ;
    rdfs:label "InsulinPump" ;
    dmo:deviceCode "insulinpump" ;
    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "InsulinPump" ;
    dmo:evidenceQuote "People who self-manage their insulin pumps (CSII) may not need a long-acting carbohydrate, but should take initial treatment as outlined and adjust their pump settings appropriately." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

