    dmo:recommendationId "any-blood-glucose-less-than-4-0mmol-l-should-be-treated-during-hospital-admission" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "During a hospital admission, any blood glucose less than 4.0mmol/L should be treated." ;
    dmo:evidenceQuote "During a hospital admission, any blood glucose less than 4.0mmol/L should be treated." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/availability-of-iv-glucose-preparation> a dmo:Recommendation ;
    rdfs:label "Availability of IV Glucose Preparation" ;
    dmo:populationScope "Hospitalised patients with diabetes mellitus" ;
    dmo:recommendationId "availability-of-iv-glucose-preparation" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Chosen preparation of IV glucose should also be included or kept nearby with appropriate giving set." ;
    dmo:evidenceQuote "Chosen preparation of IV glucose should also be included or kept nearby with appropriate giving set." ;
