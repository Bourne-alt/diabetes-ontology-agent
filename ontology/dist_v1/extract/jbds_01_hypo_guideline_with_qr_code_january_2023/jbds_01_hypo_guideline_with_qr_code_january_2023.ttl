<https://example.org/dmo/id/diabetesType/type-1-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 1 diabetes" ;
    dmo:definition "Impaired awareness of hypoglycaemia (IAH) is an acquired syndrome associated with insulin treatment. IAH results in the warning symptoms of hypoglycaemia becoming diminished in intensity, altered in nature or lost altogether. This increases the vulnerability of affected individuals of progression to severe hypoglycaemia. The prevalence of IAH increases with duration of diabetes and is more common in type 1 than in type 2 diabetes (31)." ;
    dmo:diabetesTypeCode "type-1-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 1 diabetes" ;
    dmo:prevalenceShare "0.1"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "The prevalence of IAH increases with duration of diabetes and is more common in type 1 than in type 2 diabetes (31)." ;
    dmo:evidenceQuote "CSII or “insulin pumps” administer rapid-acting insulin on a continuous basis via a subcutaneous cannula. CSII is used by some people with type 1 diabetes and some are taught that long-acting carbohydrate may not always be required following hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/diabetesType/type-1-diabetes-mellitus-t1dm> a dmo:DiabetesType ;
    rdfs:label "Type 1 diabetes mellitus (T1DM)" ;
    dmo:diabetesTypeCode "type-1-diabetes-mellitus-t1dm" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:name "Type 1 diabetes mellitus (T1DM)" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "People with type 1 diabetes mellitus (T1DM) experience around two episodes of mild hypoglycaemia per week." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 2 diabetes" ;
    dmo:definition "Multivariable logistic regression analysis showed that age >70 years, cognitive dysfunction and nephropathy were independently associated with hypoglycaemia for people in hospital with T2DM (35)." ;
    dmo:diabetesTypeCode "type-2-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "Type 2 diabetes" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "Multivariable logistic regression analysis showed that age >70 years, cognitive dysfunction and nephropathy were independently associated with hypoglycaemia for people in hospital with T2DM (35)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/acarbose> a dmo:DrugClass ;
    rdfs:label "Acarbose" ;
    dmo:drugClassCode "acarbose" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Prevents glucose from rising rather than lowering glucose concentrations" ;
    dmo:name "Acarbose" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "metformin, pioglitazone, DPP-4 inhibitors, acarbose, SLGT-2 inhibitors and GLP-1 analogues prescribed without insulin or an insulin secretagogue (sulfonylurea and repaglinide) are unlikely to result in hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/dpp-4-inhibitors> a dmo:DrugClass ;
    rdfs:label "DPP-4 inhibitors" ;
    dmo:drugClassCode "dpp-4-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Prevents glucose from rising rather than lowering glucose concentrations" ;
    dmo:name "DPP-4 inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "metformin, pioglitazone, DPP-4 inhibitors, acarbose, SLGT-2 inhibitors and GLP-1 analogues prescribed without insulin or an insulin secretagogue (sulfonylurea and repaglinide) are unlikely to result in hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/dpp-iv-inhibitors> a dmo:DrugClass ;
    rdfs:label "DPP-IV inhibitors" ;
    dmo:drugClassCode "dpp-iv-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Dipeptidyl peptidase-4 inhibitor" ;
    dmo:name "DPP-IV inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Temporary substitution of insulin therapy for oral agents (particularly using DPP-IV inhibitors) in the inpatient setting has been shown to reduce rates of hypoglycaemia while maintaining glycaemic control." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/glp-1-agonists> a dmo:DrugClass ;
    rdfs:label "GLP-1 agonists" ;
    dmo:drugClassCode "glp-1-agonists" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Glucagon-like peptide-1 agonist" ;
    dmo:name "GLP-1 agonists" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "GLP-1 agonists (GI side effects)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/glp-1-analogues> a dmo:DrugClass ;
    rdfs:label "GLP-1 analogues" ;
    dmo:drugClassCode "glp-1-analogues" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Prevents glucose from rising rather than lowering glucose concentrations" ;
    dmo:name "GLP-1 analogues" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "metformin, pioglitazone, DPP-4 inhibitors, acarbose, SLGT-2 inhibitors and GLP-1 analogues prescribed without insulin or an insulin secretagogue (sulfonylurea and repaglinide) are unlikely to result in hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10A" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin is a hormone that lowers blood glucose by promoting glucose uptake into cells and inhibiting glucose production in the liver." ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "for people receiving insulin or sulfonylurea therapy as treatment for their diabetes, evidence would suggest that achieving good glycaemic control while avoiding hypoglycaemia remains very difficult." ;
    dmo:evidenceQuote "For the majority of people on any insulin preparation and/or any insulin secretagogues, consider intervening at a capillary blood glucose (CBG) of <6.0mmol/L to prevent hypoglycaemia." ;
    dmo:evidenceQuote "If the person with diabetes in hospital has an insulin infusion in situ, stop immediately." ;
    dmo:evidenceQuote "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    dmo:evidenceQuote "Hypoglycaemia is the commonest side-effect of insulin or sulfonylurea therapy used to treat diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/insulin-secretagogues> a dmo:DrugClass ;
    rdfs:label "Insulin Secretagogues" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10B" ;
    dmo:drugClassCode "insulin-secretagogues" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin secretagogues stimulate insulin secretion from pancreatic beta cells by closing ATP-sensitive potassium channels." ;
    dmo:name "Insulin Secretagogues" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "For the majority of people on any insulin preparation and/or any insulin secretagogues, consider intervening at a capillary blood glucose (CBG) of <6.0mmol/L to prevent hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/insulin-sulfonylurea-therapy> a dmo:DrugClass ;
    rdfs:label "Insulin & sulfonylurea therapy" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "insulin-sulfonylurea-therapy" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:name "Insulin & sulfonylurea therapy" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "age >75 years, insulin & sulfonylurea therapy, black and Asian ethnicity, emergency (rather than elective) admission, lower eGFR, raised inflammatory markers, hyponatraemia (<125mmol/L) and low albumin were the strongest predictors of hypoglycaemia in people with diabetes admitted to medical or surgical wards (not intensive therapy units) (36)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/long-acting-insulin> a dmo:DrugClass ;
    rdfs:label "Long-Acting Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE" ;
    dmo:drugClassCode "long-acting-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provide a basal level of insulin over 24 hours" ;
    dmo:name "Long-Acting Insulin" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    dmo:evidenceQuote "After acute treatment, consideration should be given to whether the hypoglycaemia is likely to be prolonged, i.e. as a result of long-acting insulin or sulfonylurea therapy; these people may require a continuous infusion of glucose to maintain blood glucose levels." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/long-acting-insulin-therapy> a dmo:DrugClass ;
    rdfs:label "Long-Acting Insulin Therapy" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE" ;
    dmo:drugClassCode "long-acting-insulin-therapy" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides a basal level of insulin over an extended period" ;
    dmo:name "Long-Acting Insulin Therapy" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/metformin> a dmo:DrugClass ;
    rdfs:label "Metformin" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Prevents glucose from rising rather than lowering glucose concentrations" ;
    dmo:name "Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "metformin, pioglitazone, DPP-4 inhibitors, acarbose, SLGT-2 inhibitors and GLP-1 analogues prescribed without insulin or an insulin secretagogue (sulfonylurea and repaglinide) are unlikely to result in hypoglycaemia." ;
    dmo:evidenceQuote "metformin (GI side effects, caution with renal impairment and slower onset of action)" ;
    dmo:evidenceQuote "A middle-aged man with T2DM on metformin with an HbA1c usually around 48mmol/L would not be expected to be at high risk of hypoglycaemia and so may not need any action following blood glucose readings in the range of 4.0-6.0mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/pioglitazone> a dmo:DrugClass ;
    rdfs:label "Pioglitazone" ;
    dmo:drugClassCode "pioglitazone" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Prevents glucose from rising rather than lowering glucose concentrations" ;
    dmo:name "Pioglitazone" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "metformin, pioglitazone, DPP-4 inhibitors, acarbose, SLGT-2 inhibitors and GLP-1 analogues prescribed without insulin or an insulin secretagogue (sulfonylurea and repaglinide) are unlikely to result in hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/sglt-2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT-2 inhibitors" ;
    dmo:drugClassCode "sglt-2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Sodium-glucose co-transporter-2 inhibitor" ;
    dmo:name "SGLT-2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "SGLT-2 inhibitors (risk of euglycaemic DKA)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/slgt-2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SLGT-2 inhibitors" ;
    dmo:drugClassCode "slgt-2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Prevents glucose from rising rather than lowering glucose concentrations" ;
    dmo:name "SLGT-2 inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "metformin, pioglitazone, DPP-4 inhibitors, acarbose, SLGT-2 inhibitors and GLP-1 analogues prescribed without insulin or an insulin secretagogue (sulfonylurea and repaglinide) are unlikely to result in hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/sulfonylurea> a dmo:DrugClass ;
    rdfs:label "Sulfonylurea" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10B" ;
    dmo:drugClassCode "sulfonylurea" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Sulfonylureas stimulate insulin secretion from pancreatic beta cells by closing ATP-sensitive potassium channels." ;
    dmo:name "Sulfonylurea" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "for people receiving insulin or sulfonylurea therapy as treatment for their diabetes, evidence would suggest that achieving good glycaemic control while avoiding hypoglycaemia remains very difficult." ;
    dmo:evidenceQuote "Promote the prescription of hypoglycaemia “rescue” treatment for all people with diabetes in hospital on insulin or sulfonylurea therapy." ;
    dmo:evidenceQuote "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    dmo:evidenceQuote "Hypoglycaemia is the commonest side-effect of insulin or sulfonylurea therapy used to treat diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/drugClass/sulfonylurea-therapy> a dmo:DrugClass ;
    rdfs:label "Sulfonylurea Therapy" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BB" ;
    dmo:drugClassCode "sulfonylurea-therapy" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Stimulates insulin secretion from pancreatic beta cells" ;
    dmo:name "Sulfonylurea Therapy" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Glucagon is only licensed for insulin induced hypoglycaemia and may be less effective in people prescribed sulfonylurea therapy (may take up to 15 minutes to take effect). Glucagon mobilises glycogen from the liver and will be less effective in those who are chronically malnourished (including those who have had a prolonged period of starvation), abuse alcohol or have chronic liver disease." ;
    dmo:evidenceQuote "The risk of hypoglycaemia with sulfonylurea therapy is often underestimated and due to the duration of action of these tablets, is frequently prolonged." ;
    dmo:evidenceQuote "Nocturnal hypoglycaemia (blood glucose <3.9mmol/L) was more common in people treated with sulfonylurea therapy than insulin therapy (75.3% versus 59.3% respectively)." ;
    dmo:evidenceQuote "An 84-year-old woman with T2DM on high dose sulfonylurea therapy admitted with a urinary tract infection and acute kidney injury would be at substantially higher risk of hypoglycaemia." ;
    dmo:evidenceQuote "After acute treatment, consideration should be given to whether the hypoglycaemia is likely to be prolonged, i.e. as a result of long-acting insulin or sulfonylurea therapy; these people may require a continuous infusion of glucose to maintain blood glucose levels." ;
    dmo:evidenceQuote "The gap was largest in those with T2DM taking sulfonylurea therapy and smallest in those with T1DM" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/labTest/blood-glucose> a dmo:LabTest ;
    rdfs:label "Blood Glucose" ;
    dmo:definition "Blood glucose level less than 4.0mmol/L is defined as hypoglycaemia. For people with a blood glucose level of 4.0-6.0mmol/L, the risk of looming hypoglycaemia should be considered." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-glucose" ;
    dmo:loincCode "15577-6" ;
    dmo:name "Blood Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Hypoglycaemia is defined as blood sugar glucose of <4.0mmol/L (if not <4.0mmol/L but symptomatic give a small carbohydrate snack for symptom relief)" ;
    dmo:evidenceQuote "d. Disability (including Glasgow Coma Scale (GCS) and blood glucose)" ;
    dmo:evidenceQuote "hypoglycaemic episodes (blood glucose <4.0mmol/L) with 7.0% reporting one or more hypoglycaemic episodes <3.0mmol/L." ;
    dmo:evidenceQuote "Blood glucose levels in the range of 4.0-6.0mmol/L might trigger a reduction of insulin doses." ;
    dmo:evidenceQuote "For the majority of people with diabetes in hospital, a blood glucose between 4.0-6.0mmol/L should act as an alert value, especially if a repeated finding." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/labTest/blood-glucose-level> a dmo:LabTest ;
    rdfs:label "Blood Glucose Level" ;
    dmo:definition "A measure of the concentration of glucose in the blood, used to diagnose and monitor hypoglycaemia and hyperglycaemia." ;
    dmo:labTestCode "blood-glucose-level" ;
    dmo:name "Blood Glucose Level" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Hypoglycaemia is a level of blood glucose below normal.  Normal blood glucose levels in a person without diabetes are 3.5-7.0mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/labTest/capillary-blood-glucose> a dmo:LabTest ;
    rdfs:label "Capillary Blood Glucose" ;
    dmo:definition "A measure of blood glucose concentration obtained from capillary blood, used to assess hypoglycaemia and guide treatment." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "capillary-blood-glucose" ;
    dmo:name "Capillary Blood Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Repeat capillary blood glucose measurement 10-15 minutes later. If it is still less than 4.0mmol/L, repeat step 3 (no more than 3 treatments in total)." ;
    dmo:evidenceQuote "Repeat capillary blood glucose levels after 10-15 minutes.  If it is still less than 4.0mmol/L repeat steps 1 and 3 (no more than 3 treatments in total and only give IM glucagon once)." ;
    dmo:evidenceQuote "Repeat capillary blood glucose measurement 10 minutes later. If it is still less than 4.0mmol/L, repeat step 5 (or 6 if IV access remains unavailable)." ;
    dmo:evidenceQuote "Repeat capillary blood glucose measurement 10 to 15 minutes later. If it is still less than 4.0mmol/L, repeat step 3 (no more than 3 treatments in total)." ;
    dmo:evidenceQuote "A Scottish study examined the gap between recognition of hypoglycaemia (by capillary blood glucose monitoring) and repeat blood glucose monitoring" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/labTest/capillary-blood-glucose-measurement> a dmo:LabTest ;
    rdfs:label "Capillary Blood Glucose Measurement" ;
    dmo:definition "A measurement of blood glucose level taken from capillary blood, used to assess hypoglycaemia in acutely ill adults as part of the ABCDE approach." ;
    dmo:labTestCode "capillary-blood-glucose-measurement" ;
    dmo:name "Capillary Blood Glucose Measurement" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "For this reason, a capillary blood glucose measurement forms part of the systematic “ABCDE” initial approach to the management of the acutely ill adult (9)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/labTest/egfr> a dmo:LabTest ;
    rdfs:label "eGFR" ;
    dmo:definition "Estimated glomerular filtration rate, a measure of kidney function." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "egfr" ;
    dmo:loincCode "2160-0" ;
    dmo:name "eGFR" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mL-per-min" ;
    dmo:evidenceQuote "lower eGFR, raised inflammatory markers, hyponatraemia (<125mmol/L) and low albumin were the strongest predictors of hypoglycaemia in people with diabetes admitted to medical or surgical wards" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/labTest/hba1c> a dmo:LabTest ;
    rdfs:label "HbA1c" ;
    dmo:definition "A measure of average blood glucose levels over the past 2-3 months, used to assess long-term glycaemic control in diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "HbA1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/mol" ;
    dmo:evidenceQuote "A middle-aged man with T2DM on metformin with an HbA1c usually around 48mmol/L would not be expected to be at high risk of hypoglycaemia and so may not need any action following blood glucose readings in the range of 4.0-6.0mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/labTest/hypoglycaemia-2-9mmol-l> a dmo:LabTest ;
    rdfs:label "Hypoglycaemia (<2.9mmol/L)" ;
    dmo:definition "A severe hypoglycemic episode defined by blood glucose levels below 2.9mmol/L, most likely to occur overnight and in the morning in hospital settings." ;
    dmo:labTestCode "hypoglycaemia-2-9mmol-l" ;
    dmo:name "Hypoglycaemia (<2.9mmol/L)" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "In the hospital setting, studies conducted in both the United States and the UK show that significant hypoglycaemia (glucose <2.9mmol/L) is most likely to occur overnight and first thing in the morning." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/labTest/hypoglycaemia-3-0mmol-l> a dmo:LabTest ;
    rdfs:label "Hypoglycaemia (<3.0mmol/L)" ;
    dmo:definition "A hypoglycemic episode defined by blood glucose levels below 3.0mmol/L, associated with increased risk of recurrence and clinical intervention." ;
    dmo:labTestCode "hypoglycaemia-3-0mmol-l" ;
    dmo:name "Hypoglycaemia (<3.0mmol/L)" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "18.4% of people still reported one or more hypoglycaemic episodes (blood glucose <4.0mmol/L) with 7.0% reporting one or more hypoglycaemic episodes <3.0mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/labTest/looming-hypoglycaemia> a dmo:LabTest ;
    rdfs:label "Looming Hypoglycaemia" ;
    dmo:definition "A clinical state where blood glucose levels are between 4.0 and 6.0mmol/L, indicating a potential risk of impending hypoglycemia, especially in patients on insulin secretagogues or insulin therapy." ;
    dmo:labTestCode "looming-hypoglycaemia" ;
    dmo:name "Looming Hypoglycaemia" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "A blood glucose value between 4.0 to 6.0mmol/L could indicate looming hypoglycaemia; particularly if repeated episodes showed a particular pattern of glucose measurements below 6.0mmol/L were occurring." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/labTest/nocturnal-hypoglycaemia> a dmo:LabTest ;
    rdfs:label "Nocturnal Hypoglycaemia" ;
    dmo:definition "Hypoglycemia occurring during sleep, defined as blood glucose <3.9mmol/L." ;
    dmo:labTestCode "nocturnal-hypoglycaemia" ;
    dmo:name "Nocturnal Hypoglycaemia" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Nocturnal hypoglycaemia (blood glucose <3.9mmol/L) was more common in people treated with sulfonylurea therapy than insulin therapy (75.3% versus 59.3% respectively)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/lifestyleIntervention/carbohydrate-counting> a dmo:LifestyleIntervention ;
    rdfs:label "Carbohydrate counting" ;
    dmo:activityTarget "Providing easily identified 10g \"bricks\" of carbohydrate to allow people to easily identify the amount of carbohydrate consumed" ;
    dmo:expectedBenefit "Delaying meal time insulin injection until after the meal reduced hypoglycaemia in the hospital setting" ;
    dmo:interventionCode "carbohydrate-counting" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Carbohydrate counting" ;
    dmo:evidenceQuote "Allowing people to easily identify the amount of carbohydrate consumed (by providing easily identified 10g “bricks” of carbohydrate) can allow them to carbohydrate count." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/lifestyleIntervention/diabetes-training-for-non-specialist-medical-staff> a dmo:LifestyleIntervention ;
    rdfs:label "Diabetes training for non-specialist medical staff" ;
    dmo:activityTarget "Training non-specialist medical staff in diabetes care" ;
    dmo:expectedBenefit "Reduced length of stay in hospital over and above improvements seen across all hospital patients" ;
    dmo:interventionCode "diabetes-training-for-non-specialist-medical-staff" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "Diabetes training for non-specialist medical staff" ;
    dmo:evidenceQuote "Using a variety of measures including proactive identification of admissions involving people with diabetes, online referral system, use of web-linked glucose meters, an enhanced diabetes team and diabetes training for non-specialist medical staff, a hospital in England was able to demonstrate a reduced length of stay over and above improvements seen across all hospital patients (41)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/lifestyleIntervention/hypoglycaemia-education> a dmo:LifestyleIntervention ;
    rdfs:label "Hypoglycaemia education" ;
    dmo:interventionCode "hypoglycaemia-education" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "Hypoglycaemia education" ;
    dmo:evidenceQuote "Give hypoglycaemia education or refer to local Diabetes Inpatient Team. An education leaflet is available from the Trend Diabetes website (https://trenddiabetes.online/) (log in required)." ;
    dmo:evidenceQuote "Give hypoglycaemia education or refer to local Diabetes Inpatient Team." ;
    dmo:evidenceQuote "Give hypoglycaemia education or refer to local Diabetes Inpatient Team.  An education leaflet is available from the Trend Diabetes website (https://trenddiabetes.online/) (log in required)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/lifestyleIntervention/self-management-of-hypoglycaemia> a dmo:LifestyleIntervention ;
    rdfs:label "Self-management of hypoglycaemia" ;
    dmo:activityTarget "People capable of self-care should alert nursing staff an episode of hypoglycaemia has occurred so their management plan can be altered if necessary" ;
    dmo:expectedBenefit "Improve management of hypoglycaemia and prevent avoidable episodes" ;
    dmo:interventionCode "self-management-of-hypoglycaemia" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "Self-management of hypoglycaemia" ;
    dmo:evidenceQuote "People capable of self-care should alert nursing staff an episode of hypoglycaemia has occurred so their management plan can be altered if necessary." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/lifestyleIntervention/support-for-self-management-when-capable-and-appropriate> a dmo:LifestyleIntervention ;
    rdfs:label "Support for self-management when capable and appropriate" ;
    dmo:activityTarget "Many people with diabetes carry their own supplies of oral carbohydrate and should be supported to self-manage when capable and appropriate" ;
    dmo:expectedBenefit "Improve management of hypoglycaemia and prevent avoidable episodes" ;
    dmo:interventionCode "support-for-self-management-when-capable-and-appropriate" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "Support for self-management when capable and appropriate" ;
    dmo:evidenceQuote "Many people with diabetes carry their own supplies of oral carbohydrate and should be supported to self-manage when capable and appropriate; this decision should be recorded in their hospital care plan." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/10-glucose> a dmo:Medication ;
    rdfs:label "10% glucose" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "10-glucose" ;
    dmo:name "10% glucose" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Give 100ml of 20% glucose at 400ml/hour or 200ml of 10% glucose at 800ml/hour over 15 minutes." ;
    dmo:evidenceQuote "Further evidence has become available comparing 10% or 20% glucose with 50% glucose." ;
    dmo:evidenceQuote "Ten percent glucose preparations are considerably less hypertonic than the 50% preparation and therefore less destructive to the venous endothelium (67)." ;
    dmo:evidenceQuote "10% glucose 250ml, 500ml or 1000ml solution for IV infusion (0.1g/ml)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/10-iv-glucose> a dmo:Medication ;
