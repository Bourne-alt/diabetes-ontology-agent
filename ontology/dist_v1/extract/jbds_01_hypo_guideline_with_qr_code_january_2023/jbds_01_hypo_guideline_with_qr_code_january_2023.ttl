    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/previous-history-of-severe-hypoglycaemia> a dmo:RiskFactor ;
    rdfs:label "Previous History of Severe Hypoglycaemia" ;
    dmo:evidenceNote "Previous history of severe hypoglycaemia is listed as a medical issue associated with increased risk of hypoglycaemia." ;
    dmo:name "Previous History of Severe Hypoglycaemia" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "previous-history-of-severe-hypoglycaemia" ;
    dmo:evidenceQuote "Previous history of severe hypoglycaemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/prolonged-starvation-time-e-g-nil-by-mouth> a dmo:RiskFactor ;
    rdfs:label "Prolonged starvation time e.g. ‘Nil by Mouth’" ;
    dmo:evidenceNote "文档中明确指出这是导致低血糖的风险因素之一。" ;
    dmo:name "Prolonged starvation time e.g. ‘Nil by Mouth’" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "prolonged-starvation-time-e-g-nil-by-mouth" ;
    dmo:evidenceQuote "• Prolonged starvation time e.g. ‘Nil by Mouth’" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/raised-inflammatory-markers> a dmo:RiskFactor ;
    rdfs:label "Raised Inflammatory Markers" ;
    dmo:evidenceNote "A British study used a similar technique to show that age >75 years, insulin & sulfonylurea therapy, black and Asian ethnicity, emergency (rather than elective) admission, lower eGFR, raised inflammatory markers, hyponatraemia (<125mmol/L) and low albumin were the strongest predictors of hypoglycaemia in people with diabetes admitted to medical or surgical wards (not intensive therapy units) (36)." ;
    dmo:name "Raised Inflammatory Markers" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "raised-inflammatory-markers" ;
    dmo:evidenceQuote "A British study used a similar technique to show that age >75 years, insulin & sulfonylurea therapy, black and Asian ethnicity, emergency (rather than elective) admission, lower eGFR, raised inflammatory markers, hyponatraemia (<125mmol/L) and low albumin were the strongest predictors of hypoglycaemia in people with diabetes admitted to medical or surgical wards (not intensive therapy units) (36)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/recovery-from-acute-illness-stress> a dmo:RiskFactor ;
