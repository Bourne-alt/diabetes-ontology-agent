<https://example.org/dmo/id/recommendation/stop-infusion-if-hypersensitivity-reaction-occurs> a dmo:Recommendation ;
    rdfs:label "Stop infusion if hypersensitivity reaction occurs" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
