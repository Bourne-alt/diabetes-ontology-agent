<https://example.org/dmo/id/recommendation/restock-hypo-boxes-if-used> a dmo:Recommendation ;
    rdfs:label "Restock hypo boxes if used" ;
    dmo:recommendationId "restock-hypo-boxes-if-used" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
