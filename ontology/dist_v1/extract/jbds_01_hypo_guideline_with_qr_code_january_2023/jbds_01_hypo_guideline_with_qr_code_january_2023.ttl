<https://example.org/dmo/id/medication/intramuscular-glucagon> a dmo:Medication ;
    rdfs:label "Intramuscular Glucagon" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "intramuscular-glucagon" ;
    dmo:name "Intramuscular Glucagon" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Promote the prescription of hypoglycaemia “rescue” treatment for all people with diabetes in hospital on insulin or sulfonylurea therapy.  This could involve a “PRN (pro re nata)” or “as needed” prescription of intravenous (IV) glucose and/or intramuscular (IM) glucagon." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

