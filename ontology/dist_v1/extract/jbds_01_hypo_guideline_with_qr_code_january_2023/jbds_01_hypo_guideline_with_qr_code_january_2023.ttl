<https://example.org/dmo/id/adverseEffect/hypoglycaemia-associated-with-intravenous-insulin-infusion> a dmo:AdverseEffect ;
    rdfs:label "Hypoglycaemia associated with intravenous insulin infusion" ;
    dmo:adverseEffectCode "hypoglycaemia-associated-with-intravenous-insulin-infusion" ;
    dmo:frequencyCategory "Common" ;
    dmo:name "Hypoglycaemia associated with intravenous insulin infusion" ;
    dmo:severity "Unknown" ;
    dmo:evidenceQuote "Although intravenous (IV) insulin is often used by medical teams to manage perceived problematic glycaemic control; it does itself substantially increase the risk of inpatient hypoglycaemia of <3.0mmol/L compared with all other medication groups." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/adverseEffect/hypoglycaemia-requiring-injectable-treatment> a dmo:AdverseEffect ;
