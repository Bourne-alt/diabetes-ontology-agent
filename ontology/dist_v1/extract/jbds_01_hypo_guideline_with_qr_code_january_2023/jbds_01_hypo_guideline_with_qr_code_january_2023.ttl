<https://example.org/dmo/id/riskFactor/use-of-insulin-pumps> a dmo:RiskFactor ;
    rdfs:label "Use of Insulin Pumps" ;
    dmo:evidenceNote "For some people, especially those using insulin pumps and/or wearable glucose sensors, a range of 4-6mmol/L may be their normal when they are not eating." ;
    dmo:name "Use of Insulin Pumps" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "use-of-insulin-pumps" ;
    dmo:evidenceQuote "For some people, especially those using insulin pumps and/or wearable glucose sensors, a range of 4-6mmol/L may be their normal when they are not eating." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/use-of-intravenous-insulin-infusion> a dmo:RiskFactor ;
    rdfs:label "Use of intravenous insulin infusion" ;
    dmo:evidenceNote "Although intravenous (IV) insulin is often used by medical teams to manage perceived problematic glycaemic control; it does itself substantially increase the risk of inpatient hypoglycaemia of <3.0mmol/L compared with all other medication groups." ;
    dmo:name "Use of intravenous insulin infusion" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "use-of-intravenous-insulin-infusion" ;
    dmo:evidenceQuote "Although intravenous (IV) insulin is often used by medical teams to manage perceived problematic glycaemic control; it does itself substantially increase the risk of inpatient hypoglycaemia of <3.0mmol/L compared with all other medication groups." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/use-of-wearable-glucose-sensors> a dmo:RiskFactor ;
