<https://example.org/dmo/id/recommendation/monitor-for-persistent-hypoglycaemia-risk-after-sulfonylurea-or-long-acting-insulin> a dmo:Recommendation ;
    rdfs:label "Monitor for persistent hypoglycaemia risk after sulfonylurea or long-acting insulin" ;
    dmo:populationScope "Adults who are conscious, orientated and able to swallow" ;
    dmo:recommendationId "monitor-for-persistent-hypoglycaemia-risk-after-sulfonylurea-or-long-acting-insulin" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    dmo:evidenceQuote "10. If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/monitor-infusion-site-for-phlebitis> a dmo:Recommendation ;
