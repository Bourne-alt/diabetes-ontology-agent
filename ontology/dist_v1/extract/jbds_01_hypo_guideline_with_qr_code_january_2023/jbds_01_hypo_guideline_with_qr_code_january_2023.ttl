<https://example.org/dmo/id/recommendation/give-15-20g-rapid-acting-carbohydrate-via-feeding-tube-where-possible> a dmo:Recommendation ;
    rdfs:label "Give 15-20g rapid-acting carbohydrate via feeding tube where possible" ;
    dmo:populationScope "Adults with diabetes in hospital receiving enteral/parenteral feeding and experiencing hypoglycaemia" ;
