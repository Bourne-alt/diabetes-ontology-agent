    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "1 bottle (60ml) Lift juice shots" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/long-acting-insulin-therapy> a dmo:Medication ;
    rdfs:label "Long-acting insulin therapy" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "long-acting-insulin-therapy" ;
    dmo:name "Long-acting insulin therapy" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/metformin> a dmo:Medication ;
    rdfs:label "metformin" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "metformin" ;
    dmo:name "metformin" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "However, introducing new treatment options may confuse the people and may not be practical for many of the common agents such as metformin (GI side effects, caution with renal impairment and slower onset of action)," ;
    dmo:evidenceQuote "A middle-aged man with T2DM on metformin with an HbA1c usually around" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/mixed-insulins> a dmo:Medication ;
    rdfs:label "Mixed insulins" ;
    dmo:durationHours "12"^^xsd:integer ;
    dmo:insulinAction "Premixed" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "mixed-insulins" ;
    dmo:name "Mixed insulins" ;
    dmo:onsetMinutes "30"^^xsd:integer ;
    dmo:evidenceQuote "nadequate mixing of intermediate-acting or mixed insulins" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/orange-juice> a dmo:Medication ;
    rdfs:label "Orange juice" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "orange-juice" ;
    dmo:name "Orange juice" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "150-200ml pure fruit juice (e.g. orange juice), do not use if following a low potassium diet (e.g. to treat chronic kidney disease) in view of its potassium content" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/sglt-2-inhibitors> a dmo:Medication ;
    rdfs:label "SGLT-2 inhibitors" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "sglt-2-inhibitors" ;
    dmo:name "SGLT-2 inhibitors" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "However, introducing new treatment options may confuse the people and may not be practical for many of the common agents such as metformin (GI side effects, caution with renal impairment and slower onset of action), SGLT-2 inhibitors (risk of euglycaemic DKA) and GLP-1 agonists (GI side effects) (23)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/sugar-dissolved-in-water> a dmo:Medication ;
    rdfs:label "Sugar dissolved in water" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "sugar-dissolved-in-water" ;
    dmo:name "Sugar dissolved in water" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "3-4 heaped teaspoons of sugar dissolved in water (sugar dissolved in water is not an effective treatment for people taking acarbose as it prevents the breakdown of sucrose to glucose)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/sulfonylurea> a dmo:Medication ;
    rdfs:label "Sulfonylurea" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "sulfonylurea" ;
    dmo:name "Sulfonylurea" ;
    dmo:evidenceQuote "Hypoglycaemia is the commonest side-effect of insulin or sulfonylurea therapy used to treat diabetes. Because of their modes of action (i.e. they prevent glucose from rising rather than lowering glucose concentrations); metformin, pioglitazone, DPP-4 inhibitors, acarbose, SLGT-2 inhibitors and GLP-1 analogues prescribed without insulin or an insulin secretagogue (sulfonylurea and repaglinide) are unlikely to result in hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/sulfonylurea-therapy> a dmo:Medication ;
    rdfs:label "Sulfonylurea therapy" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "sulfonylurea-therapy" ;
    dmo:name "Sulfonylurea therapy" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    dmo:evidenceQuote "Nocturnal hypoglycaemia (blood glucose <3.9mmol/L) was more common in people treated with sulfonylurea therapy than insulin therapy (75.3% versus 59.3% respectively)." ;
    dmo:evidenceQuote "An 84-year-old woman with T2DM on high dose sulfonylurea therapy admitted" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Blood Glucose Monitoring" ;
    dmo:appliesTo "after hypoglycaemia event, for at least 24 to 48 hours" ;
    dmo:frequencyMonths "1"^^xsd:integer ;
    dmo:name "Capillary Blood Glucose Monitoring" ;
    dmo:scheduleId "capillary-blood-glucose-monitoring" ;
    dmo:triggerWindow "for at least 24 to 48 hours after hypoglycaemia event" ;
    dmo:evidenceQuote "Ensure regular capillary blood glucose monitoring is continued for at least 24 to 48 hours." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/regular-capillary-blood-glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Regular Capillary Blood Glucose Monitoring" ;
    dmo:appliesTo "adults with diabetes in hospital who have experienced hypoglycaemia" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Regular Capillary Blood Glucose Monitoring" ;
    dmo:scheduleId "regular-capillary-blood-glucose-monitoring" ;
    dmo:triggerWindow "for at least 24 to 48 hours after hypoglycaemia event" ;
    dmo:evidenceQuote "Ensure regular capillary blood glucose monitoring is continued for at least 24 to 48 hours." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/10-or-20-glucose-solutions-preferred-for-intravenous-administration> a dmo:Recommendation ;
    rdfs:label "10% or 20% glucose solutions preferred for intravenous administration" ;
    dmo:recommendationId "10-or-20-glucose-solutions-preferred-for-intravenous-administration" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "10% or 20% glucose solutions are preferred for intravenous administration" ;
    dmo:evidenceQuote "For these reasons, 10% or 20% glucose solutions are preferred for intravenous administration." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/adjust-insulin-pump-settings-after-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Adjust insulin pump settings after hypoglycaemia" ;
    dmo:populationScope "Adults who are conscious, orientated and able to swallow" ;
    dmo:recommendationId "adjust-insulin-pump-settings-after-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "People who self-manage their insulin pumps (CSII) may not need a long-acting carbohydrate, but should take initial treatment as outlined and adjust their pump settings appropriately. Many people will have a locally devised hypoglycaemia protocol that should be checked to ensure it remains appropriate for use in the inpatient setting." ;
    dmo:evidenceQuote "8. People who self-manage their insulin pumps (CSII) may not need a long-acting carbohydrate, but should take initial treatment as outlined and adjust their pump settings appropriately. Many people will have a locally devised hypoglycaemia protocol that should be checked to ensure it remains appropriate for use in the inpatient setting." ;
    dmo:evidenceQuote "10. People who self-manage their insulin pumps (CSII) may not need a long-acting carbohydrate, but should take initial treatment as outlined and adjust their pump settings appropriately. Many people will have a locally devised hypoglycaemia protocol that should be checked to ensure it remains appropriate for use in the inpatient setting." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/adjust-variable-rate-intravenous-insulin-infusion-as-per-prescribed-regimen-and-seek-medical-advice> a dmo:Recommendation ;
    rdfs:label "Adjust variable rate intravenous insulin infusion as per prescribed regimen and seek medical advice" ;
    dmo:populationScope "Adults with diabetes in hospital who have a variable rate intravenous insulin infusion and experience hypoglycaemia" ;
    dmo:recommendationId "adjust-variable-rate-intravenous-insulin-infusion-as-per-prescribed-regimen-and-seek-medical-advice" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If the person has a variable rate intravenous insulin infusion, adjust as per prescribed regimen, and seek medical advice." ;
    dmo:evidenceQuote "If the person has a variable rate intravenous insulin infusion, adjust as per prescribed regimen, and seek medical advice." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/administer-10-iv-glucose-at-100ml-hr> a dmo:Recommendation ;
    rdfs:label "Administer 10% IV glucose at 100ml/hr" ;
    dmo:recommendationId "administer-10-iv-glucose-at-100ml-hr" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "10% IV glucose at 100ml/hr. Volume should be determined by clinical circumstances (refer to Appendix 5 for administration details)" ;
    dmo:evidenceQuote "6. Once blood glucose is above 4.0mmol/L and the person has recovered:\n• Restart feed\n• If bolus feeding, give additional bolus feed (read nutritional information and \ncalculate amount required to give 20g of carbohydrate)\n• 10% IV glucose at 100ml/hr.  Volume should be determined by clinical \ncircumstances (refer to Appendix 5 for administration details)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/administer-100ml-of-20-glucose-at-400ml-hour-or-200ml-of-10-glucose-at-800ml-hour-over-15-minutes> a dmo:Recommendation ;
    rdfs:label "Administer 100ml of 20% Glucose at 400ml/hour or 200ml of 10% Glucose at 800ml/hour Over 15 Minutes" ;
    dmo:populationScope "Adults who are unconscious and/or having seizures and/or are very aggressive" ;
    dmo:recommendationId "administer-100ml-of-20-glucose-at-400ml-hour-or-200ml-of-10-glucose-at-800ml-hour-over-15-minutes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If IV access is available give 100ml of 20% glucose at 400ml/hour or 200ml of 10% glucose at 800ml/hour over 15 minutes. If an infusion pump is available then use this, but if not available the infusion should not be delayed. Care should be taken with infusion pump settings if larger volume bags are used to ensure the whole bag is not inadvertently administered. The smallest possible volume should be administered in renal and/or cardiac failure." ;
    dmo:evidenceQuote "5. If IV access is available give 100ml of 20% glucose at 400ml/hour or 200ml of 10% glucose at 800ml/hour over 15 minutes. If an infusion pump is available then use this, but if not available the infusion should not be delayed. Care should be taken with infusion pump settings if larger volume bags are used to ensure the whole bag is not inadvertently administered. The smallest possible volume should be administered in renal and/or cardiac failure." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/administer-1mg-glucagon-im-if-no-iv-access-available> a dmo:Recommendation ;
    rdfs:label "Administer 1mg Glucagon IM if No IV Access Available" ;
    dmo:populationScope "Adults who are unconscious and/or having seizures and/or are very aggressive" ;
    dmo:recommendationId "administer-1mg-glucagon-im-if-no-iv-access-available" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If no IV access is available then give 1mg Glucagon IM. Glucagon is only licensed for insulin induced hypoglycaemia and may be less effective in people prescribed sulfonylurea therapy (may take up to 15 minutes to take effect). Glucagon mobilises glycogen from the liver and will be less effective in those who are chronically malnourished (including those who have had a prolonged period of starvation), abuse alcohol or have chronic liver disease. In this situation IV glucose is the preferred option. If no IV access is available initially, continue trying to achieve IV access as IM glucagon is less likely to be successful if required for a second time." ;
    dmo:evidenceQuote "6. If no IV access is available then give 1mg Glucagon IM. Glucagon is only licensed for insulin induced hypoglycaemia and may be less effective in people prescribed sulfonylurea therapy (may take up to 15 minutes to take effect). Glucagon mobilises glycogen from the liver and will be less effective in those who are chronically malnourished (including those who have had a prolonged period of starvation), abuse alcohol or have chronic liver disease. In this situation IV glucose is the preferred option. If no IV access is available initially, continue trying to achieve IV access as IM glucagon is less likely to be successful if required for a second time." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/administer-glucagon-or-iv-glucose-if-hypoglycaemia-persists> a dmo:Recommendation ;
    rdfs:label "Administer glucagon or IV glucose if hypoglycaemia persists" ;
    dmo:populationScope "Adults who are conscious, orientated and able to swallow" ;
    dmo:recommendationId "administer-glucagon-or-iv-glucose-if-hypoglycaemia-persists" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If blood glucose remains less than 4.0mmol/L after 30-45 minutes or 3 treatment cycles, call for medical assistance. If agreed locally, glucagon (and IV glucose) may be given without prescription in an emergency for the purpose of saving a life or via a Patient Group Directive. Consider: 1mg of glucagon IM (only licensed for insulin induced hypoglycaemia, may be less effective when administered repeatedly, in people prescribed sulfonylurea therapy or people with a history of alcohol abuse or chronic liver disease), 100ml of 20% glucose (at 400ml/hour over 15 minutes) or 200ml of 10% glucose (at 800ml/hour over 15 minutes).  Care should be taken with infusion pump settings if larger volume bags are used to ensure the whole bag is not inadvertently administered.  Consider smallest possible volume in renal and/or cardiac failure" ;
    dmo:evidenceQuote "5. If blood glucose remains less than 4.0mmol/L after 30-45 minutes or 3 treatment cycles, call for medical assistance. If agreed locally, glucagon (and IV glucose) may be given without prescription in an emergency for the purpose of saving a life or via a Patient Group Directive. Consider: a. 1mg of glucagon IM (only licensed for insulin induced hypoglycaemia, may be less effective when administered repeatedly, in people prescribed sulfonylurea therapy or people with a history of alcohol abuse or chronic liver disease) b. 100ml of 20% glucose (at 400ml/hour over 15 minutes) or 200ml of 10% glucose (at 800ml/hour over 15 minutes).  Care should be taken with infusion pump settings if larger volume bags are used to ensure the whole bag is not inadvertently administered.  Consider smallest possible volume in renal and/or cardiac failure" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/administer-iv-glucose-or-im-glucagon-without-prescription-in-emergency> a dmo:Recommendation ;
    rdfs:label "Administer IV Glucose or IM Glucagon Without Prescription in Emergency" ;
    dmo:populationScope "Adults who are unconscious and/or having seizures and/or are very aggressive" ;
    dmo:recommendationId "administer-iv-glucose-or-im-glucagon-without-prescription-in-emergency" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If agreed locally, IV glucose or IM glucagon may be given without prescription in an emergency for the purpose of saving a life or via a Patient Group Directive." ;
    dmo:evidenceQuote "4. If agreed locally, IV glucose or IM glucagon may be given without prescription in an emergency for the purpose of saving a life or via a Patient Group Directive." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/administer-rapid-acting-carbohydrate-for-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Administer rapid-acting carbohydrate for hypoglycaemia" ;
    dmo:populationScope "Adults who are conscious, orientated and able to swallow" ;
    dmo:recommendationId "administer-rapid-acting-carbohydrate-for-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Give 15-20g rapid-acting carbohydrate of the person with diabetes in hospital’s choice where possible. Some examples are: 5-7 Dextrosol® tablets (or 4-5 Lift GlucoTabs™), 1 bottle (60ml) Lift juice shots, 150-200ml pure fruit juice (e.g. orange juice), do not use if following a low potassium diet (e.g. to treat chronic kidney disease) in view of its potassium content, 3-4 heaped teaspoons of sugar dissolved in water (sugar dissolved in water is not an effective treatment for people taking acarbose as it prevents the breakdown of sucrose to glucose)" ;
    dmo:evidenceQuote "3. Give 15-20g rapid-acting carbohydrate of the person with diabetes in hospital’s choice where possible.  Some examples are: a. 5-7 Dextrosol® tablets (or 4-5 Lift GlucoTabs™) b. 1 bottle (60ml) Lift juice shots c. 150-200ml pure fruit juice (e.g. orange juice), do not use if following a low potassium diet (e.g. to treat chronic kidney disease) in view of its potassium content d. 3-4 heaped teaspoons of sugar dissolved in water (sugar dissolved in water is not an effective treatment for people taking acarbose as it prevents the breakdown of sucrose to glucose)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/administration-of-iv-glucose-in-emergency> a dmo:Recommendation ;
    rdfs:label "Administration of IV Glucose in Emergency" ;
    dmo:populationScope "Adults who are conscious but confused, disorientated, unable to cooperate or aggressive but are able to swallow" ;
    dmo:recommendationId "administration-of-iv-glucose-in-emergency" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Give 100ml of 20% glucose at 400ml/hour or 200ml of 10% glucose at 800ml/hour over 15 minutes. Care should be taken with infusion pump settings if larger volume bags are used to ensure the whole bag is not inadvertently administered. Consider smallest possible volume in renal impairment and/or cardiac failure." ;
    dmo:evidenceQuote "Give 100ml of 20% glucose at 400ml/hour or 200ml of 10% glucose at 800ml/hour over 15 minutes. Care should be taken with infusion pump settings if larger volume bags are used to ensure the whole bag is not inadvertently administered. Consider smallest possible volume in renal impairment and/or cardiac failure." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/alert-value-for-blood-glucose-in-hospital> a dmo:Recommendation ;
    rdfs:label "Alert Value for Blood Glucose in Hospital" ;
    dmo:populationScope "The majority of people with diabetes in hospital" ;
    dmo:recommendationId "alert-value-for-blood-glucose-in-hospital" ;
    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "For the majority of people with diabetes in hospital, a blood glucose between 4.0-6.0mmol/L should act as an alert value, especially if a repeated finding." ;
    dmo:evidenceQuote "For the majority of people with diabetes in hospital, a blood glucose between 4.0-6.0mmol/L should act as an alert value, especially if a repeated finding." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/any-blood-glucose-less-than-4-0mmol-l-should-be-treated-during-hospital-admission> a dmo:Recommendation ;
    rdfs:label "Any blood glucose less than 4.0mmol/L should be treated during hospital admission" ;
