    dmo:evidenceQuote "Participants were selected on the basis of confusion or impaired consciousness level sufficient to make treatment with oral carbohydrate inadvisable." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/inability-to-cooperate> a dmo:Symptom ;
    rdfs:label "Inability to Cooperate" ;
    dmo:hpoCode "HP:0000728" ;
    dmo:name "Inability to Cooperate" ;
    dmo:symptomCode "inability-to-cooperate" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "B. Adults who are conscious but confused, disorientated, unable to cooperate or aggressive but are able to swallow" ;
    dmo:evidenceQuote "Hypoglycaemia must be excluded in any person with diabetes who is acutely unwell, drowsy, unconscious, unable to co-operate, presenting with aggressive behaviour or a seizure." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/looming-hypoglycaemia> a dmo:Symptom ;
    rdfs:label "Looming hypoglycaemia" ;
    dmo:hpoCode "HP:0002581" ;
    dmo:name "Looming hypoglycaemia" ;
    dmo:symptomCode "looming-hypoglycaemia" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "A blood glucose value between 4.0 to 6.0mmol/L could indicate looming hypoglycaemia; particularly if repeated episodes showed a particular pattern of glucose measurements below 6.0mmol/L were occurring." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/loss-of-consciousness> a dmo:Symptom ;
    rdfs:label "Loss of consciousness" ;
    dmo:name "Loss of consciousness" ;
    dmo:symptomCode "loss-of-consciousness" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "Observe patients for any sign of mental confusion and loss of consciousness" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/low-blood-glucose> a dmo:Symptom ;
    rdfs:label "Low Blood Glucose" ;
    dmo:hpoCode "HP:0001934" ;
    dmo:name "Low Blood Glucose" ;
    dmo:symptomCode "low-blood-glucose" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "Repeat capillary blood glucose measurement 10 minutes later. If it is still less than 4.0mmol/L, repeat step 5 (or 6 if IV access remains unavailable)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/mental-confusion> a dmo:Symptom ;
    rdfs:label "Mental confusion" ;
    dmo:name "Mental confusion" ;
    dmo:symptomCode "mental-confusion" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Observe patients for any sign of mental confusion and loss of consciousness" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/nausea> a dmo:Symptom ;
    rdfs:label "Nausea" ;
    dmo:hpoCode "HP:0002055" ;
    dmo:name "Nausea" ;
    dmo:symptomCode "nausea" ;
    dmo:urgency "Routine" ;
    dmo:evidenceQuote "People given glucagon require a larger portion of long-acting carbohydrate (40g) to replenish glycogen stores (double the suggested amounts below) although nausea associated with glucagon injections may be an issue." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/neuroglycopenic-symptoms> a dmo:Symptom ;
    rdfs:label "Neuroglycopenic Symptoms" ;
    dmo:name "Neuroglycopenic Symptoms" ;
    dmo:symptomCode "neuroglycopenic-symptoms" ;
    dmo:urgency "Routine" ;
    dmo:evidenceQuote "neuroglycopenic symptoms are the result of cerebral glucose deprivation" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/nocturnal-hypoglycaemia> a dmo:Symptom ;
    rdfs:label "Nocturnal hypoglycaemia" ;
    dmo:hpoCode "HP:0002581" ;
    dmo:name "Nocturnal hypoglycaemia" ;
    dmo:symptomCode "nocturnal-hypoglycaemia" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "In the hospital setting, studies conducted in both the United States and the UK show that significant hypoglycaemia (glucose <2.9mmol/L) is most likely to occur overnight and first thing in the morning." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/oedema> a dmo:Symptom ;
    rdfs:label "Oedema" ;
    dmo:name "Oedema" ;
    dmo:symptomCode "oedema" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Fluid and electrolyte disturbances including oedema, hyponatraemia, hypokalaemia, hypophosphatemia, and hypomagnesaemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/pain> a dmo:Symptom ;
    rdfs:label "Pain" ;
    dmo:name "Pain" ;
    dmo:symptomCode "pain" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Pain, phlebitis, and vein irritation may occur during administration as the solution is hypertonic. This is a particular risk if infused too quickly. Monitor the infusion site: if any signs of phlebitis, stop infusion, remove cannula and re-site" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/phlebitis> a dmo:Symptom ;
    rdfs:label "Phlebitis" ;
    dmo:name "Phlebitis" ;
    dmo:symptomCode "phlebitis" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Pain, phlebitis, and vein irritation may occur during administration as the solution is hypertonic. This is a particular risk if infused too quickly. Monitor the infusion site: if any signs of phlebitis, stop infusion, remove cannula and re-site" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/seizure> a dmo:Symptom ;
    rdfs:label "Seizure" ;
    dmo:name "Seizure" ;
    dmo:symptomCode "seizure" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "Hypoglycaemia must be excluded in any person with diabetes who is acutely unwell, drowsy, unconscious, unable to co-operate, presenting with aggressive behaviour or a seizure." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/seizures> a dmo:Symptom ;
    rdfs:label "Seizures" ;
    dmo:hpoCode "HP:0001250" ;
    dmo:name "Seizures" ;
    dmo:symptomCode "seizures" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "C.  Adults who are unconscious and/or having seizures and/or are very aggressive" ;
    dmo:evidenceQuote "Hypoglycaemia can cause coma, hemiparesis and seizures." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/symptoms-of-hypoglycaemia> a dmo:Symptom ;
    rdfs:label "Symptoms of hypoglycaemia" ;
    dmo:name "Symptoms of hypoglycaemia" ;
    dmo:symptomCode "symptoms-of-hypoglycaemia" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "Adults who have poorer glycaemic control may start to experience symptoms of hypoglycaemia above 4.0mmol/L. There is no evidence the thresholds for cognitive dysfunction are reset upwards." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/symptom/unconsciousness> a dmo:Symptom ;
    rdfs:label "Unconsciousness" ;
    dmo:hpoCode "HP:0001257" ;
    dmo:name "Unconsciousness" ;
    dmo:symptomCode "unconsciousness" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "C.  Adults who are unconscious and/or having seizures and/or are very aggressive" ;
    dmo:evidenceQuote "Hypoglycaemia must be excluded in any person with diabetes who is acutely unwell, drowsy, unconscious, unable to co-operate, presenting with aggressive behaviour or a seizure." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

