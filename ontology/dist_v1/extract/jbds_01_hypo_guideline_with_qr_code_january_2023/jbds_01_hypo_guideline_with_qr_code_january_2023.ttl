<https://example.org/dmo/id/recommendation/stop-insulin-infusion-during-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Stop insulin infusion during hypoglycaemia" ;
    dmo:populationScope "Adults who are conscious, orientated and able to swallow" ;
    dmo:recommendationId "stop-insulin-infusion-during-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If the person with diabetes in hospital has an insulin infusion in situ, stop immediately. Continue to follow the guidance below. Restart the insulin infusion once the hypo has been fully treated. Consider reviewing insulin infusion requirement and dosing." ;
    dmo:evidenceQuote "2. If the person with diabetes in hospital has an insulin infusion in situ, stop immediately. Continue to follow the guidance below. Restart the insulin infusion once the hypo has been fully treated. Consider reviewing insulin infusion requirement and dosing" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

