<https://example.org/dmo/id/riskFactor/impaired-awareness-of-hypoglycaemia> a dmo:RiskFactor ;
    rdfs:label "Impaired Awareness of Hypoglycaemia" ;
    dmo:evidenceNote "Impaired awareness of hypoglycaemia (IAH) is an acquired syndrome associated with insulin treatment. IAH results in the warning symptoms of hypoglycaemia becoming diminished in intensity, altered in nature or lost altogether. This increases the vulnerability of affected individuals of progression to severe hypoglycaemia." ;
    dmo:name "Impaired Awareness of Hypoglycaemia" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "impaired-awareness-of-hypoglycaemia" ;
