<https://example.org/dmo/id/recommendation/availability-of-quick-and-long-acting-carbohydrate-in-clinical-area> a dmo:Recommendation ;
    rdfs:label "Availability of quick- and long-acting carbohydrate in clinical area" ;
    dmo:recommendationId "availability-of-quick-and-long-acting-carbohydrate-in-clinical-area" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "Easily accessible quick- and long-acting carbohydrate must be available in your clinical area (ideally located in a hypo box) and all staff should be aware of its location." ;
    dmo:evidenceQuote "Easily accessible quick- and long-acting carbohydrate must be available in your clinical area (ideally located in a hypo box) and all staff should be aware of its location." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/availability-of-sharps-disposal-equipment> a dmo:Recommendation ;
    rdfs:label "Availability of Sharps Disposal Equipment" ;
    dmo:populationScope "Hospitalised patients with diabetes mellitus" ;
    dmo:recommendationId "availability-of-sharps-disposal-equipment" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "Appropriate portable sharps disposal equipment should also be kept nearby." ;
    dmo:evidenceQuote "Appropriate portable sharps disposal equipment should also be kept nearby." ;
