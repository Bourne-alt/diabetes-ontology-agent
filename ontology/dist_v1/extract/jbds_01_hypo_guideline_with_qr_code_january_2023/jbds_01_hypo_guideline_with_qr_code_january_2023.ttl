<https://example.org/dmo/id/contraindication/risk-of-rapid-infusion> a dmo:Contraindication ;
    rdfs:label "Risk of Rapid Infusion" ;
    dmo:contraCode "risk-of-rapid-infusion" ;
    dmo:rationale "Pain, phlebitis, and vein irritation may occur during administration as the solution is hypertonic. This is a particular risk if infused too quickly." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "infused too quickly" ;
    dmo:evidenceQuote "Pain, phlebitis, and vein irritation may occur during administration as the solution is hypertonic. This is a particular risk if infused too quickly." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/subcutaneous-injection> a dmo:Contraindication ;
