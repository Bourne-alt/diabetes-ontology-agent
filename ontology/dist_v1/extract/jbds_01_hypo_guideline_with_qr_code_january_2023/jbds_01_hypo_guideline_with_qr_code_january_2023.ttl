<https://example.org/dmo/id/riskFactor/reduced-carbohydrate-intake-absorption> a dmo:RiskFactor ;
    rdfs:label "Reduced Carbohydrate Intake/Absorption" ;
    dmo:evidenceNote "Reduced carbohydrate intake/absorption is listed as a lifestyle issue associated with increased risk of hypoglycaemia." ;
    dmo:name "Reduced Carbohydrate Intake/Absorption" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "reduced-carbohydrate-intake-absorption" ;
    dmo:evidenceQuote "Reduced Carbohydrate intake/absorption" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/renal-impairment> a dmo:RiskFactor ;
    rdfs:label "Renal Impairment" ;
    dmo:evidenceNote "Renal impairment increases the risk of prolonged hypoglycaemia following sulfonylurea or long-acting insulin therapy." ;
    dmo:name "Renal Impairment" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "renal-impairment" ;
    dmo:evidenceQuote "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    dmo:evidenceQuote "Older people or those with renal impairment are at particular risk." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/severe-hepatic-dysfunction> a dmo:RiskFactor ;
    rdfs:label "Severe Hepatic Dysfunction" ;
    dmo:evidenceNote "Severe hepatic dysfunction is listed as a medical issue associated with increased risk of hypoglycaemia." ;
    dmo:name "Severe Hepatic Dysfunction" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "severe-hepatic-dysfunction" ;
    dmo:evidenceQuote "Severe hepatic dysfunction" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/sulfonylurea-therapy> a dmo:RiskFactor ;
    rdfs:label "Sulfonylurea Therapy" ;
    dmo:evidenceNote "The guideline recommends promoting the prescription of hypoglycaemia 'rescue' treatment for all people with diabetes in hospital on insulin or sulfonylurea therapy." ;
    dmo:name "Sulfonylurea Therapy" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "sulfonylurea-therapy" ;
    dmo:evidenceQuote "Promote the prescription of hypoglycaemia “rescue” treatment for all people with diabetes in hospital on insulin or sulfonylurea therapy." ;
    dmo:evidenceQuote "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    dmo:evidenceQuote "The risk of hypoglycaemia with sulfonylurea therapy is often underestimated and due to the duration of action of these tablets, is frequently prolonged." ;
    dmo:evidenceQuote "Nocturnal hypoglycaemia (blood glucose <3.9mmol/L) was more common in people treated with sulfonylurea therapy than insulin therapy (75.3% versus 59.3% respectively)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/t2dm-on-high-dose-sulfonylurea-therapy> a dmo:RiskFactor ;
    rdfs:label "T2DM on high dose sulfonylurea therapy" ;
    dmo:evidenceNote "An 84-year-old woman with T2DM on high dose sulfonylurea therapy admitted with a urinary tract infection and acute kidney injury would be at substantially higher risk of hypoglycaemia." ;
    dmo:name "T2DM on high dose sulfonylurea therapy" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "t2dm-on-high-dose-sulfonylurea-therapy" ;
    dmo:evidenceQuote "An 84-year-old woman with T2DM on high dose sulfonylurea therapy admitted with a urinary tract infection and acute kidney injury would be at substantially higher risk of hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/t2dm-on-metformin> a dmo:RiskFactor ;
    rdfs:label "T2DM on metformin" ;
    dmo:evidenceNote "The document states that a middle-aged man with T2DM on metformin with an HbA1c usually around 48mmol/L would not be expected to be at high risk of hypoglycaemia." ;
    dmo:name "T2DM on metformin" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "t2dm-on-metformin" ;
    dmo:evidenceQuote "A middle-aged man with T2DM on metformin with an HbA1c usually around 48mmol/L would not be expected to be at high risk of hypoglycaemia and so may not need any action following blood glucose readings in the range of 4.0-6.0mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

