    dmo:triggerCriteria "chronically malnourished (including those who have had a prolonged period of starvation)" ;
    dmo:evidenceQuote "Glucagon mobilises glycogen from the liver and will be less effective in those who are chronically malnourished (including those who have had a prolonged period of starvation), abuse alcohol or have chronic liver disease." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/glucagon-in-people-with-renal-and-or-cardiac-failure> a dmo:Contraindication ;
    rdfs:label "Glucagon in people with renal and/or cardiac failure" ;
    dmo:contraCode "glucagon-in-people-with-renal-and-or-cardiac-failure" ;
    dmo:rationale "The smallest possible volume should be administered in renal and/or cardiac failure." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "renal and/or cardiac failure" ;
    dmo:evidenceQuote "The smallest possible volume should be administered in renal and/or cardiac failure." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/glucagon-in-people-with-sulfonylurea-therapy> a dmo:Contraindication ;
    rdfs:label "Glucagon in people with sulfonylurea therapy" ;
    dmo:contraCode "glucagon-in-people-with-sulfonylurea-therapy" ;
    dmo:rationale "Glucagon is only licensed for insulin induced hypoglycaemia and may be less effective in people prescribed sulfonylurea therapy (may take up to 15 minutes to take effect)." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "prescribed sulfonylurea therapy" ;
    dmo:evidenceQuote "Glucagon is only licensed for insulin induced hypoglycaemia and may be less effective in people prescribed sulfonylurea therapy (may take up to 15 minutes to take effect)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/glucagon-less-effective-in-those-with-depleted-glycogen-reserves> a dmo:Contraindication ;
    rdfs:label "Glucagon less effective in those with depleted glycogen reserves" ;
    dmo:contraCode "glucagon-less-effective-in-those-with-depleted-glycogen-reserves" ;
    dmo:rationale "Glucagon will be less effective in those people with depleted glycogen reserves such as those with impaired hepatic function (i.e. people with excessive alcohol consumption or severely malnourished)" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "those with depleted glycogen reserves such as those with impaired hepatic function (i.e. people with excessive alcohol consumption or severely malnourished)" ;
    dmo:evidenceQuote "Glucagon will be less effective in those people with depleted glycogen reserves such as those with impaired hepatic function (i.e. people with excessive alcohol consumption or severely malnourished)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/hypoglycaemia> a dmo:Contraindication ;
    rdfs:label "Hypoglycaemia" ;
    dmo:contraCode "hypoglycaemia" ;
    dmo:rationale "Hypoglycaemia must be excluded in any person with diabetes who is acutely unwell, drowsy, unconscious, unable to co-operate, presenting with aggressive behaviour or a seizure. For this reason, a capillary blood glucose measurement forms part of the systematic “ABCDE” initial approach to the management of the acutely ill adult (9)." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "any person with diabetes who is acutely unwell, drowsy, unconscious, unable to co-operate, presenting with aggressive behaviour or a seizure" ;
    dmo:evidenceQuote "Hypoglycaemia must be excluded in any person with diabetes who is acutely unwell, drowsy, unconscious, unable to co-operate, presenting with aggressive behaviour or a seizure." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/im-injection> a dmo:Contraindication ;
    rdfs:label "IM injection" ;
    dmo:contraCode "im-injection" ;
    dmo:rationale "IM injection: Contraindicated" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "Contraindicated" ;
    dmo:evidenceQuote "IM injection: Contraindicated" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/inadequate-mixing-of-intermediate-acting-or-mixed-insulins> a dmo:Contraindication ;
    rdfs:label "Inadequate mixing of intermediate-acting or mixed insulins" ;
    dmo:contraCode "inadequate-mixing-of-intermediate-acting-or-mixed-insulins" ;
    dmo:rationale "Poor mixing can lead to unpredictable insulin delivery and hypoglycaemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Inadequate mixing of intermediate-acting or mixed insulins" ;
