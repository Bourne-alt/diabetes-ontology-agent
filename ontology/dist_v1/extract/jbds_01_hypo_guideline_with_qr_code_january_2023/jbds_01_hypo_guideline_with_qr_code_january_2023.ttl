<https://example.org/dmo/id/recommendation/repeat-blood-glucose-measurement-after-carbohydrate-treatment> a dmo:Recommendation ;
    rdfs:label "Repeat blood glucose measurement after carbohydrate treatment" ;
    dmo:populationScope "Adults who are conscious, orientated and able to swallow" ;
    dmo:recommendationId "repeat-blood-glucose-measurement-after-carbohydrate-treatment" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Repeat capillary blood glucose measurement 10-15 minutes later. If it is still less than 4.0mmol/L, repeat step 3 (no more than 3 treatments in total).  If it is above 4.0mmol/L then go to step 7." ;
    dmo:evidenceQuote "4. Repeat capillary blood glucose measurement 10-15 minutes later. If it is still less than 4.0mmol/L, repeat step 3 (no more than 3 treatments in total).  If it is above 4.0mmol/L then go to step 7." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/repeat-blood-glucose-measurement-after-glucagon-or-iv-glucose> a dmo:Recommendation ;
    rdfs:label "Repeat blood glucose measurement after glucagon or IV glucose" ;
    dmo:populationScope "Adults who are conscious, orientated and able to swallow" ;
    dmo:recommendationId "repeat-blood-glucose-measurement-after-glucagon-or-iv-glucose" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Repeat capillary blood glucose measurement 10 minutes later. If it is still less than 4.0mmol/L, repeat step 5." ;
    dmo:evidenceQuote "6. Repeat capillary blood glucose measurement 10 minutes later. If it is still less than 4.0mmol/L, repeat step 5." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/repeat-capillary-blood-glucose-after-iv-glucose> a dmo:Recommendation ;
    rdfs:label "Repeat Capillary Blood Glucose After IV Glucose" ;
    dmo:populationScope "Adults who are conscious but confused, disorientated, unable to cooperate or aggressive but are able to swallow" ;
    dmo:recommendationId "repeat-capillary-blood-glucose-after-iv-glucose" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Repeat capillary blood glucose measurement 10 minutes later. If it is still less than 4.0mmol/L, repeat steps 3 and 4 if required." ;
    dmo:evidenceQuote "Repeat capillary blood glucose measurement 10 minutes later. If it is still less than 4.0mmol/L, repeat steps 3 and 4 if required." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/repeat-capillary-blood-glucose-after-treatment> a dmo:Recommendation ;
    rdfs:label "Repeat Capillary Blood Glucose After Treatment" ;
    dmo:populationScope "Adults who are conscious but confused, disorientated, unable to cooperate or aggressive but are able to swallow" ;
    dmo:recommendationId "repeat-capillary-blood-glucose-after-treatment" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Repeat capillary blood glucose levels after 10-15 minutes. If it is still less than 4.0mmol/L repeat steps 1 and 3 (no more than 3 treatments in total and only give IM glucagon once)." ;
    dmo:evidenceQuote "Repeat capillary blood glucose levels after 10-15 minutes. If it is still less than 4.0mmol/L repeat steps 1 and 3 (no more than 3 treatments in total and only give IM glucagon once)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/repeat-capillary-blood-glucose-measurement-10-minutes-after-treatment> a dmo:Recommendation ;
    rdfs:label "Repeat Capillary Blood Glucose Measurement 10 Minutes After Treatment" ;
    dmo:populationScope "Adults who are unconscious and/or having seizures and/or are very aggressive" ;
    dmo:recommendationId "repeat-capillary-blood-glucose-measurement-10-minutes-after-treatment" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Repeat capillary blood glucose measurement 10 minutes later. If it is still less than 4.0mmol/L, repeat step 5 (or 6 if IV access remains unavailable)." ;
    dmo:evidenceQuote "7. Repeat capillary blood glucose measurement 10 minutes later. If it is still less than 4.0mmol/L, repeat step 5 (or 6 if IV access remains unavailable)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/repeated-administration-of-glucagon-is-not-advised> a dmo:Recommendation ;
    rdfs:label "Repeated administration of glucagon is not advised" ;
    dmo:recommendationId "repeated-administration-of-glucagon-is-not-advised" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "Repeated administration of glucagon is not advised (and unlicensed), only 1% of people responded to a second injection of glucagon who had not responded to the first injection." ;
    dmo:evidenceQuote "Repeated administration of glucagon is not advised (and unlicensed), only 1% of people responded to a second injection of glucagon who had not responded to the first injection (61)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/replenishment-of-hypo-box-after-use> a dmo:Recommendation ;
