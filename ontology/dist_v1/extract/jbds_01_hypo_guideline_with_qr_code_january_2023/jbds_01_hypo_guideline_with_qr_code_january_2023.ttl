    dmo:evidenceQuote "Treat with intravenous glucose (algorithm C, section 5)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/treatment-of-hypoglycaemia-in-adults-with-diabetes-in-hospital> a dmo:Recommendation ;
    rdfs:label "Treatment of Hypoglycaemia in Adults with Diabetes in Hospital" ;
    dmo:populationScope "Non-pregnant adults with diabetes in hospital" ;
    dmo:recommendationId "treatment-of-hypoglycaemia-in-adults-with-diabetes-in-hospital" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "All non-pregnant, adults with diabetes in hospital with a blood glucose level less than 4.0mmol/L (with or without symptoms of hypoglycaemia) should be treated as outlined in this guideline; remember “4.0 is the floor”." ;
    dmo:evidenceQuote "All non-pregnant, adults with diabetes in hospital with a blood glucose level less than 4.0mmol/L (with or without symptoms of hypoglycaemia) should be treated as outlined in this guideline; remember “4.0 is the floor”." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/treatment-of-hypoglycaemia-in-hospitalised-adults> a dmo:Recommendation ;
    rdfs:label "Treatment of hypoglycaemia in hospitalised adults" ;
    dmo:populationScope "Adults who are conscious, orientated and able to swallow" ;
    dmo:recommendationId "treatment-of-hypoglycaemia-in-hospitalised-adults" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Quickly check the following: Airway, Breathing, Circulation, Disability (including Glasgow Coma Scale (GCS) and blood glucose), Exposure (including temperature)." ;
    dmo:evidenceQuote "1. Quickly check the following.  Don’t spend too much time on this, particularly if the person is otherwise well, before moving on to step 2:     a. Airway b. Breathing c. Circulation d. Disability (including Glasgow Coma Scale (GCS) and blood glucose) e. Exposure (including temperature)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/treatment-without-delay-in-seizure-cases> a dmo:Recommendation ;
    rdfs:label "Treatment Without Delay in Seizure Cases" ;
    dmo:populationScope "People with hypoglycaemia who are having a seizure or where measurement is difficult" ;
    dmo:recommendationId "treatment-without-delay-in-seizure-cases" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If measurement is difficult (e.g. in a person having a seizure) then treatment should not be delayed." ;
    dmo:evidenceQuote "If measurement is difficult (e.g. in a person having a seizure) then treatment should not be delayed." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-10-glucose-infusion-for-hypoglycaemia-management> a dmo:Recommendation ;
    rdfs:label "Use of 10% glucose infusion for hypoglycaemia management" ;
    dmo:recommendationId "use-of-10-glucose-infusion-for-hypoglycaemia-management" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "10% glucose - peripherally via a secure cannula into a large vein or central access (preferred where available). If peripheral infusion continues for more than 24 hours change infusion site to minimise thrombophlebitis. Care should be taken to ensure that the whole infusion is not inadvertently administered." ;
    dmo:evidenceQuote "10% glucose - peripherally via a secure cannula into a large vein or central access (preferred where available). If peripheral infusion continues for more than 24 hours change infusion site to minimise thrombophlebitis. Care should be taken to ensure that the whole infusion is not inadvertently administered." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-10-glucose-infusion-for-persistent-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Use of 10% glucose infusion for persistent hypoglycaemia" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients with persistent hypoglycaemia despite initial treatment" ;
    dmo:recommendationId "use-of-10-glucose-infusion-for-persistent-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "For persistent hypoglycaemia despite appropriate initial treatment, an infusion of 10% glucose at 100ml/hr may be required." ;
    dmo:evidenceQuote "For persistent hypoglycaemia despite appropriate initial treatment, an infusion of 10% glucose at 100ml/hr may be required." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-10-or-20-glucose-solutions-for-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Use of 10% or 20% glucose solutions for hypoglycaemia" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "non-pregnant adults (aged 16 years or older) with diabetes mellitus within the hospital setting" ;
    dmo:recommendationId "use-of-10-or-20-glucose-solutions-for-hypoglycaemia" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "For these reasons 10% or 20% glucose solutions are preferred." ;
    dmo:evidenceQuote "For these reasons 10% or 20% glucose solutions are preferred." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-20-glucose-infusion-for-emergency-management-of-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Use of 20% glucose infusion for emergency management of hypoglycaemia" ;
    dmo:recommendationId "use-of-20-glucose-infusion-for-emergency-management-of-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "20% glucose - short term peripheral use via a secure cannula into a large vein is acceptable for the emergency management of hypoglycaemia with close monitoring of the infusion site for thrombophlebitis. Central access is preferred where available and is desirable if 20% infusion has to be continued after the initial dose." ;
    dmo:evidenceQuote "20% glucose - short term peripheral use via a secure cannula into a large vein is acceptable for the emergency management of hypoglycaemia with close monitoring of the infusion site for thrombophlebitis.  Central access is preferred where available and is desirable if 20% infusion has to be continued after the initial dose." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-20g-of-rapid-acting-carbohydrate-for-treatment-of-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Use of 20g of rapid-acting carbohydrate for treatment of hypoglycaemia" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Adults with T1DM" ;
    dmo:recommendationId "use-of-20g-of-rapid-acting-carbohydrate-for-treatment-of-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Vindedzis et al compared 15g versus 20g and found that 32-63% of episodes resolved after one treatment with 15g carbohydrate compared with 55-89% of episodes with 20g carbohydrate." ;
    dmo:evidenceQuote "Vindedzis et al compared 15g versus 20g and found that 32-63% of episodes resolved after one treatment with 15g carbohydrate compared with 55-89% of episodes with 20g carbohydrate (46)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-40-glucose-gel-for-hypoglycaemia-in-non-cooperative-patients> a dmo:Recommendation ;
    rdfs:label "Use of 40% Glucose Gel for Hypoglycaemia in Non-Cooperative Patients" ;
    dmo:populationScope "Adults who are conscious but confused, disorientated, unable to cooperate or aggressive but are able to swallow" ;
    dmo:recommendationId "use-of-40-glucose-gel-for-hypoglycaemia-in-non-cooperative-patients" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If the person is not capable and/or uncooperative, but is able to swallow, give 2 tubes 40% glucose gel (e.g. Glucogel®) squeezed into the mouth between the teeth and gums" ;
    dmo:evidenceQuote "If the person is not capable and/or uncooperative, but is able to swallow, give 2 tubes 40% glucose gel (e.g. Glucogel®) squeezed into the mouth between the teeth and gums" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-computerised-approaches-to-reduce-inpatient-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Use of computerised approaches to reduce inpatient hypoglycaemia" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "People in hospital" ;
    dmo:recommendationId "use-of-computerised-approaches-to-reduce-inpatient-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Screening" ;
    dmo:statement "The best performing algorithm could utilise available data in the electronic patient record to highlight those at risk of hypoglycaemia to the medical team." ;
    dmo:evidenceQuote "The hope is that the best performing algorithm could utilise available data in the electronic patient record to highlight those at risk of hypoglycaemia to the medical team (42)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-continuous-subcutaneous-insulin-infusions-for-inpatient-management> a dmo:Recommendation ;
    rdfs:label "Use of continuous subcutaneous insulin infusions for inpatient management" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "People in hospital using CSII devices" ;
    dmo:recommendationId "use-of-continuous-subcutaneous-insulin-infusions-for-inpatient-management" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If people in hospital are to continue using their CSII devices, they must be well enough to self-manage their diabetes. If they are not, then alternatives such as a variable rate insulin infusion or subcutaneous insulin administration should be considered." ;
    dmo:evidenceQuote "If people in hospital are to continue using their CSII devices, they must be well enough to self-manage their diabetes. If they are not, then alternatives such as a variable rate insulin infusion or subcutaneous insulin administration should be considered." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-infusion-pump-for-glucose-administration> a dmo:Recommendation ;
    rdfs:label "Use of infusion pump for glucose administration" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients with hypoglycaemia" ;
    dmo:recommendationId "use-of-infusion-pump-for-glucose-administration" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "In all other situations, an infusion pump is required." ;
    dmo:evidenceQuote "In all other situations, an infusion pump is required." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-infusion-pump-for-non-emergency-hypoglycaemia-management> a dmo:Recommendation ;
    rdfs:label "Use of infusion pump for non-emergency hypoglycaemia management" ;
    dmo:recommendationId "use-of-infusion-pump-for-non-emergency-hypoglycaemia-management" ;
