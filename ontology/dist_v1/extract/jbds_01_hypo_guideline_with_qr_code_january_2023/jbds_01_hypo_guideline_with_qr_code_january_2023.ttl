<https://example.org/dmo/id/recommendation/flush-feeding-tube-with-40-50ml-water-after-carbohydrate-treatment> a dmo:Recommendation ;
    rdfs:label "Flush feeding tube with 40-50ml water after carbohydrate treatment" ;
    dmo:populationScope "Adults with diabetes in hospital receiving enteral feeding and experiencing hypoglycaemia" ;
    dmo:recommendationId "flush-feeding-tube-with-40-50ml-water-after-carbohydrate-treatment" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "All treatments should be followed by a 40-50ml water flush of the feeding tube to prevent tube blockage (2)." ;
    dmo:evidenceQuote "All treatments should be followed by a 40-50ml water flush of the feeding tube to prevent tube blockage (2)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/fruit-juices-and-products-specifically-designed-for-the-treatment-of-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Fruit juices and products specifically designed for the treatment of hypoglycaemia" ;
    dmo:recommendationId "fruit-juices-and-products-specifically-designed-for-the-treatment-of-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Fruit juices and products specifically designed for the treatment of hypoglycaemia only, will be exempt from this sugar tax and are therefore recommended in this guideline." ;
