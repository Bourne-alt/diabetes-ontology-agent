<https://example.org/dmo/id/riskFactor/acute-kidney-injury> a dmo:RiskFactor ;
    rdfs:label "acute kidney injury" ;
    dmo:evidenceNote "An 84-year-old woman with T2DM on high dose sulfonylurea therapy admitted with a urinary tract infection and acute kidney injury would be at substantially higher risk of hypoglycaemia." ;
    dmo:name "acute kidney injury" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "acute-kidney-injury" ;
    dmo:evidenceQuote "An 84-year-old woman with T2DM on high dose sulfonylurea therapy admitted with a urinary tract infection and acute kidney injury would be at substantially higher risk of hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/addison-s-disease> a dmo:RiskFactor ;
    rdfs:label "Addison’s disease" ;
    dmo:evidenceNote "Endocrine disorders associated with diminished counterregulatory responses" ;
    dmo:name "Addison’s disease" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "addison-s-disease" ;
    dmo:evidenceQuote "Endocrine disorders associated with diminished counterregulatory responses (e.g. Addison’s disease, growth hormone deficiency, hypothyroidism, hypopituitarism)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/age-70-years> a dmo:RiskFactor ;
    rdfs:label "Age >70 Years" ;
    dmo:evidenceNote "Multivariable logistic regression analysis showed that age >70 years was independently associated with hypoglycaemia for people in hospital with T2DM (35)." ;
    dmo:name "Age >70 Years" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "age-70-years" ;
    dmo:evidenceQuote "Multivariable logistic regression analysis showed that age >70 years, cognitive dysfunction and nephropathy were independently associated with hypoglycaemia for people in hospital with T2DM (35)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/age-75-years> a dmo:RiskFactor ;
    rdfs:label "Age >75 Years" ;
    dmo:evidenceNote "A British study used a similar technique to show that age >75 years, insulin & sulfonylurea therapy, black and Asian ethnicity, emergency (rather than elective) admission, lower eGFR, raised inflammatory markers, hyponatraemia (<125mmol/L) and low albumin were the strongest predictors of hypoglycaemia in people with diabetes admitted to medical or surgical wards (not intensive therapy units) (36)." ;
    dmo:name "Age >75 Years" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "age-75-years" ;
    dmo:evidenceQuote "A British study used a similar technique to show that age >75 years, insulin & sulfonylurea therapy, black and Asian ethnicity, emergency (rather than elective) admission, lower eGFR, raised inflammatory markers, hyponatraemia (<125mmol/L) and low albumin were the strongest predictors of hypoglycaemia in people with diabetes admitted to medical or surgical wards (not intensive therapy units) (36)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/bariatric-surgery-involving-bowel-resection> a dmo:RiskFactor ;
    rdfs:label "Bariatric Surgery Involving Bowel Resection" ;
    dmo:evidenceNote "Bariatric surgery involving bowel resection is listed as a lifestyle issue associated with increased risk of hypoglycaemia." ;
