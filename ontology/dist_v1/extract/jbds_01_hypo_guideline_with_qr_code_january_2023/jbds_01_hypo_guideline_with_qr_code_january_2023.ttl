<https://example.org/dmo/id/recommendation/exclude-hypoglycaemia-in-acutely-unwell-adults-with-diabetes> a dmo:Recommendation ;
    rdfs:label "Exclude hypoglycaemia in acutely unwell adults with diabetes" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "non-pregnant adults (aged 16 years or older) with diabetes mellitus within the hospital setting" ;
    dmo:recommendationId "exclude-hypoglycaemia-in-acutely-unwell-adults-with-diabetes" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Screening" ;
    dmo:statement "Hypoglycaemia must be excluded in any person with diabetes who is acutely unwell, drowsy, unconscious, unable to co-operate, presenting with aggressive behaviour or a seizure." ;
    dmo:evidenceQuote "Hypoglycaemia must be excluded in any person with diabetes who is acutely unwell, drowsy, unconscious, unable to co-operate, presenting with aggressive behaviour or a seizure." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

