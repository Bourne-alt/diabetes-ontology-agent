<https://example.org/dmo/id/recommendation/take-measures-to-avoid-future-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Take measures to avoid future hypoglycaemia" ;
    dmo:recommendationId "take-measures-to-avoid-future-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "Take measures to avoid hypoglycaemia in the future.  The Inpatient Diabetes Team can be contacted to discuss this." ;
    dmo:evidenceQuote "When hypoglycaemia has been successfully treated  \n(after following the initial steps outlined in algorithms A-E) \n\nl\t Consider completing an incident form (e.g. DATIX) if appropriate. \nl\t If “hypo boxes” have been used then restock as appropriate. \nl\t Identify the risk factors for hypoglycaemia (see Table 2). \nl\t Take measures to avoid hypoglycaemia in the future.  The Inpatient Diabetes \nTeam can be contacted to discuss this." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/treat-with-intravenous-glucose-algorithm-c-section-5> a dmo:Recommendation ;
    rdfs:label "Treat with intravenous glucose (algorithm C, section 5)" ;
    dmo:populationScope "Adults with diabetes in hospital who experience hypoglycaemia" ;
    dmo:recommendationId "treat-with-intravenous-glucose-algorithm-c-section-5" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
