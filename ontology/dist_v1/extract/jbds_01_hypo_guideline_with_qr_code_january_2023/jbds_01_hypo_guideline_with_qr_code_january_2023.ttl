<https://example.org/dmo/id/recommendation/use-of-intravenous-glucose-for-fasting-patients> a dmo:Recommendation ;
    rdfs:label "Use of Intravenous Glucose for Fasting Patients" ;
    dmo:populationScope "Adults with diabetes in hospital who are fasting for a procedure or operation" ;
    dmo:recommendationId "use-of-intravenous-glucose-for-fasting-patients" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If the person is fasting for a procedure or operation, then consider using intravenous glucose to avoid the operation or procedure being postponed due to oral carbohydrate consumption." ;
    dmo:evidenceQuote "If the person is fasting for a procedure or operation, then consider using intravenous glucose to avoid the operation or procedure being postponed due to oral carbohydrate consumption." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-orange-juice-with-caution-in-people-with-ckd-stage-4-or-5> a dmo:Recommendation ;
    rdfs:label "Use of orange juice with caution in people with CKD stage 4 or 5" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "People with CKD stage 4 or 5" ;
    dmo:recommendationId "use-of-orange-juice-with-caution-in-people-with-ckd-stage-4-or-5" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "Orange juice (which contains fructose) remains a popular treatment for hypoglycaemia although caution should be exercised in people with chronic kidney disease (CKD) stage 4 or CKD stage 5 due to the potassium content." ;
    dmo:evidenceQuote "Orange juice (which contains fructose) remains a popular treatment for hypoglycaemia although caution should be exercised in people with chronic kidney disease (CKD) stage 4 or CKD stage 5 due to the potassium content." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/use-of-rapid-acting-carbohydrate-for-conscious-patients> a dmo:Recommendation ;
    rdfs:label "Use of Rapid-Acting Carbohydrate for Conscious Patients" ;
    dmo:populationScope "Conscious adults with diabetes in hospital able to swallow" ;
    dmo:recommendationId "use-of-rapid-acting-carbohydrate-for-conscious-patients" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "In people who are conscious and able to swallow, 15-20g of rapid-acting carbohydrate is the treatment of choice (see algorithm A)." ;
    dmo:evidenceQuote "In people who are conscious and able to swallow, 15-20g of rapid-acting carbohydrate is the treatment of choice (see algorithm A)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/wait-at-least-10-minutes-before-re-testing-after-hypoglycaemia-treatment> a dmo:Recommendation ;
    rdfs:label "Wait at least 10 minutes before re-testing after hypoglycaemia treatment" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "General" ;
    dmo:recommendationId "wait-at-least-10-minutes-before-re-testing-after-hypoglycaemia-treatment" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "All are supportive of a minimum interval of at least 10 minutes before re-testing to ensure resolution of hypoglycaemia." ;
    dmo:evidenceQuote "All are supportive of a minimum interval of at least 10 minutes before re-testing to ensure resolution of hypoglycaemia (53)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/riskFactor/acute-discontinuation-of-long-term-corticosteroid-therapy> a dmo:RiskFactor ;
