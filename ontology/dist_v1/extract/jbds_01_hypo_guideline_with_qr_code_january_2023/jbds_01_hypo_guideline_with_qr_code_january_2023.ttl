    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/contraindication/incorrect-drug-history-and-failure-to-correctly-reconcile-on-admission> a dmo:Contraindication ;
    rdfs:label "Incorrect drug history and failure to correctly reconcile on admission" ;
    dmo:contraCode "incorrect-drug-history-and-failure-to-correctly-reconcile-on-admission" ;
    dmo:rationale "Failure to reconcile medications on admission can lead to unintended hypoglycaemia" ;
