    dmo:recommendationType "Safety" ;
    dmo:statement "Stop the infusion immediately if any signs or symptoms of a suspected hypersensitivity reaction develop. Treat reaction and seek urgent medical advice regarding hypoglycaemia treatment" ;
    dmo:evidenceQuote "Stop the infusion immediately if any signs or symptoms of a suspected hypersensitivity reaction develop. Treat reaction and seek urgent medical advice regarding hypoglycaemia treatment" ;
