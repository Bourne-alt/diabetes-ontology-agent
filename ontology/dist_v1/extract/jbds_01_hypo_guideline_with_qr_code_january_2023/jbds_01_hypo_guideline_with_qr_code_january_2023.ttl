    dmo:severity "Relative" ;
    dmo:triggerCriteria "when the person is taking acarbose" ;
    dmo:evidenceQuote "sugar dissolved in water is not an effective treatment for people taking acarbose as it prevents the breakdown of sucrose to glucose" ;
