<https://example.org/dmo/id/recommendation/awareness-of-prolonged-hypoglycaemia-risk-after-sulfonylurea-or-long-acting-insulin> a dmo:Recommendation ;
    rdfs:label "Awareness of Prolonged Hypoglycaemia Risk After Sulfonylurea or Long-Acting Insulin" ;
    dmo:populationScope "Adults who are conscious but confused, disorientated, unable to cooperate or aggressive but are able to swallow" ;
    dmo:recommendationId "awareness-of-prolonged-hypoglycaemia-risk-after-sulfonylurea-or-long-acting-insulin" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    dmo:evidenceQuote "If the hypoglycaemia was caused by sulfonylurea or long-acting insulin therapy then be aware the risk of hypoglycaemia may persist for up to 24-36 hours following the last dose, especially if there is concurrent renal impairment." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

