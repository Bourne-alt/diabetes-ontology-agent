<https://example.org/dmo/id/medication/dpp-iv-inhibitors> a dmo:Medication ;
    rdfs:label "DPP-IV inhibitors" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "dpp-iv-inhibitors" ;
    dmo:name "DPP-IV inhibitors" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Temporary substitution of insulin therapy for oral agents (particularly using DPP-IV inhibitors) in the inpatient setting has been shown to reduce rates of hypoglycaemia while maintaining glycaemic control." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/glp-1-agonists> a dmo:Medication ;
    rdfs:label "GLP-1 agonists" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "glp-1-agonists" ;
    dmo:name "GLP-1 agonists" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "However, introducing new treatment options may confuse the people and may not be practical for many of the common agents such as metformin (GI side effects, caution with renal impairment and slower onset of action), SGLT-2 inhibitors (risk of euglycaemic DKA) and GLP-1 agonists (GI side effects) (23)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/glucagon> a dmo:Medication ;
    rdfs:label "Glucagon" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "glucagon" ;
    dmo:name "Glucagon" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "1mg of glucagon IM (only licensed for insulin induced hypoglycaemia, may be less effective when administered repeatedly, in people prescribed sulfonylurea therapy or people with a history of alcohol abuse or chronic liver disease)" ;
    dmo:evidenceQuote "If no IV access is available then give 1mg Glucagon IM." ;
    dmo:evidenceQuote "Intramuscular glucagon and intravenous glucose in varying concentrations are the main treatment options." ;
    dmo:evidenceQuote "1x Glucagon pack – to be kept in the nearest drug fridge or labelled with reduced expiry date of 18 months if stored at room temperature" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/medication/glucagon-1mg-im> a dmo:Medication ;
