<https://example.org/dmo/id/recommendation/avoid-chocolate-for-treatment-of-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Avoid chocolate for treatment of hypoglycaemia" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "General" ;
    dmo:recommendationId "avoid-chocolate-for-treatment-of-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Chocolate is no longer recommended for the treatment of hypoglycaemia. Chocolate contains rapid-acting carbohydrate and fat; the addition of fat has been shown to slow the absorption of quick-acting carbohydrate." ;
    dmo:evidenceQuote "Chocolate is no longer recommended for the treatment of hypoglycaemia. Chocolate contains rapid-acting carbohydrate and fat; the addition of fat has been shown to slow the absorption of quick-acting carbohydrate (50,51)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/avoid-extravasation-during-glucose-infusion> a dmo:Recommendation ;
    rdfs:label "Avoid extravasation during glucose infusion" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients receiving glucose infusion" ;
    dmo:recommendationId "avoid-extravasation-during-glucose-infusion" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "Avoid extravasation – may cause tissue damage" ;
    dmo:evidenceQuote "Avoid extravasation – may cause tissue damage" ;
