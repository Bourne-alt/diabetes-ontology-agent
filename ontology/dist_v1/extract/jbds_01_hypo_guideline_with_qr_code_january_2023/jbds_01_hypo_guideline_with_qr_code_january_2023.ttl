<https://example.org/dmo/id/symptom/anaphylactic-anaphylactoid-reactions> a dmo:Symptom ;
    rdfs:label "Anaphylactic/anaphylactoid reactions" ;
    dmo:name "Anaphylactic/anaphylactoid reactions" ;
    dmo:symptomCode "anaphylactic-anaphylactoid-reactions" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "Hypersensitivity/infusion reactions including anaphylactic/anaphylactoid reactions have been reported with glucose infusions, thought to be from corn allergy. Caution in patients with suspected or know allergy to corn or corn products. Stop the infusion immediately if any signs or symptoms of a suspected hypersensitivity reaction develop. Treat reaction and seek urgent medical advice regarding hypoglycaemia treatment" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

