<https://example.org/dmo/id/recommendation/storage-of-glucagon-pack> a dmo:Recommendation ;
    rdfs:label "Storage of Glucagon Pack" ;
    dmo:populationScope "Hospitalised patients with diabetes mellitus" ;
    dmo:recommendationId "storage-of-glucagon-pack" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
