<https://example.org/dmo/id/medication/insulin> a dmo:Medication ;
    rdfs:label "Insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "insulin" ;
    dmo:name "Insulin" ;
    dmo:evidenceQuote "hypoglycaemia occurring during pregnancy is beyond the scope of these guidelines.   Where young people aged 16-18 years are managed by adult teams because of local arrangements, it is considered appropriate for them to be managed using local adult guidelines, the teams are familiar with rather than using potentially unfamiliar paediatric guidelines. Where individuals aged 16-18 are managed by paediatric teams, the paediatric guidelines should be followed (3,4)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

