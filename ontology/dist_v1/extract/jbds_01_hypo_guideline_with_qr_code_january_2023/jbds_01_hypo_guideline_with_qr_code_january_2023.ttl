<https://example.org/dmo/id/diabetesType/insulin-treated-type-2-diabetes-mellitus-t2dm> a dmo:DiabetesType ;
    rdfs:label "insulin-treated type 2 diabetes mellitus (T2DM)" ;
    dmo:diabetesTypeCode "insulin-treated-type-2-diabetes-mellitus-t2dm" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:name "insulin-treated type 2 diabetes mellitus (T2DM)" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "While severe hypoglycaemia is less common in people with insulin-treated type 2 diabetes mellitus (T2DM), people with insulin-treated T2DM are more likely to require hospital admission as part of their treatment than those with T1DM (12,13)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/diabetesType/t1dm> a dmo:DiabetesType ;
    rdfs:label "T1DM" ;
    dmo:definition "T1DM is a type of diabetes that is typically diagnosed in childhood and is characterized by absolute insulin deficiency due to autoimmune destruction of pancreatic beta cells." ;
    dmo:diabetesTypeCode "t1dm" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "T1DM" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "23 people with T1DM (28.0% in 2010 versus 27.0% in 2019)." ;
    dmo:evidenceQuote "The gap was largest in those with T2DM taking sulfonylurea therapy and smallest in those with T1DM; especially when the initial glucose was between 3.0-3.9 mmol/L (55)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/diabetesType/t2dm> a dmo:DiabetesType ;
    rdfs:label "T2DM" ;
    dmo:definition "T2DM is a type of diabetes that is typically diagnosed in adulthood and is characterized by insulin resistance and relative insulin deficiency." ;
    dmo:diabetesTypeCode "t2dm" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "T2DM" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "Hypoglycaemia with a glucose <3.0mmol/L recurred in in 39% and 45% of people with T2DM and T1DM respectively, in a study of over 17,000 hospital admissions (20)." ;
    dmo:evidenceQuote "The gap was largest in those with T2DM taking sulfonylurea therapy and smallest in those with T1DM; especially when the initial glucose was between 3.0-3.9 mmol/L (55)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/diabetesType/t2dm-diet-only> a dmo:DiabetesType ;
    rdfs:label "T2DM (diet only)" ;
    dmo:definition "A middle-aged man with T2DM on metformin with an HbA1c usually around 48mmol/L would not be expected to be at high risk of hypoglycaemia" ;
    dmo:diabetesTypeCode "t2dm-diet-only" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "T2DM (diet only)" ;
    dmo:prevalenceShare "0.25"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "A middle-aged man with T2DM on metformin with an HbA1c usually around 48mmol/L would not be expected to be at high risk of hypoglycaemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/diabetesType/t2dm-insulin> a dmo:DiabetesType ;
    rdfs:label "T2DM (insulin)" ;
    dmo:definition "An 84-year-old woman with T2DM on high dose sulfonylurea therapy admitted with a urinary tract infection and acute kidney injury would be at substantially higher risk of hypoglycaemia." ;
