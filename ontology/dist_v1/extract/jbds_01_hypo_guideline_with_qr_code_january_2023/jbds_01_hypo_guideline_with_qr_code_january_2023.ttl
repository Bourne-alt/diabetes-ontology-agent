    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "50-glucose" ;
    dmo:name "50% glucose" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "The increment in blood glucose after administration of 50ml of 50% glucose varies widely between individuals with hypoglycaemia." ;
    dmo:evidenceQuote "Fifty percent glucose solution is a hypertonic solution with the potential to cause significant tissue damage from extravasation and even skin necrosis." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

