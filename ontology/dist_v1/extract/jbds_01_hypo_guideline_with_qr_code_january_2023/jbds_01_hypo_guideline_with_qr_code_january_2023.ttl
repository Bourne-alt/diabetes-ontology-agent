<https://example.org/dmo/id/recommendation/blood-glucose-levels-between-4-0-6-0mmol-l-may-indicate-looming-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Blood glucose levels between 4.0-6.0mmol/L may indicate looming hypoglycaemia" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "People with diabetes in hospital" ;
    dmo:recommendationId "blood-glucose-levels-between-4-0-6-0mmol-l-may-indicate-looming-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Blood glucose levels between 4.0-6.0mmol/L may indicate looming hypoglycaemia and require special consideration; see section on glycaemic targets for people with diabetes in hospital for further details" ;
    dmo:evidenceQuote "Blood glucose levels between 4.0-6.0mmol/L may indicate looming hypoglycaemia and require special consideration; see section on glycaemic targets for people with diabetes in hospital for further details" ;
