<https://example.org/dmo/id/recommendation/blood-glucose-measurement-for-hypoglycaemia-confirmation> a dmo:Recommendation ;
    rdfs:label "Blood Glucose Measurement for Hypoglycaemia Confirmation" ;
    dmo:populationScope "People with suspected hypoglycaemia, especially if alcohol influence is suspected" ;
    dmo:recommendationId "blood-glucose-measurement-for-hypoglycaemia-confirmation" ;
    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Diagnosis" ;
    dmo:statement "Where it is safe to do so, a blood glucose measurement should be taken to confirm hypoglycaemia (especially if there is any suspicion the person may also be under the influence of alcohol)." ;
    dmo:evidenceQuote "Where it is safe to do so, a blood glucose measurement should be taken to confirm hypoglycaemia (especially if there is any suspicion the person may also be under the influence of alcohol)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/blood-glucose-monitoring-for-asymptomatic-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Blood Glucose Monitoring for Asymptomatic Hypoglycaemia" ;
    dmo:populationScope "The majority of people with diabetes in hospital" ;
    dmo:recommendationId "blood-glucose-monitoring-for-asymptomatic-hypoglycaemia" ;
    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Regular blood glucose monitoring enables detection of asymptomatic biochemical hypoglycaemia." ;
    dmo:evidenceQuote "Regular blood glucose monitoring enables detection of asymptomatic biochemical hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/call-for-medical-assistance-if-hypoglycaemia-persists> a dmo:Recommendation ;
    rdfs:label "Call for Medical Assistance if Hypoglycaemia Persists" ;
    dmo:populationScope "Adults who are conscious but confused, disorientated, unable to cooperate or aggressive but are able to swallow" ;
    dmo:recommendationId "call-for-medical-assistance-if-hypoglycaemia-persists" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Referral" ;
    dmo:statement "If blood glucose remains less than 4.0mmol/L after 30-45 minutes or 3 treatment cycles, call for medical assistance. If agreed locally, IV glucose may be given without prescription in an emergency for the purpose of saving a life or via a Patient Group Directive." ;
    dmo:evidenceQuote "If blood glucose remains less than 4.0mmol/L after 30-45 minutes or 3 treatment cycles, call for medical assistance. If agreed locally, IV glucose may be given without prescription in an emergency for the purpose of saving a life or via a Patient Group Directive." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/capillary-blood-glucose-monitoring-after-hypoglycaemia> a dmo:Recommendation ;
    rdfs:label "Capillary Blood Glucose Monitoring After Hypoglycaemia" ;
    dmo:populationScope "Adults who are conscious but confused, disorientated, unable to cooperate or aggressive but are able to swallow" ;
    dmo:recommendationId "capillary-blood-glucose-monitoring-after-hypoglycaemia" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Ensure regular capillary blood glucose monitoring is continued for at least 24 to 48 hours." ;
    dmo:evidenceQuote "Ensure regular capillary blood glucose monitoring is continued for at least 24 to 48 hours." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/carbohydrate-counting-using-10g-bricks> a dmo:Recommendation ;
    rdfs:label "Carbohydrate Counting Using 10g Bricks" ;
    dmo:populationScope "People with diabetes in hospital" ;
    dmo:recommendationId "carbohydrate-counting-using-10g-bricks" ;
    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "Allowing people to easily identify the amount of carbohydrate consumed (by providing easily identified 10g “bricks” of carbohydrate) can allow them to carbohydrate count." ;
    dmo:evidenceQuote "Allowing people to easily identify the amount of carbohydrate consumed (by providing easily identified 10g “bricks” of carbohydrate) can allow them to carbohydrate count." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

