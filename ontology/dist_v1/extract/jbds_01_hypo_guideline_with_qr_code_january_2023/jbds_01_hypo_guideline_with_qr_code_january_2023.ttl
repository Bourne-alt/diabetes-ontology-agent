<https://example.org/dmo/id/recommendation/give-additional-bolus-feed-if-bolus-feeding> a dmo:Recommendation ;
    rdfs:label "Give additional bolus feed if bolus feeding" ;
    dmo:recommendationId "give-additional-bolus-feed-if-bolus-feeding" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If bolus feeding, give additional bolus feed (read nutritional information and calculate amount required to give 20g of carbohydrate)" ;
    dmo:evidenceQuote "6. Once blood glucose is above 4.0mmol/L and the person has recovered:\n• Restart feed\n• If bolus feeding, give additional bolus feed (read nutritional information and \ncalculate amount required to give 20g of carbohydrate)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_01_hypo_guideline_with_qr_code_january_2023> .

<https://example.org/dmo/id/recommendation/give-hypoglycaemia-education-or-refer-to-local-diabetes-inpatient-team> a dmo:Recommendation ;
