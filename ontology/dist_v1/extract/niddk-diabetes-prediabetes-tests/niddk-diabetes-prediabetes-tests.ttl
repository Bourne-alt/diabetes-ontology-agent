<https://example.org/dmo/id/labTest/a1c-test> a dmo:LabTest ;
    rdfs:label "A1C Test" ;
    dmo:definition "Screening and diagnosis of prediabetes; Screening and diagnosis of type 2 diabetes; Monitoring of diabetes" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "a1c-test" ;
    dmo:loincCode "4548-4" ;
    dmo:name "A1C Test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "A1C test\nThe A1C test is sometimes called the hemoglobin A1C, HbA1c, glycated hemoglobin, or glycohemoglobin test.\nUses\nScreening and diagnosis of prediabetes1\n5.7–6.4%1\nScreening and diagnosis of type 2 diabetes1\n6.5% or higher1" ;
    dmo:evidenceQuote "The A1C test is sometimes called the hemoglobin A1C, HbA1c, glycated hemoglobin, or glycohemoglobin test." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-diabetes-prediabetes-tests> .

