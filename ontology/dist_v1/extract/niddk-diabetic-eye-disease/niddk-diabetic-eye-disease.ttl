<https://example.org/dmo/id/recommendation/anti-vegf-medicine-for-diabetic-macular-edema> a dmo:Recommendation ;
    rdfs:label "Anti-VEGF medicine for diabetic macular edema" ;
    dmo:populationScope "People with diabetic macular edema" ;
    dmo:recommendationId "anti-vegf-medicine-for-diabetic-macular-edema" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Your doctor may treat your eyes with anti-VEGF medicine, such as aflibercept, bevacizumab, or ranibizumab. These medicines block the growth of abnormal blood vessels in the eye. Anti-VEGF medicines can also stop fluid leaks, which can help treat diabetic macular edema." ;
    dmo:evidenceQuote "Your doctor may treat your eyes with anti-VEGF medicine, such as aflibercept, bevacizumab, or ranibizumab. These medicines block the growth of abnormal blood vessels in the eye. Anti-VEGF medicines can also stop fluid leaks, which can help treat diabetic macular edema." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-diabetic-eye-disease> .

