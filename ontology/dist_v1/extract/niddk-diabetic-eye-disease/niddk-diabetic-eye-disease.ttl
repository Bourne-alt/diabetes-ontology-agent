<https://example.org/dmo/id/complication/cataract> a dmo:Complication ;
    rdfs:label "Cataract" ;
    dmo:affectedOrgan "Eye" ;
    dmo:complicationCode "cataract" ;
    dmo:definition "A condition in which the lens of the eye becomes cloudy, leading to vision impairment." ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005118" ;
    dmo:name "Cataract" ;
    dmo:onsetPattern "Chronic" ;
    dmo:evidenceQuote "In a surgery center or hospital visit, your doctor can remove the cloudy lens in your eye, where the cataract has grown, and replace it with an artificial lens." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-diabetic-eye-disease> .

