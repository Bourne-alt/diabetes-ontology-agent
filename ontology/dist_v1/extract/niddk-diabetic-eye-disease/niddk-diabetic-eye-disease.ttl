    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-diabetic-eye-disease> .

<https://example.org/dmo/id/labTest/a1c> a dmo:LabTest ;
    rdfs:label "A1c" ;
    dmo:definition "A1c is a measure of average blood glucose levels over the past 2 to 3 months. It is used to monitor diabetes control and is part of the diabetes ABCs, which include A1c, blood pressure, and cholesterol." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "a1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "A1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "Your doctor may recommend having eye exams more often than once a year, along with management of your diabetes. This means managing your diabetes ABCs, which include your A1c, blood pressure, and cholesterol; and quitting smoking." ;
    dmo:evidenceQuote "To prevent diabetic eye disease, or to keep it from getting worse, manage your diabetes ABCs: your A1c, blood pressure, and cholesterol; and quit smoking if you smoke." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-diabetic-eye-disease> .

