    dmo:name "糖尿病高危人群定期测量血糖、血脂和血压" ;
    dmo:evidenceQuote "倡导糖尿病高危人群和患者定期测量血糖、血脂和血压，维持健康体重，普及健康生活方式，降低糖尿病发病风险。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/lifestyleIntervention/维持健康体重> a dmo:LifestyleIntervention ;
    rdfs:label "维持健康体重" ;
    dmo:interventionCode "维持健康体重" ;
