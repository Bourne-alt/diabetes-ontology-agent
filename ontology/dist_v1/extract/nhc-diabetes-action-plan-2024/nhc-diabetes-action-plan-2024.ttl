<https://example.org/dmo/id/complication/diabetic-foot-disease> a dmo:Complication ;
    rdfs:label "Diabetic Foot Disease" ;
    dmo:affectedOrgan "Foot" ;
    dmo:complicationCode "diabetic-foot-disease" ;
    dmo:definition "提高医务人员对糖尿病慢性并发症的早期发现、规范化诊断和治疗能力，及早干预治疗糖尿病肾脏病、糖尿病视网膜病变、糖尿病足病等并发症，延缓并发症进展，降低致残率和致死率。" ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005149" ;
    dmo:name "Diabetic Foot Disease" ;
    dmo:onsetPattern "Chronic" ;
    dmo:evidenceQuote "提高医务人员对糖尿病慢性并发症的早期发现、规范化诊断和治疗能力，及早干预治疗糖尿病肾脏病、糖尿病视网膜病变、糖尿病足病等并发症，延缓并发症进展，降低致残率和致死率。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

