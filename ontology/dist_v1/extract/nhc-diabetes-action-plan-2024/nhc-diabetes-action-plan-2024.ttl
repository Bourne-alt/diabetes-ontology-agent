    dmo:evidenceQuote "开展肥胖防控行动，加强以控制超重和肥胖等为重点的健康知识教育和主动健康管理。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/lifestyleIntervention/营养促进> a dmo:LifestyleIntervention ;
    rdfs:label "营养促进" ;
