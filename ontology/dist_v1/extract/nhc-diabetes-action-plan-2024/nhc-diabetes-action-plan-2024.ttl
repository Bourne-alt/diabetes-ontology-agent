    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/lifestyleIntervention/运动评估干预> a dmo:LifestyleIntervention ;
    rdfs:label "运动评估干预" ;
    dmo:interventionCode "运动评估干预" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "运动评估干预" ;
    dmo:evidenceQuote "加强运动评估干预，支持引导群众积极参与健身活动。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/monitoringSchedule/a1c检测> a dmo:MonitoringSchedule ;
    rdfs:label "A1C检测" ;
    dmo:appliesTo "糖尿病患者" ;
    dmo:frequencyMonths "3"^^xsd:integer ;
    dmo:name "A1C检测" ;
    dmo:scheduleId "a1c检测" ;
    dmo:evidenceQuote "提高医务人员对糖尿病慢性并发症的早期发现、规范化诊断和治疗能力，及早干预治疗糖尿病肾脏病、糖尿病视网膜病变、糖尿病足病等并发症" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/monitoringSchedule/egfr> a dmo:MonitoringSchedule ;
