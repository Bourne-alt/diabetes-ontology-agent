<https://example.org/dmo/id/lifestyleIntervention/健康教育> a dmo:LifestyleIntervention ;
    rdfs:label "健康教育" ;
    dmo:interventionCode "健康教育" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "健康教育" ;
    dmo:evidenceQuote "加强中小学生健康教育，制定儿童青少年营养促进和体育健身健康策略，保障在校运动时间，校园内限制销售含糖饮料并避免售卖高糖、高脂食品，控制肥胖等相关危险因素，提升儿童青少年健康素养。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

