<https://example.org/dmo/id/diabetesType/2型糖尿病> a dmo:DiabetesType ;
    rdfs:label "2型糖尿病" ;
    dmo:definition "基层医疗卫生机构应按照国家基本公共卫生服务规范要求，为辖区内2型糖尿病患者提供规范的健康管理服务，对2型糖尿病高危人群进行针对性的健康教育。" ;
    dmo:diabetesTypeCode "2型糖尿病" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:name "2型糖尿病" ;
    dmo:prevalenceShare "0"^^xsd:integer ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "基层医疗卫生机构应按照国家基本公共卫生服务规范要求，为辖区内2型糖尿病患者提供规范的健康管理服务，对2型糖尿病高危人群进行针对性的健康教育。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/diabetesType/diabetes前期> a dmo:DiabetesType ;
    rdfs:label "Diabetes前期" ;
    dmo:definition "以糖尿病前期人群、肥胖人群等为重点，开发营养及运动等干预适宜技术。" ;
    dmo:diabetesTypeCode "diabetes前期" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:name "Diabetes前期" ;
    dmo:prevalenceShare "0"^^xsd:integer ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "以糖尿病前期人群、肥胖人群等为重点，开发营养及运动等干预适宜技术。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/labTest/空腹血糖> a dmo:LabTest ;
    rdfs:label "空腹血糖" ;
    dmo:definition "空腹血糖是评估糖尿病和糖尿病前期的重要指标，通常指至少8小时未进食后的血糖水平。" ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "空腹血糖" ;
    dmo:name "空腹血糖" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "引导糖尿病高危人群每年至少测量1次空腹血糖，并接受医务人员的健康指导；" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/labTest/糖尿病风险评估> a dmo:LabTest ;
    rdfs:label "糖尿病风险评估" ;
    dmo:definition "通过评估个体的危险因素（如年龄、体重、家族史、生活方式等）来判断其患糖尿病的可能性。" ;
    dmo:labTestCode "糖尿病风险评估" ;
    dmo:name "糖尿病风险评估" ;
    dmo:evidenceQuote "引导糖尿病前期人群每半年检测1次空腹或餐后2小时血糖，每年到医疗机构进行1次糖尿病风险评估；" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/labTest/餐后2小时血糖> a dmo:LabTest ;
    rdfs:label "餐后2小时血糖" ;
    dmo:definition "餐后2小时血糖是指从进食第一口开始计时，2小时后的血糖水平，用于评估糖耐量状态。" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "餐后2小时血糖" ;
    dmo:name "餐后2小时血糖" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "引导糖尿病前期人群每半年检测1次空腹或餐后2小时血糖，每年到医疗机构进行1次糖尿病风险评估；" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/lifestyleIntervention/三减三健> a dmo:LifestyleIntervention ;
    rdfs:label "三减三健" ;
    dmo:activityTarget "减盐、减油、减糖、健康口腔、健康体重、健康骨骼" ;
    dmo:interventionCode "三减三健" ;
    dmo:interventionType "WeightManagement" ;
    dmo:name "三减三健" ;
    dmo:evidenceQuote "推进全民健康生活方式行动，深入开展“三减三健”（减盐、减油、减糖、健康口腔、健康体重、健康骨骼）和“体重管理年”等专项行动，开发推广健康适宜技术和支持工具，增强群众促进和维护自身健康的能力。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/lifestyleIntervention/中医养生保健> a dmo:LifestyleIntervention ;
    rdfs:label "中医养生保健" ;
    dmo:interventionCode "中医养生保健" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "中医养生保健" ;
    dmo:evidenceQuote "发布糖尿病防治核心信息和知识要点，广泛宣传合理膳食、科学运动、戒烟限酒、心理平衡、中医养生保健等健康科普知识。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

