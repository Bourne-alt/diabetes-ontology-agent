    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-action-plan-2024> .

<https://example.org/dmo/id/lifestyleIntervention/肥胖防控行动> a dmo:LifestyleIntervention ;
    rdfs:label "肥胖防控行动" ;
    dmo:activityTarget "控制超重和肥胖等为重点的健康知识教育和主动健康管理" ;
