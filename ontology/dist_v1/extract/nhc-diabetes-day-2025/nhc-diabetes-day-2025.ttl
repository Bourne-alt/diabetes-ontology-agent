<https://example.org/dmo/id/complication/cardiovascular-disease> a dmo:Complication ;
    rdfs:label "Cardiovascular Disease" ;
    dmo:affectedOrgan "Heart" ;
    dmo:complicationCode "cardiovascular-disease" ;
    dmo:definition "大血管病变主要是指动脉粥样硬化性心血管疾病和心力衰竭，其中动脉粥样硬化性心血管疾病包括冠心病、脑血管疾病和周围血管疾病。" ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005046" ;
    dmo:name "Cardiovascular Disease" ;
    dmo:onsetPattern "Chronic" ;
    dmo:evidenceQuote "大血管病变主要是指动脉粥样硬化性心血管疾病和心力衰竭，其中动脉粥样硬化性心血管疾病包括冠心病、脑血管疾病和周围血管疾病。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/complication/diabetic-foot-ulcer> a dmo:Complication ;
    rdfs:label "Diabetic Foot Ulcer" ;
    dmo:affectedOrgan "Foot" ;
    dmo:complicationCode "diabetic-foot-ulcer" ;
    dmo:definition "上述血管病变严重的可以导致心肌梗死、卒中、失明、肾衰竭、截肢等严重后果，是糖尿病患者致残或致死的主要原因。" ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005045" ;
