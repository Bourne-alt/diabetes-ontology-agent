<https://example.org/dmo/id/diabetesType/糖尿病前期> a dmo:DiabetesType ;
    rdfs:label "糖尿病前期" ;
    dmo:definition "糖尿病前期是指空腹血糖受损（IFG）或糖耐量异常（IGT）的状态。" ;
    dmo:diabetesTypeCode "糖尿病前期" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:name "糖尿病前期" ;
    dmo:prevalenceShare "0"^^xsd:integer ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "1.有糖尿病前期史（空腹血糖受损IFG或糖尿病异常IGT）；" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/labTest/肺功能检查> a dmo:LabTest ;
    rdfs:label "肺功能检查" ;
    dmo:definition "肺功能检查是诊断慢阻肺病等慢性呼吸系统疾病的重要检查手段，在进行规范的肺功能检查及胸部影像、血常规等检查后，可确诊是否患有慢阻肺病。" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "肺功能检查" ;
    dmo:name "肺功能检查" ;
    dmo:specimen "Breath" ;
    dmo:unitOfMeasure "L/min" ;
    dmo:evidenceQuote "肺功能检查是诊断慢阻肺病等慢性呼吸系统疾病的重要检查手段，在进行规范的肺功能检查及胸部影像、血常规等检查后，可确诊是否患有慢阻肺病。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/labTest/餐后2小时血糖> a dmo:LabTest ;
    rdfs:label "餐后2小时血糖" ;
    dmo:definition "餐后2小时血糖是评估糖代谢状态的指标，糖尿病前期人群每半年检测1次空腹血糖或餐后2小时血糖。" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "餐后2小时血糖" ;
    dmo:name "餐后2小时血糖" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "糖尿病前期人群每半年检测1次空腹血糖或餐后2小时血糖，当空腹血糖≥6.1mmol/L或餐后2小时血糖≥7.8mmol/L时，应到医疗机构进行糖代谢评估。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/lifestyleIntervention/主动利用基本公共卫生服务> a dmo:LifestyleIntervention ;
    rdfs:label "主动利用基本公共卫生服务" ;
    dmo:activityTarget "主动利用基本公共卫生服务，配合医生做好健康管理" ;
    dmo:expectedBenefit "配合医生做好健康管理" ;
    dmo:interventionCode "主动利用基本公共卫生服务" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "主动利用基本公共卫生服务" ;
    dmo:evidenceQuote "主动利用基本公共卫生服务，配合医生做好健康管理。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/lifestyleIntervention/减少室内外空气污染> a dmo:LifestyleIntervention ;
    rdfs:label "减少室内外空气污染" ;
    dmo:activityTarget "减少室内外空气污染，尽量选择清洁能源，改善厨房通风条件" ;
    dmo:expectedBenefit "避免二手烟暴露；减少室内外空气污染，尽量选择清洁能源，改善厨房通风条件" ;
    dmo:interventionCode "减少室内外空气污染" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "减少室内外空气污染" ;
    dmo:evidenceQuote "为预防慢阻肺病，首先要倡导健康生活方式，提倡科学运动与合理膳食，积极戒烟，避免二手烟暴露；要减少室内外空气污染，尽量选择清洁能源，改善厨房通风条件；在职业环境中做好防护，减少职业暴露；对于老年人、慢性病人群等，尤其要注意及时接种流感疫苗、肺炎球菌疫苗等；提倡高风险人群积极参与慢性呼吸系统疾病筛查，以便早期发现和治疗。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/lifestyleIntervention/及时接种流感疫苗-肺炎球菌疫苗> a dmo:LifestyleIntervention ;
    rdfs:label "及时接种流感疫苗、肺炎球菌疫苗" ;
    dmo:activityTarget "及时接种流感疫苗、肺炎球菌疫苗等" ;
    dmo:expectedBenefit "可有效预防感染导致的急性加重" ;
    dmo:interventionCode "及时接种流感疫苗-肺炎球菌疫苗" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "及时接种流感疫苗、肺炎球菌疫苗" ;
    dmo:evidenceQuote "及时接种流感疫苗和肺炎球菌疫苗，可有效预防感染导致的急性加重。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/lifestyleIntervention/合理膳食> a dmo:LifestyleIntervention ;
    rdfs:label "合理膳食" ;
    dmo:activityTarget "减少精制碳水化合物（如白米饭、面食、饼干等）和含糖饮料的摄入" ;
    dmo:expectedBenefit "有助于预防糖尿病" ;
    dmo:interventionCode "合理膳食" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "合理膳食" ;
    dmo:evidenceQuote "平衡膳食，减少精制碳水化合物（如白米饭、面食、饼干等）和含糖饮料的摄入，适当运动、戒烟限酒、规律作息。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/lifestyleIntervention/呼吸功能锻炼-如缩唇呼吸-腹式呼吸> a dmo:LifestyleIntervention ;
    rdfs:label "呼吸功能锻炼（如缩唇呼吸、腹式呼吸）" ;
    dmo:activityTarget "在医务人员指导下进行呼吸功能锻炼（如缩唇呼吸、腹式呼吸）" ;
    dmo:expectedBenefit "改善运动耐量，缓解呼吸困难症状" ;
    dmo:interventionCode "呼吸功能锻炼-如缩唇呼吸-腹式呼吸" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "呼吸功能锻炼（如缩唇呼吸、腹式呼吸）" ;
    dmo:evidenceQuote "其他常用非药物治疗包括戒烟、呼吸功能锻炼（如缩唇呼吸、腹式呼吸）、运动训练、营养支持等，可在医务人员指导下进行。及时接种流感疫苗和肺炎球菌疫苗，可有效预防感染导致的急性加重。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/lifestyleIntervention/在职业环境中做好防护> a dmo:LifestyleIntervention ;
    rdfs:label "在职业环境中做好防护" ;
    dmo:activityTarget "在职业环境中做好防护，减少职业暴露" ;
    dmo:expectedBenefit "减少职业暴露" ;
    dmo:interventionCode "在职业环境中做好防护" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "在职业环境中做好防护" ;
    dmo:evidenceQuote "为预防慢阻肺病，首先要倡导健康生活方式，提倡科学运动与合理膳食，积极戒烟，避免二手烟暴露；要减少室内外空气污染，尽量选择清洁能源，改善厨房通风条件；在职业环境中做好防护，减少职业暴露；对于老年人、慢性病人群等，尤其要注意及时接种流感疫苗、肺炎球菌疫苗等；提倡高风险人群积极参与慢性呼吸系统疾病筛查，以便早期发现和治疗。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/lifestyleIntervention/平衡心理状态> a dmo:LifestyleIntervention ;
    rdfs:label "平衡心理状态" ;
    dmo:activityTarget "平衡心理状态" ;
    dmo:expectedBenefit "有助于预防糖尿病" ;
