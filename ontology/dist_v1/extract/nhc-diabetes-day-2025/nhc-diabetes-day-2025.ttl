    dmo:name "平衡心理状态" ;
    dmo:evidenceQuote "对于一般人群，控制体重、合理膳食、适量运动、限盐、戒烟限酒、平衡心理状态有助于预防糖尿病。" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/nhc-diabetes-day-2025> .

<https://example.org/dmo/id/lifestyleIntervention/戒烟限酒> a dmo:LifestyleIntervention ;
    rdfs:label "戒烟限酒" ;
