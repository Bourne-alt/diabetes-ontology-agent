    dmo:populationScope "All people with diabetes" ;
    dmo:recommendationId "work-with-health-care-team-to-create-personalized-meal-plan" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "Work with your health care team to create a meal plan that works for you." ;
    dmo:evidenceQuote "Work with your health care team to create a meal plan that works for you." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-healthy-living-with-diabetes> .

<https://example.org/dmo/id/riskFactor/diabetes-mellitus> a dmo:RiskFactor ;
    rdfs:label "Diabetes Mellitus" ;
    dmo:evidenceNote "文档整体讨论的是糖尿病患者如何管理健康，糖尿病本身是基础疾病，不可干预。" ;
    dmo:name "Diabetes Mellitus" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "diabetes-mellitus" ;
    dmo:evidenceQuote "If you have diabetes, managing your weight may bring you several health benefits." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-healthy-living-with-diabetes> .

<https://example.org/dmo/id/riskFactor/obesity> a dmo:RiskFactor ;
    rdfs:label "Obesity" ;
    dmo:evidenceNote "文档中提到，如果成人超重或肥胖，应与医疗团队合作制定减重计划，并指出减重5%至7%可改善健康问题和血糖、胆固醇、血压水平。" ;
    dmo:name "Obesity" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "obesity" ;
    dmo:evidenceQuote "If you are an adult with overweight or obesity, work with your health care team to create a weight-loss plan. Losing 5% to 7% of your current weight may help you prevent or improve some health problems and manage your blood glucose, cholesterol, and blood pressure levels." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-healthy-living-with-diabetes> .

<https://example.org/dmo/id/riskFactor/overweight> a dmo:RiskFactor ;
    rdfs:label "Overweight" ;
    dmo:evidenceNote "文档中明确指出，如果患有糖尿病，管理体重可能带来多种健康益处，并建议通过健康饮食、减少卡路里摄入、增加体力活动和保证充足睡眠来达到或维持健康体重。" ;
    dmo:name "Overweight" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "overweight" ;
    dmo:evidenceQuote "If you have diabetes, managing your weight may bring you several health benefits. Ask your health care professional or health care team if you are at a healthy weight or if you should try to lose weight." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-healthy-living-with-diabetes> .

<https://example.org/dmo/id/riskFactor/type-1-diabetes> a dmo:RiskFactor ;
    rdfs:label "Type 1 Diabetes" ;
    dmo:evidenceNote "文档提到糖尿病酮症酸中毒（DKA）最常见于1型糖尿病患者，偶尔也影响2型糖尿病中已丧失胰岛素分泌能力者，说明1型糖尿病是不可干预的疾病类型。" ;
    dmo:name "Type 1 Diabetes" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "type-1-diabetes" ;
    dmo:evidenceQuote "DKA is most common in people with type 1 diabetes. Occasionally, DKA may affect people with type 2 diabetes who have lost their ability to produce insulin." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-healthy-living-with-diabetes> .

<https://example.org/dmo/id/riskFactor/type-2-diabetes> a dmo:RiskFactor ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:evidenceNote "文档中将2型糖尿病作为一类独立的疾病类型提及，其发展与胰岛素分泌能力丧失相关，属于不可干预的疾病状态。" ;
    dmo:name "Type 2 Diabetes" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "type-2-diabetes" ;
    dmo:evidenceQuote "Occasionally, DKA may affect people with type 2 diabetes who have lost their ability to produce insulin." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-healthy-living-with-diabetes> .

