<https://example.org/dmo/id/recommendation/avoid-low-blood-glucose-during-and-after-physical-activity> a dmo:Recommendation ;
    rdfs:label "Avoid Low Blood Glucose During and After Physical Activity" ;
    dmo:populationScope "People with diabetes who take insulin or some other diabetes medicines, such as sulfonylureas" ;
    dmo:recommendationId "avoid-low-blood-glucose-during-and-after-physical-activity" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "Physical activity often lowers the level of glucose in your blood. Low blood glucose levels may last for hours or days after physical activity. You are most likely to have low blood glucose if you take insulin or some other diabetes medicines, such as sulfonylureas." ;
    dmo:evidenceQuote "Physical activity often lowers the level of glucose in your blood. Low blood glucose levels may last for hours or days after physical activity. You are most likely to have low blood glucose if you take insulin or some other diabetes medicines, such as sulfonylureas." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-healthy-living-with-diabetes> .

