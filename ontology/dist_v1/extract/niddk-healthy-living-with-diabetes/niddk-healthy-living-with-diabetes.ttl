<https://example.org/dmo/id/recommendation/plate-method-composition> a dmo:Recommendation ;
    rdfs:label "Plate Method Composition" ;
    dmo:populationScope "All people with diabetes" ;
    dmo:recommendationId "plate-method-composition" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "Nonstarchy vegetables—such as leafy greens, peppers, carrots, or green beans—should make up half of your plate. Carb foods that are high in fiber—such as brown rice, whole grains, beans, or fruits—should make up one-quarter of your plate. Protein foods—such as lean meats, fish, dairy, or tofu or other soy products—should make up one quarter of your plate." ;
    dmo:evidenceQuote "Nonstarchy vegetables—such as leafy greens, peppers, carrots, or green beans—should make up half of your plate. Carb foods that are high in fiber—such as brown rice, whole grains, beans, or fruits—should make up one-quarter of your plate. Protein foods—such as lean meats, fish, dairy, or tofu or other soy products—should make up one quarter of your plate." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-healthy-living-with-diabetes> .

