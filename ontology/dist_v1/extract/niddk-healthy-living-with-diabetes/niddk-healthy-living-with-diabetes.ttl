<https://example.org/dmo/id/labTest/urine-ketones> a dmo:LabTest ;
    rdfs:label "urine ketones" ;
    dmo:definition "When your body uses fat for energy, your body makes chemicals called ketones. High levels of ketones in your blood can lead to a condition called diabetic ketoacidosis (DKA)." ;
    dmo:labTestCode "urine-ketones" ;
    dmo:name "urine ketones" ;
