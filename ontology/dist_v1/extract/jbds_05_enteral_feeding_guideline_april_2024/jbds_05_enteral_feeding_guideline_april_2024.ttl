    dmo:medicationCode "human-insulin-isophane" ;
    dmo:name "human insulin (isophane)" ;
    dmo:evidenceQuote "Many NHS organisations favour the use of human insulin (isophane) in the initial management of type 2 diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/insulatard> a dmo:Medication ;
