<https://example.org/dmo/id/recommendation/use-basal-insulin-for-type-1-diabetes-to-avoid-ketosis> a dmo:Recommendation ;
    rdfs:label "Use basal insulin for Type 1 Diabetes to avoid ketosis" ;
