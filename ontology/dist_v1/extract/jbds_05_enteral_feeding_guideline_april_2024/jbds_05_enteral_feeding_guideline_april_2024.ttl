    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "insulatard" ;
    dmo:name "Insulatard" ;
    dmo:onsetMinutes "60"^^xsd:integer ;
    dmo:evidenceQuote "Insulatard = 24 units at start of feed and 16 units 10 hours into feed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/insulin> a dmo:Medication ;
    rdfs:label "Insulin" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "insulin" ;
    dmo:name "Insulin" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "If feeding is required urgently then insulin should be used as glucose lowering therapy at an early stage to avoid days of hyperglycaemia associated with oral medication titration." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/insulin-aspart> a dmo:Medication ;
