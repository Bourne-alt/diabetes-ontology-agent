<https://example.org/dmo/id/recommendation/intermediate-basal-insulin-for-single-feed-with-one-break> a dmo:Recommendation ;
    rdfs:label "Intermediate basal insulin for single feed with one break" ;
    dmo:populationScope "people with Type 1 or insulin deficient diabetes" ;
    dmo:recommendationId "intermediate-basal-insulin-for-single-feed-with-one-break" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "administration of isophane (NPH) insulin at the start of the feed, with a further dose likely to be required at the midpoint of the feed if feed duration is ≥16 hours with either a 50/50 dose split or where glucose levels spike after start of the feed, consider 60% of the required total feed dose (TFD) administered at start of the feed and 40% at the mid point dose" ;
    dmo:evidenceQuote "Intermediate basal insulin administration of isophane (NPH) insulin at the start of the feed, with a further dose likely to be required at the midpoint of the feed if feed duration is ≥16 hours with either a 50/50 dose split or where glucose levels spike after start of the feed, consider 60% of the required total feed dose (TFD) administered at start of the feed and 40% at the mid point dose" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/intermediate-basal-insulin-with-possible-mid-point-dose> a dmo:Recommendation ;
    rdfs:label "Intermediate basal insulin with possible mid-point dose" ;
    dmo:recommendationId "intermediate-basal-insulin-with-possible-mid-point-dose" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Intermediate basal insulin. This regimen requires a single administration of isophane (NPH) insulin at the start of the feed, with a further dose likely to be required at the midpoint of the feed if feed duration is ≥16 hours." ;
    dmo:evidenceQuote "•  Intermediate basal insulin. This regimen requires a single administration of isophane (NPH) insulin at the start of the feed, with a further dose likely to be required at the midpoint of the feed if feed duration is ≥16 hours." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/intravenous-insulin-infusion-should-not-be-discontinued-too-early> a dmo:Recommendation ;
    rdfs:label "Intravenous insulin infusion should not be discontinued too early" ;
    dmo:populationScope "all feed regimens" ;
    dmo:recommendationId "intravenous-insulin-infusion-should-not-be-discontinued-too-early" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "With all regimens the intravenous insulin infusion should not be discontinued for at least 30 to 60 minutes after the administration of the subcutaneous dose given in association with the feed." ;
    dmo:evidenceQuote "With all regimens the intravenous insulin infusion should not be discontinued for at least 30 to 60 minutes after the administration of the subcutaneous dose given in association with the feed." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

