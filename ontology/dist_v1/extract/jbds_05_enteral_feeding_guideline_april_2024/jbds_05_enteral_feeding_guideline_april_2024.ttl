<https://example.org/dmo/id/recommendation/use-insulin-as-glucose-lowering-therapy-early-in-urgent-feeding-for-type-2-diabetes> a dmo:Recommendation ;
    rdfs:label "Use insulin as glucose lowering therapy early in urgent feeding for Type 2 Diabetes" ;
    dmo:populationScope "People with type 2 diabetes" ;
