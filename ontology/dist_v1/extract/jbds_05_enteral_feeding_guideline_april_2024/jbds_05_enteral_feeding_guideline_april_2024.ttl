    dmo:recommendationType "Treatment" ;
    dmo:statement "Note: a feed related dose should not be given within 4 hours of the feed ending for rapid analogue insulin and 6 hours of the feed ending for soluble quick acting insulin." ;
    dmo:evidenceQuote "Note: a feed related dose should not be given within 4 hours of the feed ending for rapid analogue insulin and 6 hours of the feed ending for soluble quick acting insulin." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/do-not-administer-subcutaneous-insulin-dose-if-feed-is-stopped-unexpectedly-and-dose-is-due> a dmo:Recommendation ;
    rdfs:label "Do not administer subcutaneous insulin dose if feed is stopped unexpectedly and dose is due" ;
