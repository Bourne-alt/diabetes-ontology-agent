<https://example.org/dmo/id/recommendation/assessment-for-use-of-prn-insulin-should-be-based-on-glucose-readings-taken-at-recommended-times> a dmo:Recommendation ;
    rdfs:label "Assessment for use of PRN insulin should be based on glucose readings taken at recommended times" ;
    dmo:recommendationId "assessment-for-use-of-prn-insulin-should-be-based-on-glucose-readings-taken-at-recommended-times" ;
    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Monitoring" ;
