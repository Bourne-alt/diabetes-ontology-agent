<https://example.org/dmo/id/recommendation/review-by-dit-for-patients-on-basal-insulin> a dmo:Recommendation ;
    rdfs:label "Review by DIT for patients on basal insulin" ;
    dmo:populationScope "People with any type of diabetes admitted to hospital on a basal insulin" ;
    dmo:recommendationId "review-by-dit-for-patients-on-basal-insulin" ;
    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "People with any type of diabetes, admitted to hospital on a basal insulin should be reviewed by the DIT at the earliest opportunity. These patients should continue the basal insulin during enteral feeding. In patients with risk factors for hypoglycaemia you may wish to reduce the basal insulin dose by 20%." ;
    dmo:evidenceQuote "People with any type of diabetes, admitted to hospital on a basal insulin should be reviewed by the DIT at the earliest opportunity. These patients should continue the basal insulin during enteral feeding. In patients with risk factors for hypoglycaemia you may wish to reduce the basal insulin dose by 20%." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/review-by-dit-for-people-with-known-type-1-diabetes-or-known-insulin-deficiency> a dmo:Recommendation ;
    rdfs:label "Review by DIT for people with known type 1 diabetes or known insulin deficiency" ;
    dmo:populationScope "People with known type 1 diabetes or known insulin deficiency (e.g. total pancreatectomy)" ;
    dmo:recommendationId "review-by-dit-for-people-with-known-type-1-diabetes-or-known-insulin-deficiency" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "People with known type 1 diabetes or known insulin deficiency (e.g. total pancreatectomy) should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    dmo:evidenceQuote "People with known type 1 diabetes or known insulin deficiency (e.g. total pancreatectomy) should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/review-full-prescription-comments-before-administering-feed-specific-diabetes-medication> a dmo:Recommendation ;
    rdfs:label "Review full prescription comments before administering feed-specific diabetes medication" ;
    dmo:recommendationId "review-full-prescription-comments-before-administering-feed-specific-diabetes-medication" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Always review the full prescription comments before administering any feed specific diabetes related medication to ensure it is being administered at the correct time associated to the feed" ;
    dmo:evidenceQuote "Always review the full prescription comments before administering any feed specific diabetes related medication to ensure it is being administered at the correct time associated to the feed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/review-glucose-control-at-36-48-hours> a dmo:Recommendation ;
    rdfs:label "Review glucose control at 36-48 hours" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients on enteral feeding" ;
    dmo:recommendationId "review-glucose-control-at-36-48-hours" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "The DIT and dietetic/ nutrition team need to review glucose control at 36-48 hours and consider a change in regimen if the glucose range is not within 6-12 mmol/L." ;
    dmo:evidenceQuote "The DIT and dietetic/ nutrition team need to review glucose control at 36-48 hours and consider a change in regimen if the glucose range is not within 6-12 mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/review-ketone-results-0-6-mmol-l-and-refer-to-dit-if-required> a dmo:Recommendation ;
    rdfs:label "Review ketone results >0.6 mmol/L and refer to DIT if required" ;
    dmo:recommendationId "review-ketone-results-0-6-mmol-l-and-refer-to-dit-if-required" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Any result >0.6 mmol/L should be considered elevated, reviewed by the medical team and referred to the DIT if required." ;
    dmo:evidenceQuote "Any result >0.6 mmol/L should be considered elevated, reviewed by the medical team and referred to the DIT if required." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/review-of-oral-hypoglycaemic-agents-during-transition-from-enteral-feeding> a dmo:Recommendation ;
    rdfs:label "Review of Oral Hypoglycaemic Agents During Transition from Enteral Feeding" ;
    dmo:recommendationId "review-of-oral-hypoglycaemic-agents-during-transition-from-enteral-feeding" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "For patients on oral hypoglycaemic agents, these should be reviewed, adjusted as required and recommenced as the person’s oral intake improves." ;
    dmo:evidenceQuote "For patients on oral hypoglycaemic agents, these should be reviewed, adjusted as required and recommenced as the person’s oral intake improves." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/risk-of-hypoglycaemia-if-feed-stopped-unexpectedly-and-insulin-administered> a dmo:Recommendation ;
    rdfs:label "Risk of hypoglycaemia if feed stopped unexpectedly and insulin administered" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "People with diabetes receiving enteral feeding" ;
    dmo:recommendationId "risk-of-hypoglycaemia-if-feed-stopped-unexpectedly-and-insulin-administered" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "If feed unexpectedly stopped for longer than 30 minutes and insulin has been administered, risk of hypoglycaemia is high" ;
    dmo:evidenceQuote "If feed unexpectedly stopped for longer than 30 minutes and insulin has been administered, risk of hypoglycaemia is high" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/second-dose-of-pre-mixed-insulin-at-midpoint-for-prolonged-feed> a dmo:Recommendation ;
    rdfs:label "Second dose of pre-mixed insulin at midpoint for prolonged feed" ;
    dmo:recommendationId "second-dose-of-pre-mixed-insulin-at-midpoint-for-prolonged-feed" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Where two doses are required, you can start with either a 50/50 dose split or where glucose levels spike after start of the feed you can give 60% of the required total daily dose administered at start of the feed and 40% at the mid point dose." ;
    dmo:evidenceQuote "Where two doses are required, you can start with either a 50/50 dose split or where glucose levels spike after start of the feed you can give 60% of the required total daily dose administered at start of the feed and 40% at the mid point dose." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/self-management-of-enteral-feeding-regimen-prior-to-discharge> a dmo:Recommendation ;
    rdfs:label "Self-Management of Enteral Feeding Regimen Prior to Discharge" ;
    dmo:recommendationId "self-management-of-enteral-feeding-regimen-prior-to-discharge" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "For patients who are likely to be discharged on enteral feeding, self-management of the regimen should be considered when agreeing the regimen and training should not be left for the days prior to discharge unless for a clinical reason." ;
    dmo:evidenceQuote "For patients who are likely to be discharged on enteral feeding, self-management of the regimen should be considered when agreeing the regimen and training should not be left for the days prior to discharge unless for a clinical reason." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/specific-risk-factors-for-hypoglycaemia-in-people-requiring-enteral-feeding-should-be-considered> a dmo:Recommendation ;
    rdfs:label "Specific risk factors for hypoglycaemia in people requiring enteral feeding should be considered" ;
    dmo:recommendationId "specific-risk-factors-for-hypoglycaemia-in-people-requiring-enteral-feeding-should-be-considered" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "In a patient who requires enteral feeding there may be specific risk factors for the development of hypoglycaemia – see table 2" ;
    dmo:evidenceQuote "In a patient who requires enteral feeding there may be specific risk factors for the development of hypoglycaemia – see table 2" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/standard-feed-preparations-for-people-with-diabetes> a dmo:Recommendation ;
    rdfs:label "Standard Feed Preparations for People with Diabetes" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "people with diabetes" ;
    dmo:recommendationId "standard-feed-preparations-for-people-with-diabetes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "people with diabetes receive the currently available standard feed preparations as recommended by the local dietitian or nutrition team" ;
    dmo:evidenceQuote "Thus, until further evidence is available to demonstrate benefits of diabetes specific feeds over standard feed preparations, this guideline advises that people with diabetes receive the currently available standard feed preparations as recommended by the local dietitian or nutrition team." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/start-enteral-feeds-at-prescribed-time> a dmo:Recommendation ;
    rdfs:label "Start enteral feeds at prescribed time" ;
    dmo:recommendationId "start-enteral-feeds-at-prescribed-time" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Where possible, feeds should always be started at the prescribed time. This is because insulin sensitivity changes day to night, therefore if the feed is started at different time of day, the corresponding insulin dose may no longer be correct" ;
    dmo:evidenceQuote "Where possible, feeds should always be started at the prescribed time. This is because insulin sensitivity changes day to night, therefore if the feed is started at different time of day, the corresponding insulin dose may no longer be correct" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/structured-competency-assessment-for-inpatient-diabetes-management> a dmo:Recommendation ;
    rdfs:label "Structured Competency Assessment for Inpatient Diabetes Management" ;
    dmo:populationScope "All clinical staff in Acute Trusts with contact with inpatients with diabetes" ;
    dmo:recommendationId "structured-competency-assessment-for-inpatient-diabetes-management" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "A structured competency assessment should be in place for all staff in Acute Trusts who have contact with inpatients with diabetes. Competency is defined as a level of performance demonstrating the effective application of knowledge, skill, and judgement. A structured, skill-based competency assessment, should be developed for managing hypoglycaemia and DKA, managing insulin infusions, managing diabetes and parenteral nutrition, and in patients treated with steroids." ;
    dmo:evidenceQuote "A structured competency assessment should be in place for all staff in Acute Trusts who have contact with inpatients with diabetes. Competency is defined as a level of performance demonstrating the effective application of knowledge, skill, and judgement. A structured, skill-based competency assessment, should be developed for managing hypoglycaemia and DKA, managing insulin infusions, managing diabetes and parenteral nutrition, and in patients treated with steroids." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/subcutaneous-basal-insulin-continuation> a dmo:Recommendation ;
    rdfs:label "Subcutaneous Basal Insulin Continuation" ;
    dmo:populationScope "Patients with insulin deficiency on enteral feeding" ;
    dmo:recommendationId "subcutaneous-basal-insulin-continuation" ;
