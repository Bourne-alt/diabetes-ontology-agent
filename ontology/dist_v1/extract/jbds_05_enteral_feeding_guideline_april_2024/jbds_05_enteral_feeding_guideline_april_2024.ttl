<https://example.org/dmo/id/recommendation/capillary-blood-glucose-monitoring-after-hypoglycaemic-event> a dmo:Recommendation ;
    rdfs:label "Capillary Blood Glucose Monitoring After Hypoglycaemic Event" ;
    dmo:recommendationId "capillary-blood-glucose-monitoring-after-hypoglycaemic-event" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Ensure at least 4 hourly capillary blood glucose monitoring continued for next 24 – 48 hours due to the increased risk of further hypoglycaemic episodes after any hypoglycaemic event" ;
    dmo:evidenceQuote "Ensure at least 4 hourly capillary blood glucose monitoring continued for next 24 – 48 hours due to the increased risk of further hypoglycaemic episodes after any hypoglycaemic event" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

