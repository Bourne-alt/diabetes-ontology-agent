<https://example.org/dmo/id/recommendation/discontinuation-of-csii-in-patients-unable-to-self-manage-or-without-specialist-support> a dmo:Recommendation ;
    rdfs:label "Discontinuation of CSII in patients unable to self-manage or without specialist support" ;
    dmo:populationScope "People admitted with CSII devices who are not fully competent and able to manage the pump or where no specialist pump support is available" ;
    dmo:recommendationId "discontinuation-of-csii-in-patients-unable-to-self-manage-or-without-specialist-support" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If the patient is not fully competent and able to manage the insulin pump or there is no specialist pump support available then it should be discontinued, and a subcutaneous insulin injection regimen be commenced. Do not remove CSII until a replacement regimen has been commenced. While awaiting assessment VRIII can be used to replace CSII." ;
    dmo:evidenceQuote "If the patient is not fully competent and able to manage the insulin pump or there is no specialist pump support available then it should be discontinued, and a subcutaneous insulin injection regimen be commenced. Do not remove CSII until a replacement regimen has been commenced. While awaiting assessment VRIII can be used to replace CSII." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/discontinuation-of-feed-related-diabetes-treatment-after-enteral-feeding-stops> a dmo:Recommendation ;
    rdfs:label "Discontinuation of Feed-Related Diabetes Treatment After Enteral Feeding Stops" ;
    dmo:recommendationId "discontinuation-of-feed-related-diabetes-treatment-after-enteral-feeding-stops" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "In patients who did not require any diabetes related treatment prior to enteral feeding, unless a new diagnosis of diabetes has been made, all feed related diabetes treatment can be stopped when enteral feeding stops, however ongoing glucose testing should continue to ensure glucose levels return to normal parameters." ;
    dmo:evidenceQuote "In patients who did not require any diabetes related treatment prior to enteral feeding, unless a new diagnosis of diabetes has been made, all feed related diabetes treatment can be stopped when enteral feeding stops, however ongoing glucose testing should continue to ensure glucose levels return to normal parameters." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/discontinue-vriii-and-commence-long-term-regimen-when-possible> a dmo:Recommendation ;
