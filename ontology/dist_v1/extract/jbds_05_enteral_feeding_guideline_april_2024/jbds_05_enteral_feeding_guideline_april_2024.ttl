<https://example.org/dmo/id/contraindication/discontinuation-of-csii-without-replacement-regimen> a dmo:Contraindication ;
    rdfs:label "Discontinuation of CSII without replacement regimen" ;
    dmo:contraCode "discontinuation-of-csii-without-replacement-regimen" ;
    dmo:rationale "To avoid interruption of basal insulin requirements and prevent DKA in patients with type 1 diabetes or insulin deficiency" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "Do not remove CSII until a replacement regimen has been commenced" ;
    dmo:evidenceQuote "Do not remove CSII until a replacement regimen has been commenced." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/contraindication/discontinuation-of-intravenous-insulin-infusion-before-30-60-minutes-after-subcutaneous-dose> a dmo:Contraindication ;
    rdfs:label "Discontinuation of intravenous insulin infusion before 30-60 minutes after subcutaneous dose" ;
    dmo:contraCode "discontinuation-of-intravenous-insulin-infusion-before-30-60-minutes-after-subcutaneous-dose" ;
    dmo:rationale "To ensure continuous insulin coverage during transition from IV to subcutaneous insulin, especially in the context of enteral feeding" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "The intravenous insulin infusion should not be discontinued for at least 30 to 60 minutes after the administration of the subcutaneous dose given in association with the feed" ;
    dmo:evidenceQuote "With all regimens the intravenous insulin infusion should not be discontinued for at least 30 to 60 minutes after the administration of the subcutaneous dose given in association with the feed." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

