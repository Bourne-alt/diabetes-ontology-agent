    dmo:recommendationType "Treatment" ;
    dmo:statement "If the feed is stopped at an unplanned time and a feed related subcutaneous insulin dose is due, do not administer that insulin dose" ;
    dmo:evidenceQuote "If the feed is stopped at an unplanned time and a feed related subcutaneous insulin dose is due, do not administer that insulin dose" ;
