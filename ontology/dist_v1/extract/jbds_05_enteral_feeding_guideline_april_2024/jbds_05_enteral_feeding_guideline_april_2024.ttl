<https://example.org/dmo/id/riskFactor/delayed-enteral-feed> a dmo:RiskFactor ;
    rdfs:label "Delayed Enteral Feed" ;
    dmo:evidenceNote "A further disadvantage is there is only a small break window, therefore if the feed is delayed for any reason, it can easily mean the shift away from the prescribed start/ stop times." ;
    dmo:name "Delayed Enteral Feed" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "delayed-enteral-feed" ;
    dmo:evidenceQuote "A further disadvantage is there is only a small break window, therefore if the feed is delayed for any reason, it can easily mean the shift away from the prescribed start/ stop times." ;
