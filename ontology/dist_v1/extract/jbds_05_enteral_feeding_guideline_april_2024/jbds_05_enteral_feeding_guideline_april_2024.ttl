<https://example.org/dmo/id/medication/subcutaneous-basal-insulin> a dmo:Medication ;
    rdfs:label "subcutaneous basal insulin" ;
    dmo:durationHours "12"^^xsd:integer ;
    dmo:insulinAction "Intermediate" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "subcutaneous-basal-insulin" ;
    dmo:name "subcutaneous basal insulin" ;
    dmo:onsetMinutes "30"^^xsd:integer ;
    dmo:evidenceQuote "insulin deficiency should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/subcutaneous-insulin> a dmo:Medication ;
    rdfs:label "Subcutaneous insulin" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "subcutaneous-insulin" ;
    dmo:name "Subcutaneous insulin" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "If metformin is contraindicated or if the patient requires insulin prior to admission, then commence/ optimise subcutaneous insulin (see section ‘insulin options’)" ;
    dmo:evidenceQuote "The administration of liquid metformin and/or subcutaneous insulin will be effective, and more acceptable to patients." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/variable-rate-intravenous-insulin-infusion> a dmo:Medication ;
    rdfs:label "Variable rate intravenous insulin infusion" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "variable-rate-intravenous-insulin-infusion" ;
    dmo:name "Variable rate intravenous insulin infusion" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "She was given  a variable rate intravenous insulin infusion (VRIII) for the first 72 hours of her hospital admission" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/vriii> a dmo:Medication ;
    rdfs:label "VRIII" ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "vriii" ;
    dmo:name "VRIII" ;
    dmo:evidenceQuote "While awaiting assessment VRIII can be used to replace CSII." ;
    dmo:evidenceQuote "VRIII may be used in the initial period of feeding to stabilise glucose and estimate insulin requirements while feeding regimen is established." ;
    dmo:evidenceQuote "a VRIII may be required if PRN rapid acting insulin is ineffective at correcting suboptimal glucose control, or the fasting state is deemed to be an increased risk for contributing to ketosis" ;
    dmo:evidenceQuote "If the feed is stopped at an unplanned time and a feed related subcutaneous insulin dose is due, do not administer that insulin dose" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/monitoringSchedule/bedside-capillary-blood-glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Bedside Capillary Blood Glucose Monitoring" ;
    dmo:appliesTo "inpatients with diabetes" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Bedside Capillary Blood Glucose Monitoring" ;
    dmo:scheduleId "bedside-capillary-blood-glucose-monitoring" ;
    dmo:triggerWindow "in the event of hypoglycaemia or recurrent hyperglycaemia" ;
    dmo:evidenceQuote "In the event of hypoglycaemia or recurrent hyperglycaemia, capillary blood glucose should be undertaken on a more frequent basis (e.g., every 15 minutes following treatment for hypoglycaemia) and then a minimum of 2 hourly until a review of the diabetes regimen has taken place in order to assess response to an intervention or to ensure return of glucose to the accepted range." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Blood Glucose Monitoring" ;
    dmo:appliesTo "people with diabetes receiving enteral feed" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Capillary Blood Glucose Monitoring" ;
    dmo:scheduleId "capillary-blood-glucose-monitoring" ;
    dmo:triggerWindow "pre-feed and then 4-6 hourly when the feed is running, when the feed is stopped, and at least 2 hourly during any feed break. Monitor hourly if the feed is unexpectedly switched off or the glucose levels are below the recommended target range" ;
    dmo:evidenceQuote "Monitor capillary glucose pre-feed and then 4-6 hourly when the feed is running, when the feed is stopped, and at least 2 hourly during any feed break. Monitor hourly if the feed is unexpectedly switched off or the glucose levels are below the recommended target range" ;
    dmo:evidenceQuote "Ensure at least 4 hourly capillary blood glucose monitoring continued for next 24 – 48 hours due to the increased risk of further hypoglycaemic episodes after any hypoglycaemic event" ;
    dmo:evidenceQuote "If the patient has received basal insulin, and the feed is off, then hourly monitoring of blood sugar will be required initially" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose-monitoring-during-unexpected-feed-stoppage> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Blood Glucose Monitoring During Unexpected Feed Stoppage" ;
    dmo:appliesTo "patients receiving enteral feed with insulin administration" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Capillary Blood Glucose Monitoring During Unexpected Feed Stoppage" ;
    dmo:scheduleId "capillary-blood-glucose-monitoring-during-unexpected-feed-stoppage" ;
    dmo:triggerWindow "when the feed is stopped unexpectedly" ;
    dmo:evidenceQuote "When the feed is stopped unexpectedly, and insulin has been or is being administered, healthcare practitioners should be acutely aware of the risk of hypoglycaemia. In this “fasted” state, we recommend the capillary blood glucose be checked hourly and a glucose infusion considered to replace missed carbohydrate intake." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/monitoringSchedule/capillary-glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Glucose Monitoring" ;
    dmo:appliesTo "patients receiving variable rate intravenous insulin infusion (VRIII) for the first 72 hours of hospital admission" ;
    dmo:frequencyMonths "1"^^xsd:integer ;
    dmo:name "Capillary Glucose Monitoring" ;
    dmo:scheduleId "capillary-glucose-monitoring" ;
    dmo:triggerWindow "hourly during the first 72 hours of hospital admission" ;
    dmo:evidenceQuote "Her basal insulin had been omitted. The NGT was dislodged and removed, and the intravenous insulin infusion was stopped leaving her without insulin. The NGT was re-sited several hours later but nursing staff were unable to aspirate through the NGT, and a chest X-ray was ordered. There was a delay in getting the x-ray and a delay in it being reviewed. No blood glucose monitoring was carried out." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/monitoringSchedule/dit-and-dietetic-nutrition-team-review-glucose-control> a dmo:MonitoringSchedule ;
    rdfs:label "DIT and dietetic/ nutrition team review glucose control" ;
    dmo:appliesTo "after feed regimen is established" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "DIT and dietetic/ nutrition team review glucose control" ;
    dmo:scheduleId "dit-and-dietetic-nutrition-team-review-glucose-control" ;
    dmo:triggerWindow "36-48 hours" ;
    dmo:evidenceQuote "The DIT and dietetic/ nutrition team need to review glucose control at 36-48 hours and consider a change in regimen if the glucose range is not within 6-12 mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/monitoringSchedule/foot-assessments> a dmo:MonitoringSchedule ;
    rdfs:label "Foot assessments" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Foot assessments" ;
    dmo:scheduleId "foot-assessments" ;
    dmo:triggerWindow "every shift" ;
    dmo:evidenceQuote "Foot assessments should be undertaken and documented every shift." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/monitoringSchedule/glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Glucose Monitoring" ;
    dmo:appliesTo "high-risk individuals" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Glucose Monitoring" ;
    dmo:scheduleId "glucose-monitoring" ;
    dmo:triggerWindow "minimum 4 hourly" ;
    dmo:evidenceQuote "More frequent glucose monitoring - minimum 4 hourly" ;
    dmo:evidenceQuote "Glucose monitoring should always take place at the start of the feed, end of the feed and during any feed breaks." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/monitoringSchedule/ketone-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Ketone Monitoring" ;
    dmo:appliesTo "patients with type 1 diabetes or significant insulin deficiency" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Ketone Monitoring" ;
    dmo:scheduleId "ketone-monitoring" ;
    dmo:triggerWindow "during a fasted state, acute illness or simply excess hyperglycaemia" ;
    dmo:evidenceQuote "Patients with type 1 diabetes or significant insulin deficiency will be at increased risk of ketosis during a fasted state, acute illness or simply excess hyperglycaemia. Ketone monitoring should be undertaken in line with local guidance." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/monitoringSchedule/ketone-testing> a dmo:MonitoringSchedule ;
    rdfs:label "Ketone testing" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Ketone testing" ;
    dmo:scheduleId "ketone-testing" ;
    dmo:triggerWindow "in line with local guidelines" ;
    dmo:evidenceQuote "Ketone testing should be undertaken in line with local guidelines but patients at particular risk are those with type 1 diabetes and insulin deficiency" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/adherence-to-local-guidelines-for-syringe-pumps-and-insulin-infusions> a dmo:Recommendation ;
    rdfs:label "Adherence to local guidelines for syringe pumps and insulin infusions" ;
    dmo:recommendationId "adherence-to-local-guidelines-for-syringe-pumps-and-insulin-infusions" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "Local guidelines should be adhered to for the setting up of syringe pumps, giving sets, intravenous access, skin bundles and intravenous insulin infusions." ;
    dmo:evidenceQuote "Local guidelines should be adhered to for the setting up of syringe pumps, giving sets, intravenous access, skin bundles and intravenous insulin infusions." ;
