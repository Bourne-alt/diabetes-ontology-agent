<https://example.org/dmo/id/recommendation/insulin-prescription-clarity> a dmo:Recommendation ;
    rdfs:label "Insulin Prescription Clarity" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "All patients receiving enteral feeding with insulin" ;
    dmo:recommendationId "insulin-prescription-clarity" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "It is important to ensure that prescriptions of insulin for enteral feeding include instructions for when to administer the insulin in relation to the enteral feed (at the start of the feed or X hours into feed). Insulin prescription should not simply state ‘administer when the patient is receiving enteral feeding’." ;
    dmo:evidenceQuote "It is important to ensure that prescriptions of insulin for enteral feeding include instructions for when to administer the insulin in relation to the enteral feed (at the start of the feed or X hours into feed). Insulin prescription should not simply state ‘administer when the patient is receiving enteral feeding’." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

