<https://example.org/dmo/id/recommendation/if-blood-glucose-still-4-mmol-l-alert-doctor-and-ensure-iv-access-and-start-iv-glucose-10-at-100ml-hour> a dmo:Recommendation ;
    rdfs:label "If blood glucose still <4 mmol/L, alert doctor and ensure IV access and start IV glucose 10% at 100ml/hour" ;
