<https://example.org/dmo/id/recommendation/basal-insulin-continuation-in-type-1-diabetes> a dmo:Recommendation ;
    rdfs:label "Basal Insulin Continuation in Type 1 Diabetes" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients with known type 1 diabetes or known insulin deficiency" ;
    dmo:recommendationId "basal-insulin-continuation-in-type-1-diabetes" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "People with known type 1 diabetes or known insulin deficiency should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    dmo:evidenceQuote "People with known type 1 diabetes or known insulin deficiency should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

