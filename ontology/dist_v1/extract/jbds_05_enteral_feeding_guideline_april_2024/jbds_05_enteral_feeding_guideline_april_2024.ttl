<https://example.org/dmo/id/recommendation/avoid-crushing-oral-hypoglycemics-during-enteral-feeding> a dmo:Recommendation ;
    rdfs:label "Avoid crushing oral hypoglycemics during enteral feeding" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients receiving enteral feeding" ;
    dmo:recommendationId "avoid-crushing-oral-hypoglycemics-during-enteral-feeding" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Crushing oral hypoglycaemic medications, such as sulfonylureas, to manage hyperglycaemia during enteral feeding is not advised given the unpredictable absorption and difficulties in administration associated with this action, as well as the risk of tube blockage with crushed debris." ;
    dmo:evidenceQuote "Crushing oral hypoglycaemic medications, such as sulfonylureas, to manage hyperglycaemia during enteral feeding is not advised given the unpredictable absorption and difficulties in administration associated with this action, as well as the risk of tube blockage with crushed debris." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

