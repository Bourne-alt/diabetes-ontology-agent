<https://example.org/dmo/id/recommendation/capillary-blood-glucose-less-than-4-0-mmol-l-should-be-treated-in-line-with-local-hypoglycaemia-policy> a dmo:Recommendation ;
    rdfs:label "Capillary blood glucose less than 4.0 mmol/L should be treated in line with local hypoglycaemia policy" ;
