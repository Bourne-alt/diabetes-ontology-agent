<https://example.org/dmo/id/contraindication/vriii-may-be-required-if-prn-rapid-acting-insulin-is-ineffective-at-correcting-suboptimal-glucose-control-or-the-fasting-state-is-deemed-to-be-an-increased-risk-for-contributing-to-ketosis> a dmo:Contraindication ;
    rdfs:label "VRIII may be required if PRN rapid acting insulin is ineffective at correcting suboptimal glucose control, or the fasting state is deemed to be an increased risk for contributing to ketosis" ;
    dmo:contraCode "vriii-may-be-required-if-prn-rapid-acting-insulin-is-ineffective-at-correcting-suboptimal-glucose-control-or-the-fasting-state-is-deemed-to-be-an-increased-risk-for-contributing-to-ketosis" ;
    dmo:rationale "VRIII may be required if PRN rapid acting insulin is ineffective at correcting suboptimal glucose control, or the fasting state is deemed to be an increased risk for contributing to ketosis" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "if PRN rapid acting insulin is ineffective at correcting suboptimal glucose control, or the fasting state is deemed to be an increased risk for contributing to ketosis" ;
    dmo:evidenceQuote "If a patient with known type 1 diabetes or known insulin deficiency and is nil by mouth and no enteral feed is prescribed or the feed is stopped for longer than two hours, a VRIII may be required if PRN rapid acting insulin is ineffective at correcting suboptimal glucose control, or the fasting state is deemed to be an increased risk for contributing to ketosis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/device/capillary-blood-glucose> a dmo:Device ;
    rdfs:label "Capillary Blood Glucose" ;
    dmo:deviceCode "capillary-blood-glucose" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Capillary Blood Glucose" ;
    dmo:evidenceQuote "Monitor capillary glucose pre-feed and then 4-6 hourly when the feed is running, when the feed is stopped, and at least 2 hourly during any feed break." ;
    dmo:evidenceQuote "The frequency of bedside capillary blood glucose testing should be a clinical decision based on the stability of the patient." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/device/capillary-blood-glucose-level> a dmo:Device ;
    rdfs:label "Capillary Blood Glucose Level" ;
    dmo:deviceCode "capillary-blood-glucose-level" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Capillary Blood Glucose Level" ;
    dmo:evidenceQuote "For the purpose of these guidelines, hyperglycaemia is considered to be a capillary blood glucose level above 12 mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/device/capillary-blood-glucose-monitoring> a dmo:Device ;
    rdfs:label "Capillary Blood Glucose Monitoring" ;
    dmo:deviceCode "capillary-blood-glucose-monitoring" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Capillary Blood Glucose Monitoring" ;
    dmo:evidenceQuote "Ensure at least 4 hourly capillary blood glucose monitoring continued for next 24 – 48 hours due to the increased risk of further hypoglycaemic episodes after any hypoglycaemic event" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/device/capillary-glucose-monitoring> a dmo:Device ;
    rdfs:label "capillary glucose monitoring" ;
    dmo:deviceCode "capillary-glucose-monitoring" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "capillary glucose monitoring" ;
    dmo:evidenceQuote "Her basal insulin had been omitted.\n\nThe NGT was dislodged and removed, and the intravenous insulin infusion was stopped leaving her without insulin. The NGT was re-sited several hours later but nursing staff were unable to aspirate through the NGT, and a chest X-ray was ordered. There was a delay in getting the x-ray and a delay in it being reviewed. No blood glucose monitoring was carried out." ;
    dmo:evidenceQuote "Capillary glucose and ketone monitoring" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/device/capillary-ketones> a dmo:Device ;
    rdfs:label "capillary ketones" ;
    dmo:deviceCode "capillary-ketones" ;
    dmo:deviceType "KetoneTestKit" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "capillary ketones" ;
    dmo:evidenceQuote "An on-call doctor was called and capillary ketones and arterial blood gases were measured. These were consistent with diabetic ketoacidosis (DKA)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/device/continuous-glucose-monitoring> a dmo:Device ;
    rdfs:label "Continuous Glucose Monitoring" ;
    dmo:deviceCode "continuous-glucose-monitoring" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Continuous Glucose Monitoring" ;
    dmo:evidenceQuote "If the individual is using continuous glucose monitoring before admission and is able to self-manage this may be used in addition to capillary glucose values to aid monitoring" ;
    dmo:evidenceQuote "Use of continuous glucose monitoring: If previously used, the person with diabetes may wish to continue to use CGM glucose monitoring in hospital." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/device/continuous-subcutaneous-insulin-infusion-csii-devices> a dmo:Device ;
    rdfs:label "Continuous Subcutaneous Insulin Infusion (CSII) Devices" ;
    dmo:deviceCode "continuous-subcutaneous-insulin-infusion-csii-devices" ;
    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Continuous Subcutaneous Insulin Infusion (CSII) Devices" ;
    dmo:evidenceQuote "People admitted with continuous subcutaneous insulin infusion (CSII) devices (likely type 1 diabetes) should be referred to the DIT for assessment and ongoing review." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/device/fixed-rate-intravenous-insulin-infusion> a dmo:Device ;
    rdfs:label "Fixed Rate Intravenous Insulin Infusion" ;
    dmo:deviceCode "fixed-rate-intravenous-insulin-infusion" ;
    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Fixed Rate Intravenous Insulin Infusion" ;
    dmo:evidenceQuote "In the presence of ketonaemia (>3 mmol/L) or ketonuria (>2+), consider a fixed rate intravenous insulin infusion (FRIII) to suppress ketone body formation as suggested in the JBDS-IP DKA guidelines (25)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/device/glucose-meter> a dmo:Device ;
    rdfs:label "Glucose Meter" ;
    dmo:deviceCode "glucose-meter" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Glucose Meter" ;
    dmo:evidenceQuote "Glucose monitoring should always take place at the start of the feed, end of the feed and during any feed breaks." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

