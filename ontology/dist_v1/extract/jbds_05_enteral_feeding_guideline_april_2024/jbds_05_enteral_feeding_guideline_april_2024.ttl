<https://example.org/dmo/id/riskFactor/delayed-reassessment-of-enteral-feeding-tube-patency> a dmo:RiskFactor ;
    rdfs:label "Delayed Reassessment of Enteral Feeding Tube Patency" ;
    dmo:evidenceNote "Document describes a delay in obtaining and reviewing a chest X-ray after NGT dislodgement, leading to a delay in re-siting and glucose monitoring." ;
    dmo:name "Delayed Reassessment of Enteral Feeding Tube Patency" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "delayed-reassessment-of-enteral-feeding-tube-patency" ;
    dmo:evidenceQuote "There was a delay in getting the x-ray and a delay in it being reviewed. No blood glucose monitoring was carried out." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

