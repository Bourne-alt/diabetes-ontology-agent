<https://example.org/dmo/id/recommendation/test-ketones-and-consider-correction-doses-if-glucose-above-target> a dmo:Recommendation ;
    rdfs:label "Test ketones and consider correction doses if glucose above target" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "People with diabetes receiving enteral feeding" ;
    dmo:recommendationId "test-ketones-and-consider-correction-doses-if-glucose-above-target" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If the glucose levels are above the target range test ketones in line with local guidance and consider using as required rapid acting insulin correction doses" ;
    dmo:evidenceQuote "If the glucose levels are above the target range test ketones in line with local guidance and consider using as required rapid acting insulin correction doses" ;
