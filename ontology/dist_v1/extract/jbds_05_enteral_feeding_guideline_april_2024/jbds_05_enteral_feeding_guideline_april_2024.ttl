<https://example.org/dmo/id/recommendation/do-not-discontinue-intravenous-insulin-infusion-for-at-least-30-to-60-minutes-after-subcutaneous-insulin-administration> a dmo:Recommendation ;
    rdfs:label "Do not discontinue intravenous insulin infusion for at least 30 to 60 minutes after subcutaneous insulin administration" ;
    dmo:recommendationId "do-not-discontinue-intravenous-insulin-infusion-for-at-least-30-to-60-minutes-after-subcutaneous-insulin-administration" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
