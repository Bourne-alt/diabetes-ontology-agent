<https://example.org/dmo/id/recommendation/monitoring-frequency-for-capillary-glucose-during-enteral-feeding> a dmo:Recommendation ;
    rdfs:label "Monitoring frequency for capillary glucose during enteral feeding" ;
    dmo:populationScope "People with diabetes receiving enteral feed" ;
    dmo:recommendationId "monitoring-frequency-for-capillary-glucose-during-enteral-feeding" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Monitor capillary glucose pre-feed and then 4-6 hourly when the feed is running, when the feed is stopped, and at least 2 hourly during any feed break. Monitor hourly if the feed is unexpectedly switched off or the glucose levels are below the recommended target range" ;
    dmo:evidenceQuote "Monitor capillary glucose pre-feed and then 4-6 hourly when the feed is running, when the feed is stopped, and at least 2 hourly during any feed break. Monitor hourly if the feed is unexpectedly switched off or the glucose levels are below the recommended target range" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

