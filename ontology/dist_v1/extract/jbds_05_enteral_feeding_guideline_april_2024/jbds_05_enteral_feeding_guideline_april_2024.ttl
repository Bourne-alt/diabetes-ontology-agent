    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Insulin detemir is associated with more predictable glycemic control and reduced risk of hypoglycemia than NPH insulin in patients with type 1 diabetes on a basal-bolus regimen with premeal insulin aspart." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

