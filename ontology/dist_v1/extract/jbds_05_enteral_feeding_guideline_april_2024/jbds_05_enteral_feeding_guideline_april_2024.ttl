    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "acute-illness" ;
    dmo:evidenceQuote "Patients with type 1 diabetes or significant insulin deficiency will be at increased risk of ketosis during a fasted state, acute illness or simply excess hyperglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/riskFactor/alteration-in-medication-use> a dmo:RiskFactor ;
    rdfs:label "Alteration in Medication Use" ;
    dmo:evidenceNote "Alteration in medication use, e.g. addition of glucocorticoids or omission of oral hypoglycaemic agents, is a common cause of glycaemic disturbance during enteral feeding." ;
    dmo:name "Alteration in Medication Use" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "alteration-in-medication-use" ;
    dmo:evidenceQuote "Alteration in medication use, e.g. addition of glucocorticoids or omission of oral hypoglycaemic agents" ;
