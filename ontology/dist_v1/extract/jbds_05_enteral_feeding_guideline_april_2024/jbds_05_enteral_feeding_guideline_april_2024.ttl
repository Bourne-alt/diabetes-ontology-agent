<https://example.org/dmo/id/riskFactor/nil-by-mouth> a dmo:RiskFactor ;
    rdfs:label "Nil by Mouth" ;
    dmo:evidenceNote "The patient is nil by mouth and no enteral feed is prescribed or the feed is stopped for longer than two hours, a VRIII may be required if PRN rapid acting insulin is ineffective at correcting suboptimal glucose control, or the fasting state is deemed to be an increased risk for contributing to ketosis." ;
    dmo:name "Nil by Mouth" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "nil-by-mouth" ;
    dmo:evidenceQuote "If a patient with known type 1 diabetes or known insulin deficiency and is nil by mouth and no enteral feed is prescribed or the feed is stopped for longer than two hours, a VRIII may be required if PRN rapid acting insulin is ineffective at correcting suboptimal glucose control, or the fasting state is deemed to be an increased risk for contributing to ketosis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

