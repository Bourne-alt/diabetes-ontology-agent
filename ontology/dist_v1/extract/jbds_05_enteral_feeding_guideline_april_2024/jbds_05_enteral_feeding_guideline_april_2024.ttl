    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "prn-insulin" ;
    dmo:name "PRN insulin" ;
    dmo:evidenceQuote "If no quick/ rapid acting insulin doses are prescribed during the feed then prescribe PRN insulin in line with local policy and include the comment: give with caution if to be given within 4 hours of the feed finishing" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/prn-rapid-acting-insulin> a dmo:Medication ;
    rdfs:label "PRN rapid acting insulin" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "prn-rapid-acting-insulin" ;
    dmo:name "PRN rapid acting insulin" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "When not on VRIII, PRN rapid acting insulin can be used to correct glucose levels >12 mmol/L however, caution should be taken when given < 4 hours before a feed break (see section ‘insulin options’)" ;
    dmo:evidenceQuote "Consider the use of PRN rapid acting insulin to correct glucose levels >12 mmol/L however, given with caution prior to or during a feed break" ;
    dmo:evidenceQuote "If the patient is not on any bolus insulin doses then the insulin type should be in line with local guidelines" ;
    dmo:evidenceQuote "If the feed has been stopped for a prolonged period, consideration for the use of PRN rapid acting insulin or, if indicated, a VRIII may be required" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/quick-rapid-acting-insulin> a dmo:Medication ;
    rdfs:label "Quick/rapid acting insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "quick-rapid-acting-insulin" ;
    dmo:name "Quick/rapid acting insulin" ;
    dmo:evidenceQuote "If applicable, ensure any PRN insulin prescribed is the same brand as any quick/ rapid acting insulin doses prescribed during the feed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/rapid-acting-analogue-insulin> a dmo:Medication ;
    rdfs:label "Rapid acting analogue insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "rapid-acting-analogue-insulin" ;
    dmo:name "Rapid acting analogue insulin" ;
    dmo:evidenceQuote "•  Basal bolus insulin regimen already prescribed. The basal insulin should be administered at the same time each day. This may be at the usual administration time prior to admission, or when indicated to coincide with the start of a feed, if clinically appropriate. The rapid acting analogue insulin doses will need to be reviewed and can then be given at the start of the feed and 4 hourly thereafter, ensuring no feed related rapid acting insulin dose is given within the 4 hours of the feed ending." ;
    dmo:evidenceQuote "4 hourly rapid acting analogue insulin doses from start of the feed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/rapid-acting-analogue-subcutaneous-insulin> a dmo:Medication ;
    rdfs:label "Rapid Acting Analogue Subcutaneous Insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "rapid-acting-analogue-subcutaneous-insulin" ;
    dmo:name "Rapid Acting Analogue Subcutaneous Insulin" ;
    dmo:evidenceQuote "During continuous feeding monitor blood glucose pre-feed and then 4 hourly when patient receives rapid acting analogue subcutaneous insulin or 4-6 hourly when patient receives soluble insulin or basal only" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/rapid-acting-insulin> a dmo:Medication ;
    rdfs:label "Rapid Acting Insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "rapid-acting-insulin" ;
    dmo:name "Rapid Acting Insulin" ;
    dmo:evidenceQuote "Bolus doses of soluble or rapid acting insulin may then be introduced to manage carbohydrates consumed (oral or enteral)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/rapid-or-short-acting-insulin> a dmo:Medication ;
    rdfs:label "rapid or short acting insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "rapid-or-short-acting-insulin" ;
    dmo:name "rapid or short acting insulin" ;
    dmo:evidenceQuote "Where used, the PRN insulin should be the same as any rapid or short acting insulin being used as part of the feed related insulin regimen" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/soluble-human-insulin> a dmo:Medication ;
    rdfs:label "Soluble Human Insulin" ;
    dmo:insulinAction "ShortActing" ;
