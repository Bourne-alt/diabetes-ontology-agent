<https://example.org/dmo/id/device/ketone-test-kit> a dmo:Device ;
    rdfs:label "Ketone Test Kit" ;
    dmo:deviceCode "ketone-test-kit" ;
    dmo:deviceType "KetoneTestKit" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Ketone Test Kit" ;
