<https://example.org/dmo/id/recommendation/consider-friii-for-ketonaemia-3-mmol-l-or-ketonuria-2> a dmo:Recommendation ;
    rdfs:label "Consider FRIII for ketonaemia >3 mmol/L or ketonuria >2+" ;
    dmo:recommendationId "consider-friii-for-ketonaemia-3-mmol-l-or-ketonuria-2" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "In the presence of ketonaemia (>3 mmol/L) or ketonuria (>2+), consider a fixed rate intravenous insulin infusion (FRIII) to suppress ketone body formation as suggested in the JBDS-IP DKA guidelines (25), and refer the patient urgently to the diabetes inpatient team or if unavailable, the on-call medical team." ;
    dmo:evidenceQuote "In the presence of ketonaemia (>3 mmol/L) or ketonuria (>2+), consider a fixed rate intravenous insulin infusion (FRIII) to suppress ketone body formation as suggested in the JBDS-IP DKA guidelines (25), and refer the patient urgently to the diabetes inpatient team or if unavailable, the on-call medical team." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

