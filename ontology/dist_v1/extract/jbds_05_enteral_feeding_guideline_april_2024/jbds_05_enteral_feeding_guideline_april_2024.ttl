    dmo:recommendationType "Treatment" ;
    dmo:statement "ulin deficiency should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    dmo:evidenceQuote "ulin deficiency should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/take-caution-with-correction-doses-in-people-not-receiving-insulin-with-feed> a dmo:Recommendation ;
    rdfs:label "Take caution with correction doses in people not receiving insulin with feed" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "People with diabetes receiving enteral feeding" ;
    dmo:recommendationId "take-caution-with-correction-doses-in-people-not-receiving-insulin-with-feed" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "In people not receiving insulin with the feed, take caution in giving correction doses within 2 hours of the feed stopping" ;
