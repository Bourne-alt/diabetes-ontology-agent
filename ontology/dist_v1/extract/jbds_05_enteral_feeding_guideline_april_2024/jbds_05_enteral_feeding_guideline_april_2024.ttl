    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients on enteral feeding in general wards" ;
    dmo:recommendationId "discontinue-vriii-and-commence-long-term-regimen-when-possible" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "General wards should aim however to discontinue and commence a long term treatment regimen as soon as the clinical situation allows." ;
    dmo:evidenceQuote "General wards should aim however to discontinue and commence a long term treatment regimen as soon as the clinical situation allows." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/divide-tfd-in-50-50-split-or-use-60-40-split-if-glucose-levels-spike-after-start-of-feed-for-premixed-insulin> a dmo:Recommendation ;
    rdfs:label "Divide TFD in 50/50 split or use 60/40 split if glucose levels spike after start of feed for premixed insulin" ;
    dmo:recommendationId "divide-tfd-in-50-50-split-or-use-60-40-split-if-glucose-levels-spike-after-start-of-feed-for-premixed-insulin" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Where two doses required, take TFD and divide with either a 50/50 dose split or where glucose levels spike after start of the feed, consider 60% of the required total daily dose administered at start of the feed and 40% at the mid point of the feed." ;
    dmo:evidenceQuote "Where two doses required, take TFD and divide with either a 50/50 dose split or where glucose levels spike after start of the feed, consider 60% of the required total daily dose administered at start of the feed and 40% at the mid point of the feed." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/recommendation/do-not-administer-feed-related-insulin-dose-within-4-hours-of-feed-ending-for-rapid-analogue-insulin-or-6-hours-for-soluble-quick-acting-insulin> a dmo:Recommendation ;
    rdfs:label "Do not administer feed-related insulin dose within 4 hours of feed ending for rapid analogue insulin or 6 hours for soluble quick acting insulin" ;
    dmo:recommendationId "do-not-administer-feed-related-insulin-dose-within-4-hours-of-feed-ending-for-rapid-analogue-insulin-or-6-hours-for-soluble-quick-acting-insulin" ;
