<https://example.org/dmo/id/diabetesType/insulin-deficiency> a dmo:DiabetesType ;
    rdfs:label "Insulin Deficiency" ;
    dmo:definition "Ensure basal insulin is continued for all patients with type 1 diabetes or a known insulin deficiency" ;
    dmo:diabetesTypeCode "insulin-deficiency" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "Insulin Deficiency" ;
    dmo:prevalenceShare "0.1"^^xsd:decimal ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "Ensure basal insulin is continued for all patients with type 1 diabetes or a known insulin deficiency" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/diabetesType/type-1-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 1 Diabetes" ;
    dmo:definition "Zeenat, 54 had been diagnosed with type 1 diabetes at the age of 5." ;
    dmo:diabetesTypeCode "type-1-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 1 Diabetes" ;
    dmo:prevalenceShare "0.1"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "Zeenat, 54 had been diagnosed with type 1 diabetes at the age of 5." ;
    dmo:evidenceQuote "Type 1 diabetes presents specific challenges with a higher risk of hypoglycaemia and ketosis. Careful monitoring is required acutely and in the early stages of feeding. The insulin absorption profile needs to match the rate of absorption of glucose from the gut. This may require a change in insulin regimen from that used before admission. As they are unlikely to have endogenous insulin production, a basal insulin will be required to avoid ketosis." ;
    dmo:evidenceQuote "Some will be entirely insulin deficient (treat as type 1)" ;
    dmo:evidenceQuote "People with known type 1 diabetes or known insulin deficiency (e.g. total pancreatectomy) must continue their subcutaneous basal insulin at all times" ;
    dmo:evidenceQuote "People with known type 1 diabetes or known insulin deficiency (e.g. total pancreatectomy) should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    dmo:evidenceQuote "People with known type 1 diabetes or known insulin deficiency should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    dmo:evidenceQuote "patients at particular risk are those with type 1 diabetes and insulin deficiency" ;
    dmo:evidenceQuote "If a patient with known type 1 diabetes or known insulin deficiency and is nil by mouth and no enteral feed is prescribed or the feed is stopped for longer than two hours, a VRIII may be required" ;
    dmo:evidenceQuote "Patients with type 1 diabetes or significant insulin deficiency will be at increased risk of ketosis during a fasted state, acute illness or simply excess hyperglycaemia." ;
    dmo:evidenceQuote "Should always receive basal insulin, and this should never be omitted" ;
    dmo:evidenceQuote "IN INJECTION IF DUE IN TYPE 1 DIABETES although dose alteration may be required." ;
    dmo:evidenceQuote "Basal insulin must be continued/ commenced in all patients with type 1 diabetes or those with known insulin deficiency" ;
    dmo:evidenceQuote "Ensure basal insulin is continued for all patients with type 1 diabetes or a known insulin deficiency" ;
    dmo:evidenceQuote "Type 1 diabetes. Currently on VRIII and 10 units BD Levemir" ;
    dmo:evidenceQuote "Insulin detemir is associated with more predictable glycemic control and reduced risk of hypoglycemia than NPH insulin in patients with type 1 diabetes on a basal-bolus regimen with premeal insulin aspart." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/diabetesType/type-1-diabetes-mellitus> a dmo:DiabetesType ;
    rdfs:label "Type 1 Diabetes Mellitus" ;
    dmo:definition "People with type 1 diabetes (or other insulin deficient syndromes) should continue their subcutaneous basal insulin, or a suitable alternative, at all times – even if receiving additional insulin via the subcutaneous or intravenous route" ;
    dmo:diabetesTypeCode "type-1-diabetes-mellitus" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 1 Diabetes Mellitus" ;
    dmo:prevalenceShare "0.1"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "People with type 1 diabetes (or other insulin deficient syndromes) should continue their subcutaneous basal insulin, or a suitable alternative, at all times – even if receiving additional insulin via the subcutaneous or intravenous route" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/diabetesType/type-1-or-insulin-deficient-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 1 or insulin deficient diabetes" ;
    dmo:diabetesTypeCode "type-1-or-insulin-deficient-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:name "Type 1 or insulin deficient diabetes" ;
    dmo:prevalenceShare "0"^^xsd:integer ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "Commonly insulin regimens for people with Type 1 or insulin deficient diabetes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:definition "Elfyn, 82, had been diagnosed with type 2 diabetes at the age of 58 years." ;
    dmo:diabetesTypeCode "type-2-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "Type 2 Diabetes" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "Elfyn, 82, had been diagnosed with type 2 diabetes at the age of 58 years." ;
    dmo:evidenceQuote "The largest group requiring enteral feed will be individuals with type 2 diabetes. Oral hypoglycaemic therapy may be adequate to control glucose, but the combination of insulin resistance associated with acute illness, risk of lactic acidosis or acute kidney injury may mean that their usual medication cannot be used. Metformin can be given as a liquid preparation, via an enteral feeding route. Tablets should not be crushed. If feeding is required urgently then insulin should be used as glucose lowering therapy at an early stage to avoid days of hyperglycaemia associated with oral medication titration. People with type 2 diabetes may have significant endogenous insulin production as well as clinically significant insulin resistance. Large doses of insulin may be required but conversely glucose variability may be less as they may still be making their own insulin. Matching the glucose load to pharmacological activity of the insulin chosen may be less important than for those with type 1 diabetes." ;
    dmo:evidenceQuote "whereas others may have significant insulin reserve (treat as type 2)" ;
    dmo:evidenceQuote "Metformin liquid administered via the enteral feeding tube should be continued where appropriate in any patient on metformin prior to admission, and may be considered for mild hyperglycaemia (e.g., capillary blood glucose up to 12 mmol/L) in people with well controlled type 2 diabetes, or as an adjunct in uncontrolled type 2 diabetes" ;
    dmo:evidenceQuote "Many NHS organisations favour the use of human insulin (isophane) in the initial management of type 2 diabetes." ;
    dmo:evidenceQuote "Type 2 diabetes. Currently on VRIII and no basal insulin required" ;
    dmo:evidenceQuote "A diabetes-specific enteral formula improves glycemic variability in patients with type 2 diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes-mellitus> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes Mellitus" ;
    dmo:definition "The largest group of people with diabetes using enteral nutrition are people admitted with stroke but this is also used for post-surgical management and, less frequently, for gastroenterological conditions." ;
    dmo:diabetesTypeCode "type-2-diabetes-mellitus" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "Type 2 Diabetes Mellitus" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "The largest group of people with diabetes using enteral nutrition are people admitted with stroke but this is also used for post-surgical management and, less frequently, for gastroenterological conditions." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes-or-likely-to-have-some-endogenous-insulin-production> a dmo:DiabetesType ;
    rdfs:label "Type 2 diabetes or likely to have some endogenous insulin production" ;
    dmo:diabetesTypeCode "type-2-diabetes-or-likely-to-have-some-endogenous-insulin-production" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:name "Type 2 diabetes or likely to have some endogenous insulin production" ;
    dmo:prevalenceShare "0"^^xsd:integer ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "Commonly insulin regimens for people with type 2 diabetes or likely to have some endogenous insulin production" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/diabetesType/type-3c-secondary-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 3c/Secondary diabetes" ;
    dmo:definition "Type 3c/Secondary diabetes" ;
    dmo:diabetesTypeCode "type-3c-secondary-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005149" ;
    dmo:name "Type 3c/Secondary diabetes" ;
    dmo:prevalenceShare "0.01"^^xsd:decimal ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "2.4  Type 3c/Secondary diabetes" ;
    dmo:evidenceQuote "Following pancreatitis or other pancreatic damage, insulin production can vary considerably between individuals. Some will be entirely insulin deficient (treat as type 1) whereas others may have significant insulin reserve (treat as type 2). It may not be clear at the time of feeding which applies. Pancreatic exocrine insufficiency may also be present. This may influence the rate of carbohydrate absorption of the feed and influence overall glucose control." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/actrapid> a dmo:DrugClass ;
    rdfs:label "Actrapid" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE01" ;
    dmo:drugClassCode "actrapid" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Rapid-acting soluble insulin that binds to insulin receptors to lower blood glucose" ;
    dmo:name "Actrapid" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Soluble = Actrapid 13 units at start of feed and then 6 and 12 hours into feed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/analogue-insulin> a dmo:DrugClass ;
    rdfs:label "Analogue insulin" ;
    dmo:drugClassCode "analogue-insulin" ;
    dmo:hypoglycemiaRisk "Moderate" ;
    dmo:mechanism "Analogue insulin is a modified form of insulin designed to have a more predictable and prolonged action profile compared to human insulin." ;
    dmo:name "Analogue insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "For bolus feeds given as a bolus or over < 4 hours an analogue insulin, administered 0-15 minutes prior to administration of the feed can be given to cover the carbohydrate content." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/basal-bolus-insulin> a dmo:DrugClass ;
    rdfs:label "Basal Bolus Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "basal-bolus-insulin" ;
    dmo:hypoglycemiaRisk "Moderate" ;
    dmo:mechanism "Continuation of usual long-acting insulin with either 4 hourly rapid acting analogue insulin doses from start of the feed or 6 hourly soluble quick acting insulin doses from start of the feed" ;
    dmo:name "Basal Bolus Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Basal bolus insulin  continue usual long-acting insulin with either 4 hourly rapid acting analogue insulin doses from start of the feed or 6 hourly soluble quick acting insulin doses from start of the feed." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/basal-bolus-insulin-regimen-already-prescribed> a dmo:DrugClass ;
    rdfs:label "Basal bolus insulin regimen already prescribed" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "basal-bolus-insulin-regimen-already-prescribed" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Combines long-acting basal insulin with short-acting bolus insulin to mimic physiological insulin secretion" ;
    dmo:name "Basal bolus insulin regimen already prescribed" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "•  Basal bolus insulin regimen already prescribed. The basal insulin should be administered at the same time each day. This may be at the usual administration time prior to admission, or when indicated to coincide with the start of a feed, if clinically appropriate." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/basal-insulin> a dmo:DrugClass ;
    rdfs:label "Basal Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10BB02" ;
    dmo:drugClassCode "basal-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides a continuous background level of insulin to control blood glucose between meals and during sleep." ;
    dmo:name "Basal Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Should always receive basal insulin, and this should never be omitted" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/bolus-insulin-only> a dmo:DrugClass ;
    rdfs:label "Bolus insulin only" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "bolus-insulin-only" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Short-acting insulin given to cover carbohydrate intake during feeding, without background insulin support" ;
    dmo:name "Bolus insulin only" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "•  Bolus insulin only is of particular use for bolus feeding. For bolus feeds given over 4-6 hours, a single dose of soluble human insulin, administered 20 minutes prior to the start of the bolus feed can be given." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/continuous-subcutaneous-insulin-infusion-csii> a dmo:DrugClass ;
    rdfs:label "Continuous Subcutaneous Insulin Infusion (CSII)" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "continuous-subcutaneous-insulin-infusion-csii" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Delivers a continuous infusion of insulin via a pump to mimic physiological insulin secretion" ;
    dmo:name "Continuous Subcutaneous Insulin Infusion (CSII)" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "People admitted with continuous subcutaneous insulin infusion (CSII) devices (likely type 1 diabetes) should be referred to the DIT for assessment and ongoing review." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/fixed-rate-intravenous-insulin-infusion> a dmo:DrugClass ;
    rdfs:label "Fixed Rate Intravenous Insulin Infusion" ;
    dmo:adminRoute "Intravenous" ;
    dmo:drugClassCode "fixed-rate-intravenous-insulin-infusion" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Continuous intravenous insulin infusion used to manage severe hyperglycaemia and ketosis" ;
    dmo:name "Fixed Rate Intravenous Insulin Infusion" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "In the presence of ketonaemia (>3 mmol/L) or ketonuria (>2+), consider a fixed rate intravenous insulin infusion (FRIII) to suppress ketone body formation as suggested in the JBDS-IP DKA guidelines (25), and refer the patient urgently to the diabetes inpatient team or if unavailable, the on-call medical team." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/glucagon-im-injection> a dmo:DrugClass ;
    rdfs:label "Glucagon IM Injection" ;
    dmo:adminRoute "Intravenous" ;
    dmo:atcCode "A10AD01" ;
    dmo:drugClassCode "glucagon-im-injection" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Stimulates the liver to release stored glucose into the bloodstream to treat severe hypoglycaemia." ;
    dmo:name "Glucagon IM Injection" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Give glucagon IM injection (providing no severe hepatic disease, prolonged starvation or repeated hypoglycaemia)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/human-insulin> a dmo:DrugClass ;
    rdfs:label "Human insulin" ;
    dmo:drugClassCode "human-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Human insulin is a synthetic form of insulin that closely mimics the structure and function of naturally occurring insulin in the body." ;
    dmo:name "Human insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Many NHS organisations favour the use of human insulin (isophane) in the initial management of type 2 diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/insulatard> a dmo:DrugClass ;
    rdfs:label "Insulatard" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE02" ;
    dmo:drugClassCode "insulatard" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Intermediate-acting soluble insulin that binds to insulin receptors to lower blood glucose" ;
    dmo:name "Insulatard" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Insulatard = 24 units at start of feed and 16 units 10 hours into feed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10A" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin is a hormone that lowers blood glucose by promoting glucose uptake into cells and inhibiting glucose production in the liver." ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If feed unexpectedly stopped for longer than 30 minutes and insulin has been administered, risk of hypoglycaemia is high" ;
    dmo:evidenceQuote "As they are unlikely to have endogenous insulin production, a basal insulin will be required to avoid ketosis. Although a single feed with one break is the commonest feed regimen used, particular care is needed for this group to ensure that the insulin regimen chosen matches with absorbed carbohydrate and does not produce hypoglycaemia during the rest period." ;
    dmo:evidenceQuote "This would not be used for any patient with basal insulin requirements." ;
    dmo:evidenceQuote "If the patient is not on any bolus insulin doses then the insulin type should be in line with local guidelines" ;
    dmo:evidenceQuote "IN INJECTION IF DUE IN TYPE 1 DIABETES although dose alteration may be required." ;
    dmo:evidenceQuote "Ensure basal insulin is continued for all patients with type 1 diabetes or a known insulin deficiency and should be prescribed by time of day" ;
    dmo:evidenceQuote "If the patient has type 1 diabetes or was previously on basal insulin this should have been continued alongside the VRIII and will continue once stepped down off VRIII. Therefore, insulin dose calculated will be for the enteral feed only" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/intermediate-basal-insulin> a dmo:DrugClass ;
    rdfs:label "Intermediate basal insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "intermediate-basal-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides intermediate-acting background insulin coverage, typically with a peak effect around 4-12 hours after administration" ;
    dmo:name "Intermediate basal insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "•  Intermediate basal insulin. This regimen requires a single administration of isophane (NPH) insulin at the start of the feed, with a further dose likely to be required at the midpoint of the feed if feed duration is ≥16 hours." ;
    dmo:evidenceQuote "Intermediate basal insulin administration of isophane (NPH) insulin at the start of the feed, with a further dose likely to be required at the midpoint of the feed if feed duration is ≥16 hours with either a 50/50 dose split or where glucose levels spike after start of the feed, consider 60% of the required total feed dose (TFD) administered at start of the feed and 40% at the mid point dose" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/intravenous-insulin-infusion-vriii> a dmo:DrugClass ;
    rdfs:label "Intravenous Insulin Infusion (VRIII)" ;
    dmo:adminRoute "Intravenous" ;
    dmo:drugClassCode "intravenous-insulin-infusion-vriii" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides a continuous intravenous insulin infusion to manage hyperglycaemia in acute settings" ;
    dmo:name "Intravenous Insulin Infusion (VRIII)" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If a patient with known type 1 diabetes or known insulin deficiency is nil by mouth and no enteral feed is prescribed or the feed is stopped for longer than two hours, a VRIII may be required if PRN rapid acting insulin is ineffective at correcting suboptimal glucose control, or the fasting state is deemed to be an increased risk for contributing to ketosis." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/levemir> a dmo:DrugClass ;
    rdfs:label "Levemir" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10BG02" ;
    dmo:drugClassCode "levemir" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Long-acting insulin analog that binds to insulin receptors to lower blood glucose" ;
    dmo:name "Levemir" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Step 1 - Continue usual Levemir" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/liquid-metformin> a dmo:DrugClass ;
    rdfs:label "Liquid Metformin" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "liquid-metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Increases insulin sensitivity and reduces hepatic glucose production, thereby lowering blood glucose levels." ;
    dmo:name "Liquid Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Liquid metformin may be administered via an enteral feeding tube" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/long-acting-analogue-insulin> a dmo:DrugClass ;
    rdfs:label "Long-acting analogue insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "long-acting-analogue-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides stable, prolonged background insulin coverage with a flat duration profile and no peak" ;
    dmo:name "Long-acting analogue insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "•  Long-acting analogue insulin may be used alone. This regimen may be helpful if the individual is felt to have sufficient endogenous insulin and a continuous feed regimen is chosen" ;
    dmo:evidenceQuote "Long-acting analogue insulin at the start of the feed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/long-acting-basal-insulin-analogues> a dmo:DrugClass ;
    rdfs:label "Long-acting basal insulin analogues" ;
    dmo:drugClassCode "long-acting-basal-insulin-analogues" ;
    dmo:hypoglycemiaRisk "Moderate" ;
    dmo:mechanism "Long-acting basal insulin analogues provide a prolonged, steady release of insulin to maintain baseline glucose control over 24 hours." ;
    dmo:name "Long-acting basal insulin analogues" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "long-acting basal insulin analogues (e.g., glargine, detemir) may be more safely used in non-hospitalised patients with type 1 diabetes, as the risk of hypoglycaemia with these agents may be reduced (20)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/metformin> a dmo:DrugClass ;
    rdfs:label "Metformin" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA" ;
    dmo:drugClassCode "metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Metformin reduces hepatic glucose production and improves insulin sensitivity." ;
    dmo:name "Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Liquid metformin may be administered via an enteral feeding tube" ;
    dmo:evidenceQuote "Metformin can be given as a liquid preparation, via an enteral feeding route. Tablets should not be crushed. If feeding is required urgently then insulin should be used as glucose lowering therapy at an early stage to avoid days of hyperglycaemia associated with oral medication titration." ;
    dmo:evidenceQuote "Metformin and insulin are the only two recommended treatment options to optimise glucose control during enteral feeding" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/metformin-liquid> a dmo:DrugClass ;
    rdfs:label "Metformin liquid" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA01" ;
    dmo:drugClassCode "metformin-liquid" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Decreases hepatic glucose production and improves insulin sensitivity" ;
    dmo:name "Metformin liquid" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Metformin liquid administered via the enteral feeding tube should be continued where appropriate in any patient on metformin prior to admission, and may be considered for mild hyperglycaemia (e.g., capillary blood glucose up to 12 mmol/L) in people with well controlled type 2 diabetes, or as an adjunct in uncontrolled type 2 diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/novomix30> a dmo:DrugClass ;
    rdfs:label "Novomix30" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE04" ;
    dmo:drugClassCode "novomix30" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Pre-mixed insulin analog containing 70% intermediate-acting and 30% rapid-acting insulin that binds to insulin receptors to lower blood glucose" ;
    dmo:name "Novomix30" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Analogue = Novomix30   24 units at start of feed and 16 units 10 hours into feed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/novorapid> a dmo:DrugClass ;
    rdfs:label "Novorapid" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE03" ;
    dmo:drugClassCode "novorapid" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Rapid-acting insulin analog that binds to insulin receptors to lower blood glucose" ;
    dmo:name "Novorapid" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Analogue = Novorapid 8 units at start of feed and then 4, 8, 12 and 16 hours into feed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/pre-mixed-biphasic-30-70-insulin> a dmo:DrugClass ;
    rdfs:label "Pre-mixed Biphasic (30/70) Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "pre-mixed-biphasic-30-70-insulin" ;
    dmo:hypoglycemiaRisk "Moderate" ;
    dmo:mechanism "At start and halfway through feed if feed duration >16 hours. Where two doses required, take TFD and divide with either a 50/50 dose split or where glucose levels spike after start of the feed, consider 60% of the required total daily dose administered at start of the feed and 40% at the mid point dose" ;
    dmo:name "Pre-mixed Biphasic (30/70) Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Pre-mixed biphasic (30/70) insulin at start and halfway through feed if feed duration >16 hours. Where two doses required, take TFD and divide with either a 50/50 dose split or where glucose levels spike after start of the feed, consider 60% of the required total daily dose administered at start of the feed and 40% at the mid point dose" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/pre-mixed-biphasic-insulin> a dmo:DrugClass ;
    rdfs:label "Pre-mixed biphasic insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "pre-mixed-biphasic-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Combines rapid-acting and intermediate-acting insulin to cover both mealtime and background glucose control" ;
    dmo:name "Pre-mixed biphasic insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "•  Pre-mixed biphasic (30/70) insulin administered at the start of the feed, with the option for a second dose at the midpoint of the feed if feed duration ≥ 16 hourly." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/prn-rapid-acting-insulin> a dmo:DrugClass ;
    rdfs:label "PRN Rapid Acting Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AB01" ;
    dmo:drugClassCode "prn-rapid-acting-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Used as needed to correct hyperglycaemia, typically in response to elevated blood glucose readings." ;
    dmo:name "PRN Rapid Acting Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "PRN insulin should be given with caution prior to or during a feed break" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/rapid-acting-analogue-subcutaneous-insulin> a dmo:DrugClass ;
    rdfs:label "Rapid Acting Analogue Subcutaneous Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "rapid-acting-analogue-subcutaneous-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin analogues that act quickly to lower blood glucose levels after meals" ;
    dmo:name "Rapid Acting Analogue Subcutaneous Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "In the presence of ketonaemia (>3 mmol/L) or ketonuria (>2+), consider a fixed rate intravenous insulin infusion (FRIII) to suppress ketone body formation as suggested in the JBDS-IP DKA guidelines (25), and refer the patient urgently to the diabetes inpatient team or if unavailable, the on-call medical team." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/rapid-acting-insulin> a dmo:DrugClass ;
    rdfs:label "Rapid acting insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE01" ;
    dmo:drugClassCode "rapid-acting-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Acts quickly to lower blood glucose after meals" ;
    dmo:name "Rapid acting insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Consider the use of PRN rapid acting insulin to correct glucose levels >12 mmol/L however, given with caution prior to or during a feed break" ;
    dmo:evidenceQuote "Bolus doses of soluble or rapid acting insulin may then be introduced and VRIII discontinued to manage carbohydrates consumed (oral or enteral)." ;
    dmo:evidenceQuote "consideration for the use of PRN rapid acting insulin or, if indicated, a VRIII may be required" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/subcutaneous-basal-insulin> a dmo:DrugClass ;
    rdfs:label "Subcutaneous Basal Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "subcutaneous-basal-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides a continuous background level of insulin to manage fasting blood glucose and prevent diabetic ketoacidosis in people with insulin deficiency." ;
    dmo:name "Subcutaneous Basal Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "People with type 1 diabetes (or other insulin deficient syndromes) should continue their subcutaneous basal insulin, or a suitable alternative, at all times – even if receiving additional insulin via the subcutaneous or intravenous route" ;
    dmo:evidenceQuote "People with known type 1 diabetes or known insulin deficiency (e.g. total pancreatectomy) should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    dmo:evidenceQuote "ulin deficiency should be reviewed by the DIT at the earliest opportunity and must continue their subcutaneous basal insulin at all times to avoid potentially life threatening DKA." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/subcutaneous-insulin> a dmo:DrugClass ;
    rdfs:label "Subcutaneous Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10A" ;
    dmo:drugClassCode "subcutaneous-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Replaces or supplements endogenous insulin to lower blood glucose" ;
    dmo:name "Subcutaneous Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If metformin is contraindicated or if the patient requires insulin prior to admission, then commence/ optimise subcutaneous insulin (see section ‘insulin options’)" ;
    dmo:evidenceQuote "People with known type 1 diabetes or known insulin deficiency (e.g. total pancreatectomy) must continue their subcutaneous basal insulin at all times" ;
    dmo:evidenceQuote "In the presence of ketonaemia (>3 mmol/L) or ketonuria (>2+), consider a fixed rate intravenous insulin infusion (FRIII) to suppress ketone body formation as suggested in the JBDS-IP DKA guidelines (25), and refer the patient urgently to the diabetes inpatient team or if unavailable, the on-call medical team." ;
    dmo:evidenceQuote "The administration of fizzy drinks via the enteral feeding tubes for hypoglycaemia treatment is controversial, as it can lead to damage to the lining of the feeding tube with repeated use and therefore has not been included in the recommendations made." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/sulfonylureas> a dmo:DrugClass ;
    rdfs:label "Sulfonylureas" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BB01" ;
    dmo:drugClassCode "sulfonylureas" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Stimulates insulin secretion from pancreatic beta cells" ;
    dmo:name "Sulfonylureas" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Crushing oral hypoglycaemic medications, such as sulfonylureas, to manage hyperglycaemia during enteral feeding is not advised given the unpredictable absorption and difficulties in administration associated with this action, as well as the risk of tube blockage with crushed debris." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/drugClass/vriii> a dmo:DrugClass ;
    rdfs:label "VRIII" ;
    dmo:adminRoute "Intravenous" ;
    dmo:drugClassCode "vriii" ;
    dmo:hypoglycemiaRisk "Moderate" ;
    dmo:mechanism "Used in the initial period of feeding to stabilise glucose and estimate insulin requirements while feeding regimen is established" ;
    dmo:name "VRIII" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "VRIII may be used in the initial period of feeding to stabilise glucose and estimate insulin requirements while feeding regimen is established." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/labTest/arterial-blood-gases> a dmo:LabTest ;
    rdfs:label "Arterial Blood Gases" ;
    dmo:definition "用于评估酸碱平衡和呼吸功能，特别是在怀疑糖尿病酮症酸中毒（DKA）时进行检测。" ;
    dmo:labTestCode "arterial-blood-gases" ;
    dmo:name "Arterial Blood Gases" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "An on-call doctor was called and capillary ketones and arterial blood gases were measured. These were consistent with diabetic ketoacidosis (DKA)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/labTest/capillary-blood-glucose> a dmo:LabTest ;
    rdfs:label "Capillary Blood Glucose" ;
    dmo:definition "Capillary blood glucose (CBG) is used to monitor glycaemic control in people with diabetes receiving enteral feeding." ;
    dmo:labTestCode "capillary-blood-glucose" ;
    dmo:name "Capillary Blood Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Target CBG 6-12 mmol/L during enteral feeding of people with diabetes" ;
    dmo:evidenceQuote "At 10am the following morning the patient was found to be clammy and drowsy – capillary blood glucose was 1.9 mmol/L." ;
    dmo:evidenceQuote "If capillary blood glucose persistently >12 mmol/L the treatment regimen should be reviewed and optimised promptly" ;
    dmo:evidenceQuote "PRN rapid acting insulin may be used alongside in accordance with local guidelines which the metformin is optimised. PRN insulin should be given with caution prior to or during a feed break." ;
    dmo:evidenceQuote "Capillary blood glucose persistently >12 mmol/L should be treated following the advice given in sections 4 choice of agent to achieve glycaemic control, section 5 non-insulin options and section 6, insulin options." ;
    dmo:evidenceQuote "The frequency of bedside capillary blood glucose testing should be a clinical decision based on the stability of the patient." ;
    dmo:evidenceQuote "For the purpose of these guidelines, hyperglycaemia is considered to be a capillary blood glucose level above 12 mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/labTest/capillary-blood-glucose-monitoring> a dmo:LabTest ;
    rdfs:label "Capillary Blood Glucose Monitoring" ;
    dmo:definition "Monitoring of blood glucose levels using capillary blood samples, typically performed at least every 4 hours after a hypoglycaemic event to detect further episodes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "capillary-blood-glucose-monitoring" ;
    dmo:name "Capillary Blood Glucose Monitoring" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Ensure at least 4 hourly capillary blood glucose monitoring continued for next 24 – 48 hours due to the increased risk of further hypoglycaemic episodes after any hypoglycaemic event" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/labTest/capillary-glucose> a dmo:LabTest ;
    rdfs:label "Capillary Glucose" ;
    dmo:definition "用于监测血糖水平，特别是在管理肠内喂养期间的高血糖或低血糖情况。" ;
    dmo:labTestCode "capillary-glucose" ;
    dmo:name "Capillary Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "If glucose levels are <4.0 mmol/L treat immediately as per local guidance or JBDS-IP hypoglycaemia guidelines" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/labTest/capillary-glucose-monitoring> a dmo:LabTest ;
    rdfs:label "Capillary Glucose Monitoring" ;
    dmo:definition "Monitoring of blood glucose levels using capillary blood samples, typically from a finger prick, to assess glycaemic control and guide insulin therapy." ;
    dmo:labTestCode "capillary-glucose-monitoring" ;
    dmo:name "Capillary Glucose Monitoring" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "•  Capillary glucose and ketone monitoring" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/labTest/capillary-ketones> a dmo:LabTest ;
    rdfs:label "Capillary Ketones" ;
    dmo:definition "用于检测糖尿病酮症酸中毒（DKA）的标志物，特别是在高血糖或疑似DKA时进行评估。" ;
    dmo:labTestCode "capillary-ketones" ;
    dmo:name "Capillary Ketones" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "An on-call doctor was called and capillary ketones and arterial blood gases were measured. These were consistent with diabetic ketoacidosis (DKA)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/labTest/ketonaemia> a dmo:LabTest ;
    rdfs:label "Ketonaemia" ;
    dmo:definition "If capillary blood glucose <4 mmol/L or persistently>12 mmol/L on two consecutive occasions or evidence of ketonaemia/ketonuria then inform the DIT or on-call medical team" ;
    dmo:labTestCode "ketonaemia" ;
    dmo:name "Ketonaemia" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "If capillary blood glucose <4 mmol/L or persistently>12 mmol/L on two consecutive occasions or evidence of ketonaemia/ketonuria then inform the DIT or on-call medical team" ;
    dmo:evidenceQuote "In the presence of ketonaemia (>3 mmol/L) or ketonuria (>2+), consider a fixed rate intravenous insulin infusion (FRIII) to suppress ketone body formation as suggested in the JBDS-IP DKA guidelines (25), and refer the patient urgently to the diabetes inpatient team or if unavailable, the on-call medical team." ;
    dmo:evidenceQuote "In the presence of ketonaemia >0.6 mmol/L refer to local ketone testing and DKA policy" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/labTest/ketone-monitoring> a dmo:LabTest ;
    rdfs:label "Ketone Monitoring" ;
    dmo:definition "Monitoring of ketone levels in blood to detect early signs of diabetic ketoacidosis (DKA), especially in patients with diabetes on enteral feeding." ;
    dmo:labTestCode "ketone-monitoring" ;
    dmo:name "Ketone Monitoring" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "•  Capillary glucose and ketone monitoring" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/labTest/ketone-testing> a dmo:LabTest ;
    rdfs:label "Ketone testing" ;
    dmo:definition "Ketone testing should be undertaken in line with local guidelines but patients at particular risk are those with type 1 diabetes and insulin deficiency" ;
    dmo:labTestCode "ketone-testing" ;
    dmo:name "Ketone testing" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "Ketone testing should be undertaken in line with local guidelines but patients at particular risk are those with type 1 diabetes and insulin deficiency" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/labTest/ketonuria> a dmo:LabTest ;
    rdfs:label "Ketonuria" ;
    dmo:definition "If capillary blood glucose <4 mmol/L or persistently>12 mmol/L on two consecutive occasions or evidence of ketonaemia/ketonuria then inform the DIT or on-call medical team" ;
    dmo:labTestCode "ketonuria" ;
    dmo:name "Ketonuria" ;
    dmo:unitOfMeasure "+" ;
    dmo:evidenceQuote "If capillary blood glucose <4 mmol/L or persistently>12 mmol/L on two consecutive occasions or evidence of ketonaemia/ketonuria then inform the DIT or on-call medical team" ;
    dmo:evidenceQuote "In the presence of ketonaemia (>3 mmol/L) or ketonuria (>2+), consider a fixed rate intravenous insulin infusion (FRIII) to suppress ketone body formation as suggested in the JBDS-IP DKA guidelines (25), and refer the patient urgently to the diabetes inpatient team or if unavailable, the on-call medical team." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/lifestyleIntervention/diabetes-self-management-education-and-support> a dmo:LifestyleIntervention ;
    rdfs:label "Diabetes Self-Management Education and Support" ;
    dmo:interventionCode "diabetes-self-management-education-and-support" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "Diabetes Self-Management Education and Support" ;
    dmo:evidenceQuote "Diabetes inpatient team should commence new to insulin education as early in the admission as is appropriate" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/lifestyleIntervention/self-administration-of-insulin> a dmo:LifestyleIntervention ;
    rdfs:label "Self-administration of insulin" ;
    dmo:interventionCode "self-administration-of-insulin" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "Self-administration of insulin" ;
    dmo:evidenceQuote "If the individual fulfils the requirements for self-administration of insulin for that institution, then they should be allowed to self-administer insulin if they are happy to and can follow the organisation’s procedures." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/actrapid> a dmo:Medication ;
    rdfs:label "Actrapid" ;
    dmo:durationHours "4"^^xsd:integer ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "actrapid" ;
    dmo:name "Actrapid" ;
    dmo:onsetMinutes "15"^^xsd:integer ;
    dmo:evidenceQuote "Soluble = Actrapid 13 units at start of feed and then 6 and 12 hours into feed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/additional-feed-specific-insulin> a dmo:Medication ;
    rdfs:label "Additional feed specific insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "additional-feed-specific-insulin" ;
    dmo:name "Additional feed specific insulin" ;
    dmo:evidenceQuote "Additional feed specific insulin may be prescribed on top of normal basal insulin. This may be in the form of rapid, NPH or mixed insulin" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/analogue-insulin> a dmo:Medication ;
    rdfs:label "Analogue Insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "analogue-insulin" ;
    dmo:name "Analogue Insulin" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "an analogue insulin, administered 0-15 minutes prior to administration of the feed can be given to cover the carbohydrate content." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/basal-bolus-insulin> a dmo:Medication ;
    rdfs:label "Basal Bolus Insulin" ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "basal-bolus-insulin" ;
    dmo:name "Basal Bolus Insulin" ;
    dmo:evidenceQuote "Basal bolus insulin  continue usual long-acting insulin with either 4 hourly rapid acting analogue insulin doses from start of the feed or 6 hourly soluble quick acting insulin doses from start of the feed." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/basal-insulin> a dmo:Medication ;
    rdfs:label "Basal Insulin" ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "basal-insulin" ;
    dmo:name "Basal Insulin" ;
    dmo:evidenceQuote "These patients should continue the basal insulin during enteral feeding." ;
    dmo:evidenceQuote "During continuous feeding monitor blood glucose pre-feed and then 4 hourly when patient receives rapid acting analogue subcutaneous insulin or 4-6 hourly when patient receives soluble insulin or basal only" ;
    dmo:evidenceQuote "Ensure basal insulin is continued for all patients with type 1 diabetes or a known insulin deficiency and should be prescribed by time of day" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/bolus-insulin-only> a dmo:Medication ;
    rdfs:label "Bolus insulin only" ;
    dmo:insulinAction "ShortActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "bolus-insulin-only" ;
    dmo:name "Bolus insulin only" ;
    dmo:evidenceQuote "•  Bolus insulin only is of particular use for bolus feeding. For bolus feeds given over 4-6 hours, a single dose of soluble human insulin, administered 20 minutes prior to the start of the bolus feed can be given." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/detemir> a dmo:Medication ;
    rdfs:label "detemir" ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "detemir" ;
    dmo:name "detemir" ;
    dmo:evidenceQuote "long-acting basal insulin analogues (e.g., glargine, detemir) may be more safely used in non-hospitalised patients with type 1 diabetes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/feed-specific-basal-insulin> a dmo:Medication ;
    rdfs:label "Feed specific basal insulin" ;
    dmo:insulinAction "Intermediate" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "feed-specific-basal-insulin" ;
    dmo:name "Feed specific basal insulin" ;
    dmo:evidenceQuote "If a feed specific basal insulin is used and the feed is going to be held or reduced, an insulin dose review and possible reduction may be needed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/fixed-rate-intravenous-insulin-infusion> a dmo:Medication ;
    rdfs:label "Fixed Rate Intravenous Insulin Infusion" ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "fixed-rate-intravenous-insulin-infusion" ;
    dmo:name "Fixed Rate Intravenous Insulin Infusion" ;
    dmo:evidenceQuote "In the presence of ketonaemia (>3 mmol/L) or ketonuria (>2+), consider a fixed rate intravenous insulin infusion (FRIII) to suppress ketone body formation as suggested in the JBDS-IP DKA guidelines (25), and refer the patient urgently to the diabetes inpatient team or if unavailable, the on-call medical team." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/glargine> a dmo:Medication ;
    rdfs:label "Glargine" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "glargine" ;
    dmo:name "Glargine" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Prior to hospital admission he was prescribed glargine, metformin and gliclazide" ;
    dmo:evidenceQuote "long-acting basal insulin analogues (e.g., glargine, detemir) may be more safely used in non-hospitalised patients with type 1 diabetes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/gliclazide> a dmo:Medication ;
    rdfs:label "Gliclazide" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "gliclazide" ;
    dmo:name "Gliclazide" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Prior to hospital admission he was prescribed glargine, metformin and gliclazide" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/glucagon-im-injection> a dmo:Medication ;
    rdfs:label "glucagon IM injection" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "glucagon-im-injection" ;
    dmo:name "glucagon IM injection" ;
    dmo:evidenceQuote "Alternatively: Give glucagon IM injection (providing no severe hepatic disease, prolonged starvation or repeated hypoglycaemia)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/glucogel> a dmo:Medication ;
    rdfs:label "Glucogel" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "glucogel" ;
    dmo:name "Glucogel" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Some dietitians advocate the administration of Glucogel via the enteral feeding tube in the event of hypoglycaemia, as this is generally available in the ward environment, and if followed by a flush, should be safe, and effective at elevating plasma glucose rapidly." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

<https://example.org/dmo/id/medication/human-insulin-isophane> a dmo:Medication ;
    rdfs:label "human insulin (isophane)" ;
