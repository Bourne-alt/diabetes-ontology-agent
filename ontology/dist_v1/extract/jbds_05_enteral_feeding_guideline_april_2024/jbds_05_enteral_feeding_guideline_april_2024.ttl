<https://example.org/dmo/id/recommendation/use-of-continuous-glucose-monitoring-during-enteral-feeding> a dmo:Recommendation ;
    rdfs:label "Use of Continuous Glucose Monitoring During Enteral Feeding" ;
    dmo:recommendationId "use-of-continuous-glucose-monitoring-during-enteral-feeding" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "If previously used, the person with diabetes may wish to continue to use CGM glucose monitoring in hospital. They may potentially be of great benefit during enteral feeding but are not currently advised as they have not been extensively studied during acute illness and ward staff are unfamiliar with the technology." ;
    dmo:evidenceQuote "If previously used, the person with diabetes may wish to continue to use CGM glucose monitoring in hospital. They may potentially be of great benefit during enteral feeding but are not currently advised as they have not been extensively studied during acute illness and ward staff are unfamiliar with the technology." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_05_enteral_feeding_guideline_april_2024> .

