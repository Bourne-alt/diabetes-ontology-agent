    dmo:labTestCode "a1c-blood-test" ;
    dmo:loincCode "4548-4" ;
    dmo:name "A1C blood test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "Results of the A1C test reflect your average blood glucose levels during the last 3 months. Changes in your body during pregnancy affect A1C levels. A1C test is not the best test to monitor your blood glucose level during pregnancy. Most people with diabetes should aim for an A1C of 6.5% or lower just before pregnancy. After the first 3 months of pregnancy, your target may be as low as 6%." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-pregnancy-preexisting-diabetes> .

