<https://example.org/dmo/id/recommendation/glucose-monitoring-frequency-in-people-without-pre-existing-diabetes> a dmo:Recommendation ;
    rdfs:label "Glucose Monitoring Frequency in People Without Pre-existing Diabetes" ;
    dmo:gradingSystem "Not specified" ;
    dmo:nativeEvidenceGrade "8" ;
    dmo:populationScope "People without a pre-existing diagnosis of diabetes" ;
    dmo:recommendationId "glucose-monitoring-frequency-in-people-without-pre-existing-diabetes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Monitor blood glucose at least once daily – preferably prior to lunch or evening meal, or alternatively 1-2 hours post lunch or evening meal. If the initial blood glucose is less than 12.0mmol/L continue to test once prior to or following lunch or evening meal" ;
    dmo:evidenceQuote "Monitor blood glucose at least once daily – preferably prior to lunch or evening meal, or alternatively 1-2 hours post lunch or evening meal. If the initial blood glucose is less than 12.0mmol/L continue to test once prior to or following lunch or evening meal" ;
