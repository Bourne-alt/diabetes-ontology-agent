<https://example.org/dmo/id/diabetesType/steroid-induced-diabetes> a dmo:DiabetesType ;
    rdfs:label "Steroid induced diabetes" ;
    dmo:definition "A rise in glucose related to steroid therapy occurring in people without a known diagnosis of diabetes is termed steroid induced diabetes. This may or may not resolve when the steroids are withdrawn." ;
    dmo:diabetesTypeCode "steroid-induced-diabetes" ;
    dmo:name "Steroid induced diabetes" ;
    dmo:evidenceQuote "A rise in glucose related to steroid therapy occurring in people without a known diagnosis of diabetes is termed steroid induced diabetes. This may or may not resolve when the steroids are withdrawn." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/diabetesType/type-1-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 1 diabetes" ;
