<https://example.org/dmo/id/diabetesType/glucocorticoid-induced-diabetes> a dmo:DiabetesType ;
    rdfs:label "Glucocorticoid induced diabetes" ;
    dmo:definition "Screening for glucocorticoid induced diabetes should be considered in all those treated with medium to high doses of glucocorticoids." ;
    dmo:diabetesTypeCode "glucocorticoid-induced-diabetes" ;
