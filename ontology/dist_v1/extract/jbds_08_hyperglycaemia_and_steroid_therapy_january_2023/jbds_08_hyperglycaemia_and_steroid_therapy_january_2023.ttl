<https://example.org/dmo/id/complication/diabetic-ketoacidosis> a dmo:Complication ;
    rdfs:label "Diabetic Ketoacidosis" ;
    dmo:affectedOrgan "Systemic" ;
    dmo:complicationCode "diabetic-ketoacidosis" ;
    dmo:definition "Conversely, steroid therapy impairs glucose metabolism and is the commonest cause of life threatening inpatient Hyperosmolar Hyperglycaemic State (HHS). Glucose concentrations above 10.0 mmol/L have been linked to increased mortality in people with COVID-19. Sulphonylureas are NOT recommended in this context as beta cell function may be impaired and insulin resistance is likely to be severe. Other information is included on glucose management using various insulin regimens (12)." ;
    dmo:isEmergency "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005040" ;
    dmo:name "Diabetic Ketoacidosis" ;
    dmo:onsetPattern "Acute" ;
    dmo:evidenceQuote "Conversely, steroid therapy impairs glucose metabolism and is the commonest cause of life threatening inpatient Hyperosmolar Hyperglycaemic State (HHS). Glucose concentrations above 10.0 mmol/L have been linked to increased mortality in people with COVID-19. Sulphonylureas are NOT recommended in this context as beta cell function may be impaired and insulin resistance is likely to be severe. Other information is included on glucose management using various insulin regimens (12)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

