<https://example.org/dmo/id/recommendation/referral-for-hyperglycaemia-management-in-outpatients> a dmo:Recommendation ;
    rdfs:label "Referral for Hyperglycaemia Management in Outpatients" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:populationScope "Outpatients with two consecutive glucose readings >12.0mmol/L in 48 hours" ;
    dmo:recommendationId "referral-for-hyperglycaemia-management-in-outpatients" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Referral" ;
    dmo:statement "If two consecutive readings in 48 hours exceed 12.0mmol/L, refer to the clinician who commenced the steroid therapy, or if agreed locally, the general practitioner. The clinician should then consider the algorithm for the management of hyperglycaemia with steroid use, and potentially commence a sulphonylurea or optimise existing non-insulin or insulin therapy" ;
    dmo:evidenceQuote "If two consecutive readings in 48 hours exceed 12.0mmol/L, refer to the clinician who commenced the steroid therapy, or if agreed locally, the general practitioner. The clinician should then consider the algorithm for the management of hyperglycaemia with steroid use, and potentially commence a sulphonylurea or optimise existing non-insulin or insulin therapy" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/recommendation/referral-to-treatment-algorithm-for-consistently-elevated-capillary-glucose> a dmo:Recommendation ;
    rdfs:label "Referral to Treatment Algorithm for Consistently Elevated Capillary Glucose" ;
