<https://example.org/dmo/id/drugClass/basal-analogue-insulin> a dmo:DrugClass ;
    rdfs:label "Basal Analogue Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "basal-analogue-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides a prolonged, steady background level of insulin with less peak activity than human insulin" ;
    dmo:name "Basal Analogue Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Basal analogue insulin may be appropriate if hyperglycaemia is present throughout the day and into the evening. In this context, basal insulin may best be administered in the morning." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/basal-human-insulin> a dmo:DrugClass ;
    rdfs:label "Basal Human Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "basal-human-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides a steady background level of insulin to control fasting blood glucose" ;
    dmo:name "Basal Human Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "In this situation, temporary use of a variable rate intravenous insulin infusion (VRIII) with urgent review by the diabetes inpatient team would be appropriate." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/continuous-subcutaneous-insulin-infusion> a dmo:DrugClass ;
    rdfs:label "Continuous subcutaneous insulin infusion" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10A" ;
    dmo:drugClassCode "continuous-subcutaneous-insulin-infusion" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Delivers insulin continuously under the skin via a pump to mimic physiological insulin delivery" ;
    dmo:name "Continuous subcutaneous insulin infusion" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Women on CSII may be able to safely maintain glycaemic control following steroid administration by use of correction boluses and temporary basal rate increases" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/dpp-4-inhibitors> a dmo:DrugClass ;
    rdfs:label "DPP-4 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "dpp-4-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibit dipeptidyl peptidase-4, increasing active GLP-1 levels and enhancing glucose-dependent insulin secretion" ;
    dmo:name "DPP-4 inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "there is no firm evidence to support the use of GLP-1RAs, DPP-4 inhibitors, or SGLT-2 inhibitors in these circumstances." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/dpp-iv-inhibitors> a dmo:DrugClass ;
    rdfs:label "DPP-IV inhibitors" ;
    dmo:drugClassCode "dpp-iv-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "There is currently no evidence to support the use of DPP-IV inhibitors ... in the management of steroid induced diabetes/hyperglycaemia" ;
    dmo:name "DPP-IV inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "There is currently no evidence to support the use of DPP-IV inhibitors, GLP-1, or SGLT-2 inhibitors in the management of steroid induced diabetes/hyperglycaemia (20)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/dpp-iv-inhibitors-glp-1-receptor-agonists-and-sglt2-inhibitors> a dmo:DrugClass ;
    rdfs:label "DPP-IV inhibitors, GLP-1 receptor agonists and SGLT2 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "dpp-iv-inhibitors-glp-1-receptor-agonists-and-sglt2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "DPP-IV inhibitors increase endogenous GLP-1 levels; GLP-1 receptor agonists mimic GLP-1; SGLT2 inhibitors promote urinary glucose excretion" ;
    dmo:name "DPP-IV inhibitors, GLP-1 receptor agonists and SGLT2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "DPP-IV inhibitors, GLP-1 receptor agonists and SGLT2 inhibitors 14" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/fast-or-short-acting-analogue-insulin> a dmo:DrugClass ;
    rdfs:label "Fast or short acting analogue insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE05" ;
    dmo:drugClassCode "fast-or-short-acting-analogue-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Rapid-acting insulin analogs that mimic physiological insulin release after meals" ;
    dmo:name "Fast or short acting analogue insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "In this situation, it may be necessary to use frequently (3-4 times per day) injections of fast or short acting analogue insulin." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/gliclazide> a dmo:DrugClass ;
    rdfs:label "Gliclazide" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "gliclazide" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Sulfonylurea that stimulates insulin secretion from pancreatic beta cells" ;
    dmo:name "Gliclazide" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "A trial of gliclazide 40mg twice daily (BD) may be indicated and titrated daily to a maximum of 160mg BD." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/glp-1-receptor-agonists> a dmo:DrugClass ;
    rdfs:label "GLP-1 receptor agonists" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "glp-1-receptor-agonists" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "There is currently no evidence to support the use of DPP-IV inhibitors, GLP-1, or SGLT-2 inhibitors in the management of steroid induced diabetes/hyperglycaemia" ;
    dmo:name "GLP-1 receptor agonists" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "There is currently no evidence to support the use of DPP-IV inhibitors, GLP-1, or SGLT-2 inhibitors in the management of steroid induced diabetes/hyperglycaemia (20)." ;
    dmo:evidenceQuote "there is no firm evidence to support the use of GLP-1RAs, DPP-4 inhibitors, or SGLT-2 inhibitors in these circumstances." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10A" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Exogenous insulin replacement to lower blood glucose" ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Glucose lowering treatments such as sulphonylureas and or insulin doses will need to be reduced in tanden with reductions in the steroid dosage." ;
    dmo:evidenceQuote "Morning administration of basal human insulin (Humulin I, Insuman Basal, Human Insulatard) may closely fit the glucose excursion induced by a single dose of oral steroid in the morning." ;
    dmo:evidenceQuote "If two consecutive readings in 48 hours exceed 12.0mmol/L, refer to the clinician who commenced the steroid therapy, or if agreed locally, the general practitioner. The clinician should then consider the algorithm for the management of hyperglycaemia with steroid use, and potentially commence a sulphonylurea or optimise existing non-insulin or insulin therapy" ;
    dmo:evidenceQuote "If glucose readings remain raised and are out of target, they should seek advice from the local diabetes community team or their GP ." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/insulin-degludec> a dmo:DrugClass ;
    rdfs:label "Insulin degludec" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE04" ;
    dmo:drugClassCode "insulin-degludec" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Ultra-long-acting insulin analog with a prolonged duration of action and a flat, stable profile" ;
    dmo:name "Insulin degludec" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If hypoglycaemia is a concern, once daily insulin glargine, insulin degludec, or insulin detemir given in the morning may be a safer, less complex regimen - in particular for those new to insulin." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/insulin-detemir> a dmo:DrugClass ;
    rdfs:label "Insulin detemir" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE02" ;
    dmo:drugClassCode "insulin-detemir" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Long-acting insulin analog with a prolonged duration of action and reduced risk of hypoglycaemia compared to older insulins" ;
    dmo:name "Insulin detemir" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If hypoglycaemia is a concern, once daily insulin glargine, insulin degludec, or insulin detemir given in the morning may be a safer, less complex regimen - in particular for those new to insulin." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/insulin-glargine> a dmo:DrugClass ;
    rdfs:label "Insulin glargine" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE03" ;
    dmo:drugClassCode "insulin-glargine" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Long-acting insulin analog that provides basal insulin coverage with a prolonged duration of action" ;
    dmo:name "Insulin glargine" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If hypoglycaemia is a concern, once daily insulin glargine, insulin degludec, or insulin detemir given in the morning may be a safer, less complex regimen - in particular for those new to insulin." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/isophane-insulin> a dmo:DrugClass ;
    rdfs:label "Isophane insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10AE01" ;
    dmo:drugClassCode "isophane-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Intermediate-acting insulin that provides basal insulin coverage" ;
    dmo:name "Isophane insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Twice daily gliclazide or isophane insulin This can be effective but there is a risk of early morning hypoglycaemia and care must be taken in adjusting doses with that risk in mind." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/metformin> a dmo:DrugClass ;
    rdfs:label "Metformin" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA" ;
    dmo:drugClassCode "metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "decreases gluconeogenesis and increases peripheral utilisation of glucose" ;
    dmo:name "Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Metformin decreases gluconeogenesis and increases peripheral utilisation of glucose." ;
    dmo:evidenceQuote "Metformin and pioglitazone are unlikely to be of significant, swift benefit and likewise there is no firm evidence to support the use of GLP-1RAs, DPP-4 inhibitors, or SGLT-2 inhibitors in these circumstances." ;
    dmo:evidenceQuote "The Association of British Clinical Diabetologists published specific information on how to manage inpatients with COVID-19; this included the discontinuation of metformin due to the risk of lactic acidosis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/pioglitazone> a dmo:DrugClass ;
    rdfs:label "Pioglitazone" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "pioglitazone" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Thiazolidinedione that enhances insulin sensitivity in peripheral tissues" ;
    dmo:name "Pioglitazone" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Metformin and pioglitazone are unlikely to be of significant, swift benefit and likewise there is no firm evidence to support the use of GLP-1RAs, DPP-4 inhibitors, or SGLT-2 inhibitors in these circumstances." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/sglt-2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT-2 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "sglt-2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibit glucose reabsorption in the kidneys, promoting urinary glucose excretion" ;
    dmo:name "SGLT-2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "there is no firm evidence to support the use of GLP-1RAs, DPP-4 inhibitors, or SGLT-2 inhibitors in these circumstances." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/sglt2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT2 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BJ" ;
    dmo:drugClassCode "sglt2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "There is currently no evidence to support the use of DPP-IV inhibitors, GLP-1, or SGLT-2 inhibitors in the management of steroid induced diabetes/hyperglycaemia" ;
    dmo:name "SGLT2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "There is currently no evidence to support the use of DPP-IV inhibitors, GLP-1, or SGLT-2 inhibitors in the management of steroid induced diabetes/hyperglycaemia (20)." ;
    dmo:evidenceQuote "discontinuing the use of SGLT2 inhibitors due to an increased risk of diabetic ketoacidosis (DKA) (31)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/sulphonylurea> a dmo:DrugClass ;
    rdfs:label "Sulphonylurea" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BB" ;
    dmo:drugClassCode "sulphonylurea" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Stimulates insulin secretion from pancreatic beta cells" ;
    dmo:name "Sulphonylurea" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "If two consecutive readings in 48 hours exceed 12.0mmol/L, refer to the clinician who commenced the steroid therapy, or if agreed locally, the general practitioner. The clinician should then consider the algorithm for the management of hyperglycaemia with steroid use, and potentially commence a sulphonylurea or optimise existing non-insulin or insulin therapy" ;
    dmo:evidenceQuote "These individuals should continue to blood glucose test and reduce their sulphonylurea and or insulin doses in tandem with reductions in the steroid dosage." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/sulphonylureas> a dmo:DrugClass ;
    rdfs:label "Sulphonylureas" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA" ;
    dmo:drugClassCode "sulphonylureas" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Stimulate insulin secretion from pancreatic beta cells" ;
    dmo:name "Sulphonylureas" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Glucose lowering treatments such as sulphonylureas and or insulin doses will need to be reduced in tanden with reductions in the steroid dosage." ;
    dmo:evidenceQuote "Sulphonylureas are NOT recommended in this context as beta cell function may be impaired and insulin resistance is likely to be severe." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/sulphonylureas-and-meglitinides> a dmo:DrugClass ;
    rdfs:label "Sulphonylureas and Meglitinides" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "sulphonylureas-and-meglitinides" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Stimulate insulin secretion from pancreatic beta cells" ;
    dmo:name "Sulphonylureas and Meglitinides" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Sulphonylureas and Meglitinides 14" ;
    dmo:evidenceQuote "These agents promote insulin release from the pancreatic beta cell." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/drugClass/twice-daily-gliclazide> a dmo:DrugClass ;
    rdfs:label "Twice daily gliclazide" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BB01" ;
    dmo:drugClassCode "twice-daily-gliclazide" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Sulphonylurea that stimulates insulin secretion from pancreatic beta cells" ;
    dmo:name "Twice daily gliclazide" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Twice daily gliclazide or isophane insulin This can be effective but there is a risk of early morning hypoglycaemia and care must be taken in adjusting doses with that risk in mind." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/capillary-blood-glucose> a dmo:LabTest ;
    rdfs:label "Capillary Blood Glucose" ;
    dmo:definition "A measure of blood glucose concentration obtained from a capillary blood sample, typically used for point-of-care testing." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "capillary-blood-glucose" ;
    dmo:loincCode "15536-4" ;
    dmo:name "Capillary Blood Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol-per-L" ;
    dmo:evidenceQuote "o On commencement of steroid, recommend capillary blood glucose (CBG) once daily pre or post lunch or evening meal, in those at “high risk” or with symptoms suggestive of “hyperglycaemia”." ;
    dmo:evidenceQuote "1. Set target for capillary blood glucose (CBG) e.g. 6.0-10.0mmol/L" ;
    dmo:evidenceQuote "Capillary blood glucose should be checked hourly, aiming to keep it within the target range of 4.0–7.0 mmol/L for those seeking tight control, or 4.0 – 8.0 mmol/L for those who aim for more liberal control." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/capillary-glucose> a dmo:LabTest ;
    rdfs:label "Capillary Glucose" ;
    dmo:definition "A measure of blood glucose concentration obtained from a capillary blood sample, typically via fingerstick testing." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "capillary-glucose" ;
    dmo:loincCode "15577-6" ;
    dmo:name "Capillary Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "At the commencement of corticosteroid therapy in people considered at risk of steroid induced diabetes, capillary glucose (CBG) testing should be initiated once daily." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/capillary-glucose-cbg> a dmo:LabTest ;
    rdfs:label "Capillary Glucose (CBG)" ;
    dmo:definition "Capillary glucose (CBG) monitoring is paramount to guiding appropriate therapeutic intervention." ;
    dmo:labTestCode "capillary-glucose-cbg" ;
    dmo:name "Capillary Glucose (CBG)" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Capillary glucose (CBG) monitoring is paramount to guiding appropriate therapeutic intervention." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/cbg> a dmo:LabTest ;
    rdfs:label "CBG" ;
    dmo:definition "Capillary Blood Glucose, used for monitoring blood glucose levels in real-time, particularly in titrating insulin doses." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "cbg" ;
    dmo:loincCode "15577-2" ;
    dmo:name "CBG" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol-per-L" ;
    dmo:evidenceQuote "If steroids are reduced or discontinued: o Continue CBG testing if CBG >12mmol/L in 24 hours o Any changes made should be reviewed and consideration given to reverting to previous therapy or doses" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/fasting-glucose> a dmo:LabTest ;
    rdfs:label "Fasting Glucose" ;
    dmo:definition "在类固醇治疗期间，若临床怀疑糖尿病，可在停药3个月内使用该检测进行诊断。" ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "fasting-glucose" ;
    dmo:loincCode "15577-2" ;
    dmo:name "Fasting Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol-per-L" ;
    dmo:evidenceQuote "A fasting glucose or OGTT may be advantageous if a diagnosis of diabetes is clinically suspected prior to 3 months elapsing." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/glucose-concentration> a dmo:LabTest ;
    rdfs:label "Glucose concentration" ;
    dmo:definition "Glucose concentrations above 10.0 mmol/L have been linked to increased mortality in people with COVID-19" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "glucose-concentration" ;
    dmo:loincCode "15576-2" ;
    dmo:name "Glucose concentration" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Glucose concentrations above 10.0 mmol/L have been linked to increased mortality in people with COVID-19" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/glucose-monitoring> a dmo:LabTest ;
    rdfs:label "Glucose monitoring" ;
    dmo:definition "Monitoring of blood glucose levels to assess glycaemic control, particularly important during steroid therapy and in individuals without a previous diagnosis of diabetes." ;
    dmo:labTestCode "glucose-monitoring" ;
    dmo:name "Glucose monitoring" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "In those without a pre-existing diagnosis of diabetes prior to the commencement of steroids, glucose monitoring, and person-centred and carer education should be undertaken in alignment with principles outlined within this document." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/hba1c> a dmo:LabTest ;
    rdfs:label "HbA1c" ;
    dmo:definition "A measure of average blood glucose levels over the past 2-3 months, used to assess long-term glycemic control." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "HbA1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "o Check HbA1c prior to the commencement of steroids in individuals perceived to be at high risk." ;
    dmo:evidenceQuote "If steroids are discontinued prior to discharge and hyperglycaemia persists then continue with monitoring until normal glycaemia returns or until a definitive test for diabetes is undertaken (fasting blood glucose, OGTT or HbA1c)" ;
    dmo:evidenceQuote "Impaired fasting glucose or impaired glucose tolerance, HbA1c 42-47mmol/mol" ;
    dmo:evidenceQuote "An HbA1c prior to the commencement of steroids in inpatients perceived to be at high risk of steroid induced diabetes and in those with known diabetes may be informative (15)." ;
    dmo:evidenceQuote "Given the recent hyperglycaemia the use of HbA1c as a screening tool should be delayed until 3 months following steroid cessation" ;
    dmo:evidenceQuote "It is recommended that individuals under the care of oncology teams have their baseline HbA1c and venous plasma glucose when starting steroid therapy." ;
    dmo:evidenceQuote "Up to a third of people may later develop diabetes so annual screening for diabetes using HbA1c needs to be in place" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/ogtt> a dmo:LabTest ;
    rdfs:label "OGTT" ;
    dmo:definition "Oral Glucose Tolerance Test, used to confirm diabetes diagnosis when hyperglycaemia persists after steroid discontinuation." ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "ogtt" ;
    dmo:loincCode "15576-4" ;
    dmo:name "OGTT" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol-per-L" ;
    dmo:evidenceQuote "If steroids are discontinued prior to discharge and hyperglycaemia persists then continue with monitoring until normal glycaemia returns or until a definitive test for diabetes is undertaken (fasting blood glucose, OGTT or HbA1c)" ;
    dmo:evidenceQuote "A fasting glucose or OGTT may be advantageous if a diagnosis of diabetes is clinically suspected prior to 3 months elapsing." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/urea-and-electrolytes> a dmo:LabTest ;
    rdfs:label "Urea and Electrolytes" ;
    dmo:definition "Urea and electrolytes should be checked prior to starting a variable rate intravenous insulin infusion and repeated daily to monitor fluid balance and electrolyte abnormalities." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urea-and-electrolytes" ;
    dmo:loincCode "2160-0" ;
    dmo:name "Urea and Electrolytes" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol-per-L" ;
    dmo:evidenceQuote "VRIII - Urea and electrolytes (U&Es) should be checked prior to starting a VRIII and repeated daily to monitor fluid balance and electrolyte abnormalities" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/urine-ketones> a dmo:LabTest ;
    rdfs:label "Urine Ketones" ;
    dmo:definition "A test to detect the presence of ketones in urine, used to assess for diabetic ketoacidosis, especially in Type 1 diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-ketones" ;
    dmo:loincCode "15537-2" ;
    dmo:name "Urine Ketones" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "trace / 1+ / 2+ / 3+ / 4+" ;
    dmo:evidenceQuote "o In Type 1 diabetes also check daily for ketones if CBG >12mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/labTest/venous-plasma-glucose> a dmo:LabTest ;
    rdfs:label "Venous Plasma Glucose" ;
