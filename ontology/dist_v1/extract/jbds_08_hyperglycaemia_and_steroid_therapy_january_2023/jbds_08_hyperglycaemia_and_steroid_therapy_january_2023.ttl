    dmo:recommendationType "Screening" ;
    dmo:statement "It is recommended that individuals under the care of oncology teams have their baseline HbA1c and venous plasma glucose when starting steroid therapy." ;
    dmo:evidenceQuote "It is recommended that individuals under the care of oncology teams have their baseline HbA1c and venous plasma glucose when starting steroid therapy." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/recommendation/metformin-and-pioglitazone-are-unlikely-to-be-of-significant-swift-benefit> a dmo:Recommendation ;
    rdfs:label "Metformin and pioglitazone are unlikely to be of significant, swift benefit" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "People taking multiple daily doses of steroid" ;
    dmo:recommendationId "metformin-and-pioglitazone-are-unlikely-to-be-of-significant-swift-benefit" ;
