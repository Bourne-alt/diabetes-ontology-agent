    dmo:symptomCode "glucose-reading-greater-than-12-0mmol-l" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "If a glucose reading is recorded greater than 12.0mmol/L, then glucose monitoring should be increased to a maximum of four times daily" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

