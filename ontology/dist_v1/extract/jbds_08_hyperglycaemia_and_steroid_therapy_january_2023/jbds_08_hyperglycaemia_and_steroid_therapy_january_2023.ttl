<https://example.org/dmo/id/recommendation/capillary-glucose-testing-in-people-at-risk-of-steroid-induced-diabetes> a dmo:Recommendation ;
    rdfs:label "Capillary Glucose Testing in People at Risk of Steroid Induced Diabetes" ;
    dmo:gradingSystem "Not specified" ;
    dmo:nativeEvidenceGrade "15" ;
    dmo:populationScope "People at risk of steroid induced diabetes" ;
    dmo:recommendationId "capillary-glucose-testing-in-people-at-risk-of-steroid-induced-diabetes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "At the commencement of corticosteroid therapy in people considered at risk of steroid induced diabetes, capillary glucose (CBG) testing should be initiated once daily. This should be prior to or following lunch or evening meal when the hyperglycaemic effects of morning steroid dosing is likely to be greatest." ;
    dmo:evidenceQuote "At the commencement of corticosteroid therapy in people considered at risk of steroid induced diabetes, capillary glucose (CBG) testing should be initiated once daily. This should be prior to or following lunch or evening meal when the hyperglycaemic effects of morning steroid dosing is likely to be greatest." ;
