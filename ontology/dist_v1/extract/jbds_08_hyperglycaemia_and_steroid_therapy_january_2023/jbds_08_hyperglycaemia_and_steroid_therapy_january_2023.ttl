<https://example.org/dmo/id/device/capillary-blood-glucose> a dmo:Device ;
    rdfs:label "Capillary Blood Glucose" ;
    dmo:deviceCode "capillary-blood-glucose" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Capillary Blood Glucose" ;
    dmo:evidenceQuote "On commencement of steroid, recommend capillary blood glucose (CBG) once daily pre or post lunch or evening meal, in those at “high risk” or with symptoms suggestive of “hyperglycaemia”." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

