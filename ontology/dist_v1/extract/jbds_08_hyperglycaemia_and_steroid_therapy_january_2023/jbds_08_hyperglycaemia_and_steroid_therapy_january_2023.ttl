<https://example.org/dmo/id/monitoringSchedule/annual-screening-for-diabetes> a dmo:MonitoringSchedule ;
    rdfs:label "Annual Screening for Diabetes" ;
    dmo:appliesTo "People who had diabetes precipitated by COVID-19 infection and dexamethasone treatment" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Annual Screening for Diabetes" ;
    dmo:scheduleId "annual-screening-for-diabetes" ;
    dmo:evidenceQuote "Up to a third of people may later develop diabetes so annual screening for diabetes using HbA1c needs to be in place" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary blood glucose" ;
    dmo:appliesTo "women with type 1 diabetes, gestational diabetes and for other pregnant women treated with insulin" ;
    dmo:frequencyMonths "1"^^xsd:integer ;
    dmo:name "Capillary blood glucose" ;
    dmo:scheduleId "capillary-blood-glucose" ;
    dmo:triggerWindow "hourly" ;
    dmo:evidenceQuote "Capillary blood glucose should be checked hourly, aiming to keep it within the target range of 4.0–7.0 mmol/L for those seeking tight control, or 4.0 – 8.0 mmol/L for those who aim for more liberal control." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Blood Glucose Monitoring" ;
    dmo:appliesTo "individuals perceived to be at high risk or with symptoms suggestive of hyperglycaemia" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Capillary Blood Glucose Monitoring" ;
    dmo:scheduleId "capillary-blood-glucose-monitoring" ;
    dmo:triggerWindow "4 times daily" ;
    dmo:evidenceQuote "On commencement of steroid, recommend capillary blood glucose (CBG) once daily pre or post lunch or evening meal, in those at “high risk” or with symptoms suggestive of “hyperglycaemia”." ;
    dmo:evidenceQuote "Consider increasing monitoring to 4 times daily" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose-monitoring-after-12-mmol-l-threshold> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Blood Glucose Monitoring After 12 mmol/L Threshold" ;
    dmo:appliesTo "individuals with capillary blood glucose greater than 12 mmol/L" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Capillary Blood Glucose Monitoring After 12 mmol/L Threshold" ;
    dmo:scheduleId "capillary-blood-glucose-monitoring-after-12-mmol-l-threshold" ;
    dmo:evidenceQuote "If a capillary blood glucose is found to be greater than 12mmol/L the frequency of testing should be increased to four (4x) times a day." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose-monitoring-for-consistently-high-levels> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Blood Glucose Monitoring for Consistently High Levels" ;
    dmo:appliesTo "individuals with capillary blood glucose consistently greater than 12 mmol/L (i.e. on 2 occasions during a 24hr period)" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Capillary Blood Glucose Monitoring for Consistently High Levels" ;
    dmo:scheduleId "capillary-blood-glucose-monitoring-for-consistently-high-levels" ;
    dmo:evidenceQuote "If a capillary blood glucose is found to be consistently greater than 12mmol/L (i.e. on 2 occasions during a 24hr period), then the individual should enter the treatment algorithm below." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose-monitoring-for-high-risk-individuals> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Blood Glucose Monitoring for High Risk Individuals" ;
    dmo:appliesTo "individuals at high risk or with symptoms suggestive of hyperglycaemia" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Capillary Blood Glucose Monitoring for High Risk Individuals" ;
    dmo:scheduleId "capillary-blood-glucose-monitoring-for-high-risk-individuals" ;
    dmo:evidenceQuote "On commencement of steroid, recommend capillary blood glucose (CBG) once daily pre or post lunch or evening meal, in those at “high risk” or with symptoms suggestive of “hyperglycaemia”." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose-monitoring-in-known-diabetes> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Blood Glucose Monitoring in Known Diabetes" ;
    dmo:appliesTo "individuals with known diabetes diagnosis" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Capillary Blood Glucose Monitoring in Known Diabetes" ;
    dmo:scheduleId "capillary-blood-glucose-monitoring-in-known-diabetes" ;
    dmo:evidenceQuote "Check CBG 4 times a day and use this flowchart to adjust diabetes medication accordingly." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose-monitoring-in-type-1-diabetes> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Blood Glucose Monitoring in Type 1 Diabetes" ;
    dmo:appliesTo "individuals with Type 1 diabetes" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Capillary Blood Glucose Monitoring in Type 1 Diabetes" ;
    dmo:scheduleId "capillary-blood-glucose-monitoring-in-type-1-diabetes" ;
    dmo:evidenceQuote "In Type 1 diabetes also check daily for ketones if CBG >12mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-glucose-testing> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Glucose Testing" ;
    dmo:appliesTo "in people without a pre-existing diagnosis of diabetes" ;
    dmo:frequencyMonths "1"^^xsd:integer ;
    dmo:name "Capillary Glucose Testing" ;
    dmo:scheduleId "capillary-glucose-testing" ;
    dmo:triggerWindow "at the commencement of corticosteroid therapy in people considered at risk of steroid induced diabetes" ;
    dmo:evidenceQuote "At the commencement of corticosteroid therapy in people considered at risk of steroid induced diabetes, capillary glucose (CBG) testing should be initiated once daily." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-glucose-testing-for-consistent-hyperglycaemia> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Glucose Testing for Consistent Hyperglycaemia" ;
    dmo:appliesTo "in people without a pre-existing diagnosis of diabetes" ;
    dmo:name "Capillary Glucose Testing for Consistent Hyperglycaemia" ;
    dmo:scheduleId "capillary-glucose-testing-for-consistent-hyperglycaemia" ;
    dmo:triggerWindow "If the capillary glucose is found to be consistently greater than 12.0mmol/L i.e. on two consecutive readings in 48 hours" ;
    dmo:evidenceQuote "If the capillary glucose is found to be consistently greater than 12.0mmol/L i.e. on two consecutive readings in 48 hours refer to the treatment algorithm" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-glucose-testing-for-consistent-hyperglycaemia-24-hour-version> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Glucose Testing for Consistent Hyperglycaemia (24-hour version)" ;
    dmo:appliesTo "in people without a pre-existing diagnosis of diabetes" ;
    dmo:name "Capillary Glucose Testing for Consistent Hyperglycaemia (24-hour version)" ;
    dmo:scheduleId "capillary-glucose-testing-for-consistent-hyperglycaemia-24-hour-version" ;
    dmo:triggerWindow "If the capillary glucose is found to be consistently greater than 12.0mmol/L i.e., on two occasions during 24 hours" ;
    dmo:evidenceQuote "If the capillary glucose is found to be consistently greater than 12.0mmol/L i.e., on two occasions during 24 hours, refer to the treatment algorithm" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-glucose-testing-four-times-daily> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Glucose Testing Four Times Daily" ;
    dmo:appliesTo "in people without a pre-existing diagnosis of diabetes" ;
    dmo:name "Capillary Glucose Testing Four Times Daily" ;
    dmo:scheduleId "capillary-glucose-testing-four-times-daily" ;
    dmo:triggerWindow "If a subsequent capillary glucose is found to be greater than 12.0mmol/L" ;
    dmo:evidenceQuote "If a subsequent capillary glucose is found to be greater than 12.0mmol/L, then increase the frequency of testing to four times daily (before meals and before bed)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/glucose-monitoring-after-steroid-cessation> a dmo:MonitoringSchedule ;
    rdfs:label "Glucose monitoring after steroid cessation" ;
    dmo:appliesTo "People without pre-existing diabetes who experienced steroid induced hyperglycaemia" ;
    dmo:frequencyMonths "3"^^xsd:integer ;
    dmo:name "Glucose monitoring after steroid cessation" ;
    dmo:scheduleId "glucose-monitoring-after-steroid-cessation" ;
    dmo:triggerWindow "After stopping steroid therapy in people without pre-existing diabetes who experienced steroid induced hyperglycaemia" ;
    dmo:evidenceQuote "After stopping steroid therapy in people without pre-existing diabetes who experienced steroid induced hyperglycaemia there should be screening for a diagnosis of diabetes. Given the recent hyperglycaemia the use of HbA1c as a screening tool should be delayed until 3 months following steroid cessation" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/glucose-monitoring-four-times-daily> a dmo:MonitoringSchedule ;
    rdfs:label "Glucose monitoring four times daily" ;
    dmo:appliesTo "Individuals with glucose reading >12.0mmol/L on steroid therapy" ;
    dmo:frequencyMonths "1"^^xsd:integer ;
    dmo:name "Glucose monitoring four times daily" ;
    dmo:scheduleId "glucose-monitoring-four-times-daily" ;
    dmo:triggerWindow "If a reading exceeds 12.0mmol/L increase testing to four times daily, including post prandially" ;
    dmo:evidenceQuote "If a reading exceeds 12.0mmol/L increase testing to four times daily, including post prandially" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/monitoringSchedule/glucose-monitoring-once-daily> a dmo:MonitoringSchedule ;
    rdfs:label "Glucose monitoring once daily" ;
    dmo:appliesTo "Individuals discharged on steroid therapy with continued high dose steroids" ;
    dmo:frequencyMonths "1"^^xsd:integer ;
    dmo:name "Glucose monitoring once daily" ;
    dmo:scheduleId "glucose-monitoring-once-daily" ;
    dmo:triggerWindow "If the steroid dose remains above 5mg prednisolone or equivalent, for a protracted period, and the patient is insulin treated" ;
    dmo:evidenceQuote "If the steroid dose remains above 5mg prednisolone or equivalent, for a protracted period, and the patient is insulin treated then the glucose should be checked at least once daily and prior to driving" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

