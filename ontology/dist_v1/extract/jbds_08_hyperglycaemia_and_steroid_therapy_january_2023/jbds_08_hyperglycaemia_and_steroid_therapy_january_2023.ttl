    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "insulin-glargine" ;
    dmo:name "Insulin glargine" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Care should be taken to identify and protect against nocturnal and early morning hypoglycaemia if insulin glargine, insulin detemir or insulin degludec are used in this context." ;
    dmo:evidenceQuote "once daily insulin glargine, insulin degludec, or insulin detemir given in the morning" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/medication/insuman-basal> a dmo:Medication ;
