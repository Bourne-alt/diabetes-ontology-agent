<https://example.org/dmo/id/riskFactor/covid-19-infection> a dmo:RiskFactor ;
    rdfs:label "COVID-19 Infection" ;
    dmo:evidenceNote "The document states that COVID-19 increases insulin resistance and impairs insulin production, which can result in hyperglycaemia and life-threatening DKA in people with diabetes and even in people not known to have diabetes." ;
    dmo:name "COVID-19 Infection" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "covid-19-infection" ;
    dmo:evidenceQuote "It is acknowledged that COVID-19 increases insulin resistance and impairs insulin production, which can result in hyperglycaemia and life threating DKA in people with diabetes and even in people not known to have diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/riskFactor/dose-of-glucocorticoids> a dmo:RiskFactor ;
    rdfs:label "Dose of Glucocorticoids" ;
    dmo:evidenceNote "The dose of glucocorticoids is a modifiable risk factor, as it can be adjusted or reduced to minimize metabolic effects." ;
    dmo:name "Dose of Glucocorticoids" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "dose-of-glucocorticoids" ;
    dmo:evidenceQuote "This is related to the duration of time on steroids, the potency of the drug used and the doses given, the length of time on glucocorticoids, and the relative potency and dose of the glucocorticoid." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_08_hyperglycaemia_and_steroid_therapy_january_2023> .

<https://example.org/dmo/id/riskFactor/duration-of-steroid-use> a dmo:RiskFactor ;
