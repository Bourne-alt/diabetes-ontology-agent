    dmo:atcCode "C09AA01" ;
    dmo:drugClassCode "ace-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibits angiotensin-converting enzyme, reducing angiotensin II formation and lowering blood pressure and glomerular pressure" ;
    dmo:name "ACE Inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "RAS inhibition with ACEi or ARBs has been standard of care in patients with T1D and T2D and CKD for decades." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/drugClass/arbs> a dmo:DrugClass ;
