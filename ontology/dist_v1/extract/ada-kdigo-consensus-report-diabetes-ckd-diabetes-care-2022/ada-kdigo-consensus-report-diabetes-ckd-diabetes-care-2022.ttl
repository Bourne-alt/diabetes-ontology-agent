    dmo:rationale "Use not recommended" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "eGFR <30 mL/min/1.73 m2" ;
    dmo:evidenceQuote "Miglitol No dose adjustment required Use not recommended" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/device/automated-insulin-delivery-systems> a dmo:Device ;
