<https://example.org/dmo/id/complication/acute-kidney-injury> a dmo:Complication ;
    rdfs:label "Acute Kidney Injury" ;
    dmo:affectedOrgan "Kidney" ;
    dmo:complicationCode "acute-kidney-injury" ;
    dmo:definition "Acute kidney injury (AKI) contributes to reduced metformin clearance." ;
    dmo:isEmergency "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005275" ;
    dmo:name "Acute Kidney Injury" ;
    dmo:onsetPattern "Acute" ;
    dmo:evidenceQuote "Most episodes of metformin-associated lactic acidosis occur concurrent with other acute illness, often when acute kidney injury (AKI) contributes to reduced metformin clearance." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

