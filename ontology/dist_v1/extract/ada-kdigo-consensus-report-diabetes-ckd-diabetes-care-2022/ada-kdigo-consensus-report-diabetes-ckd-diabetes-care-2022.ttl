    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Glucagon-like peptide-1 receptor agonist that enhances glucose-dependent insulin secretion and suppresses glucagon secretion" ;
    dmo:name "GLP-1 RA" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "GLP-1 RA if needed to achieve individualized glycemic target" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/drugClass/glp-1-receptor-agonists> a dmo:DrugClass ;
    rdfs:label "GLP-1 receptor agonists" ;
    dmo:drugClassCode "glp-1-receptor-agonists" ;
