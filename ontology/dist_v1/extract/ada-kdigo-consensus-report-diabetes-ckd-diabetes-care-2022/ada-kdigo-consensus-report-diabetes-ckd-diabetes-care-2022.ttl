<https://example.org/dmo/id/labTest/acr> a dmo:LabTest ;
    rdfs:label "ACR" ;
    dmo:definition "albumin-to-creatinine ratio, a measure of albuminuria used to define kidney disease in patients with T2D" ;
    dmo:labTestCode "acr" ;
    dmo:name "ACR" ;
    dmo:unitOfMeasure "mg/g" ;
    dmo:evidenceQuote "patients with T2D, kidney disease (defined primarily as ACR $30 mg/g), and potassium <4.8 mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/labTest/albumin-to-creatinine-ratio> a dmo:LabTest ;
    rdfs:label "Albumin-to-Creatinine Ratio" ;
    dmo:definition "A measure of albumin excretion in urine relative to creatinine, used to assess kidney damage and albuminuria in patients with diabetes and CKD." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "albumin-to-creatinine-ratio" ;
    dmo:loincCode "29515-2" ;
    dmo:name "Albumin-to-Creatinine Ratio" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg-per-g" ;
    dmo:evidenceQuote "Nonsteroidal MRA† if ACR ≥30 mg/g and normal potassium" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/labTest/blood-ketones> a dmo:LabTest ;
