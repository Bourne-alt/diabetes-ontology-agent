    dmo:populationScope "Patients with T2D who have established ASCVD or established kidney disease" ;
    dmo:recommendationId "use-of-an-sglt2i-or-glp-1-receptor-agonist-in-patients-with-t2d-who-have-established-ascvd-or-established-kidney-disease" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Among patients with T2D who have established ASCVD or established kidney disease, an SGLT2i or GLP-1 receptor agonist with demonstrated cardiovascular disease benefit is recommended as part of the comprehensive cardiovascular risk reduction and/or glucose-lowering regimens." ;
    dmo:evidenceQuote "Among patients with T2D who have established ASCVD or established kidney disease, an SGLT2i or GLP-1 receptor agonist with demonstrated cardiovascular disease benefit is recommended as part of the comprehensive cardiovascular risk reduction and/or glucose-lowering regimens (A)." ;
