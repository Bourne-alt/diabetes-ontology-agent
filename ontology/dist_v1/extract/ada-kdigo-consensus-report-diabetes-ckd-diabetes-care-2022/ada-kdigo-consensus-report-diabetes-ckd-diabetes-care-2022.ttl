<https://example.org/dmo/id/recommendation/use-of-a-long-acting-glp-1-receptor-agonist-in-patients-with-t2d-and-ckd-who-have-not-achieved-individualized-glycemic-targets-despite-use-of-metformin-and-sglt2i-treatment-or-who-are-unable-to-use-those-medications> a dmo:Recommendation ;
    rdfs:label "Use of a long-acting GLP-1 receptor agonist in patients with T2D and CKD who have not achieved individualized glycemic targets despite use of metformin and SGLT2i treatment or who are unable to use those medications" ;
    dmo:gradingSystem "KDIGO" ;
    dmo:nativeEvidenceGrade "1B" ;
    dmo:populationScope "Patients with T2D and CKD who have not achieved individualized glycemic targets despite use of metformin and SGLT2i treatment, or who are unable to use those medications" ;
    dmo:recommendationId "use-of-a-long-acting-glp-1-receptor-agonist-in-patients-with-t2d-and-ckd-who-have-not-achieved-individualized-glycemic-targets-despite-use-of-metformin-and-sglt2i-treatment-or-who-are-unable-to-use-those-medications" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "In patients with T2D and CKD who have not achieved individualized glycemic targets despite use of metformin and SGLT2i treatment, or who are unable to use those medications, we recommend a long-acting GLP-1 receptor agonist." ;
    dmo:evidenceQuote "In patients with T2D and CKD who have not achieved individualized glycemic targets despite use of metformin and SGLT2i treatment, or who are unable to use those medications, we recommend a long-acting GLP-1 receptor agonist (1B)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/recommendation/use-of-an-sglt2i-or-glp-1-receptor-agonist-in-patients-with-t2d-who-have-established-ascvd-or-established-kidney-disease> a dmo:Recommendation ;
