    dmo:scheduleId "egfr-monitoring" ;
    dmo:evidenceQuote "eGFR should be monitored at least annually in patients with CKD" ;
    dmo:evidenceQuote "Monitor eGFR with increasing frequency as eGFR falls to <60 mL/min/1.73 m 2" ;
