    dmo:mechanism "Glucagon-like peptide 1 receptor agonist" ;
    dmo:name "GLP-1 receptor agonists" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "GLP-1 receptor agonists Nausea/vomiting/diarrhea /C15Educate on tolerability and symptom recognition\n/C15Start at lowest recommended dose and titrate slowly\nHypoglycemia /C15Adjust background glucose-lowering agents (e.g., insulin or sulfonylureas) as appropriate" ;
    dmo:evidenceQuote "SGLT2 inhibitors* GLP-1 receptor agonists§ Sulfonylureas (2nd generation) DPP-4 inhibitors Thiazolidinediones α-Glucosidase inhibitors" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin mechanism of action" ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Insulin Initiate and titrate conservatively to avoid hypoglycemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/drugClass/metformin> a dmo:DrugClass ;
    rdfs:label "Metformin" ;
    dmo:drugClassCode "metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Biguanide" ;
    dmo:name "Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Metformin Metformin-associated lactic acidosis /C15Monitor eGFR with increasing frequency as eGFR falls to <60 mL/min/1.73 m 2\n/C15Adjust metformin dose as appropriate per eGFR (see Table 4)\n/C15Consider dose reduction in the presence of conditions that predispose patients\nto hypoperfusion and hypoxemia for eGFR 45 –59 mL/min/1.73 m 2\n/C15Discontinue for eGFR <30 mL/min/1.73 m 2\n/C15Institute a sick day protocol\nB12 malabsorption /C15Monitor patients for vitamin B 12 deﬁciency when treated with metformin for\n>4 years" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/drugClass/sglt2-inhibitor> a dmo:DrugClass ;
    rdfs:label "SGLT2 inhibitor" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BJ02" ;
    dmo:drugClassCode "sglt2-inhibitor" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibits sodium-glucose co-transporter 2 in the proximal tubule, promoting urinary glucose excretion" ;
    dmo:name "SGLT2 inhibitor" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "The ADA 2022 Standards Care and the KDIGO 2022 guideline recommend early initiation of metformin plus an SGLT2 inhibitor in most patients with T2D and CKD (2,17) (Table 1)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/drugClass/sglt2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT2 inhibitors" ;
    dmo:drugClassCode "sglt2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Sodium–glucose cotransporter 2 inhibitor" ;
    dmo:name "SGLT2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "SGLT2i Genital mycotic infections /C15Counsel on genital hygiene\nVolume depletion /C15Monitor for hypovolemia and consider proactive dose reduction of diuretics in\npatients at high risk\n/C15Hold SGLT2i during illness\nDiabetic ketoacidosis /C15Educate about signs/symptoms to facilitate early recognition\n/C15Monitor blood or urine ketones in the case of very high risk\n/C15Institute a sick day protocol\n/C15Maintain at least low-dose insulin in insulin-requiring individuals" ;
    dmo:evidenceQuote "SGLT2 inhibitors* GLP-1 receptor agonists§ Sulfonylureas (2nd generation) DPP-4 inhibitors Thiazolidinediones α-Glucosidase inhibitors" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/drugClass/sglt2i> a dmo:DrugClass ;
    rdfs:label "SGLT2i" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "sglt2i" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibits sodium-glucose cotransporter 2 in the proximal tubule, promoting urinary glucose excretion" ;
    dmo:name "SGLT2i" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "SGLT2i (Initiate if eGFR ≥20; continue until dialysis or transplant)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/drugClass/sodium-glucose-cotransporter-2-inhibitors> a dmo:DrugClass ;
    rdfs:label "Sodium-glucose cotransporter 2 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BH" ;
    dmo:drugClassCode "sodium-glucose-cotransporter-2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibit the sodium-glucose cotransporter 2 in the proximal tubule of the kidney, leading to increased urinary glucose excretion and lower blood glucose levels." ;
    dmo:name "Sodium-glucose cotransporter 2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "SGLT2 inhibition for CKD and cardiovascular disease in type 2 diabetes: report of a scienti ﬁc workshop sponsored by the National Kidney Foundation. Diabetes 2021;70:1–16" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

