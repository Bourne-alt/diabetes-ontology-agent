    dmo:definition "blood ketones" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-ketones" ;
    dmo:loincCode "21700-0" ;
    dmo:name "Blood Ketones" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol-per-L" ;
    dmo:evidenceQuote "Monitor blood or urine ketones in the case of very high risk" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/labTest/estimated-glomerular-filtration-rate> a dmo:LabTest ;
    rdfs:label "Estimated Glomerular Filtration Rate" ;
    dmo:definition "Persistent eGFR <60 mL/min/1.73 m2 defines CKD diagnosis." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "estimated-glomerular-filtration-rate" ;
    dmo:loincCode "30954-2" ;
    dmo:name "Estimated Glomerular Filtration Rate" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mL/min/1.73 m2" ;
    dmo:evidenceQuote "Persistent eGFR <60 mL/min/1 .73 m2 and" ;
    dmo:evidenceQuote "SGLT2i (Initiate if eGFR ≥20; continue until dialysis or transplant)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/labTest/uacr> a dmo:LabTest ;
    rdfs:label "UACR" ;
    dmo:definition "A measure of albumin excretion in urine, used to assess kidney damage in diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "uacr" ;
    dmo:loincCode "29515-2" ;
    dmo:name "UACR" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg/g" ;
    dmo:evidenceQuote "Like CREDENCE and DAPA-CKD, EMPA-KIDNEY was stopped early for clear positive efﬁcacy (63); corresponding expansion of the indications for use of an SGLT2i in CKD may be further supported b a s e do nt h e s eﬁndings." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/labTest/urine-albumin-to-creatinine-ratio> a dmo:LabTest ;
    rdfs:label "Urine Albumin-to-Creatinine Ratio" ;
    dmo:definition "Persistent urine ACR ≥30 mg/g defines CKD diagnosis." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-albumin-to-creatinine-ratio" ;
    dmo:loincCode "2951-2" ;
    dmo:name "Urine Albumin-to-Creatinine Ratio" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg/g" ;
    dmo:evidenceQuote "Persistent urine ACR ≥30 mg/g and/or" ;
    dmo:evidenceQuote "urine albumin ranging from normal to 200 mg/g creatinine" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/labTest/urine-ketones> a dmo:LabTest ;
    rdfs:label "Urine Ketones" ;
    dmo:definition "urine ketones" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-ketones" ;
    dmo:loincCode "21701-8" ;
    dmo:name "Urine Ketones" ;
