<https://example.org/dmo/id/complication/atherosclerotic-cardiovascular-disease> a dmo:Complication ;
    rdfs:label "Atherosclerotic Cardiovascular Disease" ;
    dmo:affectedOrgan "Heart" ;
    dmo:complicationCode "atherosclerotic-cardiovascular-disease" ;
    dmo:definition "Atherosclerotic cardiovascular disease (ASCVD) refers to the buildup of plaque in the arteries, leading to conditions such as coronary artery disease, cerebrovascular disease, and peripheral artery disease." ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Atherosclerotic Cardiovascular Disease" ;
    dmo:onsetPattern "Chronic" ;
    dmo:evidenceQuote "Among patients with T2D who have established ASCVD or established kidney disease, an SGLT2i or GLP-1 receptor agonist with demonstrated cardiovascular disease benefit is recommended as part of the comprehensive cardiovascular risk reduction and/or glucose-lowering regimens (A)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/complication/cardiovascular-disease> a dmo:Complication ;
    rdfs:label "Cardiovascular Disease" ;
    dmo:affectedOrgan "Heart" ;
    dmo:complicationCode "cardiovascular-disease" ;
    dmo:definition "CVD refers to conditions such as coronary heart disease, ischemic stroke, and other cardiovascular events, which are more common in patients with diabetes and CKD." ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Cardiovascular Disease" ;
    dmo:onsetPattern "Chronic" ;
    dmo:evidenceQuote "cardiovascular events and mortality are more common than kidney failure" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/complication/chronic-kidney-disease> a dmo:Complication ;
    rdfs:label "Chronic Kidney Disease" ;
    dmo:affectedOrgan "Kidney" ;
    dmo:complicationCode "chronic-kidney-disease" ;
    dmo:definition "Persistent abnormalities in either urine ACR or eGFR (or both) diagnose CKD and should lead to immediate initiation of evidence-based treatments." ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005146" ;
    dmo:name "Chronic Kidney Disease" ;
    dmo:onsetPattern "Chronic" ;
    dmo:evidenceQuote "Persistent abnormalities in either urine ACR or eGFR (or both) diagnose CKD and should lead to immediate initiation of evidence-based treatments." ;
    dmo:evidenceQuote "patients with diabetes and CKD" ;
    dmo:evidenceQuote "In patients with T2D and CKD who have not achieved individualized glycemic targets despite use of metformin and SGLT2i treatment, or who are unable to use those medications, we recommend a long-acting GLP-1 receptor agonist (1B)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/complication/diabetic-ketoacidosis> a dmo:Complication ;
    rdfs:label "Diabetic Ketoacidosis" ;
    dmo:affectedOrgan "Systemic" ;
    dmo:complicationCode "diabetic-ketoacidosis" ;
    dmo:definition "Diabetic ketoacidosis (DKA) is a serious complication of diabetes characterized by hyperglycemia, ketonemia, and metabolic acidosis, often requiring emergency treatment." ;
    dmo:isEmergency "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "Diabetic Ketoacidosis" ;
    dmo:onsetPattern "Acute" ;
    dmo:evidenceQuote "Diabetic ketoacidosis /C15Educate about signs/symptoms to facilitate early recognition /C15Monitor blood or urine ketones in the case of very high risk /C15Institute a sick day protocol /C15Maintain at least low-dose insulin in insulin-requiring individuals" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

