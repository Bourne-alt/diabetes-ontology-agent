<https://example.org/dmo/id/adverseEffect/genital-mycotic-infections> a dmo:AdverseEffect ;
    rdfs:label "Genital mycotic infections" ;
    dmo:adverseEffectCode "genital-mycotic-infections" ;
    dmo:frequencyCategory "Uncommon" ;
    dmo:name "Genital mycotic infections" ;
    dmo:severity "Mild" ;
    dmo:evidenceQuote "SGLT2i Genital mycotic infections /C15Counsel on genital hygiene" ;
    dmo:evidenceQuote "Genital mycotic infections are a known complication of SGLT2i. A meta-analysis of clinical trials reported that genital mycotic infections occurred in 6% of participants assigned to an SGLT2i, compared with 1% of those assigned to placebo (65)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

