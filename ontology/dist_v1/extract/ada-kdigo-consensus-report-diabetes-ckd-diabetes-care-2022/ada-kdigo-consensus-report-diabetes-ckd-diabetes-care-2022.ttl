<https://example.org/dmo/id/contraindication/maintain-at-least-low-dose-insulin-in-insulin-requiring-individuals-during-sglt2i-use> a dmo:Contraindication ;
    rdfs:label "Maintain at least low-dose insulin in insulin-requiring individuals during SGLT2i use" ;
    dmo:contraCode "maintain-at-least-low-dose-insulin-in-insulin-requiring-individuals-during-sglt2i-use" ;
    dmo:rationale "Maintain at least low-dose insulin in insulin-requiring individuals" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "Insulin-requiring individuals" ;
    dmo:evidenceQuote "Maintain at least low-dose insulin in insulin-requiring individuals" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/contraindication/metformin-associated-lactic-acidosis> a dmo:Contraindication ;
    rdfs:label "Metformin-associated lactic acidosis" ;
    dmo:contraCode "metformin-associated-lactic-acidosis" ;
    dmo:rationale "Metformin is excreted unchanged in urine, and impaired metformin excretion in patients with CKD increases the risk of lactic acidosis; most episodes occur concurrent with other acute illness, often when AKI reduces metformin clearance" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in patients with eGFR <30 mL/min/1.73 m2 or during acute illness, especially when acute kidney injury (AKI) contributes to reduced metformin clearance" ;
    dmo:evidenceQuote "Most episodes of metformin-associated lactic acidosis occur concurrent with other acute illness, often when acute kidney injury (AKI) contributes to reduced metformin clearance." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/contraindication/metformin-contraindicated-with-egfr-30-ml-min-1-73-m2> a dmo:Contraindication ;
    rdfs:label "Metformin contraindicated with eGFR <30 mL/min/1.73 m2" ;
    dmo:contraCode "metformin-contraindicated-with-egfr-30-ml-min-1-73-m2" ;
    dmo:rationale "Contraindicated" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "eGFR <30 mL/min/1.73 m2" ;
    dmo:evidenceQuote "Metformin Reduce dose to 1000 mg/day Contraindicated" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/contraindication/miglitol-use-not-recommended-with-egfr-30-ml-min-1-73-m2> a dmo:Contraindication ;
    rdfs:label "Miglitol use not recommended with eGFR <30 mL/min/1.73 m2" ;
