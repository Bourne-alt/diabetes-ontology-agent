<https://example.org/dmo/id/riskFactor/acute-kidney-injury> a dmo:RiskFactor ;
    rdfs:label "Acute Kidney Injury" ;
    dmo:evidenceNote "Acute kidney injury contributes to reduced metformin clearance, increasing the risk of metformin-associated lactic acidosis." ;
    dmo:name "Acute Kidney Injury" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "acute-kidney-injury" ;
    dmo:evidenceQuote "Most episodes of metformin-associated lactic acidosis occur concurrent with other acute illness, often when acute kidney injury (AKI) contributes to reduced metformin clearance." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/riskFactor/albuminuria> a dmo:RiskFactor ;
    rdfs:label "Albuminuria" ;
    dmo:evidenceNote "An ACE inhibitor (ACEi) or angiotensin II receptor blocker (ARB) is recommended for patients with T1D or T2D who have hypertension and albuminuria, titrated to the maximum antihypertensive or highest tolerated dose." ;
    dmo:name "Albuminuria" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "albuminuria" ;
    dmo:evidenceQuote "An ACE inhibitor (ACEi) or angiotensin II receptor blocker (ARB) is recommended for patients with T1D or T2D who have hypertension and albuminuria, titrated to the maximum antihypertensive or highest tolerated dose." ;
