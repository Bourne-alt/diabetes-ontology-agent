<https://example.org/dmo/id/riskFactor/limited-life-expectancy> a dmo:RiskFactor ;
    rdfs:label "Limited Life Expectancy" ;
    dmo:evidenceNote "Limited life expectancy is a factor that may lead to higher HbA1c targets, as the harms of intensive treatment may outweigh benefits." ;
    dmo:name "Limited Life Expectancy" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "limited-life-expectancy" ;
    dmo:evidenceQuote "although with higher goals (i.e., <8%) acceptable for patients with limited life expectancy and in whom the harms of treatment may outweigh the beneﬁts." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

<https://example.org/dmo/id/riskFactor/low-cardiovascular-risk> a dmo:RiskFactor ;
    rdfs:label "Low Cardiovascular Risk" ;
    dmo:evidenceNote "Low cardiovascular risk is defined as 10-year ASCVD risk <15% and influences the choice of less stringent BP targets." ;
    dmo:name "Low Cardiovascular Risk" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "low-cardiovascular-risk" ;
    dmo:evidenceQuote "For patients with diabetes, hypertension, and low cardiovascular risk (defined as those with 10-year ASCVD risk<15%), the ADA recommends a BP target of <140/90 mmHg (grade A recommendation) (40)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/ada-kdigo-consensus-report-diabetes-ckd-diabetes-care-2022> .

