<https://example.org/dmo/id/complication/blindness> a dmo:Complication ;
    rdfs:label "Blindness" ;
    dmo:affectedOrgan "Eye" ;
    dmo:complicationCode "blindness" ;
    dmo:definition "Blindness is a health problem from diabetes that can be prevented or delayed by managing your ABCs." ;
    dmo:isEmergency "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005150" ;
    dmo:name "Blindness" ;
    dmo:onsetPattern "Chronic" ;
    dmo:evidenceQuote "Managing your ABCs may lower your chances of having health problems from diabetes, such as a heart attack, stroke, kidney disease, blindness, and foot or leg amputations." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

