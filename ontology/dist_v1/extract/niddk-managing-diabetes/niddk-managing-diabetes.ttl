    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/diabetesType/type-1-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 1 Diabetes" ;
    dmo:definition "If you have type 1 diabetes, your health care team may ask you to check your urine at home for substances called ketones." ;
    dmo:diabetesTypeCode "type-1-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 1 Diabetes" ;
    dmo:prevalenceShare "0.1"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "If you have type 1 diabetes, your health care team may ask you to check your urine at home for substances called ketones." ;
    dmo:evidenceQuote "Most often, ketoacidosis affects people with type 1 diabetes." ;
    dmo:evidenceQuote "The study showed that participants with type 1 diabetes who kept their blood glucose levels close to normal greatly lowered their chances of developing eye, kidney, and nerve disease." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:definition "However, some people with type 2 diabetes can develop ketoacidosis if they do not produce enough insulin." ;
    dmo:diabetesTypeCode "type-2-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "Type 2 Diabetes" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "However, some people with type 2 diabetes can develop ketoacidosis if they do not produce enough insulin." ;
    dmo:evidenceQuote "The study found that people with less effective diabetes management during the first year after being diagnosed with diabetes had a higher risk of diabetes complications and death." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes-in-adolescents-and-youth> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes in Adolescents and Youth" ;
    dmo:definition "The TODAY studies, both funded by NIDDK, show the importance of early, intensive treatment and blood glucose management for children or adolescents diagnosed with type 2 diabetes." ;
    dmo:diabetesTypeCode "type-2-diabetes-in-adolescents-and-youth" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0018750" ;
    dmo:name "Type 2 Diabetes in Adolescents and Youth" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "Adolescence" ;
    dmo:evidenceQuote "The TODAY studies, both funded by NIDDK, show the importance of early, intensive treatment and blood glucose management for children or adolescents diagnosed with type 2 diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Replaces or supplements insulin in the body to lower blood glucose levels" ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If you have type 1 diabetes, your health care team may ask you to check your urine at home for substances called ketones. A large amount of ketones in your urine may mean that you need to manage your diabetes more carefully. Work with your primary health care professional—who may be a doctor, physician assistant, or nurse practitioner—to change your diabetes care plan. If high levels of ketones are left untreated, you may develop a dangerous condition called diabetic ketoacidosis External link." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/labTest/a1c-blood-glucose-test> a dmo:LabTest ;
    rdfs:label "A1C blood glucose test" ;
    dmo:definition "The A1C test shows your average blood glucose level over the last 3 months." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "a1c-blood-glucose-test" ;
    dmo:loincCode "4548-4" ;
    dmo:name "A1C blood glucose test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "The A1C test shows your average blood glucose level over the last 3 months." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/labTest/a1c-test> a dmo:LabTest ;
    rdfs:label "A1C test" ;
    dmo:definition "A blood test that measures your average blood glucose level over the past 2 to 3 months." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "a1c-test" ;
    dmo:loincCode "4548-4" ;
    dmo:name "A1C test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "You do not get the same level of detail from blood tests—such as the A1C test—that you take at a health care professional’s office." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/labTest/cholesterol-test> a dmo:LabTest ;
    rdfs:label "cholesterol test" ;
    dmo:definition "Cholesterol is a fat, also called lipid, that is produced by your liver. Unhealthy levels of cholesterol in your blood can build up and clog your blood vessels, which may result in a heart attack or a stroke." ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "cholesterol-test" ;
    dmo:loincCode "2085-9" ;
    dmo:name "cholesterol test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Ask your health care team how often you need a cholesterol test NIH external link, also called a lipid panel, and what your cholesterol level should be." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/labTest/urine-ketones> a dmo:LabTest ;
    rdfs:label "Urine Ketones" ;
    dmo:definition "Substances in the urine that indicate the body is breaking down fat for energy, which can happen when there is not enough insulin." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-ketones" ;
    dmo:loincCode "2339-0" ;
    dmo:name "Urine Ketones" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "trace / small / moderate / large" ;
    dmo:evidenceQuote "If you have type 1 diabetes, your health care team may ask you to check your urine at home for substances called ketones. A large amount of ketones in your urine may mean that you need to manage your diabetes more carefully." ;
    dmo:evidenceQuote "Your health care team may want you to check your urine for ketones if you have symptoms of diabetic ketoacidosis." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/lifestyleIntervention/create-a-healthy-meal-plan> a dmo:LifestyleIntervention ;
    rdfs:label "Create a healthy meal plan" ;
    dmo:expectedBenefit "may help keep your blood glucose, blood pressure, and cholesterol levels in the ranges recommended by your health care team" ;
    dmo:interventionCode "create-a-healthy-meal-plan" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Create a healthy meal plan" ;
    dmo:evidenceQuote "Create a healthy meal plan You may worry that having diabetes means going without foods you enjoy. The good news is that you can still eat your favorite foods, but you might need to eat smaller portions or enjoy them less often. Work with your health care team, which may include a registered dietitian or a diabetes educator, to create a meal plan that works for you." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/lifestyleIntervention/diabetes-meal-plan> a dmo:LifestyleIntervention ;
    rdfs:label "Diabetes meal plan" ;
    dmo:interventionCode "diabetes-meal-plan" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Diabetes meal plan" ;
    dmo:evidenceQuote "If you often have low blood glucose levels, you may need to change your diabetes meal plan, physical activity plan, or medicines." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/lifestyleIntervention/physical-activity> a dmo:LifestyleIntervention ;
    rdfs:label "Physical Activity" ;
