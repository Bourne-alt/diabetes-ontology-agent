<https://example.org/dmo/id/lifestyleIntervention/reach-and-maintain-a-healthy-weight> a dmo:LifestyleIntervention ;
    rdfs:label "Reach and maintain a healthy weight" ;
    dmo:activityTarget "To lose weight, you may need to consume fewer calories or get more physical activity." ;
    dmo:interventionCode "reach-and-maintain-a-healthy-weight" ;
    dmo:interventionType "WeightManagement" ;
    dmo:name "Reach and maintain a healthy weight" ;
    dmo:evidenceQuote "Reach and maintain a healthy weight If you are overweight or have obesity, ask your health care team how you can manage your weight. To lose weight, you may need to consume fewer calories or get more physical activity. Your health care team may also recommend medicines or surgery to help manage your weight." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/medication/statin> a dmo:Medication ;
    rdfs:label "Statin" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "false"^^xsd:boolean ;
    dmo:medicationCode "statin" ;
    dmo:name "Statin" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Some people may need to take a medicine called a statin External link, or another medicine, to lower their cholesterol for heart health." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/monitoringSchedule/a1c-blood-glucose-test> a dmo:MonitoringSchedule ;
    rdfs:label "A1C blood glucose test" ;
    dmo:appliesTo "For most people with diabetes" ;
