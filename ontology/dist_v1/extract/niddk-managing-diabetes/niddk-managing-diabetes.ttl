<https://example.org/dmo/id/device/artificial-pancreas> a dmo:Device ;
    rdfs:label "Artificial Pancreas" ;
    dmo:deviceCode "artificial-pancreas" ;
    dmo:deviceType "ArtificialPancreas" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Artificial Pancreas" ;
    dmo:evidenceQuote "Some people use a CGM as part of an artificial pancreas. An artificial pancreas is a system that mimics how a healthy pancreas controls blood glucose in the body. A CGM, an insulin pump, and a software program that shares information between the CGM and insulin pump make up the artificial pancreas." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/device/artificial-pancreas-system> a dmo:Device ;
    rdfs:label "Artificial Pancreas System" ;
    dmo:deviceCode "artificial-pancreas-system" ;
    dmo:deviceType "ArtificialPancreas" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Artificial Pancreas System" ;
    dmo:evidenceQuote "NIDDK supported research that helped scientists develop the first continuous glucose monitor (CGM) that was approved by the U.S. Food and Drug Administration (FDA) in 1999. CGMs, which are part of artificial pancreas systems, help people track glucose levels in real-time with fewer finger pricks." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/device/blood-glucose-meter> a dmo:Device ;
    rdfs:label "Blood Glucose Meter" ;
    dmo:deviceCode "blood-glucose-meter" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Blood Glucose Meter" ;
    dmo:evidenceQuote "You can check your blood glucose level at home with a blood glucose meter External link. The meter tests a drop of your blood, usually from a prick of your fingertip. The meter will show you how much glucose is in your blood at that moment." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

<https://example.org/dmo/id/device/continuous-glucose-monitor> a dmo:Device ;
    rdfs:label "Continuous Glucose Monitor" ;
    dmo:deviceCode "continuous-glucose-monitor" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Continuous Glucose Monitor" ;
    dmo:evidenceQuote "People who take insulin to manage their diabetes may benefit from using a continuous glucose monitor (CGM). A CGM uses a sensor in the tissue under your skin and shows changes in glucose levels throughout the day and night. Many CGM systems have alarms and warnings that let you know if your glucose level is too low or too high." ;
    dmo:evidenceQuote "CGMs, which are part of artificial pancreas systems, help people track glucose levels in real-time with fewer finger pricks." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-managing-diabetes> .

