    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "The oral glucose tolerance test (OGTT) helps doctors detect type 2 diabetes, prediabetes, and gestational diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/labTest/a1c> a dmo:LabTest ;
    rdfs:label "A1C" ;
    dmo:definition "A1C test results and blood glucose levels do not match, your doctor should consider that the A1C test may not be a reliable test for you." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "a1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "A1C" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "If your A1C test results and blood glucose levels do not match, your doctor should consider that the A1C test may not be a reliable test for you." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/labTest/a1c-test> a dmo:LabTest ;
    rdfs:label "A1C Test" ;
    dmo:definition "The A1C test is a blood test that provides your average levels of blood glucose over the last 3 months. Other names for the A1C test are hemoglobin A1C, HbA1C, glycated hemoglobin, and glycosylated hemoglobin test. You can eat and drink before this test. Before using the A1C test to diagnose diabetes, your doctor will consider factors, such as whether you are in your second or third trimester of pregnancy or whether you have certain types of anemia NIH external link or another problem with your blood.1 The A1C test might not be accurate in those cases." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "a1c-test" ;
    dmo:name "A1C Test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "The A1C test is a blood test that provides your average levels of blood glucose over the last 3 months. Other names for the A1C test are hemoglobin A1C, HbA1C, glycated hemoglobin, and glycosylated hemoglobin test. You can eat and drink before this test. Before using the A1C test to diagnose diabetes, your doctor will consider factors, such as whether you are in your second or third trimester of pregnancy or whether you have certain types of anemia NIH external link or another problem with your blood.1 The A1C test might not be accurate in those cases." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/labTest/fasting-plasma-glucose> a dmo:LabTest ;
    rdfs:label "Fasting Plasma Glucose" ;
    dmo:definition "Before the test, you will need to fast for at least 8 hours. A health care professional will take a blood sample to measure your glucose level after fasting." ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "fasting-plasma-glucose" ;
    dmo:loincCode "15577-6" ;
    dmo:name "Fasting Plasma Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Before the test, you will need to fast for at least 8 hours. A health care professional will take a blood sample to measure your glucose level after fasting." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/labTest/fasting-plasma-glucose-test> a dmo:LabTest ;
    rdfs:label "Fasting Plasma Glucose Test" ;
    dmo:definition "The fasting plasma glucose (FPG) test measures your blood glucose level at a single point in time. For the most reliable results, your doctor will give you the test in the morning after you have fasted for at least 8 hours. Fasting means having nothing to eat or drink except sips of water." ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "fasting-plasma-glucose-test" ;
    dmo:name "Fasting Plasma Glucose Test" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "The fasting plasma glucose (FPG) test measures your blood glucose level at a single point in time. For the most reliable results, your doctor will give you the test in the morning after you have fasted for at least 8 hours. Fasting means having nothing to eat or drink except sips of water." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/labTest/glucose-challenge-test> a dmo:LabTest ;
    rdfs:label "Glucose Challenge Test" ;
    dmo:definition "In this test, a health care professional will take a sample of your blood 1 hour after you drink a sweet liquid containing glucose." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "glucose-challenge-test" ;
    dmo:loincCode "15580-0" ;
    dmo:name "Glucose Challenge Test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "In this test, a health care professional will take a sample of your blood 1 hour after you drink a sweet liquid containing glucose." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/labTest/oral-glucose-tolerance-test> a dmo:LabTest ;
    rdfs:label "Oral Glucose Tolerance Test" ;
    dmo:definition "The oral glucose tolerance test (OGTT) helps doctors detect type 2 diabetes, prediabetes, and gestational diabetes." ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "oral-glucose-tolerance-test" ;
    dmo:loincCode "15578-4" ;
    dmo:name "Oral Glucose Tolerance Test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "The oral glucose tolerance test (OGTT) helps doctors detect type 2 diabetes, prediabetes, and gestational diabetes. However, the OGTT is a more expensive test than the FPG test and the glucose challenge test, and it is not as easy to give." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/labTest/oral-glucose-tolerance-test-2h> a dmo:LabTest ;
    rdfs:label "Oral Glucose Tolerance Test-2h" ;
    dmo:definition "Another blood sample is taken 2 hours later to check your blood glucose level." ;
