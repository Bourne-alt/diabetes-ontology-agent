    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/diabetesType/prediabetes> a dmo:DiabetesType ;
    rdfs:label "Prediabetes" ;
    dmo:definition "If your blood glucose levels are higher than the target range, but not high enough to be diagnosed with diabetes, doctors will diagnose you with prediabetes. Having prediabetes is serious because it raises the chance of developing type 2 diabetes." ;
    dmo:diabetesTypeCode "prediabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005150" ;
    dmo:name "Prediabetes" ;
    dmo:prevalenceShare "0.15"^^xsd:decimal ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "If your blood glucose levels are higher than the target range, but not high enough to be diagnosed with diabetes, doctors will diagnose you with prediabetes. Having prediabetes is serious because it raises the chance of developing type 2 diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/diabetesType/type-1-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 1 Diabetes" ;
    dmo:definition "If you have diabetes, your doctor may look for certain autoantibodies to see if your diabetes is type 1. Autoantibodies are proteins in your immune system that mistakenly attack your healthy tissues and cells." ;
    dmo:diabetesTypeCode "type-1-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 1 Diabetes" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "If you have diabetes, your doctor may look for certain autoantibodies to see if your diabetes is type 1." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:definition "The oral glucose tolerance test (OGTT) helps doctors detect type 2 diabetes, prediabetes, and gestational diabetes." ;
