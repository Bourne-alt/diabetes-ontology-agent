<https://example.org/dmo/id/contraindication/a1c-test-in-presence-of-another-problem-with-your-blood> a dmo:Contraindication ;
    rdfs:label "A1C test in presence of another problem with your blood" ;
    dmo:contraCode "a1c-test-in-presence-of-another-problem-with-your-blood" ;
    dmo:rationale "Before using the A1C test to diagnose diabetes, your doctor will consider factors, such as whether you are in your second or third trimester of pregnancy or whether you have certain types of anemia NIH external link or another problem with your blood." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "you have another problem with your blood" ;
    dmo:evidenceQuote "Before using the A1C test to diagnose diabetes, your doctor will consider factors, such as whether you are in your second or third trimester of pregnancy or whether you have certain types of anemia NIH external link or another problem with your blood." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

