<https://example.org/dmo/id/diabetesType/gestational-diabetes> a dmo:DiabetesType ;
    rdfs:label "Gestational Diabetes" ;
    dmo:definition "All pregnant women who do not have a previous diagnosis of diabetes should be tested for gestational diabetes between 24 and 28 weeks of pregnancy." ;
    dmo:diabetesTypeCode "gestational-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005149" ;
    dmo:name "Gestational Diabetes" ;
    dmo:prevalenceShare "0.07"^^xsd:decimal ;
    dmo:typicalOnset "Pregnancy" ;
    dmo:evidenceQuote "All pregnant women who do not have a previous diagnosis of diabetes should be tested for gestational diabetes between 24 and 28 weeks of pregnancy." ;
    dmo:evidenceQuote "If you are pregnant, your doctor might test you for gestational diabetes with the glucose challenge test." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-tests-diagnosis> .

<https://example.org/dmo/id/diabetesType/monogenic-diabetes> a dmo:DiabetesType ;
    rdfs:label "Monogenic Diabetes" ;
    dmo:definition "Genetic testing can diagnose most forms of monogenic diabetes, which is caused by a change—or mutation—in a gene." ;
    dmo:diabetesTypeCode "monogenic-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005150" ;
