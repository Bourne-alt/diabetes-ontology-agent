<https://example.org/dmo/id/labTest/fasting-blood-glucose> a dmo:LabTest ;
    rdfs:label "Fasting Blood Glucose" ;
    dmo:definition "Fasting blood glucose is a measure of blood glucose after an overnight fast and is used to assess glycemic status in patients with diabetes or prediabetes." ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "fasting-blood-glucose" ;
    dmo:loincCode "15577-2" ;
    dmo:name "Fasting Blood Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "In adults with prediabetes, we suggest aerobic exercise (such as walking 8–9 miles a week) and healthy eating (with a goal weight loss >3%) to achieve a reduction in body fat mass, weight loss, and improvement in fasting blood glucose." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-quick-reference-guide_final_508> .

<https://example.org/dmo/id/labTest/glycemic-variability> a dmo:LabTest ;
    rdfs:label "Glycemic Variability" ;
    dmo:definition "Glycemic variability refers to the fluctuations in blood glucose levels over time, which can be assessed through HbA1c or fasting blood glucose measurements, and is used as a prognostic indicator for hypoglycemia, morbidity, and mortality." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "glycemic-variability" ;
    dmo:loincCode "94575-5" ;
    dmo:name "Glycemic Variability" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "fluctuation in HbA1c or fasting blood glucose" ;
    dmo:evidenceQuote "For adults with type 2 diabetes mellitus, we suggest using high glycemic variability over time (e.g., fluctuation in HbA1c or fasting blood glucose) as a prognostic indicator for risk of hypoglycemia, morbidity, and mortality." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-quick-reference-guide_final_508> .

<https://example.org/dmo/id/labTest/hba1c> a dmo:LabTest ;
    rdfs:label "HbA1c" ;
    dmo:definition "HbA1c is a measure of average blood glucose levels over the past 2–3 months and is used to assess long-term glycemic control in patients with diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "HbA1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "We suggest an HbA1c range of 7.0–8.5% for most patients, if it can be safely achieved." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-quick-reference-guide_final_508> .

