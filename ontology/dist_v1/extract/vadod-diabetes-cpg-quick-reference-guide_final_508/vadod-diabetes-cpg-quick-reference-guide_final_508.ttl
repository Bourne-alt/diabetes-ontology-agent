<https://example.org/dmo/id/riskFactor/advanced-age> a dmo:RiskFactor ;
    rdfs:label "Advanced Age" ;
    dmo:evidenceNote "Advanced age is a non-modifiable risk factor for type 2 diabetes mellitus, as it is considered in evaluating patient characteristics for pharmacotherapy in prediabetes." ;
    dmo:name "Advanced Age" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "advanced-age" ;
    dmo:evidenceQuote "In adults with prediabetes who have participated in healthy lifestyle modification and remain at high risk for progression to type 2 diabetes mellitus, we suggest evaluating patient characteristics (e.g., age, life expectancy, co-occurring conditions, BMI, other risk factors) and offering metformin or other select medications to reduce the risk of progression from prediabetes to type 2 diabetes mellitus." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-quick-reference-guide_final_508> .

