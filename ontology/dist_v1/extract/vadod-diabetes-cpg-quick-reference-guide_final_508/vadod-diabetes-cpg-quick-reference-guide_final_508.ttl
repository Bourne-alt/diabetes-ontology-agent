    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "co-occurring-conditions" ;
    dmo:evidenceQuote "In adults with prediabetes who have participated in healthy lifestyle modification and remain at high risk for progression to type 2 diabetes mellitus, we suggest evaluating patient characteristics (e.g., age, life expectancy, co-occurring conditions, BMI, other risk factors) and offering metformin or other select medications to reduce the risk of progression from prediabetes to type 2 diabetes mellitus." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-quick-reference-guide_final_508> .

<https://example.org/dmo/id/riskFactor/high-bmi> a dmo:RiskFactor ;
    rdfs:label "High BMI" ;
    dmo:evidenceNote "High BMI is a modifiable risk factor for type 2 diabetes mellitus, as weight loss is recommended in adults with prediabetes to reduce body fat mass." ;
    dmo:name "High BMI" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "high-bmi" ;
    dmo:evidenceQuote "In adults with prediabetes, we suggest aerobic exercise (such as walking 8–9 miles a week) and healthy eating (with a goal weight loss >3%) to achieve a reduction in body fat mass, weight loss, and improvement in fasting blood glucose." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-quick-reference-guide_final_508> .

<https://example.org/dmo/id/riskFactor/obesity> a dmo:RiskFactor ;
    rdfs:label "Obesity" ;
    dmo:evidenceNote "Obesity is a modifiable risk factor for type 2 diabetes mellitus, as weight loss is recommended in adults with prediabetes to reduce body fat mass and improve fasting blood glucose." ;
    dmo:name "Obesity" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "obesity" ;
    dmo:evidenceQuote "In adults with prediabetes, we suggest aerobic exercise (such as walking 8–9 miles a week) and healthy eating (with a goal weight loss >3%) to achieve a reduction in body fat mass, weight loss, and improvement in fasting blood glucose." ;
