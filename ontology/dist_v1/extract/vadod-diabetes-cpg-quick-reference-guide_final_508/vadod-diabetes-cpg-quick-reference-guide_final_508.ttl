<https://example.org/dmo/id/recommendation/use-high-glycemic-variability-as-prognostic-indicator> a dmo:Recommendation ;
    rdfs:label "Use High Glycemic Variability as Prognostic Indicator" ;
    dmo:gradingSystem "VA-DoD" ;
    dmo:nativeEvidenceGrade "Weak" ;
    dmo:populationScope "adults with type 2 diabetes mellitus" ;
    dmo:recommendationId "use-high-glycemic-variability-as-prognostic-indicator" ;
    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "For adults with type 2 diabetes mellitus, we suggest using high glycemic variability over time (e.g., fluctuation in HbA1c or fasting blood glucose) as a prognostic indicator for risk of hypoglycemia, morbidity, and mortality." ;
