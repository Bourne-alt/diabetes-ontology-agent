<https://example.org/dmo/id/diabetesType/prediabetes> a dmo:DiabetesType ;
    rdfs:label "Prediabetes" ;
    dmo:definition "In adults with prediabetes, we suggest aerobic exercise (such as walking 8–9 miles a week) and healthy eating (with a goal weight loss >3%) to achieve a reduction in body fat mass, weight loss, and improvement in fasting blood glucose." ;
    dmo:diabetesTypeCode "prediabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:name "Prediabetes" ;
    dmo:prevalenceShare "0"^^xsd:integer ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "In adults with prediabetes, we suggest aerobic exercise (such as walking 8–9 miles a week) and healthy eating (with a goal weight loss >3%) to achieve a reduction in body fat mass, weight loss, and improvement in fasting blood glucose." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-quick-reference-guide_final_508> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes-mellitus> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes Mellitus" ;
    dmo:definition "In adults with type 2 diabetes mellitus, we suggest offering health care delivered through telehealth interventions to improve outcomes." ;
    dmo:diabetesTypeCode "type-2-diabetes-mellitus" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 2 Diabetes Mellitus" ;
    dmo:prevalenceShare "0"^^xsd:integer ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "In adults with type 2 diabetes mellitus, we suggest offering health care delivered through telehealth interventions to improve outcomes." ;
    dmo:evidenceQuote "For adults with type 2 diabetes mellitus, we suggest a vegetarian dietary pattern for glycemic control and weight loss." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-quick-reference-guide_final_508> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin is a hormone that facilitates the uptake of glucose into cells, thereby lowering blood glucose levels." ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "In adults with type 2 diabetes mellitus, especially those 65 years and older, we suggest prioritizing drug classes other than insulin, sulfonylureas, or meglitinides to minimize the risk of hypoglycemia, if glycemic control can be achieved with other treatments." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-quick-reference-guide_final_508> .

<https://example.org/dmo/id/drugClass/meglitinides> a dmo:DrugClass ;
    rdfs:label "Meglitinides" ;
    dmo:drugClassCode "meglitinides" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Meglitinides are a class of oral hypoglycemic agents that stimulate insulin secretion from pancreatic beta cells, primarily in response to meals." ;
    dmo:name "Meglitinides" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "In adults with type 2 diabetes mellitus, especially those 65 years and older, we suggest prioritizing drug classes other than insulin, sulfonylureas, or meglitinides to minimize the risk of hypoglycemia, if glycemic control can be achieved with other treatments." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-quick-reference-guide_final_508> .

<https://example.org/dmo/id/drugClass/sulfonylureas> a dmo:DrugClass ;
    rdfs:label "Sulfonylureas" ;
    dmo:drugClassCode "sulfonylureas" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Sulfonylureas are a class of oral hypoglycemic agents that stimulate insulin secretion from pancreatic beta cells." ;
    dmo:name "Sulfonylureas" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "In adults with type 2 diabetes mellitus, especially those 65 years and older, we suggest prioritizing drug classes other than insulin, sulfonylureas, or meglitinides to minimize the risk of hypoglycemia, if glycemic control can be achieved with other treatments." ;
