<https://example.org/dmo/id/labTest/blood-glucose> a dmo:LabTest ;
    rdfs:label "Blood glucose" ;
    dmo:definition "A measure of the concentration of glucose in the blood, used to assess acute glycaemic status." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-glucose" ;
    dmo:loincCode "15577-6" ;
    dmo:name "Blood glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Hypoglycaemia is defined as blood glucose <4 mmol/L." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/labTest/blood-ketones> a dmo:LabTest ;
    rdfs:label "Blood ketones" ;
    dmo:definition "A measure of ketone bodies in the blood, used to assess risk of diabetic ketoacidosis (DKA)." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-ketones" ;
    dmo:loincCode "57690-0" ;
    dmo:name "Blood ketones" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Check blood ketones if unwell or blood glucose >11 mmol/L (risk of DKA)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/labTest/hba1c> a dmo:LabTest ;
    rdfs:label "HbA1c" ;
    dmo:definition "A measure of average blood glucose levels over the past 2-3 months, used to assess long-term glycaemic control." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "HbA1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/mol" ;
    dmo:evidenceQuote "Target pre-operative HbA1c <69 mmol/mol (<8.5%) if safe to do so." ;
    dmo:evidenceQuote "HbA1c to be measured and communicated to the specialist metabolic-bariatric surgery MDT coordinator prior to the individual being listed for surgery (within 3 month(s). HbA1c should ideally be 69 mmol/mol (<8.5%) (5)" ;
    dmo:evidenceQuote "The specialist metabolic-bariatric surgical MDT/GP/Diabetes car e provider should check HbA1c at 3, 6 and 12 months." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/labTest/urine-ketones> a dmo:LabTest ;
    rdfs:label "Urine Ketones" ;
    dmo:definition "A test to detect ketones in urine, used to monitor for diabetic ketoacidosis (DKA), especially in individuals with type 1 diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-ketones" ;
    dmo:loincCode "15514-0" ;
    dmo:name "Urine Ketones" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "trace / 1+ / 2+ / 3+ / 4+" ;
    dmo:evidenceQuote "The provision of a ketone testing kit and a form of continuous glucose monitoring. Liaise with the diabetes team." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

