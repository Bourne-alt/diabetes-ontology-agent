<https://example.org/dmo/id/diabetesType/type-1-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 1 Diabetes" ;
    dmo:definition "Hypoglycaemia is defined as blood glucose <4 mmol/L. Prevention and management of hypoglycaemia must be considered when planning and during the perioperative and postoperative phases of surgery in all those at risk (on insulin and insulin secretagogues)" ;
    dmo:diabetesTypeCode "type-1-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "Type 1 Diabetes" ;
    dmo:prevalenceShare "0.1"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "Hypoglycaemia is defined as blood glucose <4 mmol/L. Prevention and management of hypoglycaemia must be considered when planning and during the perioperative and postoperative phases of surgery in all those at risk (on insulin and insulin secretagogues)" ;
    dmo:evidenceQuote "If using insulin pump/hybrid closed loop system, seek specialist diabetes advice for an individualised care plan." ;
    dmo:evidenceQuote "Individuals with type 1 diabetes require review by the Diabetes-Bariatric Physician." ;
    dmo:evidenceQuote "Individuals with type 1 diabetes could liaise with diabetes teams to adjust further to achieve/maintain optimal diabetes control" ;
    dmo:evidenceQuote "For individuals with type 1 diabetes: insulin must never be stopped as this expose them to the risk of DKA." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:definition "The role of metabolic-bariatric surgery as effective interventions for obesity and type 2 diabetes is well recognised, particularly in achieving type 2 diabetes remission or improvement in glycaemic control, treatment impact and improvements in associated complications" ;
    dmo:diabetesTypeCode "type-2-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 2 Diabetes" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "The role of metabolic-bariatric surgery as effective interventions for obesity and type 2 diabetes is well recognised, particularly in achieving type 2 diabetes remission or improvement in glycaemic control, treatment impact and improvements in associated complications" ;
    dmo:evidenceQuote "Refer to obesity/specialist metabolic bariatric surgery MDT. Document type of diabetes." ;
    dmo:evidenceQuote "Type 2 diabetes - Insulin-based therapy agents during the liver reduction diet (LRD)" ;
    dmo:evidenceQuote "Individuals on insulin therapy should be discussed with and/or reviewed by the Diabetes-Bariatric Physician/Nurse. There is no set rule for insulin needs following metabolic-bariatric surgery(4)." ;
    dmo:evidenceQuote "If type 2 diabetes remission is achieved following surgery, a recommendation should be made for an annual HbA1c and routine microvascular/macrovascular screening as this group is at high-risk of type 2 diabetes relapse and complications." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/basal-insulin-regimens> a dmo:DrugClass ;
    rdfs:label "Basal insulin regimens" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "basal-insulin-regimens" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides a steady background level of insulin to control fasting glucose" ;
    dmo:name "Basal insulin regimens" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Reduce dose by 35-50% of pre-liver reduction diet (LRD) dose. Consider further reduction or discontinuation in those with type 2 diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/biguanide> a dmo:DrugClass ;
    rdfs:label "Biguanide" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "biguanide" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Improves insulin sensitivity and reduces hepatic glucose production" ;
    dmo:name "Biguanide" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Biguanide Metformin Can be restarted" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/dipeptidyl-peptidase-4-inhibitors> a dmo:DrugClass ;
    rdfs:label "Dipeptidyl peptidase-4 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "dipeptidyl-peptidase-4-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibits DPP-4 enzyme, increasing active GLP-1 levels" ;
    dmo:name "Dipeptidyl peptidase-4 inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Discontinue. Can be restarted if there is a need to optimise glycaemic control or there is intolerance of metformin" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/dpp-4-inhibitors> a dmo:DrugClass ;
    rdfs:label "DPP-4 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "dpp-4-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibit dipeptidyl peptidase-4, increasing active GLP-1 levels" ;
    dmo:name "DPP-4 inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "DPP-4 inhibitors Continue Discontinue" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/glp-1-based-therapies> a dmo:DrugClass ;
    rdfs:label "GLP-1 based therapies" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "glp-1-based-therapies" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Activate glucagon-like peptide-1 receptors, enhancing glucose-dependent insulin secretion and suppressing glucagon" ;
    dmo:name "GLP-1 based therapies" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "GLP-1 based therapies Continue Discontinue" ;
    dmo:evidenceQuote "The recent consensus statement of the Association of Anaesthetists, Association of British Clinical Diabetologists, British Obesity and Metabolic Surgery Society, Centre for Perioperative Care, Joint British Diabetes Societies for Inpatient Care, Royal College of Anaesthetists, Society for Obesity and Bariatric Anaesthesia and UK Clinical Pharmacy Association included specific recommendations for the peri-operative management of patients taking GLP-1 based therapies to avoid pulmonary aspiration (9)." ;
    dmo:evidenceQuote "Discontinue. May result in GI related side effects (nausea, vomiting). However, this could be restarted with diabetes team advice" ;
    dmo:evidenceQuote "Reintroduction of GLP-1 based therapies may be appropriate for ongoing management of glycaemic control, excess weight and cardiovascular risk. Seek specialist diabetes advice." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10A" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Directly lowers blood glucose by promoting glucose uptake in muscle and fat and inhibiting hepatic glucose production" ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Do NOT stop insulin (risk of DKA)." ;
    dmo:evidenceQuote "Discontinue at start of LRD" ;
    dmo:evidenceQuote "Individuals with type 1 diabetes must not have their insulin discontinued, as they will develop diabetic ketoacidosis (DKA). This may occur in up to 25% of cases following metabolic-bariatric surgery." ;
    dmo:evidenceQuote "Do not stop insulin; risk of DKA." ;
    dmo:evidenceQuote "For individuals with type 1 diabetes: insulin must never be stopped as this expose them to the risk of DKA." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/meglitinides> a dmo:DrugClass ;
    rdfs:label "Meglitinides" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "meglitinides" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Not specified in the document" ;
    dmo:name "Meglitinides" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Sulfonylureas, meglitinides and sodium glucose transporter-2 (SGLT2) inhibitors should be discontinued." ;
    dmo:evidenceQuote "Discontinue at start of LRD" ;
    dmo:evidenceQuote "Discontinue. Risk of hypoglycaemia" ;
    dmo:evidenceQuote "It is also important to check for the occurrence of and frequency of hypoglycaemia when conducting reviews in the postoperative phase for all individuals with diabetes on sulfonylurea, meglitinides or insulin therapies." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/metformin> a dmo:DrugClass ;
    rdfs:label "Metformin" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Decreases hepatic glucose production and improves insulin sensitivity" ;
    dmo:name "Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Metformin Continue Restart immediate-release if pre-op HbA1c ≥58 mmol/mol" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/premixed-insulin-regimens> a dmo:DrugClass ;
    rdfs:label "Premixed insulin regimens" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "premixed-insulin-regimens" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Combines short-acting and intermediate-acting insulin to cover both mealtime and background insulin needs" ;
    dmo:name "Premixed insulin regimens" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Reduce dose by 35-50% of pre-LRD dose. Consider further reduction or discontinuation in those with type 2 diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/sglt2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT2 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "sglt2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibit sodium-glucose co-transporter 2 in the kidneys, promoting urinary glucose excretion" ;
    dmo:name "SGLT2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "SGLT2 inhibitors Discontinue. Seek advice if additional indication (e.g. CKD, heart failure)" ;
    dmo:evidenceQuote "Sulfonylureas, meglitinides and sodium glucose transporter-2 (SGLT2) inhibitors should be discontinued." ;
    dmo:evidenceQuote "Discontinue at start of LRD" ;
    dmo:evidenceQuote "Discontinue. Risk of euglycaemic ketoacidosis" ;
    dmo:evidenceQuote "For those with type 2 diabetes and risk factors for (or existing) diabetes complications, ensure agents with added benefits of cardiovascular and renal protection are used (e.g. SGLT2 inhibitors)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds-21-metabolic-bariatric-surgery-march-2026> .

<https://example.org/dmo/id/drugClass/sulfonylurea> a dmo:DrugClass ;
