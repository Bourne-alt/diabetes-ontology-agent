    dmo:evidenceQuote "High levels of blood glucose can harm your heart, blood vessels, kidneys, feet, and eyes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-cardiovascular-disease> .

<https://example.org/dmo/id/riskFactor/high-blood-pressure> a dmo:RiskFactor ;
    rdfs:label "High Blood Pressure" ;
    dmo:evidenceNote "High blood pressure can cause a heart attack or stroke and damage your kidneys and eyes." ;
    dmo:name "High Blood Pressure" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "high-blood-pressure" ;
    dmo:evidenceQuote "High blood pressure can cause a heart attack or stroke and damage your kidneys and eyes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-cardiovascular-disease> .

<https://example.org/dmo/id/riskFactor/high-cholesterol> a dmo:RiskFactor ;
