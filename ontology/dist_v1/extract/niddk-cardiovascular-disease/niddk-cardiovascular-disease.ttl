<https://example.org/dmo/id/riskFactor/male-sex> a dmo:RiskFactor ;
    rdfs:label "Male Sex" ;
    dmo:evidenceNote "Your risk for heart disease is greater if you are male rather than female, whether you have diabetes or not." ;
    dmo:name "Male Sex" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "male-sex" ;
    dmo:evidenceQuote "Your risk for heart disease is greater if you are male rather than female, whether you have diabetes or not." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-cardiovascular-disease> .

<https://example.org/dmo/id/riskFactor/obesity-and-belly-fat> a dmo:RiskFactor ;
    rdfs:label "Obesity and Belly Fat" ;
    dmo:evidenceNote "Being overweight or having obesity can make it harder to manage your diabetes and raise your risk for many health problems, including heart disease and high blood pressure. If you are overweight, a healthy eating plan with fewer calories and more physical activity often will lower your blood glucose levels and reduce your need for medicines. Excess belly fat around your waist, even if you are not overweight, can raise your chances of developing heart disease." ;
    dmo:name "Obesity and Belly Fat" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "obesity-and-belly-fat" ;
    dmo:evidenceQuote "Being overweight or having obesity can make it harder to manage your diabetes and raise your risk for many health problems, including heart disease and high blood pressure. If you are overweight, a healthy eating plan with fewer calories and more physical activity often will lower your blood glucose levels and reduce your need for medicines. Excess belly fat around your waist, even if you are not overweight, can raise your chances of developing heart disease." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-cardiovascular-disease> .

<https://example.org/dmo/id/riskFactor/physical-inactivity> a dmo:RiskFactor ;
    rdfs:label "Physical Inactivity" ;
    dmo:evidenceNote "Physical activity can help you manage your diabetes and may help you cope with stress." ;
    dmo:name "Physical Inactivity" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "physical-inactivity" ;
    dmo:evidenceQuote "Physical activity can help you manage your diabetes and may help you cope with stress." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-cardiovascular-disease> .

<https://example.org/dmo/id/riskFactor/smoking> a dmo:RiskFactor ;
    rdfs:label "Smoking" ;
    dmo:evidenceNote "Smoking raises your risk of developing heart disease. If you have diabetes, it is important to stop smoking, because both smoking and diabetes narrow blood vessels." ;
    dmo:name "Smoking" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "smoking" ;
    dmo:evidenceQuote "Smoking raises your risk of developing heart disease. If you have diabetes, it is important to stop smoking, because both smoking and diabetes narrow blood vessels." ;
    dmo:evidenceQuote "If you quit smoking you will lower your risk for heart attack; stroke; nerve, kidney, and eye disease; and amputation" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/niddk-cardiovascular-disease> .

