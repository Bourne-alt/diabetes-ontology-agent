<https://example.org/dmo/id/recommendation/evaluation-and-use-of-metformin-or-other-select-medications-for-adults-with-prediabetes> a dmo:Recommendation ;
    rdfs:label "Evaluation and Use of Metformin or Other Select Medications for Adults with Prediabetes" ;
    dmo:gradingSystem "VA-DoD" ;
    dmo:nativeEvidenceGrade "Weak" ;
    dmo:populationScope "Adults with prediabetes who have participated in healthy lifestyle modification and remain at high risk for progression to type 2 diabetes mellitus" ;
    dmo:recommendationId "evaluation-and-use-of-metformin-or-other-select-medications-for-adults-with-prediabetes" ;
    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "In adults with prediabetes who have participated in healthy lifestyle modification and remain at high risk for progression to type 2 diabetes mellitus, we suggest evaluating patient characteristics (e.g., age, life expectancy, co-occurring conditions, BMI, other risk factors) and offering metformin or other select medications to reduce the risk of progression from prediabetes to type 2 diabetes mellitus." ;
    dmo:evidenceQuote "In adults with prediabetes who have participated in healthy lifestyle modification and remain at high risk for progression to type 2 diabetes mellitus, we suggest evaluating patient characteristics (e.g., age, life expectancy, co-occurring conditions, BMI, other risk factors) and offering metformin or other select medications to reduce the risk of progression from prediabetes to type 2 diabetes mellitus." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

