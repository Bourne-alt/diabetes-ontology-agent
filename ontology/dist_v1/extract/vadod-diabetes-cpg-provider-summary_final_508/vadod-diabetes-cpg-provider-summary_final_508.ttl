<https://example.org/dmo/id/recommendation/collaborative-management-of-co-occurring-conditions> a dmo:Recommendation ;
    rdfs:label "Collaborative Management of Co-occurring Conditions" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients with Type 2 Diabetes Mellitus and co-occurring conditions" ;
    dmo:recommendationId "collaborative-management-of-co-occurring-conditions" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Because T2DM is sometimes accompanied by co-occurring conditions, managing T2DM collaboratively with other care providers is often best. Some co-occurring conditions might require early specialist consultation to determine necessary changes in treatment or to establish a common understanding of how care will be coordinated." ;
    dmo:evidenceQuote "Because T2DM is sometimes accompanied by co-occurring conditions, managing T2DM collaboratively with other care providers is often best. Some co-occurring conditions might require early specialist consultation to determine necessary changes in treatment or to establish a common understanding of how care will be coordinated." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

