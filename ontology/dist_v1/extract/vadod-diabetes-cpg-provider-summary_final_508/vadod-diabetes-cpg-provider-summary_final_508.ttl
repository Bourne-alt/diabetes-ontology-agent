    dmo:triggerCriteria "Increased risk for frequent or serious genitourinary infections" ;
    dmo:evidenceQuote "• Increased risk for frequent or serious genitourinary infections" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/contraindication/may-continue-at-reduced-dose-if-egfr-45> a dmo:Contraindication ;
    rdfs:label "May continue at reduced dose if eGFR <45" ;
