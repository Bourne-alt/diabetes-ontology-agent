<https://example.org/dmo/id/recommendation/discourage-medication-changes-in-response-to-a-single-hba1c-test> a dmo:Recommendation ;
    rdfs:label "Discourage medication changes in response to a single HbA1c test" ;
    dmo:recommendationId "discourage-medication-changes-in-response-to-a-single-hba1c-test" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
