    dmo:rationale "Increased risk of lactic acidosis (especially in setting of acute HF, dehydration, excessive alcohol intake, renal impairment, sepsis)" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "eGFR <45" ;
    dmo:evidenceQuote "Contraindicated eGFR <30; may continue at reduced dose, but do not initiate if eGFR <45" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

