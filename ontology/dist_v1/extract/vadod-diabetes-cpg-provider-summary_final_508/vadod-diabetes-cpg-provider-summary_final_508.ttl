<https://example.org/dmo/id/recommendation/consider-addition-of-sodium-glucose-cotransporter-2-inhibitor-or-glucagon-like-peptide-1-receptor-agonist-in-adults-with-type-2-diabetes-mellitus-who-have-cardiovascular-disease-or-renal-disease> a dmo:Recommendation ;
    rdfs:label "Consider addition of sodium-glucose cotransporter-2 inhibitor or glucagon-like peptide-1 receptor agonist in adults with type 2 diabetes mellitus who have cardiovascular disease or renal disease" ;
    dmo:gradingSystem "VA-DoD" ;
    dmo:nativeEvidenceGrade "Weak" ;
    dmo:populationScope "adults with type 2 diabetes mellitus who have cardiovascular disease or renal disease" ;
    dmo:recommendationId "consider-addition-of-sodium-glucose-cotransporter-2-inhibitor-or-glucagon-like-peptide-1-receptor-agonist-in-adults-with-type-2-diabetes-mellitus-who-have-cardiovascular-disease-or-renal-disease" ;
    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "In adults with type 2 diabetes mellitus who have cardiovascular disease or renal disease, we suggest that the addition of a sodium-glucose cotransporter-2 inhibitor or glucagon-like peptide-1 receptor agonist be considered, even if the patient has already achieved their individualized target range for glycemic control." ;
    dmo:evidenceQuote "In adults with type 2 diabetes mellitus who have cardiovascular disease or renal disease, we suggest that the addition of a sodium-glucose cotransporter-2 inhibitor or glucagon-like peptide-1 receptor agonist be considered, even if the patient has already achieved their individualized target range for glycemic control." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

