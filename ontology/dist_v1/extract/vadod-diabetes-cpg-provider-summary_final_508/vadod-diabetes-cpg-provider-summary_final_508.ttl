<https://example.org/dmo/id/contraindication/proliferative-diabetic-retinopathy-semaglutide> a dmo:Contraindication ;
    rdfs:label "Proliferative Diabetic Retinopathy (semaglutide)" ;
    dmo:contraCode "proliferative-diabetic-retinopathy-semaglutide" ;
    dmo:rationale "Proliferative Diabetic Retinopathy (semaglutide): This risk must be balanced against the risk of progressive retinopathy in the setting of persistent poor glycemic control." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Proliferative Diabetic Retinopathy (semaglutide)" ;
