    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/device/real-time-continuous-glucose-monitoring> a dmo:Device ;
    rdfs:label "Real-time continuous glucose monitoring" ;
    dmo:deviceCode "real-time-continuous-glucose-monitoring" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Real-time continuous glucose monitoring" ;
    dmo:evidenceQuote "In insulin-treated adults with type 2 diabetes mellitus who are not achieving glycemic goals, we suggest real-time continuous glucose monitoring to decrease hypoglycemia and improve HbA1c." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/diabetesType/latent-autoimmune-diabetes-of-adults> a dmo:DiabetesType ;
    rdfs:label "Latent autoimmune diabetes of adults" ;
    dmo:definition "referred to as latent autoimmune diabetes of adults (LADA)." ;
    dmo:diabetesTypeCode "latent-autoimmune-diabetes-of-adults" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005151" ;
    dmo:name "Latent autoimmune diabetes of adults" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "referred to as latent autoimmune diabetes of adults (LADA)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/diabetesType/prediabetes> a dmo:DiabetesType ;
    rdfs:label "Prediabetes" ;
    dmo:definition "Prediabetes" ;
    dmo:diabetesTypeCode "prediabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "Prediabetes" ;
    dmo:prevalenceShare "0.1"^^xsd:decimal ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "In adults with prediabetes, we suggest aerobic exercise (such as walking 8– 9 miles a week) and healthy eating (with a goal weight loss >3%) to achieve a reduction in body fat mass, weight loss, and improvement in fasting blood glucose." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/diabetesType/type-1-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 1 Diabetes" ;
    dmo:definition "Type 1 DM (T1DM) is due to deficient insulin production and secretion and can present across the lifespan, with older patients often having a more indolent presentation that has been referred to as latent autoimmune diabetes of adults (LADA)." ;
    dmo:diabetesTypeCode "type-1-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0001117" ;
    dmo:name "Type 1 Diabetes" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "Type 1 DM (T1DM) is due to deficient insulin production and secretion and can present across the lifespan, with older patients often having a more indolent presentation that has been referred to as latent autoimmune diabetes of adults (LADA)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:definition "The vast majority (~95%) of Americans with diabetes have T2DM." ;
    dmo:diabetesTypeCode "type-2-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 2 Diabetes" ;
    dmo:prevalenceShare "0.95"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "The vast majority (~95%) of Americans with diabetes have T2DM." ;
    dmo:evidenceQuote "T2DM is a major contributor to morbidity and mortality in the U.S. It is associated with a two-fold to four-fold increased risk for atherosclerotic CVD, resulting in substantial morbidity and mortality from coronary events." ;
    dmo:evidenceQuote "VA/DoD Clinical Practice Guideline for the Management of Type 2 Diabetes Mellitus – Provider Summary" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes-mellitus> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes Mellitus" ;
    dmo:definition "In contrast, Type 2 DM (T2DM) is due to progressive insulin deficiency on a background of insulin resistance." ;
    dmo:diabetesTypeCode "type-2-diabetes-mellitus" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0001513" ;
    dmo:name "Type 2 Diabetes Mellitus" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "In contrast, Type 2 DM (T2DM) is due to progressive insulin deficiency on a background of insulin resistance." ;
    dmo:evidenceQuote "VA/DoD Clinical Practice Guideline for the Management of Type 2 Diabetes Mellitus – Provider Summary" ;
    dmo:evidenceQuote "In adults with type 2 diabetes mellitus, we suggest offering health care delivered through telehealth interventions to improve outcomes." ;
    dmo:evidenceQuote "For adults with type 2 diabetes mellitus, we suggest a Mediterranean style diet to improve glycemic control, body weight, and hypertension." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/diabetesType/type-2-dm> a dmo:DiabetesType ;
    rdfs:label "Type 2 DM" ;
    dmo:definition "Type 2 DM (T2DM) is due to progressive insulin deficiency on a background of insulin resistance." ;
    dmo:diabetesTypeCode "type-2-dm" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 2 DM" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "Type 2 DM (T2DM) is due to progressive insulin deficiency on a background of insulin resistance." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/biguanide-metformin> a dmo:DrugClass ;
    rdfs:label "Biguanide (Metformin)" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA01" ;
    dmo:drugClassCode "biguanide-metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Improves insulin sensitivity and reduces hepatic glucose production." ;
    dmo:name "Biguanide (Metformin)" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Biguanide (Metformin) 1– 1.5% No Potential ASCVD benefit Neutral Neutral/ mild loss Contraindicated eGFR <30; may continue at reduced dose, but do not initiate if eGFR <45 Increased risk of lactic acidosis (especially in setting of acute HF, dehydration, excessive alcohol intake, renal impairment, sepsis) GI (diarrhea, nausea) Vitamin B12 deficiency; rarely associated with anemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/dpp4i> a dmo:DrugClass ;
    rdfs:label "DPP4i" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "dpp4i" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:name "DPP4i" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "DPP4i\n0.5– 1% No Neutral for \nASCVD risk, \npotential \nincreased risk \nof HF \n(saxagliptin)\nNeutral Neutral" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/gip-glp-1-agonist-tirzepatide> a dmo:DrugClass ;
    rdfs:label "GIP/GLP-1 agonist (Tirzepatide)" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "gip-glp-1-agonist-tirzepatide" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:name "GIP/GLP-1 agonist (Tirzepatide)" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "GIP/GLP-1 \nagonist \n(Tirzepatide)\n2– 2.5% No Neutral based \non available \nevidence \nProspective \nstudies to \nevaluate \nASCVD and \nHF outcomes \nare ongoing.\nNeutral based \non available \nevidence  \nVery high \nloss" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/glp-1-ra> a dmo:DrugClass ;
    rdfs:label "GLP-1 RA" ;
    dmo:drugClassCode "glp-1-ra" ;
    dmo:mechanism "Glucagon-like peptide-1 receptor agonist" ;
    dmo:name "GLP-1 RA" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "• Consider SGLT-2 inhibitor or GLP-1 RA use in patients with diabetic nephropathy." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/glp-1-receptor-agonist> a dmo:DrugClass ;
    rdfs:label "GLP-1 receptor agonist" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "glp-1-receptor-agonist" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:name "GLP-1 receptor agonist" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "GLP-1 \nreceptor \nagonist\n1– 2% No ASCVD benefit \n(liraglutide, \ndulaglutide, \nsemaglutide \ninjectable)\nBenefit \n(primarily \nreduced \nalbuminuria;\nliraglutide, \ndulaglutide, \nsemaglutide \ninjectable)\nModerate \n- very \nhigh loss \n(Efficacy \ndepends \non agent \nand \ndose.)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/glucagon-like-peptide-1-receptor-agonists> a dmo:DrugClass ;
    rdfs:label "Glucagon-like Peptide-1 Receptor Agonists" ;
    dmo:drugClassCode "glucagon-like-peptide-1-receptor-agonists" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Glucagon-like peptide-1 receptor agonists (GLP-1 RAs) are a class of medications that mimic the action of the incretin hormone GLP-1, which enhances glucose-dependent insulin secretion, suppresses inappropriately high glucagon secretion, slows gastric emptying, and promotes satiety." ;
    dmo:name "Glucagon-like Peptide-1 Receptor Agonists" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "For adults with type 2 diabetes mellitus with atherosclerotic cardiovascular disease, we recommend glucagon-like peptide-1 receptor agonists or sodium-glucose cotransporter-2 inhibitors with proven cardiovascular benefits to decrease the risk of major adverse cardiovascular events." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10A" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Replaces or supplements endogenous insulin to lower blood glucose levels." ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "In insulin-treated adults with type 2 diabetes mellitus who are not achieving glycemic goals, we suggest real-time continuous glucose monitoring to decrease hypoglycemia and improve HbA1c." ;
    dmo:evidenceQuote "In adults with type 2 diabetes mellitus, especially those 65 years and older, we suggest prioritizing drug classes other than insulin, sulfonylureas, or meglitinides to minimize the risk of hypoglycemia, if glycemic control can be achieved with other treatments." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/meglitinide> a dmo:DrugClass ;
    rdfs:label "Meglitinide" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "meglitinide" ;
    dmo:hypoglycemiaRisk "Moderate" ;
    dmo:name "Meglitinide" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "• Increased risk for hypoglycemia (elderly, renal or hepatic impairment, poor intake) \n• Upper respiratory infection\n• Flu-like symptoms\n• Taken orally three times daily with meals (skip dose if skipped meal)\n• Do not combine with SU or prandial insulin." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/meglitinides> a dmo:DrugClass ;
    rdfs:label "Meglitinides" ;
    dmo:drugClassCode "meglitinides" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Meglitinides are a class of oral hypoglycemic agents that stimulate insulin secretion from pancreatic beta cells, similar to sulfonylureas but with a shorter duration of action." ;
    dmo:name "Meglitinides" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "In adults with type 2 diabetes mellitus, especially those 65 years and older, we suggest prioritizing drug classes other than insulin, sulfonylureas, or meglitinides to minimize the risk of hypoglycemia, if glycemic control can be achieved with other treatments." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/metformin> a dmo:DrugClass ;
    rdfs:label "Metformin" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA01" ;
    dmo:drugClassCode "metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Decreases hepatic glucose production and improves insulin sensitivity." ;
    dmo:name "Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "In adults with prediabetes who have participated in healthy lifestyle modification and remain at high risk for progression to type 2 diabetes mellitus, we suggest evaluating patient characteristics (e.g., age, life expectancy, co-occurring conditions, BMI, other risk factors) and offering metformin or other select medications to reduce the risk of progression from prediabetes to type 2 diabetes mellitus." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/sglt-2-inhibitor> a dmo:DrugClass ;
    rdfs:label "SGLT-2 inhibitor" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "sglt-2-inhibitor" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Sodium-glucose cotransporter 2 inhibitor" ;
    dmo:name "SGLT-2 inhibitor" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "• Consider SGLT-2 inhibitor or GLP-1 RA use in patients with diabetic nephropathy." ;
    dmo:evidenceQuote "SGLT-2 inhibitor\n0.5– 1% No ASCVD benefit \n(empagliflozin, \ncanagliflozin)\nBenefit \n(empagliflozin, \ncanagliflozin, \ndapagliflozin)\nModerate \nloss" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/sodium-glucose-cotransporter-2-inhibitors> a dmo:DrugClass ;
    rdfs:label "Sodium-Glucose Cotransporter-2 Inhibitors" ;
    dmo:drugClassCode "sodium-glucose-cotransporter-2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Sodium-glucose cotransporter-2 inhibitors (SGLT2 inhibitors) are a class of medications that inhibit the reabsorption of glucose in the kidneys, leading to increased urinary glucose excretion and lower blood glucose levels." ;
    dmo:name "Sodium-Glucose Cotransporter-2 Inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "For adults with type 2 diabetes mellitus with atherosclerotic cardiovascular disease, we recommend glucagon-like peptide-1 receptor agonists or sodium-glucose cotransporter-2 inhibitors with proven cardiovascular benefits to decrease the risk of major adverse cardiovascular events." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/su> a dmo:DrugClass ;
    rdfs:label "SU" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "su" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:name "SU" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "SU\n1– 1.5% Yes Neutral Neutral Mild-\nmoderate \ngain" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/sulfonylureas> a dmo:DrugClass ;
    rdfs:label "Sulfonylureas" ;
    dmo:drugClassCode "sulfonylureas" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Sulfonylureas are a class of oral hypoglycemic agents that stimulate insulin secretion from pancreatic beta cells." ;
    dmo:name "Sulfonylureas" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "In adults with type 2 diabetes mellitus, especially those 65 years and older, we suggest prioritizing drug classes other than insulin, sulfonylureas, or meglitinides to minimize the risk of hypoglycemia, if glycemic control can be achieved with other treatments." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/drugClass/tzd> a dmo:DrugClass ;
    rdfs:label "TZD" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "tzd" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:name "TZD" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "• HF or evidence of fluid overload\n• History or high risk of fracture \n• Active liver disease (liver transaminases >2.5 times above the upper reference limit), unless NASH is known to be the underlying cause of the elevation\n• Active or history of bladder cancer\n• Pregnancy\n• Macular edema\n• Weight gain\n• Fluid retention\n• HF\n• Macular edema \n• Bone fractures\n• Might increase risk of bladder cancer (pioglitazone)\n• Taken orally without regard to meals\n• Full glycemic effect takes several weeks. \n• HF risk is increased with concurrent insulin." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/labTest/a1c> a dmo:LabTest ;
    rdfs:label "A1C" ;
    dmo:definition "A measure of average blood glucose levels over the past 2–3 months, used to diagnose and monitor diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "a1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "A1C" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "Drug Class Average A1c Reduction Hypo- glycemia (as mono- therapy) Cardio- vascular Effects Renal Effects Weight Change Contraindications or Precautions Adverse Effects Dosing and Administration SGLT-2 inhibitor 0.5– 1% No ASCVD benefit (empagliflozin, canagliflozin) Benefit (empagliflozin, canagliflozin, dapagliflozin) Moderate loss • eGFR <20– 30 (see labeling) • Increased risk for DKA • Increased risk for frequent or serious genitourinary infections • Pregnancy/ breastfeeding • Genitourinary infections • DKA (might be euglycemic) • Volume depletion/ hypotension • Initial reversible increase in serum creatinine; long-term improvement • Bone fractures (canagliflozin) • Lower limb amputations were increased with canagliflozin versus placebo in one trial (CANVAS)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/labTest/egfr> a dmo:LabTest ;
    rdfs:label "eGFR" ;
    dmo:definition "Contraindicated eGFR <30; may continue at reduced dose, but do not initiate if eGFR <45" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "egfr" ;
    dmo:loincCode "21600-0" ;
    dmo:name "eGFR" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mL-per-min" ;
    dmo:evidenceQuote "Contraindicated eGFR <30; may continue at reduced dose, but do not initiate if eGFR <45" ;
    dmo:evidenceQuote "e if eGFR <45 Increased risk of lactic acidosis (especially in setting of acute HF, dehydration, excessive alcohol intake, renal impairment, sepsis)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/labTest/estimated-glomerular-filtration-rate> a dmo:LabTest ;
    rdfs:label "Estimated Glomerular Filtration Rate" ;
    dmo:definition "A measure of kidney function used to assess the stage of chronic kidney disease (CKD) in patients with T2DM." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "estimated-glomerular-filtration-rate" ;
    dmo:loincCode "2160-0" ;
    dmo:name "Estimated Glomerular Filtration Rate" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mL-per-min/1.73m2" ;
    dmo:evidenceQuote "Monitor urine microalbumin/creatinine ratio at least annually." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/labTest/fasting-plasma-glucose> a dmo:LabTest ;
    rdfs:label "Fasting Plasma Glucose" ;
    dmo:definition "Fasting is defined as no caloric intake for at least eight hours." ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "fasting-plasma-glucose" ;
    dmo:loincCode "15577-6" ;
    dmo:name "Fasting Plasma Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "FPG ≥126 mg/dL (7.0 mmol/L) on two occasions" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/labTest/fibrosis-4> a dmo:LabTest ;
    rdfs:label "Fibrosis-4" ;
    dmo:definition "Fibrosis-4 is a non-invasive scoring system used to assess liver fibrosis in patients with non-alcoholic fatty liver disease." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "fibrosis-4" ;
    dmo:loincCode "94575-5" ;
    dmo:name "Fibrosis-4" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "dimensionless" ;
    dmo:evidenceQuote "In adults with type 2 diabetes mellitus and co-occurring non-alcoholic fatty liver disease, we suggest clinicians should assess for fibrosis using a non-invasive tool (e.g., Fibrosis-4)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/labTest/hba1c> a dmo:LabTest ;
    rdfs:label "HbA1c" ;
    dmo:definition "Hemoglobin A1c is a measure of average blood glucose levels over the past 2-3 months and is used to assess long-term glycemic control in patients with diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "HbA1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "We suggest setting an individualized HbA1c target range based on the clinician’s appraisal of the risk benefit ratio, patient characteristics, presence or absence of type 2 diabetes mellitus complications, comorbidities, and life expectancy." ;
    dmo:evidenceQuote "We suggest an HbA1c range of 7.0– 8.5% for most patients, if it can be safely achieved." ;
    dmo:evidenceQuote "HbA1c assays should be based on the NGSP reference standard. Clinicians should obtain information regarding the coefficient of variation (CV) from the methodology used at their site." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/labTest/hemoglobin-a1c> a dmo:LabTest ;
    rdfs:label "Hemoglobin A1c" ;
    dmo:definition "Using a clinical laboratory (not a point-of-care) methodology standardized to the National Glycohemoglobin Standardization Program (NGSP)" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hemoglobin-a1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "Hemoglobin A1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "HbA1c ≥6.5% with a confirmatory FPG ≥126 mg/dL (7.0 mmol/L)" ;
    dmo:evidenceQuote "Monitor urine microalbumin/creatinine ratio at least annually." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/labTest/oral-glucose-tolerance-test-2h> a dmo:LabTest ;
    rdfs:label "Oral Glucose Tolerance Test-2h" ;
    dmo:definition "Two-hour plasma glucose on 75g OGTT of >200 mg/dl" ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "oral-glucose-tolerance-test-2h" ;
    dmo:loincCode "15578-4" ;
    dmo:name "Oral Glucose Tolerance Test-2h" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Two-hour plasma glucose on 75g OGTT of >200 mg/dl" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/labTest/uacr> a dmo:LabTest ;
    rdfs:label "UACR" ;
    dmo:definition "A measure of albumin in the urine relative to creatinine, used to assess kidney damage in diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "uacr" ;
    dmo:loincCode "29515-3" ;
    dmo:name "UACR" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg-per-g" ;
    dmo:evidenceQuote "Benefit (empagliflozin, canagliflozin, dapagliflozin) Moderate loss • eGFR <20– 30 (see labeling) • Increased risk for DKA • Increased risk for frequent or serious genitourinary infections • Pregnancy/ breastfeeding • Genitourinary infections • DKA (might be euglycemic) • Volume depletion/ hypotension • Initial reversible increase in serum creatinine; long-term improvement • Bone fractures (canagliflozin) • Lower limb amputations were increased with canagliflozin versus placebo in one trial (CANVAS)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

<https://example.org/dmo/id/labTest/urine-microalbumin-to-creatinine-ratio> a dmo:LabTest ;
    rdfs:label "Urine Microalbumin-to-Creatinine Ratio" ;
    dmo:definition "A test to detect early kidney damage in patients with T2DM by measuring the amount of albumin in the urine relative to creatinine." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-microalbumin-to-creatinine-ratio" ;
    dmo:loincCode "2951-2" ;
    dmo:name "Urine Microalbumin-to-Creatinine Ratio" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "mg-per-g" ;
    dmo:evidenceQuote "Monitor urine microalbumin/creatinine ratio at least annually." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/vadod-diabetes-cpg-provider-summary_final_508> .

