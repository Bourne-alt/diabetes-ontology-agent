    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Three insulin rates are recommended in Table 3: Reduced rate for patients thought to be insulin sensitive, Standard rate for most patients, Increased rate for patients likely to be insulin resistant." ;
    dmo:evidenceQuote "Three insulin rates are recommended in Table 3\n Reduced rate for patients thought to be insulin sensitive\n Standard rate for most patients\n Increased rate for patients likely to be insulin resistant" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

