<https://example.org/dmo/id/recommendation/restart-basal-insulin-if-omitted-in-error> a dmo:Recommendation ;
    rdfs:label "Restart basal insulin if omitted in error" ;
    dmo:recommendationId "restart-basal-insulin-if-omitted-in-error" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "If basal insulin was omitted in error this must be restarted before the VRIII is discontinued. If the basal insulin is not due for several hours, give half the usual dose of basal insulin, along with a meal and bolus insulin. This will provide essential background insulin until the usual dose can be recommenced." ;
    dmo:evidenceQuote "If basal insulin was omitted in error this must be restarted before the VRIII is discontinued. If the basal insulin is not due for several hours, give half the usual dose of basal insulin, along with a meal and bolus insulin. This will provide essential background insulin until the usual dose can be recommenced." ;
    dmo:evidenceQuote "If the basal insulin was omitted in error this must be restarted before the VRIII is discontinued." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

