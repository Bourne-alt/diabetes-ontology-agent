    dmo:evidenceQuote "Review GLP1 and DDP4 inhibitors if patient was admitted with suspected pancreatitis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/glitazones> a dmo:DrugClass ;
    rdfs:label "Glitazones" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BB" ;
    dmo:drugClassCode "glitazones" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Activate peroxisome proliferator-activated receptor gamma (PPAR-γ), improving insulin sensitivity" ;
    dmo:name "Glitazones" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Review glitazone therapy if patient was admitted with heart failure, has macular oedema or has been admitted with a lower limb fracture following a fall" ;
    dmo:evidenceQuote "Review glitazone therapy if the patient was admitted with heart failure or lower limb fracture or has known macular oedema" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/glp-1-mimetics> a dmo:DrugClass ;
    rdfs:label "GLP-1 mimetics" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10BJ" ;
    dmo:drugClassCode "glp-1-mimetics" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Glucagon-like peptide-1 receptor agonists that enhance glucose-dependent insulin secretion, suppress inappropriately elevated glucagon secretion, and slow gastric emptying" ;
    dmo:name "GLP-1 mimetics" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "GLP-1 mimetics should be recommenced at the usual dose and time" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/glp-1-receptor-agonists> a dmo:DrugClass ;
    rdfs:label "GLP-1 receptor agonists" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10BX02" ;
    dmo:drugClassCode "glp-1-receptor-agonists" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "GLP-1 receptor agonists enhance glucose-dependent insulin secretion, suppress glucagon release, slow gastric emptying, and promote satiety." ;
    dmo:name "GLP-1 receptor agonists" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "Review the GLP-1 and DPP4 - inhibitors if the patient was admitted with suspected pancreatitis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/glp-1ra> a dmo:DrugClass ;
    rdfs:label "GLP-1RA" ;
    dmo:drugClassCode "glp-1ra" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Glucagon-like peptide-1 receptor agonist" ;
    dmo:name "GLP-1RA" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "Review GLP1 and DDP4 inhibitors if patient was admitted with suspected pancreatitis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Intravenous" ;
    dmo:atcCode "A10A" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin is a hormone that lowers blood glucose levels by promoting glucose uptake into cells and inhibiting glucose production in the liver." ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "The half life of intravenous insulin is very short (7-8 minutes) and restarting promptly minimises the risk of ketosis." ;
    dmo:evidenceQuote "Review diabetes treatment in all patients admitted with unstable blood glucose or HbA1c > 59 mmol/mol (7.5%), and refer to the diabetes in-patient team." ;
    dmo:evidenceQuote "Frail elderly patients, renal failure (CKD stage 4 or 5), severe hepatic failure, newly diagnosed Type 1 diabetes: Total daily insulin dose = 0.3 x body weight in kg" ;
    dmo:evidenceQuote "If the patient is on basal insulin, this must be continued alongside the VRIII." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/intravenous-insulin> a dmo:DrugClass ;
    rdfs:label "Intravenous Insulin" ;
    dmo:adminRoute "Intravenous" ;
    dmo:drugClassCode "intravenous-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin administered directly into the bloodstream to lower blood glucose levels." ;
    dmo:name "Intravenous Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If the TPN is stopped for any reason this will put the patient at risk of hypoglycaemia. In this situation the VRIII should be discontinued and blood glucose monitored hourly until the TPN can be reinstated or other steps taken to avoid hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/intravenous-insulin-infusions> a dmo:DrugClass ;
    rdfs:label "Intravenous Insulin Infusions" ;
    dmo:adminRoute "Intravenous" ;
    dmo:drugClassCode "intravenous-insulin-infusions" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin administered via intravenous infusion to lower blood glucose levels in critically ill patients." ;
    dmo:name "Intravenous Insulin Infusions" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Several recent clinical trials in critically ill patients have reported no reduction in mortality from intensive insulin treatment (IIT) (target near normoglycaemia) compared with conventional management (target BG <10.0 mmol/L). Some of these studies report harm associated with intensive insulin regimes, with increased rates of severe hypoglycaemia and, in one study, increased mortality" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/isophane-insulin> a dmo:DrugClass ;
    rdfs:label "Isophane Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10BX07" ;
    dmo:drugClassCode "isophane-insulin" ;
    dmo:hypoglycemiaRisk "Moderate" ;
    dmo:mechanism "Intermediate-acting insulin that provides a prolonged but not continuous insulin effect." ;
    dmo:name "Isophane Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Continue basal long-acting analogues* or isophane insulin** in patients usually taking multiple daily injections of insulin (MDI or basal-bolus insulin therapy)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/long-acting-insulin-analogues> a dmo:DrugClass ;
    rdfs:label "Long-acting Insulin Analogues" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:atcCode "A10BX07" ;
    dmo:drugClassCode "long-acting-insulin-analogues" ;
    dmo:hypoglycemiaRisk "Moderate" ;
    dmo:mechanism "Provide a prolonged, steady release of insulin to maintain glucose control over 24 hours." ;
    dmo:name "Long-acting Insulin Analogues" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Continue basal long-acting analogues* or isophane insulin** in patients usually taking multiple daily injections of insulin (MDI or basal-bolus insulin therapy)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/metformin> a dmo:DrugClass ;
    rdfs:label "Metformin" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BA01" ;
    dmo:drugClassCode "metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Metformin reduces hepatic glucose production and improves insulin sensitivity." ;
    dmo:name "Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Metformin should only be recommenced when the eGFR is >30 ml/min. Reduce the dose to 500 mg bd if the eGFR is <45 ml/min" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/sglt2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT2 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BJ" ;
    dmo:drugClassCode "sglt2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibit sodium-glucose co-transporter 2 in the proximal renal tubule, promoting urinary glucose excretion" ;
    dmo:name "SGLT2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "Review dapagliflozin therapy if patient was admitted with urogenital infection" ;
    dmo:evidenceQuote "Review dapagliflozin therapy if the patient was admitted with a urogenital infection" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/sglt2i> a dmo:DrugClass ;
    rdfs:label "SGLT2i" ;
    dmo:drugClassCode "sglt2i" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Sodium-glucose co-transporter 2 inhibitor" ;
    dmo:name "SGLT2i" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "Review dapagliflozin therapy if patient was admitted with urogenital infection" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/subcutaneous-rapid-acting-analogue-insulin> a dmo:DrugClass ;
    rdfs:label "Subcutaneous Rapid Acting Analogue Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "subcutaneous-rapid-acting-analogue-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Rapid-acting insulin analogues provide a quick onset of action to cover mealtime glucose excursions." ;
    dmo:name "Subcutaneous Rapid Acting Analogue Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Type 1 diabetes: give subcutaneous rapid acting analogue insulin *. Assume that 1 unit will drop blood glucose by 3 mmol/L BUT wherever possible take advice from the patient about the amount of insulin normally required to correct high blood glucose." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/sulfonylureas> a dmo:DrugClass ;
    rdfs:label "Sulfonylureas" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BB" ;
    dmo:drugClassCode "sulfonylureas" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Sulfonylureas stimulate insulin secretion from pancreatic beta cells." ;
    dmo:name "Sulfonylureas" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Dose of insulin secretagogues may need to be reduced if food intake is likely to be limited" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/sulphonylureas> a dmo:DrugClass ;
    rdfs:label "Sulphonylureas" ;
    dmo:adminRoute "Oral" ;
    dmo:atcCode "A10BB" ;
    dmo:drugClassCode "sulphonylureas" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Stimulate insulin secretion from pancreatic beta cells" ;
    dmo:name "Sulphonylureas" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Dose of insulin secretagogues e.g. sulphonylureas or glinides may need to be reduced if food intake is likely to be limited" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/tzd> a dmo:DrugClass ;
    rdfs:label "TZD" ;
    dmo:drugClassCode "tzd" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Thiazolidinedione" ;
    dmo:name "TZD" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Review glitazone therapy if patient was admitted with heart failure, has macular oedema or has been admitted with a lower limb fracture following a fall" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/variable-rate-intravenous-insulin-infusion> a dmo:DrugClass ;
    rdfs:label "Variable Rate Intravenous Insulin Infusion" ;
    dmo:adminRoute "Intravenous" ;
    dmo:drugClassCode "variable-rate-intravenous-insulin-infusion" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Adjusts insulin delivery rate in response to blood glucose levels to achieve normoglycaemia" ;
    dmo:name "Variable Rate Intravenous Insulin Infusion" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "However, when used incorrectly, it can result in morbidity from hypoglycaemia, excess length of stay, rebound hyperglycaemia and even DKA" ;
    dmo:evidenceQuote "The infusion of intravenous insulin at a variable rate according to regular capillary blood glucose measurements with the aim of controlling serum glucose levels within a specified range." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/vriii> a dmo:DrugClass ;
    rdfs:label "VRIII" ;
    dmo:adminRoute "Intravenous" ;
    dmo:drugClassCode "vriii" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Continuous intravenous insulin infusion used to tightly control blood glucose in critically ill patients" ;
    dmo:name "VRIII" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Patients treated with a VRIII should be reviewed at least daily to:  ensure progress and recovery in their presenting illness  monitor fluid balance  reassess the need for the VRIII" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/admission-plasma-glucose> a dmo:LabTest ;
    rdfs:label "Admission plasma glucose" ;
    dmo:definition "Plasma glucose level measured at the time of hospital admission, used to assess hyperglycemia in acutely ill patients." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "admission-plasma-glucose" ;
    dmo:loincCode "15576-2" ;
    dmo:name "Admission plasma glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Admission plasma glucose: independent risk factor for long-term prognosis after myocardial infarction even in non diabetic patients. Diabetes Care. 1999;22(11):1827-31." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/blood-glucose> a dmo:LabTest ;
    rdfs:label "Blood Glucose" ;
    dmo:definition "Blood glucose levels should be checked at least twice in 24 hours for patients receiving TPN. If the blood glucose is elevated a VRIII will be required, in which case CBG should be monitored hourly." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-glucose" ;
    dmo:name "Blood Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "All patients receiving TPN should have their blood glucose levels checked at least twice in 24 hours but the frequency of monitoring should be increased if hyperglycaemia develops or if the patient has pre-existing diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/blood-glucose-concentration> a dmo:LabTest ;
    rdfs:label "Blood glucose concentration" ;
    dmo:definition "The level of glucose in the blood, measured at various time points during acute illness, with variability linked to mortality." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "blood-glucose-concentration" ;
    dmo:loincCode "15576-2" ;
    dmo:name "Blood glucose concentration" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Variability of blood glucose concentration and short-term mortality in critically ill patients. Anaesthesiology. 2006;105(2):244-52." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/blood-ketones> a dmo:LabTest ;
    rdfs:label "Blood Ketones" ;
    dmo:definition "A measure of ketone bodies in the blood, used to assess the risk of diabetic ketoacidosis." ;
    dmo:labTestCode "blood-ketones" ;
    dmo:name "Blood Ketones" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Blood glucose greater than 12.0 mmol/L with blood ketones less than 3.0 mmol/L or urine ketones no more than ++" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/capillary-blood-glucose> a dmo:LabTest ;
    rdfs:label "Capillary Blood Glucose" ;
    dmo:definition "Capillary blood glucose levels should be checked hourly. This minimises the risk of uncontrolled hyperglycaemia, prompts a review of the infusion equipment and prescribed insulin rate if the trend is unsatisfactory and ensures prompt treatment of hypoglycaemia (patients may be unaware or too ill to alert staff)." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "capillary-blood-glucose" ;
    dmo:loincCode "15536-1" ;
    dmo:name "Capillary Blood Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "CBG levels should be checked hourly. This minimises the risk of uncontrolled hyperglycaemia, prompts a review of the infusion equipment and prescribed insulin rate if the trend is unsatisfactory and ensures prompt treatment of hypoglycaemia (patients may be unaware or too ill to alert staff)." ;
    dmo:evidenceQuote "Repeat capillary blood glucose measurement 15 minutes later. If it is still less than 4.0 mmol/L, repeat." ;
    dmo:evidenceQuote "Check the CBG one hour after discontinuing VRIII and at least four times for first 24 hours after VRIII has been discontinued, to ensure that there is no rebound hyperglycaemia i.e. pre-meal and pre-bed" ;
    dmo:evidenceQuote "Capillary Blood Glucose (CBG) should be checked one hour after discontinuing VRIII and at least four times for the next 24 hours to ensure that there is no rebound hyperglycaemia i.e. pre-meal and pre-bed." ;
    dmo:evidenceQuote "CBGs must be monitored hourly whilst the VRIII is in use" ;
    dmo:evidenceQuote "If the CBGs have fallen below 4.0 mmol/L i.e. the patient has had a hypo, stop the VRIII and treat the hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/capillary-blood-ketones> a dmo:LabTest ;
    rdfs:label "Capillary Blood Ketones" ;
    dmo:definition "Measurement of ketone levels in capillary blood to assess risk of diabetic ketoacidosis (DKA) in patients with diabetes who are unwell or have persistent hyperglycaemia." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "capillary-blood-ketones" ;
    dmo:name "Capillary Blood Ketones" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Patients with type 1 diabetes who are unwell or who develop persistent hyperglycaemia whilst in hospital (2 readings >12 mmol/L at least one hour apart) should have a baseline capillary blood ketone measurement with appropriate action taken (Table 4)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/cbg> a dmo:LabTest ;
    rdfs:label "CBG" ;
    dmo:definition "CBG should be checked one hour after discontinuing VRIII and at least four-hourly for the next 24 hours, to ensure that there is no rebound hyper- or hypo-glycaemia." ;
    dmo:labTestCode "cbg" ;
    dmo:name "CBG" ;
    dmo:evidenceQuote "CBG should be checked one hour after discontinuing VRIII and at least four-hourly for the next 24 hours, to ensure that there is no rebound hyper- or hypo- glycaemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/egfr> a dmo:LabTest ;
    rdfs:label "eGFR" ;
    dmo:definition "Estimated glomerular filtration rate, a measure of kidney function." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "egfr" ;
    dmo:loincCode "2160-0" ;
    dmo:name "eGFR" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mL/min" ;
    dmo:evidenceQuote "Metformin should only be recommenced when the eGFR is >30 ml/min. Reduce the dose to 500 mg bd if the eGFR is <45 ml/min" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/electrolytes> a dmo:LabTest ;
    rdfs:label "Electrolytes" ;
    dmo:definition "Check electrolytes daily (at risk of hyponatraemia and hypokalaemia)" ;
    dmo:labTestCode "electrolytes" ;
    dmo:name "Electrolytes" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "Check electrolytes daily (at risk of hyponatraemia and hypokalaemia)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/fasting-glucose> a dmo:LabTest ;
    rdfs:label "Fasting glucose" ;
    dmo:definition "Fasting glucose greater than 7.0 mmol/L or random glucose greater than 11.1 mmol/L during hospital stay but glucose tolerance reverts back to the normal range after discharge." ;
    dmo:labTestCode "fasting-glucose" ;
    dmo:name "Fasting glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Fasting glucose greater than 7.0 mmol/L or random glucose greater than 11.1 mmol/L during hospital stay but glucose tolerance reverts back to the normal range after discharge." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/hba1c> a dmo:LabTest ;
    rdfs:label "HbA1c" ;
    dmo:definition "A measure of average blood glucose levels over the past 2-3 months, used to assess long-term diabetes control." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "HbA1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol-per-mol" ;
    dmo:evidenceQuote "recent pre-admission HbA1c >58 mmol/mol [7.5%]" ;
    dmo:evidenceQuote "Review diabetes treatment in all patients admitted with unstable blood glucose or HbA1c > 59 mmol/mol (7.5%), and refer to the diabetes in-patient team." ;
    dmo:evidenceQuote "Check HbA1c and consider adjusting usual medication. Seek advice from the diabetes team for optimisation of their diabetes medication and ongoing management." ;
    dmo:evidenceQuote "If diabetes control was suboptimal prior to admission (i.e. recent pre admission HbA1c >59 mmol/mol)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/ketones> a dmo:LabTest ;
    rdfs:label "Ketones" ;
    dmo:definition "Check ketones 4 hourly if have Type 1 diabetes, at least once if Type 2" ;
    dmo:labTestCode "ketones" ;
    dmo:name "Ketones" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Check ketones 4 hourly if have Type 1 diabetes, at least once if Type 2" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/measurement-of-capillary-blood-ketones> a dmo:LabTest ;
    rdfs:label "Measurement of Capillary Blood Ketones" ;
    dmo:definition "Measurement of ketone levels in capillary blood, used to assess risk of diabetic ketoacidosis during illness." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "measurement-of-capillary-blood-ketones" ;
    dmo:name "Measurement of Capillary Blood Ketones" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "3.6.2 Measurement of capillary blood ketones" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/random-blood-glucose> a dmo:LabTest ;
    rdfs:label "Random blood glucose" ;
    dmo:definition "A measure of blood glucose concentration taken at any time of day, regardless of when the person last ate." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "random-blood-glucose" ;
    dmo:loincCode "15576-2" ;
    dmo:name "Random blood glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "Randomized study of basal-bolus insulin therapy in the inpatient management of patients with type 2 diabetes (RABBIT 2 trial). Diabetes Care. 2007;30(9):2181-6." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/serum-k> a dmo:LabTest ;
    rdfs:label "Serum K" ;
    dmo:definition "Serum potassium level, used to assess electrolyte balance and guide potassium supplementation in infusion fluids." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "serum-k" ;
    dmo:loincCode "2088-2" ;
    dmo:name "Serum K" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "If K is >5.5 mmol/L – no K is to be added to the infusion fluid" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/serum-potassium> a dmo:LabTest ;
    rdfs:label "Serum Potassium" ;
    dmo:definition "Serum potassium levels are monitored to guide fluid selection and prevent hypokalaemia, especially in patients on VRIII for more than 24 hours." ;
    dmo:labTestCode "serum-potassium" ;
    dmo:name "Serum Potassium" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Patients on a VRIII for more than 24 hours are likely to need fluid containing sodium chloride to avoid hyponatraemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/serum-sodium> a dmo:LabTest ;
    rdfs:label "Serum Sodium" ;
    dmo:definition "Serum sodium levels are monitored to assess risk of hyponatraemia and guide fluid management, particularly in patients with fluid overload concerns." ;
    dmo:labTestCode "serum-sodium" ;
    dmo:name "Serum Sodium" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Hyponatraemia or serum sodium falls by >3 mmol/L in 24 hr" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/urea-and-electrolytes> a dmo:LabTest ;
    rdfs:label "Urea and Electrolytes" ;
    dmo:definition "A blood test to assess kidney function and electrolyte balance, performed at least daily in patients receiving VRIII." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urea-and-electrolytes" ;
    dmo:name "Urea and Electrolytes" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Daily urea and electrolytes" ;
    dmo:evidenceQuote "In addition other biochemical tests, e.g. micronutrients etc. may be needed. Consult your local nutrition and diabetes teams." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/urine-ketones> a dmo:LabTest ;
    rdfs:label "Urine Ketones" ;
    dmo:definition "The patient should be checked for ketones if the cannula is re-sited and the glucose has risen or no improvement is seen." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "urine-ketones" ;
    dmo:name "Urine Ketones" ;
    dmo:specimen "Urine" ;
    dmo:unitOfMeasure "trace / 1+ / 2+ / 3+ / 4+" ;
    dmo:evidenceQuote "If glucose has risen or no improvement is seen, the cannula should be re-sited and the patient should be checked for ketones." ;
    dmo:evidenceQuote "Blood glucose greater than 12.0 mmol/L with blood ketones less than 3.0 mmol/L or urine ketones no more than ++" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/venous-bicarbonate> a dmo:LabTest ;
    rdfs:label "Venous Bicarbonate" ;
    dmo:definition "Measurement of bicarbonate levels in venous blood to assess acid-base status, used to confirm diagnosis of diabetic ketoacidosis (DKA) when blood ketones are >3.0 mmol/L." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-bicarbonate" ;
    dmo:name "Venous Bicarbonate" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "If blood ketone testing is not available, urinary ketones may be used. If urine ketones are 2+ or more a venous blood gas must be taken to check bicarbonate and venous pH." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/labTest/venous-ph> a dmo:LabTest ;
    rdfs:label "Venous pH" ;
    dmo:definition "Measurement of venous blood pH to assess acid-base status, used in conjunction with venous bicarbonate to confirm diagnosis of diabetic ketoacidosis (DKA)." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "venous-ph" ;
    dmo:name "Venous pH" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "If blood ketone testing is not available, urinary ketones may be used. If urine ketones are 2+ or more a venous blood gas must be taken to check bicarbonate and venous pH." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/lifestyleIntervention/self-management-education> a dmo:LifestyleIntervention ;
    rdfs:label "Self-Management Education" ;
    dmo:interventionCode "self-management-education" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "Self-Management Education" ;
    dmo:evidenceQuote "It is important that patients receive education and support in self-management of diabetes, that they are confident to self-inject prior to discharge, and that follow-up support is available from appropriately trained professionals." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/medication/background-long-acting-insulin> a dmo:Medication ;
    rdfs:label "Background (long-acting) insulin" ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "background-long-acting-insulin" ;
    dmo:name "Background (long-acting) insulin" ;
    dmo:evidenceQuote "Background (long‐acting) insulin should have been continued, if not, this MUST be given prior to discontinuation of the VRIII" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

