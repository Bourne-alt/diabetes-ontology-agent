<https://example.org/dmo/id/recommendation/stop-vriii-and-treat-hypoglycaemia-if-cbg-4-0-mmol-l> a dmo:Recommendation ;
    rdfs:label "Stop VRIII and treat hypoglycaemia if CBG <4.0 mmol/L" ;
    dmo:recommendationId "stop-vriii-and-treat-hypoglycaemia-if-cbg-4-0-mmol-l" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "If the CBGs have fallen below 4.0 mmol/L i.e. the patient has had a hypo, stop the VRIII and treat the hypoglycaemia." ;
    dmo:evidenceQuote "If the CBGs have fallen below 4.0 mmol/L i.e. the patient has had a hypo, stop the VRIII and treat the hypoglycaemia." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/recommendation/stop-vriii-during-hypoglycaemia-and-restart-promptly> a dmo:Recommendation ;
    rdfs:label "Stop VRIII during hypoglycaemia and restart promptly" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients receiving VRIII with hypoglycaemia" ;
    dmo:recommendationId "stop-vriii-during-hypoglycaemia-and-restart-promptly" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Stop the VRIII. Note the insulin infusion should generally not be stopped for more than 20 minutes. The half life of intravenous insulin is very short (7-8 minutes) and restarting promptly minimises the risk of ketosis." ;
    dmo:evidenceQuote "Stop the VRIII\nNote the insulin infusion should generally not be stopped for more than 20 minutes.\nThe half life of intravenous insulin is very short (7-8 minutes) and restarting promptly minimises the risk of ketosis." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/recommendation/suggested-scales-for-insulin-infusion-rate> a dmo:Recommendation ;
