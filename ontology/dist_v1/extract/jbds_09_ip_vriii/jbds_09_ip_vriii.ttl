<https://example.org/dmo/id/contraindication/serum-potassium-3-5-mmol-l> a dmo:Contraindication ;
    rdfs:label "Serum potassium <3.5 mmol/L" ;
    dmo:contraCode "serum-potassium-3-5-mmol-l" ;
    dmo:rationale "Patients on a VRIII for more than 24 hours are likely to need fluid containing sodium chloride to avoid hyponatraemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "If serum K <3.5 senior review as extra potassium needs to be given" ;
    dmo:evidenceQuote "If serum K <3.5 senior review as extra potassium needs to be given" ;
