<https://example.org/dmo/id/contraindication/serum-potassium-5-5-mmol-l> a dmo:Contraindication ;
    rdfs:label "Serum potassium >5.5 mmol/L" ;
    dmo:contraCode "serum-potassium-5-5-mmol-l" ;
    dmo:rationale "Fluids containing KCl should be selected to maintain serum potassium in the 3.5-5.0 range. The combination of glucose and insulin can lead to life threatening hypokalaemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "If serum K >5.5 no additional K but reassess serum K regularly" ;
    dmo:evidenceQuote "If serum K >5.5 no additional K but reassess serum K regularly" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

