    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "dehydration" ;
    dmo:evidenceQuote "Patients who are vomiting, pyrexial or dehydrated will need additional fluid, usually in the form of 0.9% NaCl." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/riskFactor/elderly-age> a dmo:RiskFactor ;
    rdfs:label "Elderly Age" ;
    dmo:evidenceNote "The cohort of patients is likely to be elderly and have multiple co-morbidities which may be adversely affected by prolonged treatment with a VRIII." ;
    dmo:name "Elderly Age" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "elderly-age" ;
