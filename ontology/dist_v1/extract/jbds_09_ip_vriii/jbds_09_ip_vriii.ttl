<https://example.org/dmo/id/contraindication/intensive-insulin-therapy-in-medical-icu-patients-without-diabetes> a dmo:Contraindication ;
    rdfs:label "Intensive Insulin Therapy in Medical ICU Patients Without Diabetes" ;
    dmo:contraCode "intensive-insulin-therapy-in-medical-icu-patients-without-diabetes" ;
    dmo:rationale "a moderate glucose target was independently associated with increased risk of mortality in patients without diabetes (OR, 1.36; 95% CI, 1.01-1.84; P= 0.05)" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "patients without previously diagnosed diabetes" ;
    dmo:evidenceQuote "a moderate glucose target was independently associated with increased risk of mortality in patients without diabetes (OR, 1.36; 95% CI, 1.01-1.84; P= 0.05)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/contraindication/intensive-insulin-therapy-in-patients-with-acute-coronary-syndrome> a dmo:Contraindication ;
    rdfs:label "Intensive Insulin Therapy in Patients with Acute Coronary Syndrome" ;
    dmo:contraCode "intensive-insulin-therapy-in-patients-with-acute-coronary-syndrome" ;
    dmo:rationale "NICE recommends the use of a dose adjusted intravenous insulin to prevent uncontrolled hyperglycaemia (BG >11.0 mmol/L) in patients with acute coronary syndrome (ACS). Regular BG monitoring is advised, aiming for moderate glycaemic control target BG <11 mmol/L with avoidance of intensive glycaemic control and hypoglycaemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "avoidance of intensive glycaemic control and hypoglycaemia" ;
    dmo:evidenceQuote "NICE recommends the use of a dose adjusted intravenous insulin to prevent uncontrolled hyperglycaemia (BG >11.0 mmol/L) in patients with acute coronary syndrome (ACS). Regular BG monitoring is advised, aiming for moderate glycaemic control target BG <11 mmol/L with avoidance of intensive glycaemic control and hypoglycaemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/contraindication/intensive-insulin-therapy-in-patients-with-acute-myocardial-infarction> a dmo:Contraindication ;
    rdfs:label "Intensive Insulin Therapy in Patients with Acute Myocardial Infarction" ;
    dmo:contraCode "intensive-insulin-therapy-in-patients-with-acute-myocardial-infarction" ;
    dmo:rationale "Analysis of the UK MINAP (Myocardial Ischaemia National Audit Project) data showed that admission glucose was strongly associated with mortality in all presentations of acute myocardial infarction irrespective of established diabetes diagnosis" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "admission glucose was strongly associated with mortality in all presentations of acute myocardial infarction irrespective of established diabetes diagnosis" ;
    dmo:evidenceQuote "Analysis of the UK MINAP (Myocardial Ischaemia National Audit Project) data showed that admission glucose was strongly associated with mortality in all presentations of acute myocardial infarction irrespective of established diabetes diagnosis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

