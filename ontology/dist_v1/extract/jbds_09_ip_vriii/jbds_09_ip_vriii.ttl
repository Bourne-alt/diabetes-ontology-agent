<https://example.org/dmo/id/medication/intravenous-insulin-infusions> a dmo:Medication ;
    rdfs:label "Intravenous Insulin Infusions" ;
    dmo:durationHours "0"^^xsd:integer ;
    dmo:insulinAction "NotApplicable" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "intravenous-insulin-infusions" ;
    dmo:name "Intravenous Insulin Infusions" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "Most of the studies investigating the optimal blood glucose targets for patients treated with intravenous insulin infusions have been in the critical care setting." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/medication/lantus-glargine> a dmo:Medication ;
    rdfs:label "Lantus (Glargine)" ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "lantus-glargine" ;
    dmo:name "Lantus (Glargine)" ;
    dmo:evidenceQuote "Insulin name Lantus (Glargine), Levemir (Detemir), Degludec, Insulatard, Humulin I, Insuman Basal" ;
