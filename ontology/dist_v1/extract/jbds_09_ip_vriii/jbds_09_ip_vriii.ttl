<https://example.org/dmo/id/medication/levemir-detemir> a dmo:Medication ;
    rdfs:label "Levemir (Detemir)" ;
    dmo:insulinAction "LongActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "levemir-detemir" ;
    dmo:name "Levemir (Detemir)" ;
    dmo:evidenceQuote "Insulin name Lantus (Glargine), Levemir (Detemir), Degludec, Insulatard, Humulin I, Insuman Basal" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/medication/rapid-acting-analogue-insulin> a dmo:Medication ;
    rdfs:label "Rapid Acting Analogue Insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "rapid-acting-analogue-insulin" ;
    dmo:name "Rapid Acting Analogue Insulin" ;
    dmo:evidenceQuote "Type 1 diabetes: give subcutaneous rapid acting analogue insulin *. Assume that 1 unit will drop blood glucose by 3 mmol/L BUT wherever possible take advice from the patient about the amount of insulin normally required to correct high blood glucose." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/medication/rapid-acting-insulin> a dmo:Medication ;
    rdfs:label "Rapid-acting insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "rapid-acting-insulin" ;
    dmo:name "Rapid-acting insulin" ;
    dmo:evidenceQuote "Give rapid‐acting insulin with the meal and then stop the VRIII 30 minutes later" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/medication/subcutaneous-rapid-acting-analogue-insulin> a dmo:Medication ;
    rdfs:label "Subcutaneous Rapid Acting Analogue Insulin" ;
    dmo:insulinAction "RapidActing" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "subcutaneous-rapid-acting-analogue-insulin" ;
    dmo:name "Subcutaneous Rapid Acting Analogue Insulin" ;
    dmo:evidenceQuote "Type 1 diabetes: give subcutaneous rapid acting analogue insulin *. Assume that 1 unit will drop blood glucose by 3 mmol/L BUT wherever possible take advice from the patient about the amount of insulin normally required to correct high blood glucose." ;
    dmo:evidenceQuote "Type 2 diabetes: give 0.1 units/kg of subcutaneous rapid acting analogue Insulin *, and recheck blood glucose 1 hour later to ensure it is falling." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/medication/subcutaneous-sliding-scale-regime> a dmo:Medication ;
