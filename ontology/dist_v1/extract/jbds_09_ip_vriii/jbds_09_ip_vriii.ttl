    dmo:mechanism "Inhibit dipeptidyl peptidase-4, increasing active GLP-1 levels" ;
    dmo:name "DPP4 inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Review GLP1 and DDP4 inhibitors if patient was admitted with suspected pancreatitis" ;
    dmo:evidenceQuote "Review the GLP-1 and DPP4 - inhibitors if the patient was admitted with suspected pancreatitis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/drugClass/dpp4i> a dmo:DrugClass ;
    rdfs:label "DPP4i" ;
    dmo:drugClassCode "dpp4i" ;
