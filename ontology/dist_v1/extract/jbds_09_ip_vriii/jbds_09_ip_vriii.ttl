    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "subcutaneous-sliding-scale-regime" ;
    dmo:name "subcutaneous 'sliding scale' regime" ;
    dmo:onsetMinutes "15"^^xsd:integer ;
    dmo:evidenceQuote "a subcutaneous ‘sliding scale’ regime where 4 injections were given per day with no basal insulin" ;
