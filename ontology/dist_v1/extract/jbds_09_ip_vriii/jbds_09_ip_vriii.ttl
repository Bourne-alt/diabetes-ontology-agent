    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Or 0.18% NaCl with 4% glucose with 0.15% KCl (20 mmol/L) OR 0.18% NaCl with 4% glucose with 0.3% KCl (40 mmol/L)." ;
    dmo:evidenceQuote "Or 0.18% NaCl with 4% glucose with 0.15% KCl (20 mmol/L) OR 0.18% NaCl with 4% glucose with 0.3% KCl (40 mmol/L)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/recommendation/use-0-45-nacl-and-5-glucose-with-0-3-kcl-40-mmol-l-at-125-ml-hr-for-patients-with-no-concern-of-fluid-overload> a dmo:Recommendation ;
    rdfs:label "Use 0.45% NaCl and 5% glucose with 0.3% KCl (40 mmol/L) at 125 ml/hr for patients with no concern of fluid overload" ;
    dmo:populationScope "Patients with no concern of fluid overload" ;
    dmo:recommendationId "use-0-45-nacl-and-5-glucose-with-0-3-kcl-40-mmol-l-at-125-ml-hr-for-patients-with-no-concern-of-fluid-overload" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "First choice: 0.45% NaCl and 5% glucose with 0.3% KCl (40 mmol/L) at 125 ml/hr if serum K is 3.5-5.5 mmol/L. Aim to keep K 4.0 - 5.0 mmol/L." ;
    dmo:evidenceQuote "First choice: 0.45% NaCl and 5% glucose with 0.3% KCl (40 mmol/L) at 125 ml/hr if serum K is 3.5-5.5 mmol/L Aim to keep K 4.0 - 5.0 mmol/L" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

