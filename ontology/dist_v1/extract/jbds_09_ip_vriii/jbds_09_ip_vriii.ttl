<https://example.org/dmo/id/recommendation/precaution-when-discontinuing-csii-without-alternative-insulin-provision> a dmo:Recommendation ;
    rdfs:label "Precaution When Discontinuing CSII Without Alternative Insulin Provision" ;
    dmo:populationScope "Patients on Continuous Subcutaneous Insulin Infusions (CSII) requiring VRIII" ;
    dmo:recommendationId "precaution-when-discontinuing-csii-without-alternative-insulin-provision" ;
    dmo:recommendationStrength "Strong" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "ALWAYS commence VRIII before disconnecting CSII pump, since if the CSII pump is discontinued without an alternative provision of insulin, diabetic ketoacidosis is likely to develop within a short space of time because there is no reservoir of long-acting insulin." ;
    dmo:evidenceQuote "ALWAYS commence VRIII before disconnecting CSII pump, since if the CSII pump is discontinued without an alternative provision of insulin, diabetic ketoacidosis is likely to develop within a short space of time because there is no reservoir of long-acting insulin." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

