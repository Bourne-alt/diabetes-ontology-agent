<https://example.org/dmo/id/riskFactor/elevated-preoperative-glucose-levels> a dmo:RiskFactor ;
    rdfs:label "Elevated Preoperative Glucose Levels" ;
    dmo:evidenceNote "术前血糖升高与非心脏、非血管手术患者围手术期死亡率增加相关。" ;
    dmo:name "Elevated Preoperative Glucose Levels" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "elevated-preoperative-glucose-levels" ;
    dmo:evidenceQuote "Increased preoperative glucose levels are associated with perioperative mortality in patients undergoing non cardiac, nonvascular surgery." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/riskFactor/glucose-variability> a dmo:RiskFactor ;
    rdfs:label "Glucose variability" ;
    dmo:evidenceNote "Glucose variability is an independent predictor of mortality in critically ill patients." ;
    dmo:name "Glucose variability" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "glucose-variability" ;
    dmo:evidenceQuote "Several studies have found glucose variability to be an independent predictor of mortality in critically ill patients" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/riskFactor/heart-failure> a dmo:RiskFactor ;
    rdfs:label "Heart Failure" ;
    dmo:evidenceNote "Patients with heart failure or severe renal or hepatic impairment may be unable to tolerate standard volumes of fluid and it may be necessary to use 10% glucose to meet the substrate requirements." ;
    dmo:name "Heart Failure" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "heart-failure" ;
    dmo:evidenceQuote "Patients with heart failure or severe renal or hepatic impairment may be unable to tolerate standard volumes of fluid and it may be necessary to use 10% glucose to meet the substrate requirements." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/riskFactor/hyperglycaemia> a dmo:RiskFactor ;
    rdfs:label "Hyperglycaemia" ;
    dmo:evidenceNote "Hyperglycaemia is associated with poor clinical outcomes, including prolonged hospital stay, infection, disability after discharge, and death." ;
    dmo:name "Hyperglycaemia" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "hyperglycaemia" ;
    dmo:evidenceQuote "Several observational studies point to a strong association between hyperglycaemia and poor clinical outcomes, including prolonged hospital stay, infection, disability after discharge from the hospital, and death" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/riskFactor/hyperglycemia> a dmo:RiskFactor ;
    rdfs:label "Hyperglycemia" ;
    dmo:evidenceNote "高血糖是住院患者死亡率的独立风险因素，即使在非糖尿病患者中也是如此。" ;
    dmo:name "Hyperglycemia" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "hyperglycemia" ;
    dmo:evidenceQuote "Admission plasma glucose: independent risk factor for long-term prognosis after myocardial infarction even in non diabetic patients." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

<https://example.org/dmo/id/riskFactor/hyperglycemia-in-acutely-ill-patients> a dmo:RiskFactor ;
