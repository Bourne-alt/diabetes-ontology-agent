    dmo:recommendationType "Treatment" ;
    dmo:statement "Patients with heart failure or severe renal or hepatic impairment may be unable to tolerate standard volumes of fluid and it may be necessary to use 10% glucose to meet the substrate requirements." ;
    dmo:evidenceQuote "Patients with heart failure or severe renal or hepatic impairment may be unable to tolerate standard volumes of fluid and it may be necessary to use 10% glucose to meet the substrate requirements." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_09_ip_vriii> .

