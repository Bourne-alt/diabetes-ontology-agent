<https://example.org/dmo/id/recommendation/individualised-care-plan-at-discharge-for-frail-inpatients-with-diabetes> a dmo:Recommendation ;
    rdfs:label "Individualised care plan at discharge for frail inpatients with diabetes" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
