<https://example.org/dmo/id/contraindication/diabetic-oral-agents-with-stringent-glycaemic-control> a dmo:Contraindication ;
    rdfs:label "Diabetic oral agents with stringent glycaemic control" ;
    dmo:contraCode "diabetic-oral-agents-with-stringent-glycaemic-control" ;
    dmo:rationale "Stringent glycaemic control is unnecessary. Increases risk of stroke and VTE disease. Discontinue and only consider recommencing if recurrence of symptoms" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "stringent glycaemic control" ;
    dmo:evidenceQuote "Stringent glycaemic control is unnecessary. Increases risk of stroke and VTE disease. Discontinue and only consider recommencing if recurrence of symptoms" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/do-not-deny-insulin-in-t1d> a dmo:Contraindication ;
    rdfs:label "Do not deny insulin in T1D" ;
    dmo:contraCode "do-not-deny-insulin-in-t1d" ;
    dmo:rationale "to prevent diabetic ketoacidosis and maintain metabolic stability" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "in the presence of type 1 diabetes" ;
    dmo:evidenceQuote "Do not deny insulin in T1D" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/excessive-hba1c-reduction-6-0-42-mmol-mol> a dmo:Contraindication ;
    rdfs:label "Excessive HbA1c reduction <6.0% (<42 mmol/mol)" ;
    dmo:contraCode "excessive-hba1c-reduction-6-0-42-mmol-mol" ;
    dmo:rationale "excessive HbA1c reduction (<6.0% (<42 mmol/mol)) has been shown to be associated with discontinuation of disability-free survival in community dwelling older people with comorbid diabetes and CKD" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in community dwelling older people with comorbid diabetes and CKD" ;
    dmo:evidenceQuote "excessive HbA1c reduction (<6.0% (<42 mmol/mol)) has been shown to be associated with discontinuation of disability-free survival in community dwelling older people with comorbid diabetes and CKD" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/excessive-reduction-of-insulin-doses-in-patients-with-type-1-diabetes-and-cognitive-impairment> a dmo:Contraindication ;
    rdfs:label "Excessive reduction of insulin doses in patients with type 1 diabetes and cognitive impairment" ;
    dmo:contraCode "excessive-reduction-of-insulin-doses-in-patients-with-type-1-diabetes-and-cognitive-impairment" ;
    dmo:rationale "to avoid rebound hyperglycaemia and diabetic ketoacidosis" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "patients with type 1 diabetes and cognitive impairment" ;
    dmo:evidenceQuote "care must be taken to not excessively reduce insulin doses in order to avoid rebound hyperglycaemia and diabetic ketoacidosis." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/gastrointestinal-antispasmodics-agents> a dmo:Contraindication ;
    rdfs:label "Gastrointestinal antispasmodics agents" ;
    dmo:contraCode "gastrointestinal-antispasmodics-agents" ;
    dmo:rationale "Regular daily prescription of gastrointestinal antispasmodics agents unless the patient has frequent relapse of colic symptoms because of high risk of anti-cholinergic side effects" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "frequent relapse of colic symptoms" ;
    dmo:evidenceQuote "Regular daily prescription of gastrointestinal antispasmodics agents unless the patient has frequent relapse of colic symptoms because of high risk of anti-cholinergic side effects" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/glp-1-receptor-agonist-use-in-frail-inpatients> a dmo:Contraindication ;
    rdfs:label "GLP-1 Receptor Agonist Use in Frail Inpatients" ;
    dmo:contraCode "glp-1-receptor-agonist-use-in-frail-inpatients" ;
    dmo:rationale "in view of further potential weight loss as a side-effect" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "frail and may have an acute illness" ;
    dmo:evidenceQuote "For example, as the inpatient is frail and may have an acute illness, is a GLP-1 receptor agonist still an appropriate choice (in view of further potential weight loss as a side-effect)?" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/h2-receptor-antagonist-at-full-therapeutic-dose> a dmo:Contraindication ;
    rdfs:label "H2 receptor antagonist at full therapeutic dose" ;
    dmo:contraCode "h2-receptor-antagonist-at-full-therapeutic-dose" ;
    dmo:rationale "H2 receptor antagonist at full therapeutic dose for ≥8/52, unless persistent dyspeptic symptoms at lower maintenance dose" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "≥8/52" ;
    dmo:evidenceQuote "H2 receptor antagonist at full therapeutic dose for ≥8/52, unless persistent dyspeptic symptoms at lower maintenance dose" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/intensive-glucose-control> a dmo:Contraindication ;
    rdfs:label "Intensive glucose control" ;
    dmo:contraCode "intensive-glucose-control" ;
    dmo:rationale "Intensive glucose control is contraindicated in frail older people because of the increased risk of hypoglycaemia, which is associated with greater hazards including mortality, extended length-of-stay, increased cardiovascular events, increased risk of fracture inducing falls, and readmissions. The autonomic response and hypoglycaemia symptom arousal may be blunted in frail older people, and they may not be able to communicate symptoms effectively." ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "in frail older people" ;
    dmo:evidenceQuote "In the frail older patient intensive glucose control is contraindicated. Glucose targets should be less stringent, current guidance recommends a target range of 7.8 to 10 mmol/L8." ;
    dmo:evidenceQuote "In the frail older patient intensive glucose control is contraindicated." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/intensive-treatment-with-hypoglycaemic-medications-in-older-patients-75-years-old-with-diabetes-and-ckd> a dmo:Contraindication ;
    rdfs:label "Intensive treatment with hypoglycaemic medications in older patients (≥75 years old) with diabetes and CKD" ;
    dmo:contraCode "intensive-treatment-with-hypoglycaemic-medications-in-older-patients-75-years-old-with-diabetes-and-ckd" ;
    dmo:rationale "Up to 20% of older patients (≥75 years old) with diabetes and CKD are unnecessarily intensively treated with hypoglycaemic medications increasing their risk of severe hypoglycaemia" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in older patients (≥75 years old) with diabetes and CKD" ;
    dmo:evidenceQuote "Up to 20% of older patients (≥75 years old) with diabetes and CKD are unnecessarily intensively treated with hypoglycaemic medications increasing their risk of severe hypoglycaemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/leukotriene-antagonists-in-copd> a dmo:Contraindication ;
    rdfs:label "Leukotriene antagonists in COPD" ;
    dmo:contraCode "leukotriene-antagonists-in-copd" ;
    dmo:rationale "These drugs have no proven role in COPD, they are indicated only in asthma" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "in COPD" ;
    dmo:evidenceQuote "These drugs have no proven role in COPD, they are indicated only in asthma" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/lipid-lowering-therapies> a dmo:Contraindication ;
    rdfs:label "Lipid lowering therapies" ;
    dmo:contraCode "lipid-lowering-therapies" ;
    dmo:rationale "These medications need to be prescribed for a long duration to be of benefit. For short-term use, the risk of ADEs outweighs the potential benefits" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "For short-term use, the risk of ADEs outweighs the potential benefits" ;
    dmo:evidenceQuote "These medications need to be prescribed for a long duration to be of benefit. For short-term use, the risk of ADEs outweighs the potential benefits" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/long-term-oral-nsaids> a dmo:Contraindication ;
    rdfs:label "Long-term oral NSAIDs" ;
    dmo:contraCode "long-term-oral-nsaids" ;
    dmo:rationale "Increased risk of side effects (peptic ulcer disease, bleeding, worsening heart failure, etc.) when taken regularly for ≥2 months" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "regularly for ≥2 months" ;
    dmo:evidenceQuote "Increased risk of side effects (peptic ulcer disease, bleeding, worsening heart failure, etc.) when taken regularly for ≥2 months" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/long-term-oral-steroids> a dmo:Contraindication ;
    rdfs:label "Long-term oral steroids" ;
    dmo:contraCode "long-term-oral-steroids" ;
    dmo:rationale "Increased risk of side effects (peptic ulcer disease, etc.) when taken regularly for ≥2 months. Consider careful dose reduction and gradual discontinuation" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "regularly for ≥2 months" ;
    dmo:evidenceQuote "Increased risk of side effects (peptic ulcer disease, etc.) when taken regularly for ≥2 months. Consider careful dose reduction and gradual discontinuation" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/memantine> a dmo:Contraindication ;
    rdfs:label "Memantine" ;
    dmo:contraCode "memantine" ;
    dmo:rationale "Discontinue and monitor in patients with moderate to severe dementia, unless memantine has clearly improved BPSD (specifically in frail patients who meet the criteria above)" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Discontinue and monitor in patients with moderate to severe dementia, unless memantine has clearly improved BPSD (specifically in frail patients who meet the criteria above)" ;
    dmo:evidenceQuote "Discontinue and monitor in patients with moderate to severe dementia, unless memantine has clearly improved BPSD (specifically in frail patients who meet the criteria above)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/memantine-in-moderate-to-severe-dementia> a dmo:Contraindication ;
    rdfs:label "Memantine in moderate to severe dementia" ;
    dmo:contraCode "memantine-in-moderate-to-severe-dementia" ;
    dmo:rationale "Discontinue and monitor in patients with moderate to severe dementia, unless memantine has clearly improved BPSD (specifically in frail patients who meet the criteria above)" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "moderate to severe dementia" ;
    dmo:evidenceQuote "Discontinue and monitor in patients with moderate to severe dementia, unless memantine has clearly improved BPSD (specifically in frail patients who meet the criteria above)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/mixed-insulins> a dmo:Contraindication ;
    rdfs:label "Mixed insulins" ;
    dmo:contraCode "mixed-insulins" ;
    dmo:rationale "Mixed insulins may convey a greater hazard than a background insulin (NPH or analogue) alone or in conjunction with a short acting insulin with meals. It is difficult to regulate mixed insulins particularly when meal timings and carbohydrate consumption are unpredictable." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in frail older people with unpredictable meal timings and carbohydrate consumption" ;
    dmo:evidenceQuote "It has been reported that mixed insulins may convey a greater hazard than a background insulin (NPH or analogue) alone or in conjunction with a short acting insulin with meals11. It is difficult to regulate mixed insulins particularly when meal timings and carbohydrate consumption are unpredictable." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/multi-vitamin-combination-supplements-for-prophylaxis> a dmo:Contraindication ;
    rdfs:label "Multi-vitamin combination supplements for prophylaxis" ;
    dmo:contraCode "multi-vitamin-combination-supplements-for-prophylaxis" ;
    dmo:rationale "Discontinue when prescribed for prophylaxis rather than treatment" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "prescribed for prophylaxis rather than treatment" ;
    dmo:evidenceQuote "Discontinue when prescribed for prophylaxis rather than treatment" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/muscarinic-antagonists-with-long-term-urinary-bladder-catheterisation> a dmo:Contraindication ;
    rdfs:label "Muscarinic antagonists with long-term urinary bladder catheterisation" ;
    dmo:contraCode "muscarinic-antagonists-with-long-term-urinary-bladder-catheterisation" ;
    dmo:rationale "No benefit with long-term urinary bladder catheterisation, unless clear history of painful detrusor hyperactivity" ;
