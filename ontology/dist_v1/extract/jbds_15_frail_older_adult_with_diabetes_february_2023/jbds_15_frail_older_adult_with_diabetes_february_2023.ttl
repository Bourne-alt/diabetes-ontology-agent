    dmo:mechanism "Activates peroxisome proliferator-activated receptor gamma (PPAR-γ)" ;
    dmo:name "Pioglitazone" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Metformin\nSulphonylureas \nDPP4 inhibitors, pioglitazone, Meglitinides or \nSGLT2 inhibitors" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/sglt-2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT-2 inhibitors" ;
    dmo:drugClassCode "sglt-2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:name "SGLT-2 inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "SGLT-2 inhibitors are to be avoided given their risk of genito-urinary tract infections, dehydration and postural symptoms all of which can affect mental performance" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/sglt2-inhibitor> a dmo:DrugClass ;
    rdfs:label "SGLT2 Inhibitor" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "sglt2-inhibitor" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibits glucose reabsorption in the kidneys, leading to increased urinary glucose excretion" ;
    dmo:name "SGLT2 Inhibitor" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "Alternatively, if the inpatient is on a SGLT2 inhibitor and is acutely unwell or undergoing major surgery, it should be discontinued temporarily or permanently (because of the risk of precipitating ketoacidosis)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/sglt2-inhibitors> a dmo:DrugClass ;
    rdfs:label "SGLT2 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "sglt2-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibit glucose reabsorption in the kidneys, promoting urinary glucose excretion" ;
    dmo:name "SGLT2 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "Metformin\nSulphonylureas \nDPP4 inhibitors, pioglitazone, Meglitinides or \nSGLT2 inhibitors" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/subcutaneous-insulin> a dmo:DrugClass ;
