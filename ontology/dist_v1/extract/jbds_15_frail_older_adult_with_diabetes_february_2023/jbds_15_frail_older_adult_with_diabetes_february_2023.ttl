<https://example.org/dmo/id/recommendation/robust-glucose-monitoring-with-soft-targets-during-illness-or-post-surgery-in-frail-older-patients-with-diabetes> a dmo:Recommendation ;
    rdfs:label "Robust Glucose Monitoring with Soft Targets During Illness or Post-Surgery in Frail Older Patients with Diabetes" ;
    dmo:populationScope "Frail older patients with diabetes who are unwell or have undergone surgery" ;
    dmo:recommendationId "robust-glucose-monitoring-with-soft-targets-during-illness-or-post-surgery-in-frail-older-patients-with-diabetes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "It is important to note that when someone is unwell or has undergone surgery their glucose levels will be elevated, hence robust glucose monitoring with soft glucose targets (7 mmol/L) should be observed until the insulin requirements are established." ;
    dmo:evidenceQuote "It is important to note that when someone is unwell or has undergone surgery their glucose levels will be elevated, hence robust glucose monitoring with soft glucose targets (7 mmol/L) should be observed until the insulin requirements are established." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/robust-prescribing-and-administration-systems-to-reduce-medicine-errors-in-frail-older-patients-with-diabetes> a dmo:Recommendation ;
    rdfs:label "Robust Prescribing and Administration Systems to Reduce Medicine Errors in Frail Older Patients with Diabetes" ;
    dmo:populationScope "Frail older patients with diabetes" ;
    dmo:recommendationId "robust-prescribing-and-administration-systems-to-reduce-medicine-errors-in-frail-older-patients-with-diabetes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Safety" ;
    dmo:statement "Medicine errors are still too high in hospitalised diabetes patients, and in those who are frail and especially those with communication deficits these risks may be amplified. Hence, robust prescribing and administration systems are required with careful cross checking to reduce these hazards." ;
    dmo:evidenceQuote "Medicine errors are still too high in hospitalised diabetes patients, and in those who are frail and especially those with communication deficits these risks may be amplified. Hence, robust prescribing and administration systems are required with careful cross checking to reduce these hazards." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

