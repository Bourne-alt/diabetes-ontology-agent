<https://example.org/dmo/id/recommendation/assessment-of-quality-of-life-in-older-people-with-diabetes-and-frailty> a dmo:Recommendation ;
    rdfs:label "Assessment of quality of life in older people with diabetes and frailty" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "older people with diabetes and frailty" ;
    dmo:recommendationId "assessment-of-quality-of-life-in-older-people-with-diabetes-and-frailty" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "quality of life should be assessed in older people with diabetes and frailty" ;
    dmo:evidenceQuote "Apart from glycaemia targets, other key outcomes that require assessment but usually are not a feature of every day diabetes clinical practice are physical performance measures, an objective assessment of hypoglycaemia risk, falls risk assessment, and quality of life: these outcome measures will prove to have an important influence in deciding if a specific management strategy is worthwhile in routine clinical care of older people with diabetes and frailty." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

