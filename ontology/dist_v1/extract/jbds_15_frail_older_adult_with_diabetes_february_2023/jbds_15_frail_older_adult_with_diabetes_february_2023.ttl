    dmo:triggerWindow "on admission or who becomes acutely unwell during their inpatient stay" ;
    dmo:evidenceQuote "Blood ketone measurement is recommended for the older frail inpatient who is acutely unwell on admission or who becomes acutely unwell during their inpatient stay" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-blood-glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Blood Glucose Monitoring" ;
    dmo:appliesTo "inpatients with type 1 diabetes" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Capillary Blood Glucose Monitoring" ;
    dmo:scheduleId "capillary-blood-glucose-monitoring" ;
    dmo:triggerWindow "pre-meal and pre-bed" ;
    dmo:evidenceQuote "Capillary blood glucose monitoring should occur a minimum of 4 times per day, pre-meal and pre-bed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/capillary-glucose-tests> a dmo:MonitoringSchedule ;
    rdfs:label "Capillary Glucose Tests" ;
    dmo:appliesTo "frail older patients with diabetes" ;
    dmo:frequencyMonths "1"^^xsd:integer ;
    dmo:name "Capillary Glucose Tests" ;
    dmo:scheduleId "capillary-glucose-tests" ;
    dmo:evidenceQuote "patients should have regular capillary glucose tests, preferably in the fasting state." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/comprehensive-geriatric-assessment> a dmo:MonitoringSchedule ;
    rdfs:label "Comprehensive geriatric assessment" ;
    dmo:appliesTo "all patients with chronic kidney disease" ;
    dmo:frequencyMonths "12"^^xsd:integer ;
    dmo:name "Comprehensive geriatric assessment" ;
    dmo:scheduleId "comprehensive-geriatric-assessment" ;
    dmo:evidenceQuote "Baseline CGA should be performed then regular assessments to measure change over time with implementation of suitable interventions." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/glucose-level-assessment-for-hypoglycaemic-symptoms> a dmo:MonitoringSchedule ;
    rdfs:label "Glucose Level Assessment for Hypoglycaemic Symptoms" ;
    dmo:appliesTo "patients exhibiting hypoglycaemic symptoms (confusion, drowsiness, sweating, blurred vision, tremor or an unsteady gait)" ;
    dmo:name "Glucose Level Assessment for Hypoglycaemic Symptoms" ;
    dmo:scheduleId "glucose-level-assessment-for-hypoglycaemic-symptoms" ;
    dmo:evidenceQuote "Glucose levels should also be assessed if patients exhibit any hypoglycaemic symptoms (confusion, drowsiness, sweating, blurred vision, tremor or an unsteady gait)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/hba1c> a dmo:MonitoringSchedule ;
    rdfs:label "HbA1c" ;
    dmo:appliesTo "frail older adults with chronic kidney disease" ;
    dmo:frequencyMonths "3"^^xsd:integer ;
    dmo:name "HbA1c" ;
    dmo:scheduleId "hba1c" ;
    dmo:evidenceQuote "In frail older adults with chronic kidney disease, glycaemic control should be relaxed with a HbA1c range of 7.5-8.5% (59-69 mmol/mol)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/pre-meal-and-before-bed-glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Pre-meal and before bed glucose monitoring" ;
    dmo:appliesTo "older people with diabetes, especially frail patients" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Pre-meal and before bed glucose monitoring" ;
    dmo:scheduleId "pre-meal-and-before-bed-glucose-monitoring" ;
    dmo:triggerWindow "pre-meal times and before bed" ;
    dmo:evidenceQuote "Hence robust monitoring is required optimally at pre-meal times and before bed, with less stringent targets to avoid hypoglycaemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/pre-meal-blood-glucose-monitoring> a dmo:MonitoringSchedule ;
    rdfs:label "Pre-meal Blood Glucose Monitoring" ;
    dmo:appliesTo "frail older people with diabetes in hospital settings" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Pre-meal Blood Glucose Monitoring" ;
    dmo:scheduleId "pre-meal-blood-glucose-monitoring" ;
    dmo:triggerWindow "pre-meal times" ;
    dmo:evidenceQuote "robust monitoring is required optimally at pre-meal times and before bed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/renal-function> a dmo:MonitoringSchedule ;
    rdfs:label "Renal function" ;
    dmo:appliesTo "frail older adults with chronic kidney disease" ;
    dmo:frequencyMonths "3"^^xsd:integer ;
    dmo:name "Renal function" ;
    dmo:scheduleId "renal-function" ;
    dmo:evidenceQuote "Monitoring of renal function and timely adjustment of hypoglycaemic medications is required to avoid excessive lowering of HbA1c." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/systematic-glucose-monitoring-in-hospital-settings> a dmo:MonitoringSchedule ;
    rdfs:label "Systematic glucose monitoring in hospital settings" ;
    dmo:appliesTo "older people with diabetes in hospital settings" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Systematic glucose monitoring in hospital settings" ;
    dmo:scheduleId "systematic-glucose-monitoring-in-hospital-settings" ;
    dmo:evidenceQuote "Older people are also at increased risk of significant hypoglycaemia in hospital settings4, and systematic monitoring is indicated." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/monitoringSchedule/venous-blood-gases-measurement> a dmo:MonitoringSchedule ;
    rdfs:label "Venous Blood Gases Measurement" ;
    dmo:appliesTo "inpatients with type 1 diabetes" ;
    dmo:frequencyMonths "0"^^xsd:integer ;
    dmo:name "Venous Blood Gases Measurement" ;
    dmo:scheduleId "venous-blood-gases-measurement" ;
    dmo:triggerWindow "if there is continued unacceptable hyperglycaemia and deterioration in health status" ;
    dmo:evidenceQuote "Inpatients with type 1 diabetes are at particular risk of DKA and require blood ketones and venous blood gases to be measured if there is continued unacceptable hyperglycaemia and deterioration in health status" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/a-general-inpatient-glucose-range-of-7-8-10-mmol-l-or-acceptable-range-6-12-mmol-l-seems-reasonable-and-the-discussions-around-ideal-and-acceptable-glycaemic-targets-and-national-and-international-policy-statements-in-this-area-have-been-summarised-in-jbds-guidance1-and-glycaemic-targets-should-be-individualised> a dmo:Recommendation ;
    rdfs:label "A general inpatient glucose range of 7.8-10 mmol/L or acceptable range 6 – 12 mmol/L seems reasonable, and the discussions around ideal and acceptable glycaemic targets, and national and international policy statements in this area, have been summarised in JBDS guidance1 and glycaemic targets should be individualised" ;
    dmo:populationScope "frail older inpatient" ;
    dmo:recommendationId "a-general-inpatient-glucose-range-of-7-8-10-mmol-l-or-acceptable-range-6-12-mmol-l-seems-reasonable-and-the-discussions-around-ideal-and-acceptable-glycaemic-targets-and-national-and-international-policy-statements-in-this-area-have-been-summarised-in-jbds-guidance1-and-glycaemic-targets-should-be-individualised" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "A general inpatient glucose range of 7.8-10 mmol/L or acceptable range 6 – 12 mmol/L seems reasonable, and the discussions around ideal and acceptable glycaemic targets, and national and international policy statements in this area, have been summarised in JBDS guidance1 and glycaemic targets should be individualised" ;
    dmo:evidenceQuote "A general inpatient glucose range of 7.8-10 mmol/L or acceptable range 6 – 12 mmol/L seems reasonable, and the discussions around ideal and acceptable glycaemic targets, and national and international policy statements in this area, have been summarised in JBDS guidance1 and glycaemic targets should be individualised" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/a-multidisciplinary-approach-involving-stroke-and-diabetes-teams-to-develop-local-protocols-and-periodic-training-for-the-staff-on-the-comprehensive-assessment-and-management-of-hyperglycaemia-is-appropriate-as-is-an-agreed-approach-to-functional-assessment-and-management-of-frailty> a dmo:Recommendation ;
