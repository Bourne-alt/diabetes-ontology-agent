<https://example.org/dmo/id/riskFactor/low-gfr> a dmo:RiskFactor ;
    rdfs:label "Low GFR" ;
    dmo:evidenceNote "Risk factors which indicate potential decompensating in a patient with diabetes are male sex, low GFR, use of ACE inhibitors, proteinuria, and insulin treatment among others" ;
    dmo:name "Low GFR" ;
