<https://example.org/dmo/id/contraindication/anti-platelets-for-primary-cardiovascular-prevention> a dmo:Contraindication ;
    rdfs:label "Anti-platelets for primary cardiovascular prevention" ;
    dmo:contraCode "anti-platelets-for-primary-cardiovascular-prevention" ;
