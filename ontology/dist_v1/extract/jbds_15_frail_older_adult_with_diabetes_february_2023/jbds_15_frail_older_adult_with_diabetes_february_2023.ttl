<https://example.org/dmo/id/lifestyleIntervention/progressive-resistance-exercise-training> a dmo:LifestyleIntervention ;
    rdfs:label "Progressive resistance exercise training" ;
    dmo:activityTarget "progressive resistance exercise training" ;
    dmo:expectedBenefit "result in muscle hypertrophy, increase in muscle strength, muscle mass and performance" ;
    dmo:interventionCode "progressive-resistance-exercise-training" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "Progressive resistance exercise training" ;
    dmo:evidenceQuote "Multimodality intervention with adequate nutrition and progressive resistance exercise training has been shown to result in muscle hypertrophy, increase in muscle strength, muscle mass and performance" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/reduced-salt-intake-and-increased-activity-where-feasible> a dmo:LifestyleIntervention ;
    rdfs:label "Reduced salt intake and increased activity where feasible" ;
    dmo:interventionCode "reduced-salt-intake-and-increased-activity-where-feasible" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Reduced salt intake and increased activity where feasible" ;
    dmo:evidenceQuote "Initially non-pharmacological interventions may be employed in order to reduce BP – reduced salt intake and increased activity where feasible." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

