    dmo:recommendationId "individualised-care-plan-at-discharge-for-frail-inpatients-with-diabetes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Inpatients with diabetes and frailty should have an individualised care plan in place at the time of discharge from a single clinical unit or hospital ward." ;
    dmo:evidenceQuote "Percentage of inpatients with diabetes and frailty who have an individualised care plan in place at the time of discharge from a single clinical unit or hospital ward in the past year" ;
