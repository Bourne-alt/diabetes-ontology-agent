<https://example.org/dmo/id/lifestyleIntervention/physical-function-assessment> a dmo:LifestyleIntervention ;
    rdfs:label "Physical function assessment" ;
    dmo:activityTarget "Assess physical function on admission and ensure adequate compensating strategies if patient has limited mobility" ;
    dmo:interventionCode "physical-function-assessment" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "Physical function assessment" ;
    dmo:evidenceQuote "It is important to assess physical function on admission and ensure adequate compensating strategies if patient has limited mobility" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/physiotherapy-ot> a dmo:LifestyleIntervention ;
    rdfs:label "Physiotherapy/OT" ;
