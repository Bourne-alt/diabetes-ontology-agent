    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "two-or-more-long-term-conditions" ;
    dmo:evidenceQuote "The presence of two or more long term conditions predicts a high risk of hospital admission" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/type-2-diabetes> a dmo:RiskFactor ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:evidenceNote "Current evidence for dementia in diabetes is predominantly from patients with type 2 diabetes given their older nature hence the majority of recommendations centre around medication review especially of oral medications." ;
    dmo:name "Type 2 Diabetes" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "type-2-diabetes" ;
    dmo:evidenceQuote "Current evidence for dementia in diabetes is predominantly from patients with type 2 diabetes given their older nature hence the majority of recommendations centre around medication review especially of oral medications." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/unexpected-physical-activity> a dmo:RiskFactor ;
    rdfs:label "Unexpected Physical Activity" ;
    dmo:evidenceNote "Unexpected physical activity such as with a physiotherapist or mobilisation after illness can cause glucose lowering." ;
    dmo:name "Unexpected Physical Activity" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "unexpected-physical-activity" ;
    dmo:evidenceQuote "Unexpected physical activity- e.g. with physiotherapist; mobilisation after illness" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/use-of-ace-inhibitors> a dmo:RiskFactor ;
    rdfs:label "Use of ACE Inhibitors" ;
    dmo:evidenceNote "Risk factors which indicate potential decompensating in a patient with diabetes are male sex, low GFR, use of ACE inhibitors, proteinuria, and insulin treatment among others" ;
    dmo:name "Use of ACE Inhibitors" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "use-of-ace-inhibitors" ;
    dmo:evidenceQuote "Risk factors which indicate potential decompensating in a patient with diabetes are male sex, low GFR, use of ACE inhibitors, proteinuria, and insulin treatment among others" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/use-of-dpp4-inhibitors> a dmo:RiskFactor ;
    rdfs:label "Use of DPP4 Inhibitors" ;
    dmo:evidenceNote "DPP4 inhibitors are a class of oral glucose lowering agents used in diabetes management and may contribute to hypoglycaemia risk, especially in frail older adults." ;
    dmo:name "Use of DPP4 Inhibitors" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "use-of-dpp4-inhibitors" ;
    dmo:evidenceQuote "DPP4 inhibitors, pioglitazone, Meglitinides or SGLT2 inhibitors" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/use-of-insulin> a dmo:RiskFactor ;
    rdfs:label "Use of Insulin" ;
    dmo:evidenceNote "Insulin was the second most common medication class causing hypoglycaemia in hospitalised patients, at 13.9%." ;
    dmo:name "Use of Insulin" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "use-of-insulin" ;
    dmo:evidenceQuote "Four medication classes (alone or combination) were the main culprits of which insulin was the second most common (13.9%)" ;
    dmo:evidenceQuote "Risk factors include: polypharmacy, muscle weakness, a history of a previous stroke, use of insulin, cognitive dysfunction, orthostatic hypotension, and visual loss2." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/use-of-meglitinides> a dmo:RiskFactor ;
    rdfs:label "Use of Meglitinides" ;
    dmo:evidenceNote "Meglitinides are a class of oral glucose lowering agents used in diabetes management and may contribute to hypoglycaemia risk, especially in frail older adults." ;
    dmo:name "Use of Meglitinides" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "use-of-meglitinides" ;
