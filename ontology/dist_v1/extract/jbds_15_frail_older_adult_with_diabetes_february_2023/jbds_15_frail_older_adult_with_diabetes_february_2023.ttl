    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/hyperglycaemia> a dmo:RiskFactor ;
    rdfs:label "Hyperglycaemia" ;
    dmo:evidenceNote "Hyperglycaemia has been implicated in reducing cognitive function suggesting control should not be too lax." ;
    dmo:name "Hyperglycaemia" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "hyperglycaemia" ;
    dmo:evidenceQuote "Hyperglycaemia has been implicated in reducing cognitive function suggesting control should not be too lax." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/hyperglycaemia-on-admission> a dmo:RiskFactor ;
    rdfs:label "Hyperglycaemia on admission" ;
    dmo:evidenceNote "Hyperglycaemia on admission (defined as blood glucose level >6.1 mmol/L) is associated with poor outcome regardless of diabetes status7." ;
    dmo:name "Hyperglycaemia on admission" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "hyperglycaemia-on-admission" ;
    dmo:evidenceQuote "Hyperglycaemia on admission (defined as blood glucose level >6.1 mmol/L) is associated with poor outcome regardless of diabetes status7." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/hypoglycaemia> a dmo:RiskFactor ;
    rdfs:label "Hypoglycaemia" ;
    dmo:evidenceNote "People on insulin may be prone to hypoglycaemia and potentially nocturia will result from persistent hyperglycaemia, both of which may increase inpatient falls risk." ;
    dmo:name "Hypoglycaemia" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "hypoglycaemia" ;
    dmo:evidenceQuote "People on insulin may be prone to hypoglycaemia and potentially nocturia will result from persistent hyperglycaemia, both of which may increase inpatient falls risk." ;
    dmo:evidenceQuote "Medicine errors are still too high in hospitalised diabetes patients, and in those who are frail and especially those with communication deficits these risks may be amplified." ;
    dmo:evidenceQuote "Data linking hypoglycaemia and morbidity in the frail group are more robust. On balance more weight should be given to avoiding hypoglycaemia even at the risk of running slightly higher blood glucose during elective admissions." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/hypoglycaemia-in-older-adults> a dmo:RiskFactor ;
    rdfs:label "Hypoglycaemia in Older Adults" ;
    dmo:evidenceNote "Hypoglycaemia is a major cause of hospital admissions in adults over 60, with 72% of such admissions due to hypoglycaemia." ;
    dmo:name "Hypoglycaemia in Older Adults" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "hypoglycaemia-in-older-adults" ;
    dmo:evidenceQuote "Similarly, in England, between 2005 and 2014 there were over 72,000 admissions due to hypoglycaemia in the over 60s. This equates to 72% of admissions due to hypoglycaemia in this cohort11." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

