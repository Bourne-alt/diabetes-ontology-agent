    dmo:recommendationType "Treatment" ;
    dmo:statement "Categorise frailty as Mild, Moderate to Severe, and set glucose targets accordingly: Mild F 7.5–10 mmol/L, ModF-SF 7.5–12 mmol/L" ;
    dmo:evidenceQuote "Glucose Management Acute illness Categorise Moderate - Severe Frailty Categorise Mild Frailty Random Glucose - Mild F 7.5 - 10 mmol.l ModF-SF  7.5-12 mmol/l" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

