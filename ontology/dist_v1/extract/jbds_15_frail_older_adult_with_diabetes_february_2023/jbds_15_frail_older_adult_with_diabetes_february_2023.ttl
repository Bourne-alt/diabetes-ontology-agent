<https://example.org/dmo/id/adverseEffect/severe-hypoglycemia> a dmo:AdverseEffect ;
    rdfs:label "Severe Hypoglycemia" ;
    dmo:adverseEffectCode "severe-hypoglycemia" ;
    dmo:frequencyCategory "Uncommon" ;
    dmo:name "Severe Hypoglycemia" ;
    dmo:severity "LifeThreatening" ;
    dmo:evidenceQuote "Up to 20% of older patients (≥75 years old) with diabetes and CKD are unnecessarily intensively treated with hypoglycaemic medications increasing their risk of severe hypoglycaemia8." ;
    dmo:evidenceQuote "Intensive Treatment and Severe Hypoglycemia Among Adults With Type 2 Diabetes. JAMA Intern Med. 2016;176:969-78." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

