    dmo:name "Hyperglycaemia" ;
    dmo:symptomCode "hyperglycaemia" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Patients with cognitive impairment or delirium must have their blood glucose levels carefully monitored to ensure hypoglycaemia or hyperglycaemia does not worsen their condition" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/hypoglycaemia> a dmo:Symptom ;
    rdfs:label "Hypoglycaemia" ;
    dmo:hpoCode "HP:0001934" ;
    dmo:name "Hypoglycaemia" ;
    dmo:symptomCode "hypoglycaemia" ;
    dmo:urgency "Emergency" ;
    dmo:evidenceQuote "Older people are also at increased risk of significant hypoglycaemia in hospital settings4, and systematic monitoring is indicated." ;
    dmo:evidenceQuote "Patients with cognitive impairment or delirium must have their blood glucose levels carefully monitored to ensure hypoglycaemia or hyperglycaemia does not worsen their condition" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/neuroglycopaenic-symptoms> a dmo:Symptom ;
    rdfs:label "Neuroglycopaenic Symptoms" ;
    dmo:name "Neuroglycopaenic Symptoms" ;
    dmo:symptomCode "neuroglycopaenic-symptoms" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "often fail to perceive neuroglycopaenic symptoms or be unable to alert staff because of dementia or cognitive dysfunction12." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/osmotic-symptoms> a dmo:Symptom ;
    rdfs:label "Osmotic symptoms" ;
    dmo:name "Osmotic symptoms" ;
    dmo:symptomCode "osmotic-symptoms" ;
    dmo:urgency "Routine" ;
    dmo:evidenceQuote "Osmotic symptoms may be less apparent in older frail people as the renal threshold for glycosuria can be elevated and this and other symptoms such as fatigue can be attributed to features associated with aging, such as confusion and general inactivity1." ;
    dmo:evidenceQuote "Such deficits may have an impact on the patient’s capacity to voice problems such as osmotic symptoms or hypoglycaemia;" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/postural-symptoms> a dmo:Symptom ;
