<https://example.org/dmo/id/riskFactor/increase-in-caloric-intake-from-nutritional-supplements-or-ng-feeds> a dmo:RiskFactor ;
    rdfs:label "Increase in Caloric Intake from Nutritional Supplements or NG Feeds" ;
    dmo:evidenceNote "Higher caloric intake from supplements or NG feeds than pre-admission can lead to elevated glucose levels." ;
    dmo:name "Increase in Caloric Intake from Nutritional Supplements or NG Feeds" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "increase-in-caloric-intake-from-nutritional-supplements-or-ng-feeds" ;
    dmo:evidenceQuote "Increase in caloric intake from nutritional supplements or NG feeds above that taken pre-admission; different nutritional content to usual food; meal times different to those in community" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/increasing-atheromatous-burden> a dmo:RiskFactor ;
    rdfs:label "Increasing Atheromatous Burden" ;
    dmo:evidenceNote "The benefits of statin therapy in primary prevention may be related to the increased atheromatous burden in older people." ;
    dmo:name "Increasing Atheromatous Burden" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "increasing-atheromatous-burden" ;
    dmo:evidenceQuote "the benefits perhaps related to the increased atheromatous burden in older people9." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/inefficient-ordering-system> a dmo:RiskFactor ;
    rdfs:label "Inefficient Ordering System" ;
    dmo:evidenceNote "A recent study in care homes showed that each care home resident was taking eight medicines each on average and on any single day 70% of the patients experienced at least one medication error because of inaccessible doctor, not usual doctor, work load pressure, lack of medication training, drug round interruptions, lack of team work among home practice and pharmacy and inefficient ordering system" ;
    dmo:name "Inefficient Ordering System" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "inefficient-ordering-system" ;
    dmo:evidenceQuote "A recent study in care homes showed that each care home resident was taking eight medicines each on average and on any single day 70% of the patients experienced at least one medication error because of inaccessible doctor, not usual doctor, work load pressure, lack of medication training, drug round interruptions, lack of team work among home practice and pharmacy and inefficient ordering system" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/infections-with-resistant-organisms> a dmo:RiskFactor ;
    rdfs:label "Infections with Resistant Organisms" ;
    dmo:evidenceNote "Residents of care homes have at least double the risk of urine infections and four times the risk of infections with resistant organisms" ;
    dmo:name "Infections with Resistant Organisms" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "infections-with-resistant-organisms" ;
    dmo:evidenceQuote "Residents of care homes have at least double the risk of urine infections and four times the risk of infections with resistant organisms" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/injection-into-areas-of-lipohypertrophy-lipoatrophy> a dmo:RiskFactor ;
    rdfs:label "Injection into Areas of Lipohypertrophy / Lipoatrophy" ;
    dmo:evidenceNote "Injections into abnormal skin areas can affect insulin absorption and lead to glycaemic variability." ;
    dmo:name "Injection into Areas of Lipohypertrophy / Lipoatrophy" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "injection-into-areas-of-lipohypertrophy-lipoatrophy" ;
    dmo:evidenceQuote "Injection into areas of lipohypertrophy/ lipoatrophy" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/insulin-and-oha-prescription-administration-errors> a dmo:RiskFactor ;
    rdfs:label "Insulin and OHA Prescription / Administration Errors" ;
    dmo:evidenceNote "Errors in prescribing or administering insulin or oral hypoglycaemic agents can cause glycaemic variability." ;
    dmo:name "Insulin and OHA Prescription / Administration Errors" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "insulin-and-oha-prescription-administration-errors" ;
    dmo:evidenceQuote "Insulin and OHA prescription / administration errors" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/insulin-and-oha-prescription-administration-errors-inappropriate-use-of-stat-doses> a dmo:RiskFactor ;
    rdfs:label "Insulin and OHA Prescription / Administration Errors / Inappropriate Use of 'Stat' Doses" ;
    dmo:evidenceNote "Errors in prescribing or administering insulin or OHA, including inappropriate 'stat' doses, can cause glycaemic variability." ;
    dmo:name "Insulin and OHA Prescription / Administration Errors / Inappropriate Use of 'Stat' Doses" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "insulin-and-oha-prescription-administration-errors-inappropriate-use-of-stat-doses" ;
