<https://example.org/dmo/id/recommendation/assessment-of-capacity-for-self-administration-of-insulin-in-frail-older-patients-with-diabetes> a dmo:Recommendation ;
    rdfs:label "Assessment of Capacity for Self-Administration of Insulin in Frail Older Patients with Diabetes" ;
    dmo:populationScope "Frail older patients with diabetes being discharged who are to self-administer insulin" ;
    dmo:recommendationId "assessment-of-capacity-for-self-administration-of-insulin-in-frail-older-patients-with-diabetes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Lifestyle" ;
    dmo:statement "If the patient is to self-administer then carefully consider their capacity and competence to do this. They need to be observed and allowed to rehearse the skills (testing glucose and injecting insulin), preferably with any carer or family member." ;
    dmo:evidenceQuote "If the patient is to self-administer then carefully consider their capacity and competence to do this. They need to be observed and allowed to rehearse the skills (testing glucose and injecting insulin), preferably with any carer or family member." ;
