<https://example.org/dmo/id/recommendation/access-to-capillary-blood-glucose-and-blood-ketone-monitoring-for-community-living-older-patients-with-diabetes> a dmo:Recommendation ;
    rdfs:label "Access to capillary blood glucose and blood ketone monitoring for community-living older patients with diabetes" ;
