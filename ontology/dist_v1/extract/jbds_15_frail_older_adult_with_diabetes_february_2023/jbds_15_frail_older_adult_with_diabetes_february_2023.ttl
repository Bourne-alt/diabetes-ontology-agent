    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/estimated-10-year-risk-of-developing-cardiovascular-disease-using-the-qrisk-23-assessment-tool> a dmo:LabTest ;
    rdfs:label "Estimated 10-year risk of developing cardiovascular disease using the QRISK®23 assessment tool" ;
    dmo:definition "their estimated 10-year risk of developing cardiovascular disease using the QRISK®23 assessment tool is 10% or more" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "estimated-10-year-risk-of-developing-cardiovascular-disease-using-the-qrisk-23-assessment-tool" ;
    dmo:name "Estimated 10-year risk of developing cardiovascular disease using the QRISK®23 assessment tool" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "their estimated 10-year risk of developing cardiovascular disease using the QRISK®23 assessment tool is 10% or more" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/fasting-state-glucose-level> a dmo:LabTest ;
    rdfs:label "Fasting State Glucose Level" ;
    dmo:definition "Glucose levels should be assessed in the fasting state to monitor targets in frail older patients with diabetes." ;
    dmo:fastingRequired "true"^^xsd:boolean ;
    dmo:labTestCode "fasting-state-glucose-level" ;
    dmo:name "Fasting State Glucose Level" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "patients should have regular capillary glucose tests, preferably in the fasting state." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/hba1c> a dmo:LabTest ;
    rdfs:label "HbA1c" ;
    dmo:definition "Measure HbA1c and gauge control over previous 2 months" ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c" ;
    dmo:loincCode "4548-4" ;
    dmo:name "HbA1c" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/mol" ;
    dmo:evidenceQuote "Measure HbA1c and gauge control over previous 2 months" ;
    dmo:evidenceQuote "Immediate referral to DIT if HbA1c >69 mmol/mol or if on insulin pump or CSII" ;
    dmo:evidenceQuote "with HbA1c, blood pressure and serum cholesterol levels being helpful in some cases" ;
    dmo:evidenceQuote "The document should clarify the target range of HbA1c and whether management is being supported by CBG readings." ;
    dmo:evidenceQuote "HbA1c, BP and cholesterol levels exist for patients on a high risk register" ;
    dmo:evidenceQuote "HbA1c is a more global measurement of glycaemia for the few weeks prior to the measurement being taken and is not suitable for use in making management choices during hospital days of a few days duration" ;
    dmo:evidenceQuote "Current guidance sets HbA1c targets between 53 to 64 mmol/mol (7-8%). However, laxer targets up to 70 mmol/mol (8.5%) are also accepted on an individualised basis 5,6." ;
    dmo:evidenceQuote "HbA1c, diabetes and cognitive decline: the English Longitudinal Study of Ageing. Diabetologia. 2018 61:839–848" ;
    dmo:evidenceQuote "In frail older adults with chronic kidney disease, glycaemic control should be relaxed with a HbA1c range of 7.5-8.5% (59-69 mmol/mol)" ;
    dmo:evidenceQuote "timely adjustment of hypoglycaemic medications is required to avoid excessive lowering of HbA1c." ;
    dmo:evidenceQuote "Aim for monotherapy. Target HbA1c: <8%/64 mmol/mol. Stringent glycaemic control is unnecessary. Increases risk of stroke and VTE disease." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/hba1c-7-5-8-5> a dmo:LabTest ;
    rdfs:label "HbA1c 7.5-8.5%" ;
    dmo:definition "A recommended HbA1c target range for frail older adults with chronic kidney disease to avoid hypoglycaemia and further deterioration of frailty." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c-7-5-8-5" ;
    dmo:loincCode "4548-4" ;
    dmo:name "HbA1c 7.5-8.5%" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "percent" ;
    dmo:evidenceQuote "In frail older adults with chronic kidney disease, glycaemic control should be relaxed with a HbA1c range of 7.5-8.5% (59-69 mmol/mol)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/hba1c-testing> a dmo:LabTest ;
    rdfs:label "HbA1c testing" ;
    dmo:definition "HbA1c testing is used to determine diabetes status in patients who have no history of diabetes but presented with stress hyperglycaemia." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "hba1c-testing" ;
    dmo:name "HbA1c testing" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "Patients who have no history of diabetes and presented with stress hyperglycaemia will require HbA1c testing to determine diabetes status and they should be followed up." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/ketones> a dmo:LabTest ;
