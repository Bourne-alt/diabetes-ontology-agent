<https://example.org/dmo/id/riskFactor/insulin-resistance-due-to-stress-of-illness> a dmo:RiskFactor ;
    rdfs:label "Insulin Resistance Due to Stress of Illness" ;
    dmo:evidenceNote "Stress from illness such as infection can lead to insulin resistance." ;
    dmo:name "Insulin Resistance Due to Stress of Illness" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "insulin-resistance-due-to-stress-of-illness" ;
    dmo:evidenceQuote "Insulin resistance due to stress of illness e.g. infection" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/insulin-therapy> a dmo:RiskFactor ;
    rdfs:label "Insulin Therapy" ;
    dmo:evidenceNote "Insulin therapy poses the greatest risk and if it is required it must be used cautiously." ;
    dmo:name "Insulin Therapy" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "insulin-therapy" ;
    dmo:evidenceQuote "Insulin therapy poses the greatest risk and if it is required it must be used cautiously." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/insulin-treatment> a dmo:RiskFactor ;
    rdfs:label "Insulin Treatment" ;
    dmo:evidenceNote "Risk factors which indicate potential decompensating in a patient with diabetes are male sex, low GFR, use of ACE inhibitors, proteinuria, and insulin treatment among others" ;
    dmo:name "Insulin Treatment" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "insulin-treatment" ;
    dmo:evidenceQuote "Risk factors which indicate potential decompensating in a patient with diabetes are male sex, low GFR, use of ACE inhibitors, proteinuria, and insulin treatment among others" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/intensive-glucose-control> a dmo:RiskFactor ;
    rdfs:label "Intensive Glucose Control" ;
    dmo:evidenceNote "Intensive glucose control is a modifiable risk factor because it can be adjusted or suspended in frail older patients to reduce hypoglycaemia risk." ;
    dmo:name "Intensive Glucose Control" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "intensive-glucose-control" ;
    dmo:evidenceQuote "In the frail older patient intensive glucose control is contraindicated." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/lack-of-access-to-snacks> a dmo:RiskFactor ;
    rdfs:label "Lack of Access to Snacks" ;
    dmo:evidenceNote "Inability to access snacks can contribute to hypoglycaemia." ;
    dmo:name "Lack of Access to Snacks" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "lack-of-access-to-snacks" ;
    dmo:evidenceQuote "lack of access to snacks" ;
