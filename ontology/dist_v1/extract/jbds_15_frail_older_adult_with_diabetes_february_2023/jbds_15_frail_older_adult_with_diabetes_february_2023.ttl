<https://example.org/dmo/id/riskFactor/use-of-steroids> a dmo:RiskFactor ;
    rdfs:label "Use of Steroids" ;
    dmo:evidenceNote "High-dose steroids can induce hyperglycaemia and require specific treatment algorithms to manage glucose levels, increasing the risk of hypoglycaemia if not managed properly." ;
    dmo:name "Use of Steroids" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "use-of-steroids" ;
    dmo:evidenceQuote "Diet only- poor control recently on pre-admission HbA1c; or instigation of high dose steroids*" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/visual-loss> a dmo:RiskFactor ;
    rdfs:label "Visual Loss" ;
    dmo:evidenceNote "Older people with diabetes have an increased falls risk due to the presence of multiple risk factors1. Risk factors include: polypharmacy, muscle weakness, a history of a previous stroke, use of insulin, cognitive dysfunction, orthostatic hypotension, and visual loss2." ;
    dmo:name "Visual Loss" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "visual-loss" ;
    dmo:evidenceQuote "Risk factors include: polypharmacy, muscle weakness, a history of a previous stroke, use of insulin, cognitive dysfunction, orthostatic hypotension, and visual loss2." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/work-load-pressure> a dmo:RiskFactor ;
    rdfs:label "Work Load Pressure" ;
    dmo:evidenceNote "A recent study in care homes showed that each care home resident was taking eight medicines each on average and on any single day 70% of the patients experienced at least one medication error because of inaccessible doctor, not usual doctor, work load pressure, lack of medication training, drug round interruptions, lack of team work among home practice and pharmacy and inefficient ordering system" ;
    dmo:name "Work Load Pressure" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "work-load-pressure" ;
    dmo:evidenceQuote "A recent study in care homes showed that each care home resident was taking eight medicines each on average and on any single day 70% of the patients experienced at least one medication error because of inaccessible doctor, not usual doctor, work load pressure, lack of medication training, drug round interruptions, lack of team work among home practice and pharmacy and inefficient ordering system" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/at-risk-foot> a dmo:Symptom ;
    rdfs:label "At-Risk Foot" ;
    dmo:name "At-Risk Foot" ;
    dmo:symptomCode "at-risk-foot" ;
    dmo:urgency "Routine" ;
    dmo:evidenceQuote "international and national data suggest that at least a third of patients with diabetes in hospital have an at-risk foot, and this is higher in older people6,7." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/blurred-vision> a dmo:Symptom ;
    rdfs:label "Blurred Vision" ;
    dmo:name "Blurred Vision" ;
    dmo:symptomCode "blurred-vision" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Glucose levels should also be assessed if patients exhibit any hypoglycaemic symptoms (confusion, drowsiness, sweating, blurred vision, tremor or an unsteady gait)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/cognitive-function-deficits> a dmo:Symptom ;
    rdfs:label "Cognitive Function Deficits" ;
    dmo:name "Cognitive Function Deficits" ;
    dmo:symptomCode "cognitive-function-deficits" ;
    dmo:urgency "Routine" ;
    dmo:evidenceQuote "there are known associations between deficits in cognitive function and dementia in patients with diabetes9." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/cognitive-impairment> a dmo:Symptom ;
    rdfs:label "Cognitive Impairment" ;
    dmo:hpoCode "HP:0000717" ;
    dmo:name "Cognitive Impairment" ;
    dmo:symptomCode "cognitive-impairment" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Older adults with diabetes and frailty should be screened for dementia and lower thresholds for suspicion of cognitive impairment considered in such individuals" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/confusion> a dmo:Symptom ;
    rdfs:label "Confusion" ;
    dmo:hpoCode "HP:0000708" ;
    dmo:name "Confusion" ;
    dmo:symptomCode "confusion" ;
    dmo:urgency "Routine" ;
    dmo:evidenceQuote "Osmotic symptoms may be less apparent in older frail people as the renal threshold for glycosuria can be elevated and this and other symptoms such as fatigue can be attributed to features associated with aging, such as confusion and general inactivity1." ;
    dmo:evidenceQuote "such as fatigue can be attributed to features associated with aging, such as confusion and general inactivity1." ;
    dmo:evidenceQuote "However given the risks of falls, confusion and risks of hypoglycaemia, a pragmatic approach is needed to avoid unnecessary risk and harm from hypoglycaemia as well4." ;
    dmo:evidenceQuote "Glucose levels should also be assessed if patients exhibit any hypoglycaemic symptoms (confusion, drowsiness, sweating, blurred vision, tremor or an unsteady gait)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/dehydration> a dmo:Symptom ;
    rdfs:label "Dehydration" ;
    dmo:hpoCode "HP:0001943" ;
    dmo:name "Dehydration" ;
    dmo:symptomCode "dehydration" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Clinicians must be aware of the implications of delirium on oral intake and the implications of dehydration and caloric intake on diabetes care and medication dosing." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/delirium> a dmo:Symptom ;
    rdfs:label "Delirium" ;
    dmo:hpoCode "HP:0000719" ;
    dmo:name "Delirium" ;
    dmo:symptomCode "delirium" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "Patients with cognitive impairment or delirium must have their blood glucose levels carefully monitored to ensure hypoglycaemia or hyperglycaemia does not worsen their condition" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/symptom/dementia> a dmo:Symptom ;
