<https://example.org/dmo/id/complicationStage/chronic-kidney-disease> a dmo:ComplicationStage ;
    rdfs:label "Chronic Kidney Disease" ;
    dmo:name "Chronic Kidney Disease" ;
    dmo:stageCode "chronic-kidney-disease" ;
    dmo:stageCriteria "Diabetes is associated with an accelerated ageing process that promotes frailty2. Diabetes-associated complications such as chronic kidney disease (CKD) further increase the risk of frailty3." ;
    dmo:stageOrder "1"^^xsd:integer ;
    dmo:evidenceQuote "Diabetes is associated with an accelerated ageing process that promotes frailty2. Diabetes-associated complications such as chronic kidney disease (CKD) further increase the risk of frailty3." ;
