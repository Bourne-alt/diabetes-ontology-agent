    dmo:evidenceQuote "Where possible or indicated, flash glucose monitoring and other ‘wearables’ should be considered to enhance blood glucose monitoring, and avoid frequent skin pricking for capillary glucose measurement" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/acute-illness> a dmo:RiskFactor ;
    rdfs:label "Acute Illness" ;
    dmo:evidenceNote "Acute illness in a frail inpatient may influence the appropriateness of certain diabetes therapies, such as GLP-1 receptor agonists." ;
    dmo:name "Acute Illness" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "acute-illness" ;
    dmo:evidenceQuote "For example, as the inpatient is frail and may have an acute illness, is a GLP-1 receptor agonist still an appropriate choice (in view of further potential weight loss as a side-effect)?" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/acute-kidney-injury> a dmo:RiskFactor ;
    rdfs:label "Acute Kidney Injury" ;
    dmo:evidenceNote "Acute kidney injury is a non-modifiable condition that can affect glucose regulation." ;
    dmo:name "Acute Kidney Injury" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "acute-kidney-injury" ;
    dmo:evidenceQuote "Acute kidney injury; severe hepatic dysfunction" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/acute-stroke-illness> a dmo:RiskFactor ;
    rdfs:label "Acute stroke illness" ;
    dmo:evidenceNote "Frailty is present in 1 in 4 acute stroke patients" ;
    dmo:name "Acute stroke illness" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "acute-stroke-illness" ;
    dmo:evidenceQuote "Frailty is present in 1 in 4 acute stroke patients" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/advanced-age> a dmo:RiskFactor ;
    rdfs:label "Advanced Age" ;
    dmo:evidenceNote "The benefits of statin therapy in secondary prevention in those over 80 years of age is limited." ;
    dmo:name "Advanced Age" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "advanced-age" ;
    dmo:evidenceQuote "The benefits of statin therapy in secondary prevention in those over 80 year of age is limited." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/adverse-drug-reactions> a dmo:RiskFactor ;
    rdfs:label "Adverse Drug Reactions" ;
    dmo:evidenceNote "Adverse drug reactions are a significant cause of hospital admissions in older adults, particularly due to insulin and oral glucose-lowering agents." ;
    dmo:name "Adverse Drug Reactions" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "adverse-drug-reactions" ;
    dmo:evidenceQuote "In the US the number of admissions in those over 65 years due to adverse drug reactions is around 120,000 with 700,000 emergency department visits. Four medication classes (alone or combination) were the main culprits of which insulin was the second most common (13.9%) and oral glucose lowering agents being the 4th at 10.7%10." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/anorexia-and-under-nutrition> a dmo:RiskFactor ;
    rdfs:label "Anorexia and Under Nutrition" ;
    dmo:evidenceNote "Anorexia and under nutrition, which increases as renal function declines, are underlying factors that lead to frailty especially in patients with end stage renal disease (ESRD) or those on dialysis5." ;
    dmo:name "Anorexia and Under Nutrition" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "anorexia-and-under-nutrition" ;
    dmo:evidenceQuote "Anorexia and under nutrition, which increases as renal function declines, are underlying factors that lead to frailty especially in patients with end stage renal disease (ESRD) or those on dialysis5." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/at-risk-foot> a dmo:RiskFactor ;
    rdfs:label "At-risk Foot" ;
    dmo:evidenceNote "International and national data suggest that at least a third of patients with diabetes in hospital have an at-risk foot, and this is higher in older people6,7" ;
    dmo:name "At-risk Foot" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "at-risk-foot" ;
    dmo:evidenceQuote "international and national data suggest that at least a third of patients with diabetes in hospital have an at-risk foot, and this is higher in older people6,7" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/cardiovascular-risk-factors> a dmo:RiskFactor ;
    rdfs:label "Cardiovascular Risk Factors" ;
    dmo:evidenceNote "Document explicitly lists this as a risk factor to be evaluated." ;
    dmo:name "Cardiovascular Risk Factors" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "cardiovascular-risk-factors" ;
    dmo:evidenceQuote "poorly controlled diabetes, history of hypoglycaemia, poor nutritional intake, cardiovascular risk factors, co-morbidities including recent disabling stroke or fracture, polypharmacy with potential drug interactions, poor support or self-care, activities of daily living, risk of DKA and hyperglycaemia, risk of falls, susceptibility for infections, residence in care homes, depression and dementia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/carotid-stenosis> a dmo:RiskFactor ;
    rdfs:label "Carotid stenosis" ;
    dmo:evidenceNote "Carotid stenting may be considered in patients with asymptomatic (>70%) or symptomatic (>50%) carotid stenosis" ;
    dmo:name "Carotid stenosis" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "carotid-stenosis" ;
    dmo:evidenceQuote "Carotid stenting may be considered in patients with asymptomatic (>70%) or symptomatic (>50%) carotid stenosis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/catheterisation> a dmo:RiskFactor ;
    rdfs:label "Catheterisation" ;
    dmo:evidenceNote "Older people with diabetes who are catheterised have complex mobility and neurological issues and are prone to frequent urine infections" ;
    dmo:name "Catheterisation" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "catheterisation" ;
    dmo:evidenceQuote "Older people with diabetes who are catheterised have complex mobility and neurological issues and are prone to frequent urine infections" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/chronic-kidney-disease> a dmo:RiskFactor ;
    rdfs:label "Chronic kidney disease" ;
    dmo:evidenceNote "Liaise with DIT in the presence of stage 3b or above CKD; assess ‘hypo’ risk from existing GLT" ;
    dmo:name "Chronic kidney disease" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "chronic-kidney-disease" ;
    dmo:evidenceQuote "Liaise with DIT in the presence of stage 3b or above CKD; assess ‘hypo’ risk from existing GLT" ;
    dmo:evidenceQuote "Diabetes-associated complications such as chronic kidney disease (CKD) further increase the risk of frailty3." ;
    dmo:evidenceQuote "Percentage of older inpatients with diabetes, frailty and chronic kidney disease (CKD) receiving comprehensive geriatric assessment (CGA) including nutritional assessment in a single clinical unit or hospital ward in the past year" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/cognitive-deficits> a dmo:RiskFactor ;
    rdfs:label "Cognitive Deficits" ;
    dmo:evidenceNote "Frailty can also be associated with cognitive deficits affecting a person’s capacity to self-manage their diabetes and communicate with family or carers." ;
    dmo:name "Cognitive Deficits" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "cognitive-deficits" ;
    dmo:evidenceQuote "Frailty can also be associated with cognitive deficits affecting a person’s capacity to self-manage their diabetes and communicate with family or carers." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/cognitive-dysfunction> a dmo:RiskFactor ;
    rdfs:label "Cognitive Dysfunction" ;
    dmo:evidenceNote "Older people with diabetes have an increased falls risk due to the presence of multiple risk factors1. Risk factors include: polypharmacy, muscle weakness, a history of a previous stroke, use of insulin, cognitive dysfunction, orthostatic hypotension, and visual loss2." ;
    dmo:name "Cognitive Dysfunction" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "cognitive-dysfunction" ;
    dmo:evidenceQuote "Risk factors include: polypharmacy, muscle weakness, a history of a previous stroke, use of insulin, cognitive dysfunction, orthostatic hypotension, and visual loss2." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/cognitive-impairment> a dmo:RiskFactor ;
    rdfs:label "Cognitive impairment" ;
    dmo:evidenceNote "Assess cognitive function to ensure compliance with therapy and reduce risk of ‘hypos’ – see Appendix 3" ;
    dmo:name "Cognitive impairment" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "cognitive-impairment" ;
    dmo:evidenceQuote "Assess cognitive function to ensure compliance with therapy and reduce risk of ‘hypos’ – see Appendix 3" ;
    dmo:evidenceQuote "Patients with cognitive impairment are five times more likely to get hospitalised with various reasons including lower respiratory and urinary infections but they do not get any additional care from primary care" ;
    dmo:evidenceQuote "Simplification may be necessary if the patients’ cognitive or functional ability has declined" ;
    dmo:evidenceQuote "Patients with diabetes and cognitive impairment are a subgroup of the frail older adult that need a specific focus." ;
    dmo:evidenceQuote "Particular care must be taken if there is cognitive impairment." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/cognitive-impairment-and-dementia> a dmo:RiskFactor ;
    rdfs:label "Cognitive Impairment and Dementia" ;
    dmo:evidenceNote "文档中明确指出该因素与延迟或失败出院、早期再入院相关" ;
    dmo:name "Cognitive Impairment and Dementia" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "cognitive-impairment-and-dementia" ;
    dmo:evidenceQuote "those with a history of repeated admissions for poor glucose control, hypoglycaemia, those with moderate to severe frailty, those with high comorbidity load, those with cognitive impairment and dementia who have still managed to remain in their own homes prior to admission, and those from residential care homes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/communication-deficits> a dmo:RiskFactor ;
    rdfs:label "Communication Deficits" ;
    dmo:evidenceNote "Communication deficits are a non-modifiable risk factor that increases the risk of medicine errors in hospitalised diabetes patients." ;
    dmo:name "Communication Deficits" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "communication-deficits" ;
    dmo:evidenceQuote "Medicine errors are still too high in hospitalised diabetes patients, and in those who are frail and especially those with communication deficits these risks may be amplified." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/comorbid-conditions> a dmo:RiskFactor ;
    rdfs:label "Comorbid Conditions" ;
    dmo:evidenceNote "Other factors that may lead to resolution of hyperglycaemia in CKD are gradual reduction of renal gluconeogenesis as renal function declines, physical inactivity and comorbid conditions6." ;
    dmo:name "Comorbid Conditions" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "comorbid-conditions" ;
    dmo:evidenceQuote "Other factors that may lead to resolution of hyperglycaemia in CKD are gradual reduction of renal gluconeogenesis as renal function declines, physical inactivity and comorbid conditions6." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/deconditioning> a dmo:RiskFactor ;
    rdfs:label "Deconditioning" ;
    dmo:evidenceNote "Be aware that deconditioning can take place within a few days of enforced bed rest or immobilisation" ;
    dmo:name "Deconditioning" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "deconditioning" ;
    dmo:evidenceQuote "Be aware that deconditioning can take place within a few days of enforced bed rest or immobilisation" ;
    dmo:evidenceQuote "deconditioning can take place within a few days of enforced bed rest or immobilisation" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/dehydration> a dmo:RiskFactor ;
    rdfs:label "Dehydration" ;
    dmo:evidenceNote "Clinicians must be aware of the implications of delirium on oral intake and the implications of dehydration and caloric intake on diabetes care and medication dosing." ;
    dmo:name "Dehydration" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "dehydration" ;
    dmo:evidenceQuote "Clinicians must be aware of the implications of delirium on oral intake and the implications of dehydration and caloric intake on diabetes care and medication dosing." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/delirium> a dmo:RiskFactor ;
    rdfs:label "Delirium" ;
    dmo:evidenceNote "There is little data on delirium in diabetes and its management, which is a suggested area of future research." ;
    dmo:name "Delirium" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "delirium" ;
    dmo:evidenceQuote "There is little data on delirium in diabetes and its management, which is a suggested area of future research." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/dementia> a dmo:RiskFactor ;
    rdfs:label "Dementia" ;
    dmo:evidenceNote "Additional factors are present in older age and may influence management e.g. depression, dementia" ;
    dmo:name "Dementia" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "dementia" ;
    dmo:evidenceQuote "Additional factors are present in older age and may influence management e.g. depression, dementia" ;
    dmo:evidenceQuote "A recent review of hospital diabetes management of older people identified multiple risk factors for hypoglycaemia many of which cluster in the frail older population, such as: dementia; renal insufficiency; and nutritional deficits9." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/dementia-or-cognitive-dysfunction> a dmo:RiskFactor ;
    rdfs:label "Dementia or Cognitive Dysfunction" ;
    dmo:evidenceNote "Dementia or cognitive dysfunction can impair a patient's ability to perceive neuroglycopaenic symptoms or alert staff to hypoglycaemia." ;
    dmo:name "Dementia or Cognitive Dysfunction" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "dementia-or-cognitive-dysfunction" ;
    dmo:evidenceQuote "Hospitalised older patients often experience a failure of counter-regulatory mechanisms to illness and particularly hypoglycaemia, for example, an attenuated release of glucagon and adrenaline and often fail to perceive neuroglycopaenic symptoms or be unable to alert staff because of dementia or cognitive dysfunction12." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/depression> a dmo:RiskFactor ;
    rdfs:label "Depression" ;
    dmo:evidenceNote "Additional factors are present in older age and may influence management e.g. depression, dementia" ;
    dmo:name "Depression" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "depression" ;
    dmo:evidenceQuote "Additional factors are present in older age and may influence management e.g. depression, dementia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/diabetes> a dmo:RiskFactor ;
    rdfs:label "Diabetes" ;
    dmo:evidenceNote "diabetes is one of five major comorbidities that is associated with the actual development of frailty" ;
    dmo:name "Diabetes" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "diabetes" ;
    dmo:evidenceQuote "diabetes is one of five major comorbidities that is associated with the actual development of frailty" ;
    dmo:evidenceQuote "Many older people admitted into hospital with the recent pandemic associated with covid-19 have experienced significant comorbidity and mortality and these adverse events have been particularly worse in those with diabetes and frailty in view of their increased vulnerability." ;
    dmo:evidenceQuote "up to a quarter may have diabetes" ;
    dmo:evidenceQuote "Diabetes increases the risk of ischaemic stroke by about two fold especially in women2." ;
    dmo:evidenceQuote "Diabetes leads to increased mortality and increased length of stay in patients attending hospital." ;
    dmo:evidenceQuote "Diabetes leads to increased mortality and increased length of stay in patients attending hospital. This is a particular problem for those patients attending for surgery or elective procedures." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/diarrhoea> a dmo:RiskFactor ;
    rdfs:label "Diarrhoea" ;
    dmo:evidenceNote "Older people whose nutritional state is compromised due to diarrhoea or poor intake can develop pressure ulcers quickly and may require admissions" ;
    dmo:name "Diarrhoea" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "diarrhoea" ;
    dmo:evidenceQuote "Older people whose nutritional state is compromised due to diarrhoea or poor intake can develop pressure ulcers quickly and may require admissions" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/different-nutritional-content-to-usual-food> a dmo:RiskFactor ;
    rdfs:label "Different Nutritional Content to Usual Food" ;
    dmo:evidenceNote "Differences in nutritional content compared to usual food can cause glucose variation." ;
    dmo:name "Different Nutritional Content to Usual Food" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "different-nutritional-content-to-usual-food" ;
    dmo:evidenceQuote "Different nutritional content to usual food, delayed or missed meals for investigations, Less caloric intake due to anorexia from illness; dislike of hospital food; lack of support to eat from care givers; meal times different to those in community, lack of access to snacks" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/dislike-of-hospital-food> a dmo:RiskFactor ;
    rdfs:label "Dislike of Hospital Food" ;
    dmo:evidenceNote "Patient dislike of hospital food can lead to reduced caloric intake." ;
    dmo:name "Dislike of Hospital Food" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "dislike-of-hospital-food" ;
    dmo:evidenceQuote "dislike of hospital food; lack of support to eat from care givers; meal times different to those in community, lack of access to snacks" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/drug-round-interruptions> a dmo:RiskFactor ;
    rdfs:label "Drug Round Interruptions" ;
    dmo:evidenceNote "A recent study in care homes showed that each care home resident was taking eight medicines each on average and on any single day 70% of the patients experienced at least one medication error because of inaccessible doctor, not usual doctor, work load pressure, lack of medication training, drug round interruptions, lack of team work among home practice and pharmacy and inefficient ordering system" ;
    dmo:name "Drug Round Interruptions" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "drug-round-interruptions" ;
    dmo:evidenceQuote "A recent study in care homes showed that each care home resident was taking eight medicines each on average and on any single day 70% of the patients experienced at least one medication error because of inaccessible doctor, not usual doctor, work load pressure, lack of medication training, drug round interruptions, lack of team work among home practice and pharmacy and inefficient ordering system" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/enforced-bed-rest> a dmo:RiskFactor ;
    rdfs:label "Enforced Bed Rest" ;
    dmo:evidenceNote "deconditioning can take place within a few days of enforced bed rest or immobilisation" ;
    dmo:name "Enforced Bed Rest" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "enforced-bed-rest" ;
    dmo:evidenceQuote "deconditioning can take place within a few days of enforced bed rest or immobilisation" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/failure-of-counter-regulatory-mechanisms> a dmo:RiskFactor ;
    rdfs:label "Failure of Counter-Regulatory Mechanisms" ;
    dmo:evidenceNote "Hospitalised older patients often experience a failure of counter-regulatory mechanisms to illness and particularly hypoglycaemia, such as attenuated release of glucagon and adrenaline." ;
    dmo:name "Failure of Counter-Regulatory Mechanisms" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "failure-of-counter-regulatory-mechanisms" ;
    dmo:evidenceQuote "Hospitalised older patients often experience a failure of counter-regulatory mechanisms to illness and particularly hypoglycaemia, for example, an attenuated release of glucagon and adrenaline and often fail to perceive neuroglycopaenic symptoms or be unable to alert staff because of dementia or cognitive dysfunction12." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/failure-to-review-medicines-or-set-appropriate-glucose-targets> a dmo:RiskFactor ;
    rdfs:label "Failure to Review Medicines or Set Appropriate Glucose Targets" ;
    dmo:evidenceNote "The mechanisms that may increase the risk of hypoglycaemia in frail older people include iatrogenic factors, which include: inappropriate types/doses of glucose lowering therapies; medicine errors; meal timings that are not co-ordinated with insulin doses; and a failure to review medicines or set appropriate glucose targets10." ;
    dmo:name "Failure to Review Medicines or Set Appropriate Glucose Targets" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "failure-to-review-medicines-or-set-appropriate-glucose-targets" ;
    dmo:evidenceQuote "The mechanisms that may increase the risk of hypoglycaemia in frail older people include iatrogenic factors, which include: inappropriate types/doses of glucose lowering therapies; medicine errors; meal timings that are not co-ordinated with insulin doses; and a failure to review medicines or set appropriate glucose targets10." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/frailty> a dmo:RiskFactor ;
    rdfs:label "Frailty" ;
    dmo:evidenceNote "Frailty is present in 1 in 4 acute stroke patients" ;
    dmo:name "Frailty" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "frailty" ;
    dmo:evidenceQuote "Frailty is present in 1 in 4 acute stroke patients" ;
    dmo:evidenceQuote "frailty is a common finding and may be present in 32-48% of adults aged 65 years and over with diabetes living in the community and that diabetes is one of five major comorbidities that is associated with the actual development of frailty" ;
    dmo:evidenceQuote "The Writing Group firmly identifies frailty as a pre-disability condition that creates opportunity for intervention to enhance functional performance but also recognises that such intervention approaches may be of limited value in inpatient settings." ;
    dmo:evidenceQuote "Frailty by definition reduces the margin of tolerance to physiological stress, for example, hyper- or hypoglycaemia. Frailty can also be associated with cognitive deficits affecting a person’s capacity to self-manage their diabetes and communicate with family or carers." ;
    dmo:evidenceQuote "Older frail patients with an at-risk foot should be assessed by a multi-disciplinary diabetes foot team or podiatrist8" ;
    dmo:evidenceQuote "Managing diabetes in the older person should be aligned with their individual functional status, presence of frailty and dependency, co-morbidity, quality of life and life expectancy." ;
    dmo:evidenceQuote "Percentage of older inpatients with frailty and diabetes receiving adjustments to their medications by trained and experienced HCPs who take into account current clinical status, prevailing glucose levels and appropriate glycaemic targets in a single clinical unit or hospital ward in the past year" ;
    dmo:evidenceQuote "Older adults with diabetes and frailty should be screened for dementia and lower thresholds for suspicion of cognitive impairment considered in such individuals" ;
    dmo:evidenceQuote "There needs to be a proactive approach to identifying and providing support to this subgroup of patients with diabetes, frailty and cognitive impairment." ;
    dmo:evidenceQuote "Lipid lowering agents should be reviewed in the context of the primary cause for admission, evidence of increasing frailty, and be in conjunction with the patient’s wishes, and with the input of the patient’s family." ;
    dmo:evidenceQuote "In the frail older patient intensive glucose control is contraindicated." ;
    dmo:evidenceQuote "Frailty is independently linked with adverse clinical outcomes in all stages of CKD and has been shown to be associated with an increased risk of mortality and hospitalisation4." ;
    dmo:evidenceQuote "It is good practice to have some integration between nephrology and gerontology units so that patients identified as frail receive specialist geriatric assessment." ;
    dmo:evidenceQuote "Frailty may increase the risk of hypoglycaemia11 therefore, blood glucose levels should not be lowered below a safer level of 6.0 mmol/L." ;
    dmo:evidenceQuote "Frail patients are at risk of deconditioning if managed in a hospital environment. This risk is greater if the diagnosis of frailty is combined with the diagnosis of diabetes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/frailty-in-older-adults> a dmo:RiskFactor ;
    rdfs:label "Frailty in Older Adults" ;
    dmo:evidenceNote "Frailty in older adults is a key factor that affects treatment decisions and increases the risk of hypoglycaemia and poor recovery from acute events." ;
    dmo:name "Frailty in Older Adults" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "frailty-in-older-adults" ;
    dmo:evidenceQuote "An individualised approach to glucose regulation for hospitalised frail inpatients is essential to avoid hypoglycaemia and continuing symptoms of hyperglycaemia which can exacerbate recovery from other acute events causing admission." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/frequent-urine-infections> a dmo:RiskFactor ;
    rdfs:label "Frequent Urine Infections" ;
    dmo:evidenceNote "Older people with diabetes who are catheterised have complex mobility and neurological issues and are prone to frequent urine infections. They need a responsive support system in the community and oral and very often intravenous antibiotics" ;
    dmo:name "Frequent Urine Infections" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "frequent-urine-infections" ;
    dmo:evidenceQuote "Older people with diabetes who are catheterised have complex mobility and neurological issues and are prone to frequent urine infections. They need a responsive support system in the community and oral and very often intravenous antibiotics" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/functional-decline> a dmo:RiskFactor ;
    rdfs:label "Functional Decline" ;
    dmo:evidenceNote "Functional ability decline may necessitate simplification of diabetes regimens." ;
    dmo:name "Functional Decline" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "functional-decline" ;
    dmo:evidenceQuote "Simplification may be necessary if the patients’ cognitive or functional ability has declined" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/glucose-lowering-medication> a dmo:RiskFactor ;
    rdfs:label "Glucose Lowering Medication" ;
    dmo:evidenceNote "Glucose lowering medications can cause a fall in glucose levels." ;
    dmo:name "Glucose Lowering Medication" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "glucose-lowering-medication" ;
    dmo:evidenceQuote "Glucose Lowering Medication" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/high-comorbidity-load> a dmo:RiskFactor ;
    rdfs:label "High Comorbidity Load" ;
    dmo:evidenceNote "文档中明确指出该因素与延迟或失败出院、早期再入院相关" ;
    dmo:name "High Comorbidity Load" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "high-comorbidity-load" ;
    dmo:evidenceQuote "those with a history of repeated admissions for poor glucose control, hypoglycaemia, those with moderate to severe frailty, those with high comorbidity load, those with cognitive impairment and dementia who have still managed to remain in their own homes prior to admission, and those from residential care homes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/high-hba1c-levels> a dmo:RiskFactor ;
    rdfs:label "High HbA1c Levels" ;
    dmo:evidenceNote "Higher HbA1c levels predict a higher risk of hospitalisation." ;
    dmo:name "High HbA1c Levels" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "high-hba1c-levels" ;
    dmo:evidenceQuote "Higher HbA1c levels predict a higher risk of hospitalisation8" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/history-of-a-previous-stroke> a dmo:RiskFactor ;
    rdfs:label "History of a Previous Stroke" ;
    dmo:evidenceNote "Older people with diabetes have an increased falls risk due to the presence of multiple risk factors1. Risk factors include: polypharmacy, muscle weakness, a history of a previous stroke, use of insulin, cognitive dysfunction, orthostatic hypotension, and visual loss2." ;
    dmo:name "History of a Previous Stroke" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "history-of-a-previous-stroke" ;
    dmo:evidenceQuote "Risk factors include: polypharmacy, muscle weakness, a history of a previous stroke, use of insulin, cognitive dysfunction, orthostatic hypotension, and visual loss2." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/history-of-falls> a dmo:RiskFactor ;
    rdfs:label "History of falls" ;
    dmo:evidenceNote "History of falls requires liaison with geriatric medicine service and/or physiotherapy to have a falls risk assessment" ;
    dmo:name "History of falls" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "history-of-falls" ;
    dmo:evidenceQuote "History of falls requires liaison with geriatric medicine service and/or physiotherapy to have a falls risk assessment" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/history-of-hypoglycaemia> a dmo:RiskFactor ;
    rdfs:label "History of Hypoglycaemia" ;
    dmo:evidenceNote "Document explicitly lists this as a risk factor to be evaluated." ;
    dmo:name "History of Hypoglycaemia" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "history-of-hypoglycaemia" ;
    dmo:evidenceQuote "poorly controlled diabetes, history of hypoglycaemia, poor nutritional intake, cardiovascular risk factors, co-morbidities including recent disabling stroke or fracture, polypharmacy with potential drug interactions, poor support or self-care, activities of daily living, risk of DKA and hyperglycaemia, risk of falls, susceptibility for infections, residence in care homes, depression and dementia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/history-of-repeated-admissions-for-hypoglycaemia> a dmo:RiskFactor ;
    rdfs:label "History of Repeated Admissions for Hypoglycaemia" ;
    dmo:evidenceNote "文档中明确指出该因素与延迟或失败出院、早期再入院相关" ;
    dmo:name "History of Repeated Admissions for Hypoglycaemia" ;
    dmo:riskCategory "Modifiable" ;
    dmo:riskFactorCode "history-of-repeated-admissions-for-hypoglycaemia" ;
    dmo:evidenceQuote "those with a history of repeated admissions for poor glucose control, hypoglycaemia, those with moderate to severe frailty, those with high comorbidity load, those with cognitive impairment and dementia who have still managed to remain in their own homes prior to admission, and those from residential care homes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/history-of-repeated-admissions-for-poor-glucose-control> a dmo:RiskFactor ;
    rdfs:label "History of Repeated Admissions for Poor Glucose Control" ;
    dmo:evidenceNote "文档中明确指出该因素与延迟或失败出院、早期再入院相关" ;
    dmo:name "History of Repeated Admissions for Poor Glucose Control" ;
