<https://example.org/dmo/id/riskFactor/limited-mobility> a dmo:RiskFactor ;
    rdfs:label "Limited Mobility" ;
    dmo:evidenceNote "It is important to assess physical function on admission and ensure adequate compensating strategies if patient has limited mobility" ;
