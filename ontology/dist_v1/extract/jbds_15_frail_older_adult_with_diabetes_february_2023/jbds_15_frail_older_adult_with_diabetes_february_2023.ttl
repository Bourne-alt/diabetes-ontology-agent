<https://example.org/dmo/id/recommendation/access-to-previous-hba1c-readings> a dmo:Recommendation ;
    rdfs:label "Access to Previous HbA1c Readings" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Older adults with diabetes admitted to hospital" ;
    dmo:recommendationId "access-to-previous-hba1c-readings" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Screening" ;
    dmo:statement "Attempts should be made to access previous HbA1c readings carried out in the previous 6-12 months. This allows the HCP to assess previous control in the context of the current admission and to set goals for discharge planning with regards to glycaemia" ;
    dmo:evidenceQuote "Attempts should be made to access previous HbA1c readings carried out in the previous 6-12 months. This allows the HCP to assess previous control in the context of the current admission and to set goals for discharge planning with regards to glycaemia" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/acute-care-toolkit-3-royal-college-of-physicians-london> a dmo:Recommendation ;
    rdfs:label "Acute care toolkit 3 – Royal College of Physicians, London" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "frail older adults in acute medical units" ;
    dmo:recommendationId "acute-care-toolkit-3-royal-college-of-physicians-london" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Recommendations in the toolkit include configuring pathways and services to incorporate the main essentials of comprehensive geriatric assessment (CGA), structured medication reviews, referral pathways for those who have fallen, and liaising with GP commissioners to bring about integrated care across all relevant sectors including community and primary care." ;
    dmo:evidenceQuote "Recommendations in the toolkit include configuring pathways and services to incorporate the main essentials of comprehensive geriatric assessment (CGA), structured medication reviews, referral pathways for those who have fallen, and liaising with GP commissioners to bring about integrated care across all relevant sectors including community and primary care." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/adjustments-to-the-admission-therapy-regime-should-be-minimised-where-possible-and-recorded-in-the-medical-case-notes-the-frequency-of-review-is-recommended-to-be-every-24h> a dmo:Recommendation ;
