<https://example.org/dmo/id/contraindication/alpha-blockers-for-hypertension> a dmo:Contraindication ;
    rdfs:label "Alpha-blockers for hypertension" ;
    dmo:contraCode "alpha-blockers-for-hypertension" ;
    dmo:rationale "Stringent blood pressure control is not required in very frail older people. Alpha blockers in particular can cause marked vasodilatation, which can result in marked postural hypotension, falls and injuries" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Stringent blood pressure control is not required in very frail older people. Alpha blockers in particular can cause marked vasodilatation, which can result in marked postural hypotension, falls and injuries" ;
    dmo:evidenceQuote "Stringent blood pressure control is not required in very frail older people. Alpha blockers in particular can cause marked vasodilatation, which can result in marked postural hypotension, falls and injuries" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

