<https://example.org/dmo/id/recommendation/avoid-alpha-blockers-for-hypertension-in-very-frail-older-people> a dmo:Recommendation ;
    rdfs:label "Avoid alpha-blockers for hypertension in very frail older people" ;
    dmo:populationScope "Very frail older people" ;
    dmo:recommendationId "avoid-alpha-blockers-for-hypertension-in-very-frail-older-people" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Stringent blood pressure control is not required in very frail older people. Alpha blockers in particular can cause marked vasodilatation, which can result in marked postural hypotension, falls and injuries" ;
    dmo:evidenceQuote "B2. Alpha-blockers for hypertension Stringent blood pressure control is not required in very frail older people. Alpha blockers in particular can cause marked vasodilatation, which can result in marked postural hypotension, falls and injuries" ;
