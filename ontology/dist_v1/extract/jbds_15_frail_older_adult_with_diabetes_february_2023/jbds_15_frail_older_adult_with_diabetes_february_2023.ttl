    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/ward-protocol-for-glucose-monitoring-and-medication-review-in-frail-older-patients-with-diabetes> a dmo:Recommendation ;
    rdfs:label "Ward Protocol for Glucose Monitoring and Medication Review in Frail Older Patients with Diabetes" ;
    dmo:populationScope "Frail older patients with diabetes" ;
    dmo:recommendationId "ward-protocol-for-glucose-monitoring-and-medication-review-in-frail-older-patients-with-diabetes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Have a ward protocol for assessing patients, reviewing medication, setting glucose targets and monitoring glucose levels." ;
    dmo:evidenceQuote "Have a ward protocol for assessing patients, reviewing medication, setting glucose targets and monitoring glucose levels." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/where-are-the-diabetes-frailty-needs-best-met> a dmo:Recommendation ;
    rdfs:label "Where are the diabetes/frailty needs best met?" ;
