    dmo:recommendationStrength "Conditional" ;
    dmo:recommendationType "Treatment" ;
    dmo:statement "Aim for monotherapy. Target HbA1c: <8%/64 mmol/mol. Stringent glycaemic control is unnecessary. Increases risk of stroke and VTE disease. Discontinue and only consider recommencing if recurrence of symptoms" ;
