<https://example.org/dmo/id/medication/humulin-i> a dmo:Medication ;
    rdfs:label "Humulin I" ;
    dmo:durationHours "24"^^xsd:integer ;
    dmo:insulinAction "Intermediate" ;
    dmo:isInsulin "true"^^xsd:boolean ;
    dmo:medicationCode "humulin-i" ;
    dmo:name "Humulin I" ;
