<https://example.org/dmo/id/contraindication/neuroleptic-antipsychotics> a dmo:Contraindication ;
    rdfs:label "Neuroleptic antipsychotics" ;
    dmo:contraCode "neuroleptic-antipsychotics" ;
    dmo:rationale "Aim to reduce dose and gradually discontinue these drugs in patients taking them for longer than 12 weeks if there are no current clinical features of behavioural and psychiatric symptoms of dementia (BPSD)" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "Aim to reduce dose and gradually discontinue these drugs in patients taking them for longer than 12 weeks if there are no current clinical features of behavioural and psychiatric symptoms of dementia (BPSD)" ;
    dmo:evidenceQuote "Aim to reduce dose and gradually discontinue these drugs in patients taking them for longer than 12 weeks if there are no current clinical features of behavioural and psychiatric symptoms of dementia (BPSD)" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/nutritional-supplements-other-than-vitamins-for-prophylaxis> a dmo:Contraindication ;
    rdfs:label "Nutritional supplements (other than vitamins) for prophylaxis" ;
    dmo:contraCode "nutritional-supplements-other-than-vitamins-for-prophylaxis" ;
    dmo:rationale "Discontinue when prescribed for prophylaxis rather than treatment" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "prescribed for prophylaxis rather than treatment" ;
    dmo:evidenceQuote "Discontinue when prescribed for prophylaxis rather than treatment" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/older-patients-who-are-not-well> a dmo:Contraindication ;
    rdfs:label "Older patients who are not well" ;
    dmo:contraCode "older-patients-who-are-not-well" ;
    dmo:rationale "Older patients who are not well may need to stop nephrotoxic drugs" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "when unwell" ;
    dmo:evidenceQuote "Older patients who are not well may need to stop nephrotoxic drugs24." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/prophylactic-antibiotics-for-recurrent-cellulitis-or-utis> a dmo:Contraindication ;
    rdfs:label "Prophylactic antibiotics for recurrent cellulitis or UTIs" ;
    dmo:contraCode "prophylactic-antibiotics-for-recurrent-cellulitis-or-utis" ;
    dmo:rationale "No firm evidence for prophylactic antibiotics to prevent recurrent cellulitis or UTIs" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "to prevent recurrent cellulitis or UTIs" ;
    dmo:evidenceQuote "No firm evidence for prophylactic antibiotics to prevent recurrent cellulitis or UTIs" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/proton-pump-inhibitors-at-full-therapeutic-dose> a dmo:Contraindication ;
    rdfs:label "Proton Pump Inhibitors at full therapeutic dose" ;
    dmo:contraCode "proton-pump-inhibitors-at-full-therapeutic-dose" ;
    dmo:rationale "Proton Pump Inhibitors at full therapeutic dose ≥8/52, unless persistent dyspeptic symptoms at lower maintenance dose" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "≥8/52, unless persistent dyspeptic symptoms at lower maintenance dose" ;
    dmo:evidenceQuote "Proton Pump Inhibitors at full therapeutic dose ≥8/52, unless persistent dyspeptic symptoms at lower maintenance dose" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/sglt-2-inhibitors> a dmo:Contraindication ;
    rdfs:label "SGLT-2 inhibitors" ;
    dmo:contraCode "sglt-2-inhibitors" ;
    dmo:rationale "SGLT-2 inhibitors are to be avoided given their risk of genito-urinary tract infections, dehydration and postural symptoms all of which can affect mental performance" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "given their risk of genito-urinary tract infections, dehydration and postural symptoms all of which can affect mental performance" ;
    dmo:evidenceQuote "SGLT-2 inhibitors are to be avoided given their risk of genito-urinary tract infections, dehydration and postural symptoms all of which can affect mental performance" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/sglt2-inhibitor-use-in-acutely-unwell-patients-or-those-undergoing-major-surgery> a dmo:Contraindication ;
    rdfs:label "SGLT2 Inhibitor Use in Acutely Unwell Patients or Those Undergoing Major Surgery" ;
    dmo:contraCode "sglt2-inhibitor-use-in-acutely-unwell-patients-or-those-undergoing-major-surgery" ;
    dmo:rationale "because of the risk of precipitating ketoacidosis" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "acutely unwell or undergoing major surgery" ;
    dmo:evidenceQuote "Alternatively, if the inpatient is on a SGLT2 inhibitor and is acutely unwell or undergoing major surgery, it should be discontinued temporarily or permanently (because of the risk of precipitating ketoacidosis)." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/sorms-for-osteoporosis> a dmo:Contraindication ;
    rdfs:label "SORMs for osteoporosis" ;
    dmo:contraCode "sorms-for-osteoporosis" ;
    dmo:rationale "Benefits unlikely to be achieved within 1 year, increased short–intermediate term risk of associated ADEs particularly venous thromboembolism and stroke" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "within 1 year" ;
    dmo:evidenceQuote "Benefits unlikely to be achieved within 1 year, increased short–intermediate term risk of associated ADEs particularly venous thromboembolism and stroke" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/sulfonylureas-su> a dmo:Contraindication ;
    rdfs:label "Sulfonylureas (SU)" ;
    dmo:contraCode "sulfonylureas-su" ;
    dmo:rationale "Sulfonylureas have been identified as a hazard particularly in hospitalised older people: special caution may be required in patients with renal impairment. A UK based study observed that hypoglycaemia in SU treated patients was more common in the early hours of the morning, which is a very high risk period. Those most at risk were older and had lower HbA1c levels." ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in hospitalised older people, particularly with renal impairment" ;
    dmo:evidenceQuote "Sulfonylureas (SU) have also been identified as a hazard particularly in hospitalised older people: special caution may be required in patients with renal impairment12. A UK based study, observed that hypoglycaemia in SU treated patients was more common in the early hours of the morning which is clearly a very high risk period13." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/sulphonylureas> a dmo:Contraindication ;
    rdfs:label "Sulphonylureas" ;
    dmo:contraCode "sulphonylureas" ;
    dmo:rationale "Sulphonylureas and insulin regimes (especially pre-mixed) should be reviewed in patients with delirium and/or reduced oral intake with avoidance of hypoglycaemia either by dose reduction or change in regimen" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "in patients with delirium and/or reduced oral intake with avoidance of hypoglycaemia either by dose reduction or change in regimen" ;
    dmo:evidenceQuote "Sulphonylureas and insulin regimes (especially pre-mixed) should be reviewed in patients with delirium and/or reduced oral intake with avoidance of hypoglycaemia either by dose reduction or change in regimen" ;
    dmo:evidenceQuote "It is advisable that sulphonylureas are not placed into Dossett boxes for the frail older adult" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/theophylline-use> a dmo:Contraindication ;
    rdfs:label "Theophylline use" ;
    dmo:contraCode "theophylline-use" ;
    dmo:rationale "This drug has a narrow therapeutic index, requires monitoring of serum levels and interacts with other commonly prescribed drugs putting patients at an increased risk of ADEs" ;
    dmo:severity "Relative" ;
    dmo:triggerCriteria "narrow therapeutic index, requires monitoring of serum levels and interacts with other commonly prescribed drugs putting patients at an increased risk of ADEs" ;
    dmo:evidenceQuote "This drug has a narrow therapeutic index, requires monitoring of serum levels and interacts with other commonly prescribed drugs putting patients at an increased risk of ADEs" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/use-of-diuretic-therapy-in-frail-older-people-with-diabetes> a dmo:Contraindication ;
    rdfs:label "Use of diuretic therapy in frail older people with diabetes" ;
    dmo:contraCode "use-of-diuretic-therapy-in-frail-older-people-with-diabetes" ;
    dmo:rationale "Caution is recommended with the use of diuretic therapy in terms of exacerbating falls risk after discharge" ;
    dmo:severity "Caution" ;
    dmo:triggerCriteria "in terms of exacerbating falls risk after discharge" ;
    dmo:evidenceQuote "Caution is recommended with the use of diuretic therapy in terms of exacerbating falls risk after discharge" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/contraindication/use-of-fibrate-or-niacin-in-addition-to-statin-therapy> a dmo:Contraindication ;
    rdfs:label "Use of fibrate or niacin in addition to statin therapy" ;
    dmo:contraCode "use-of-fibrate-or-niacin-in-addition-to-statin-therapy" ;
    dmo:rationale "The addition of fibrate or niacin to statin therapy has no proven benefit in frail older people with diabetes and should not be considered" ;
    dmo:severity "Absolute" ;
    dmo:triggerCriteria "in frail older people with diabetes" ;
    dmo:evidenceQuote "The addition of fibrate or niacin to statin therapy has no proven benefit in frail older people with diabetes and should not be considered" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/blood-glucose-level> a dmo:Device ;
    rdfs:label "Blood Glucose Level" ;
    dmo:deviceCode "blood-glucose-level" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Blood Glucose Level" ;
    dmo:evidenceQuote "All patients with acute stroke should have their blood glucose checked on admission regardless of their diabetes or frailty status" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/blood-ketone-measurement> a dmo:Device ;
    rdfs:label "Blood Ketone Measurement" ;
    dmo:deviceCode "blood-ketone-measurement" ;
    dmo:deviceType "KetoneTestKit" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Blood Ketone Measurement" ;
    dmo:evidenceQuote "Blood ketone measurement is recommended for the older frail inpatient who is acutely unwell on admission or who becomes acutely unwell during their inpatient stay" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/blood-ketone-monitoring> a dmo:Device ;
    rdfs:label "Blood Ketone Monitoring" ;
    dmo:deviceCode "blood-ketone-monitoring" ;
    dmo:deviceType "KetoneTestKit" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Blood Ketone Monitoring" ;
    dmo:evidenceQuote "Where able, community-living older patients with type 1 and type 2 diabetes should be considered to have access, training and support for capillary blood glucose monitoring and blood ketone monitoring as required" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/capillary-blood-glucose-monitoring> a dmo:Device ;
    rdfs:label "Capillary Blood Glucose Monitoring" ;
    dmo:deviceCode "capillary-blood-glucose-monitoring" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Capillary Blood Glucose Monitoring" ;
    dmo:evidenceQuote "Where able, community-living older patients with type 1 and type 2 diabetes should be considered to have access, training and support for capillary blood glucose monitoring and blood ketone monitoring as required" ;
    dmo:evidenceQuote "Capillary blood glucose monitoring should occur a minimum of 4 times per day, pre-meal and pre-bed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/capillary-glucose-level> a dmo:Device ;
    rdfs:label "capillary glucose level" ;
    dmo:deviceCode "capillary-glucose-level" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "capillary glucose level" ;
    dmo:evidenceQuote "a tailored insulin twice daily regimen adjusted according to capillary glucose level has been shown to be effective16." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/capillary-glucose-tests> a dmo:Device ;
    rdfs:label "capillary glucose tests" ;
    dmo:deviceCode "capillary-glucose-tests" ;
    dmo:deviceType "GlucoseMeter" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "capillary glucose tests" ;
    dmo:evidenceQuote "patients should have regular capillary glucose tests, preferably in the fasting state." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/cgm> a dmo:Device ;
    rdfs:label "CGM" ;
    dmo:deviceCode "cgm" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "CGM" ;
    dmo:evidenceQuote "• Consider CGM for acute illness" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/continuous-glucose-monitoring> a dmo:Device ;
    rdfs:label "Continuous Glucose Monitoring" ;
    dmo:deviceCode "continuous-glucose-monitoring" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Continuous Glucose Monitoring" ;
    dmo:evidenceQuote "Consider CGM if frequent ‘hypos’" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/flash-glucose-monitoring> a dmo:Device ;
    rdfs:label "Flash Glucose Monitoring" ;
    dmo:deviceCode "flash-glucose-monitoring" ;
    dmo:deviceType "CGM" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Flash Glucose Monitoring" ;
    dmo:evidenceQuote "All frail inpatients with diabetes who are not using technology (mobile phone apps, flash glucose monitoring (FGM), other ‘wearables’) to monitor their blood glucose levels should be assessed for their suitability to use these and their interest in them" ;
    dmo:evidenceQuote "Where possible or indicated, flash glucose monitoring and other ‘wearables’ should be considered to enhance blood glucose monitoring, and avoid frequent skin pricking for capillary glucose measurement" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/insulinpump> a dmo:Device ;
    rdfs:label "InsulinPump" ;
    dmo:deviceCode "insulinpump" ;
    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "InsulinPump" ;
    dmo:evidenceQuote "• Involve diabetes IP team at all stages of surgery: immediate referral if HbA1c > 69 mmol/l or on insulin pump or CSII" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/intravenous-insulin-infusion> a dmo:Device ;
    rdfs:label "Intravenous Insulin Infusion" ;
    dmo:deviceCode "intravenous-insulin-infusion" ;
    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "true"^^xsd:boolean ;
    dmo:name "Intravenous Insulin Infusion" ;
    dmo:evidenceQuote "Hyperglycaemia should be treated initially with subcutaneous insulin on a sliding scale but if persistent, intravenous insulin infusion can be used" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/ketone-and-cbg-testing> a dmo:Device ;
    rdfs:label "Ketone and CBG testing" ;
    dmo:deviceCode "ketone-and-cbg-testing" ;
    dmo:deviceType "KetoneTestKit" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Ketone and CBG testing" ;
    dmo:evidenceQuote "Ketone and CBG testing in older patients living in the community and in care homes may identify metabolic decompensation early to avoid hospital admission, 21-23 but this will require upskilling of care home staff." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/device/subcutaneous-insulin> a dmo:Device ;
    rdfs:label "Subcutaneous Insulin" ;
    dmo:deviceCode "subcutaneous-insulin" ;
    dmo:deviceType "InsulinPump" ;
    dmo:isRealTime "false"^^xsd:boolean ;
    dmo:name "Subcutaneous Insulin" ;
    dmo:evidenceQuote "Hyperglycaemia should be treated initially with subcutaneous insulin on a sliding scale but if persistent, intravenous insulin infusion can be used" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/diabetesType/pre-diabetes> a dmo:DiabetesType ;
    rdfs:label "Pre-diabetes" ;
    dmo:definition "Half of the population over 65 years of age has pre-diabetes" ;
    dmo:diabetesTypeCode "pre-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005148" ;
    dmo:name "Pre-diabetes" ;
    dmo:prevalenceShare "0.5"^^xsd:decimal ;
    dmo:typicalOnset "AnyAge" ;
    dmo:evidenceQuote "Half of the population over 65 years of age has pre-diabetes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/diabetesType/t2dm> a dmo:DiabetesType ;
    rdfs:label "T2DM" ;
    dmo:definition "T2DM / Features of frailty / Community based" ;
    dmo:diabetesTypeCode "t2dm" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "T2DM" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "T2DM / Features of frailty / Community based" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/diabetesType/type-1-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 1 Diabetes" ;
    dmo:definition "Do not deny insulin in T1D" ;
    dmo:diabetesTypeCode "type-1-diabetes" ;
    dmo:insulinRequired "true"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 1 Diabetes" ;
    dmo:prevalenceShare "0.05"^^xsd:decimal ;
    dmo:typicalOnset "Childhood" ;
    dmo:evidenceQuote "Do not deny insulin in T1D" ;
    dmo:evidenceQuote "The Writing Group also recognises that there is a paucity of specific studies on managing frailty in those with diabetes in any clinical setting, and emphasise the need for a minimum best clinical practice approach where such evidence is totally lacking." ;
    dmo:evidenceQuote "Older patients with type 1 diabetes are especially vulnerable to hospital admission with DKA and HHS particularly when unwell" ;
    dmo:evidenceQuote "Inpatients with type 1 diabetes should not have their insulin treatment withdrawn" ;
    dmo:evidenceQuote "Patients with Type 1 diabetes have an absolute deficiency of insulin and there must always be insulin on board at all times." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes> a dmo:DiabetesType ;
    rdfs:label "Type 2 Diabetes" ;
    dmo:definition "The structure of the Guideline is based on the template of the International Diabetes Federation (IDF) Global Guideline on Managing Older People with Type 2 Diabetes (2013)" ;
    dmo:diabetesTypeCode "type-2-diabetes" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:mondoCode "MONDO:0005147" ;
    dmo:name "Type 2 Diabetes" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "The structure of the Guideline is based on the template of the International Diabetes Federation (IDF) Global Guideline on Managing Older People with Type 2 Diabetes (2013)" ;
    dmo:evidenceQuote "Consider DPP4-I as a first choice for treatment if necessary" ;
    dmo:evidenceQuote "The International Diabetes Federation (IDF) Global Guidance on Managing Older People with type 2 Diabetes provided for the first time care recommendations for those with dependency including frailty, dementia and end of life care, and the recent publication of an International Position Statement on the Management of Frailty in Diabetes Mellitus has drawn significant attention to the area of frailty and diabetes and highlighted the importance of all hospital clinicians involved in the care of such patients to have a high degree of familiarity and clinical experience in managing the associated problems of frailty and functional impairment." ;
    dmo:evidenceQuote "Current evidence for dementia in diabetes is predominantly from patients with type 2 diabetes given their older nature hence the majority of recommendations centre around medication review especially of oral medications." ;
    dmo:evidenceQuote "Statin therapy is recommended in order to reduce cardiovascular risk unless specifically contraindicated: consider offering Atorvastatin 20mg for the primary prevention of CVD in those with type 2 diabetes if the person is aged 84 years and younger, are well functioning with mild evidence of frailty only, and their estimated 10-year risk of developing cardiovascular disease using the QRISK®23 assessment tool is 10% or more" ;
    dmo:evidenceQuote "older inpatients with diabetes and frailty" ;
    dmo:evidenceQuote "Insulin regimens in type 2 diabetes should be simplified; these individuals may only require a single injection of intermediate insulin e.g. Insuman Basal, Humulin I, Insulatard" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/diabetesType/type-2-diabetes-mellitus> a dmo:DiabetesType ;
    rdfs:label "Type 2 diabetes mellitus" ;
    dmo:definition "Type 2 diabetes mellitus in older people: a brief statement of key principles of modern day management including the assessment of frailty." ;
    dmo:diabetesTypeCode "type-2-diabetes-mellitus" ;
    dmo:insulinRequired "false"^^xsd:boolean ;
    dmo:name "Type 2 diabetes mellitus" ;
    dmo:prevalenceShare "0.9"^^xsd:decimal ;
    dmo:typicalOnset "Adulthood" ;
    dmo:evidenceQuote "Type 2 diabetes mellitus in older people: a brief statement of key principles of modern day management including the assessment of frailty." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/basal-insulin> a dmo:DrugClass ;
    rdfs:label "Basal Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "basal-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides a background level of insulin to control fasting blood glucose" ;
    dmo:name "Basal Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "In order to control prandial hyperglycaemia, frail inpatients may be required to be started on a basal insulin with the addition of bolus insulin on a temporary basis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/basal-insulin-plus-bolus-correction> a dmo:DrugClass ;
    rdfs:label "Basal insulin plus bolus correction" ;
    dmo:drugClassCode "basal-insulin-plus-bolus-correction" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Basal insulin provides a continuous background level of insulin to control fasting blood glucose, while bolus correction insulin is administered to cover mealtime glucose excursions and correct hyperglycemia." ;
    dmo:name "Basal insulin plus bolus correction" ;
    dmo:weightEffect "Gain" ;
    dmo:evidenceQuote "Consider basal insulin plus bolus correction for persistent BGL >12 mmol/l" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/bolus-insulin> a dmo:DrugClass ;
    rdfs:label "Bolus Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "bolus-insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Provides a rapid-acting insulin dose to cover mealtime glucose excursions" ;
    dmo:name "Bolus Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "In order to control prandial hyperglycaemia, frail inpatients may be required to be started on a basal insulin with the addition of bolus insulin on a temporary basis" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/diabetic-oral-agents> a dmo:DrugClass ;
    rdfs:label "Diabetic oral agents" ;
    dmo:drugClassCode "diabetic-oral-agents" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:name "Diabetic oral agents" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Aim for monotherapy. Target HbA1c: <8%/64 mmol/mol. Stringent glycaemic control is unnecessary. Increases risk of stroke and VTE disease. Discontinue and only consider recommencing if recurrence of symptoms" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/dpp-4-inhibitors> a dmo:DrugClass ;
    rdfs:label "DPP-4 inhibitors" ;
    dmo:drugClassCode "dpp-4-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:name "DPP-4 inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "DPP-4 inhibitors have a place in the management of glucose levels in view of their low side effect profile and low hypoglycaemia risk" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/dpp4-i> a dmo:DrugClass ;
    rdfs:label "DPP4-I" ;
    dmo:drugClassCode "dpp4-i" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Dipeptidyl peptidase-4 inhibitors (DPP4-I) are a class of oral antidiabetic agents that enhance insulin secretion and reduce glucagon secretion by inhibiting the enzyme DPP-4, thereby increasing the levels of incretin hormones such as GLP-1 and GIP." ;
    dmo:name "DPP4-I" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Consider DPP4-I as a first choice for treatment if necessary" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/dpp4-inhibitors> a dmo:DrugClass ;
    rdfs:label "DPP4 inhibitors" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "dpp4-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Inhibit dipeptidyl peptidase-4, increasing active incretin levels" ;
    dmo:name "DPP4 inhibitors" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Metformin\nSulphonylureas \nDPP4 inhibitors, pioglitazone, Meglitinides or \nSGLT2 inhibitors" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/glp-1-receptor-agonist> a dmo:DrugClass ;
    rdfs:label "GLP-1 Receptor Agonist" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "glp-1-receptor-agonist" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Stimulates insulin secretion and suppresses glucagon release in a glucose-dependent manner, delays gastric emptying, and promotes satiety" ;
    dmo:name "GLP-1 Receptor Agonist" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "For example, as the inpatient is frail and may have an acute illness, is a GLP-1 receptor agonist still an appropriate choice (in view of further potential weight loss as a side-effect)?" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/glp1-inhibitors> a dmo:DrugClass ;
    rdfs:label "GLP1 inhibitors" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "glp1-inhibitors" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Glucagon-like peptide-1 (GLP-1) receptor agonists stimulate insulin secretion in a glucose-dependent manner and suppress glucagon secretion, leading to reduced blood glucose levels." ;
    dmo:name "GLP1 inhibitors" ;
    dmo:weightEffect "Loss" ;
    dmo:evidenceQuote "Insulin and other non-insulin injectable treatments such as GLP1 inhibitors and oral diabetes therapies may be withdrawn in people with type 2 diabetes if clinically appropriate" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/insulin> a dmo:DrugClass ;
    rdfs:label "Insulin" ;
    dmo:adminRoute "Subcutaneous" ;
    dmo:drugClassCode "insulin" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Exogenous insulin replacement to lower blood glucose" ;
    dmo:name "Insulin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Insulin and OHA prescription / administration errors/ inappropriate use of ‘stat’ doses of glucose lowering medication" ;
    dmo:evidenceQuote "Sulphonylureas and insulin regimes (especially pre-mixed) should be reviewed in patients with delirium and/or reduced oral intake with avoidance of hypoglycaemia either by dose reduction or change in regimen" ;
    dmo:evidenceQuote "People on insulin may be prone to hypoglycaemia and potentially nocturia will result from persistent hyperglycaemia, both of which may increase inpatient falls risk." ;
    dmo:evidenceQuote "Insulin therapy poses the greatest risk and if it is required it must be used cautiously." ;
    dmo:evidenceQuote "Insulin regimens in type 2 diabetes should be simplified; these individuals may only require a single injection of intermediate insulin e.g. Insuman Basal, Humulin I, Insulatard" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/intravenous-insulin-infusion> a dmo:DrugClass ;
    rdfs:label "Intravenous Insulin Infusion" ;
    dmo:adminRoute "Intravenous" ;
    dmo:drugClassCode "intravenous-insulin-infusion" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Insulin delivered directly into the bloodstream to rapidly lower blood glucose levels." ;
    dmo:name "Intravenous Insulin Infusion" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Hyperglycaemia should be treated initially with subcutaneous insulin on a sliding scale but if persistent, intravenous insulin infusion can be used" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/long-acting-analogue> a dmo:DrugClass ;
    rdfs:label "Long acting analogue" ;
    dmo:drugClassCode "long-acting-analogue" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:name "Long acting analogue" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "If there is a limited risk of excess hyperglycaemia then one dose of NPH or a long acting analogue should be considered." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/meglitinides> a dmo:DrugClass ;
    rdfs:label "Meglitinides" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "meglitinides" ;
    dmo:hypoglycemiaRisk "High" ;
    dmo:mechanism "Stimulate insulin secretion from pancreatic beta cells" ;
    dmo:name "Meglitinides" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Metformin\nSulphonylureas \nDPP4 inhibitors, pioglitazone, Meglitinides or \nSGLT2 inhibitors" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/metformin> a dmo:DrugClass ;
    rdfs:label "Metformin" ;
    dmo:adminRoute "Oral" ;
    dmo:drugClassCode "metformin" ;
    dmo:hypoglycemiaRisk "Low" ;
    dmo:mechanism "Decreases hepatic glucose production and improves insulin sensitivity" ;
    dmo:name "Metformin" ;
    dmo:weightEffect "Neutral" ;
    dmo:evidenceQuote "Metformin\nSulphonylureas \nDPP4 inhibitors, pioglitazone, Meglitinides or \nSGLT2 inhibitors" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/drugClass/nph> a dmo:DrugClass ;
    rdfs:label "NPH" ;
