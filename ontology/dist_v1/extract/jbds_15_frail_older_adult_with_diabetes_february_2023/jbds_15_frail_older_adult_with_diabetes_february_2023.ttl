    dmo:name "Background insulin (NPH or analogue)" ;
    dmo:onsetMinutes "0"^^xsd:integer ;
    dmo:evidenceQuote "It has been reported that mixed insulins may convey a greater hazard than a background insulin (NPH or analogue) alone or in conjunction with a short acting insulin with meals11." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/medication/basal-bolus> a dmo:Medication ;
