<https://example.org/dmo/id/symptom/falls> a dmo:Symptom ;
    rdfs:label "Falls" ;
    dmo:hpoCode "HP:0002577" ;
    dmo:name "Falls" ;
    dmo:symptomCode "falls" ;
    dmo:urgency "Urgent" ;
    dmo:evidenceQuote "However given the risks of falls, confusion and risks of hypoglycaemia, a pragmatic approach is needed to avoid unnecessary risk and harm from hypoglycaemia as well4." ;
    dmo:evidenceQuote "Falls remain a leading cause of morbidity and mortality in older people with diabetes and results in considerable disability and decreased quality of life – frailty exacerbates this impact." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

