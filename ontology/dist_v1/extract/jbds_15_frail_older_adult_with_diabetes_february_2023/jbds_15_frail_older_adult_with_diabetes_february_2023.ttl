<https://example.org/dmo/id/recommendation/aim-for-monotherapy-with-diabetic-oral-agents> a dmo:Recommendation ;
    rdfs:label "Aim for monotherapy with diabetic oral agents" ;
    dmo:gradingSystem "Unspecified" ;
