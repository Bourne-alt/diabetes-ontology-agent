    dmo:name "BP" ;
    dmo:unitOfMeasure "mmHg" ;
    dmo:evidenceQuote "HbA1c, BP and cholesterol levels exist for patients on a high risk register" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/capillary-blood-glucose> a dmo:LabTest ;
    rdfs:label "capillary blood glucose" ;
    dmo:definition "agreed target capillary blood glucose (CBG) when appropriate" ;
    dmo:labTestCode "capillary-blood-glucose" ;
    dmo:name "capillary blood glucose" ;
    dmo:unitOfMeasure "mg-per-dL" ;
    dmo:evidenceQuote "agreed target capillary blood glucose (CBG) when appropriate" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/capillary-blood-glucose-monitoring> a dmo:LabTest ;
    rdfs:label "Capillary Blood Glucose Monitoring" ;
    dmo:definition "Capillary blood glucose monitoring should occur a minimum of 4 times per day, pre-meal and pre-bed" ;
    dmo:labTestCode "capillary-blood-glucose-monitoring" ;
    dmo:name "Capillary Blood Glucose Monitoring" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "Capillary blood glucose monitoring should occur a minimum of 4 times per day, pre-meal and pre-bed" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/capillary-glucose-test> a dmo:LabTest ;
    rdfs:label "Capillary Glucose Test" ;
    dmo:definition "Regular capillary glucose tests should be performed to monitor glucose targets in frail older patients with diabetes." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "capillary-glucose-test" ;
    dmo:name "Capillary Glucose Test" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/L" ;
    dmo:evidenceQuote "patients should have regular capillary glucose tests, preferably in the fasting state." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/cbg> a dmo:LabTest ;
    rdfs:label "CBG" ;
