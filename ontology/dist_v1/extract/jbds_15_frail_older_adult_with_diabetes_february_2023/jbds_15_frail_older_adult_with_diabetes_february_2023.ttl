<https://example.org/dmo/id/riskFactor/low-hba1c-levels> a dmo:RiskFactor ;
    rdfs:label "Low HbA1c Levels" ;
    dmo:evidenceNote "Admission HbA1c levels less than 7% have the highest rate of inpatient hypoglycaemia episodes." ;
    dmo:name "Low HbA1c Levels" ;
    dmo:riskCategory "NonModifiable" ;
    dmo:riskFactorCode "low-hba1c-levels" ;
    dmo:evidenceQuote "It has been shown that the admission HbA1c can predict a patient’s propensity to have in hospital hypoglycaemia with levels less than 7% having the highest rate of episodes7." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/lower-socio-economic-and-deprived-areas> a dmo:RiskFactor ;
    rdfs:label "Lower Socio-Economic and Deprived Areas" ;
    dmo:evidenceNote "People living in lower socio-economic and deprived areas are more likely to need emergency hospital admission" ;
    dmo:name "Lower Socio-Economic and Deprived Areas" ;
    dmo:riskCategory "SocioDemographic" ;
    dmo:riskFactorCode "lower-socio-economic-and-deprived-areas" ;
