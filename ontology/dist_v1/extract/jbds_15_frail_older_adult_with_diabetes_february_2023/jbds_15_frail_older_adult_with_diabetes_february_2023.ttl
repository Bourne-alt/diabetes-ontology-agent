<https://example.org/dmo/id/labTest/renal-function-and-electrolytes> a dmo:LabTest ;
    rdfs:label "Renal function and electrolytes" ;
    dmo:definition "Renal function and electrolytes should be monitored routinely." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "renal-function-and-electrolytes" ;
    dmo:name "Renal function and electrolytes" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "Renal function and electrolytes should be monitored routinely" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/venous-blood-gases> a dmo:LabTest ;
    rdfs:label "Venous Blood Gases" ;
    dmo:definition "Inpatients with type 1 diabetes are at particular risk of DKA and require blood ketones and venous blood gases to be measured if there is continued unacceptable hyperglycaemia and deterioration in health status" ;
    dmo:labTestCode "venous-blood-gases" ;
    dmo:name "Venous Blood Gases" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "Inpatients with type 1 diabetes are at particular risk of DKA and require blood ketones and venous blood gases to be measured if there is continued unacceptable hyperglycaemia and deterioration in health status" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/assessment-of-suitability-and-interest-in-using-mobile-phone-apps-or-flash-glucose-monitoring-fgm> a dmo:LifestyleIntervention ;
    rdfs:label "Assessment of suitability and interest in using mobile phone apps or flash glucose monitoring (FGM)" ;
    dmo:interventionCode "assessment-of-suitability-and-interest-in-using-mobile-phone-apps-or-flash-glucose-monitoring-fgm" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "Assessment of suitability and interest in using mobile phone apps or flash glucose monitoring (FGM)" ;
    dmo:evidenceQuote "All frail inpatients with diabetes who are not using technology (mobile phone apps, flash glucose monitoring (FGM), other ‘wearables’) to monitor their blood glucose levels should be assessed for their suitability to use these and their interest in them" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/exercise-and-rehabilitation-plan> a dmo:LifestyleIntervention ;
    rdfs:label "Exercise and rehabilitation plan" ;
    dmo:activityTarget "Exercises based on strength training including resistance training, and stretching/flexibility training should be considered" ;
    dmo:expectedBenefit "Focus on maintaining nutritional status, preventing weight loss and lower limb muscle loss; avoid deconditioning which can increase the severity of frailty" ;
    dmo:interventionCode "exercise-and-rehabilitation-plan" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "Exercise and rehabilitation plan" ;
    dmo:evidenceQuote "After acute illness, agree an IP exercise and rehabilitation plan with PLWD/nursing and OT/Physio \n• Exercises based on strength training including resistance training, and \nstretching/flexibility training should be considered \n• Focus on maintaining nutritional status, preventing weight loss and lower limb muscle loss \n• Avoid deconditioning which can increase the severity of frailty \n• Be aware that deconditioning can take place within a few days of enforced bed rest or immobilisation" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/high-quality-diabetes-education-programme> a dmo:LifestyleIntervention ;
    rdfs:label "High quality diabetes education programme" ;
    dmo:expectedBenefit "can empower patients and carers and has the potential to reduce hospital admissions" ;
    dmo:interventionCode "high-quality-diabetes-education-programme" ;
    dmo:interventionType "SelfManagementEd" ;
    dmo:name "High quality diabetes education programme" ;
    dmo:evidenceQuote "A high quality diabetes education programme can empower patients and carers and has the potential to reduce hospital admissions25 26." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/ip-exercise-including-rt-and-balance-training> a dmo:LifestyleIntervention ;
    rdfs:label "IP exercise including RT and balance training" ;
    dmo:interventionCode "ip-exercise-including-rt-and-balance-training" ;
    dmo:interventionType "PhysicalActivity" ;
    dmo:name "IP exercise including RT and balance training" ;
    dmo:evidenceQuote "IP exercise including RT and balance training" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/maintain-nutritional-status-and-prevent-weight-loss> a dmo:LifestyleIntervention ;
    rdfs:label "Maintain nutritional status and prevent weight loss" ;
    dmo:activityTarget "Focus on maintaining nutritional status, preventing weight loss and lower limb muscle loss" ;
    dmo:expectedBenefit "Avoid deconditioning which can increase the severity of frailty" ;
    dmo:interventionCode "maintain-nutritional-status-and-prevent-weight-loss" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Maintain nutritional status and prevent weight loss" ;
    dmo:evidenceQuote "After acute illness, agree an IP exercise and rehabilitation plan with PLWD/nursing and OT/Physio \n• Exercises based on strength training including resistance training, and \nstretching/flexibility training should be considered \n• Focus on maintaining nutritional status, preventing weight loss and lower limb muscle loss \n• Avoid deconditioning which can increase the severity of frailty \n• Be aware that deconditioning can take place within a few days of enforced bed rest or immobilisation" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/multimodality-intervention-with-adequate-nutrition-and-resistance-exercise> a dmo:LifestyleIntervention ;
    rdfs:label "Multimodality intervention with adequate nutrition and resistance exercise" ;
    dmo:activityTarget "adequate nutrition and resistance exercise" ;
    dmo:expectedBenefit "improve muscle function which can deteriorate rapidly in those with chronic kidney disease" ;
    dmo:interventionCode "multimodality-intervention-with-adequate-nutrition-and-resistance-exercise" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Multimodality intervention with adequate nutrition and resistance exercise" ;
    dmo:evidenceQuote "We recommend a multimodality intervention with adequate nutrition and resistance exercise to improve muscle function which can deteriorate rapidly in those with chronic kidney disease" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/nutritional-assessment> a dmo:LifestyleIntervention ;
    rdfs:label "nutritional assessment" ;
    dmo:interventionCode "nutritional-assessment" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "nutritional assessment" ;
    dmo:evidenceQuote "comprehensive geriatric assessment (CGA) including nutritional assessment" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/nutritional-deficits> a dmo:LifestyleIntervention ;
    rdfs:label "Nutritional deficits" ;
    dmo:activityTarget "Assess on admission patients’ BMI and weight and capacity to self-feed; monitor weight and refer for dietetic assessment if BMI <18 or if weight declines during admission" ;
    dmo:expectedBenefit "Avoid nutritional supplements with high glucose loads and rapid dispersal" ;
    dmo:interventionCode "nutritional-deficits" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Nutritional deficits" ;
    dmo:evidenceQuote "Nutritional deficits have been reported in older hospitalised patients5, therefore assessing on admission patients’ BMI and weight and capacity to self-feed are important. During the hospital stay, monitor weight and refer for dietetic assessment if BMI <18 or if weight declines during admission. Care should be taken in identifying nutritional supplements, avoiding those with high glucose loads and rapid dispersal" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/nutritional-input> a dmo:LifestyleIntervention ;
    rdfs:label "Nutritional input" ;
    dmo:activityTarget "Minimise de-conditioning to prevent lower limb muscle loss" ;
    dmo:expectedBenefit "Prevent lower limb muscle loss" ;
    dmo:interventionCode "nutritional-input" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Nutritional input" ;
    dmo:evidenceQuote "❖ Minimise de-conditioning to prevent lower limb muscle loss: physiotherapy/OT and nutritional input" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/nutritional-status-assessment> a dmo:LifestyleIntervention ;
    rdfs:label "Nutritional status assessment" ;
    dmo:interventionCode "nutritional-status-assessment" ;
    dmo:interventionType "Nutrition" ;
    dmo:name "Nutritional status assessment" ;
    dmo:evidenceQuote "Frail older patients may have nutritional deficits, ensure that nutritional status is assessed and that optimal nutritional support is provided" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/lifestyleIntervention/optimise-nutritional-status> a dmo:LifestyleIntervention ;
