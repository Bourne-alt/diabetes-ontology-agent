    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/riskFactor/use-of-oral-glucose-lowering-agents> a dmo:RiskFactor ;
    rdfs:label "Use of Oral Glucose Lowering Agents" ;
