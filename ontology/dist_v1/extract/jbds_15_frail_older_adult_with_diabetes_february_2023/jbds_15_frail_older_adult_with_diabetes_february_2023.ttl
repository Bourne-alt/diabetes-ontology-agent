<https://example.org/dmo/id/labTest/lipids-review> a dmo:LabTest ;
    rdfs:label "Lipids review" ;
    dmo:definition "Review of lipid levels as part of cardiovascular risk assessment in older inpatients with diabetes and frailty." ;
    dmo:fastingRequired "false"^^xsd:boolean ;
    dmo:labTestCode "lipids-review" ;
    dmo:name "Lipids review" ;
    dmo:specimen "Blood" ;
    dmo:evidenceQuote "Percentage of older inpatients with diabetes and frailty receiving a cardiovascular risk assessment including blood pressure and lipids review in a single clinical unit or hospital ward in the past year" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/labTest/random-glucose> a dmo:LabTest ;
    rdfs:label "Random Glucose" ;
    dmo:definition "Random Glucose - Mild F 7.5 - 10 mmol.l ModF-SF 7.5-12 mmol/l" ;
    dmo:labTestCode "random-glucose" ;
    dmo:name "Random Glucose" ;
    dmo:specimen "Blood" ;
    dmo:unitOfMeasure "mmol/l" ;
    dmo:evidenceQuote "Random Glucose - Mild F 7.5 - 10 mmol.l ModF-SF 7.5-12 mmol/l" ;
    dmo:evidenceQuote "Random Glucose -  Mild F 7.5 - 10 mmol.l  ModF-SF  7.5-12 mmol/l" ;
