    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/use-of-frailty-assessment-scales-in-managing-patients-with-diabetes-and-cognitive-impairment> a dmo:Recommendation ;
    rdfs:label "Use of Frailty Assessment Scales in Managing Patients with Diabetes and Cognitive Impairment" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Patients with diabetes and cognitive impairment" ;
    dmo:recommendationId "use-of-frailty-assessment-scales-in-managing-patients-with-diabetes-and-cognitive-impairment" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Skill is needed in managing such patients with use of frailty assessment scales beneficial in identifying the degree of function in order to plan management." ;
    dmo:evidenceQuote "Skill is needed in managing such patients with use of frailty assessment scales beneficial in identifying the degree of function in order to plan management." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/use-of-physical-performance-measures-in-routine-clinical-care> a dmo:Recommendation ;
    rdfs:label "Use of physical performance measures in routine clinical care" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "older people with diabetes and frailty" ;
    dmo:recommendationId "use-of-physical-performance-measures-in-routine-clinical-care" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "physical performance measures should be assessed in routine clinical care of older people with diabetes and frailty" ;
    dmo:evidenceQuote "Apart from glycaemia targets, other key outcomes that require assessment but usually are not a feature of every day diabetes clinical practice are physical performance measures, an objective assessment of hypoglycaemia risk, falls risk assessment, and quality of life: these outcome measures will prove to have an important influence in deciding if a specific management strategy is worthwhile in routine clinical care of older people with diabetes and frailty." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/use-of-prisma-7-questionnaire-for-disability-identification> a dmo:Recommendation ;
    rdfs:label "Use of PRISMA 7 Questionnaire for Disability Identification" ;
    dmo:recommendationId "use-of-prisma-7-questionnaire-for-disability-identification" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Screening" ;
    dmo:statement "PRISMA 7 Questionnaire7 – this is a seven item questionnaire to identify disability that has been used in earlier frailty studies and is also suitable for postal completion. A score of >3 is considered to identify frailty" ;
    dmo:evidenceQuote "PRISMA 7 Questionnaire7 – this is a seven item questionnaire to identify disability that has been used in earlier frailty studies and is also suitable for postal completion. A score of >3 is considered to identify frailty" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/use-of-risk-prediction-models-in-diabetes-care> a dmo:Recommendation ;
    rdfs:label "Use of risk prediction models in diabetes care" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "Older adults with diabetes" ;
    dmo:recommendationId "use-of-risk-prediction-models-in-diabetes-care" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "The use of risk prediction models is valuable and integrated health and social care networks have demonstrated a reduction in emergency admissions with diabetes." ;
    dmo:evidenceQuote "The use of risk prediction models is valuable and integrated health and social care networks have demonstrated a reduction in emergency admissions with diabetes" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/use-of-the-hospital-frailty-risk-score-for-frailty-identification> a dmo:Recommendation ;
    rdfs:label "Use of the Hospital Frailty Risk Score for frailty identification" ;
    dmo:populationScope "patients aged 75 years and over admitted into hospital" ;
    dmo:recommendationId "use-of-the-hospital-frailty-risk-score-for-frailty-identification" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Screening" ;
    dmo:statement "More recently, a new tool (The Hospital Frailty Risk Score) (HFRS)12 has been validated to identify patients aged 75 years and over being admitted into hospital who have features of frailty and are at greatest risk of adverse outcomes. The HFRS can be calculated from routine used hospital data based on ICD-10 diagnostic codes." ;
    dmo:evidenceQuote "More recently, a new tool (The Hospital Frailty Risk Score) (HFRS)12 has been validated to identify patients aged 75 years and over being admitted into hospital who have features of frailty and are at greatest risk of adverse outcomes. The HFRS can be calculated from routine used hospital data based on ICD-10 diagnostic codes." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/use-of-wearables-such-as-flash-glucose-monitoring-fgm-or-mobile-phone-apps-should-not-be-denied> a dmo:Recommendation ;
    rdfs:label "Use of wearables such as flash glucose monitoring (FGM) or mobile phone apps should not be denied" ;
    dmo:populationScope "Older people with diabetes" ;
    dmo:recommendationId "use-of-wearables-such-as-flash-glucose-monitoring-fgm-or-mobile-phone-apps-should-not-be-denied" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "The use of ‘wearables’ such as flash glucose monitoring (FGM) or mobile phone apps (eHealth) to assist in the monitoring blood glucose levels should not be denied to older people with diabetes and prompts a discussion with the inpatient in this area in relation to their suitability and wish to consider them as part of self-management." ;
    dmo:evidenceQuote "The use of ‘wearables’ such as flash glucose monitoring (FGM) or mobile phone apps (eHealth) to assist in the monitoring blood glucose levels should not be denied to older people with diabetes and prompts a discussion with the inpatient in this area in relation to their suitability and wish to consider them as part of self-management." ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/vaccination-for-older-frail-individuals-with-diabetes> a dmo:Recommendation ;
    rdfs:label "Vaccination for older frail individuals with diabetes" ;
    dmo:populationScope "Older frail individuals with diabetes living in the community" ;
    dmo:recommendationId "vaccination-for-older-frail-individuals-with-diabetes" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Screening" ;
    dmo:statement "Pneumococcal, influenza, and shingles (Herpes Zoster) vaccination should be considered in all older frail individuals with diabetes living in the community" ;
    dmo:evidenceQuote "Pneumococcal, influenza, and shingles (Herpes Zoster) vaccination should be considered in all older frail individuals with diabetes living in the community" ;
    prov:wasDerivedFrom <https://example.org/dmo/id/guidelineSource/jbds_15_frail_older_adult_with_diabetes_february_2023> .

<https://example.org/dmo/id/recommendation/vulnerable-adults-team-may-need-to-be-consulted-in-relation-to-safe-and-effective-discharge-planning> a dmo:Recommendation ;
    rdfs:label "Vulnerable adults team may need to be consulted in relation to safe and effective discharge planning" ;
