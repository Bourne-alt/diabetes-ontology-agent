<https://example.org/dmo/id/recommendation/recommended-blood-glucose-targets-in-recent-guidelines> a dmo:Recommendation ;
    rdfs:label "Recommended blood glucose targets in recent guidelines" ;
    dmo:gradingSystem "Unspecified" ;
    dmo:nativeEvidenceGrade "Unspecified" ;
    dmo:populationScope "patients with moderate to severe frailty" ;
    dmo:recommendationId "recommended-blood-glucose-targets-in-recent-guidelines" ;
    dmo:recommendationStrength "Unspecified" ;
    dmo:recommendationType "Monitoring" ;
    dmo:statement "Recommended blood glucose targets in recent guidelines8 are 6-15 mmol/L although levels of 6 and 7 mmol/L may pose an unacceptable hypoglycaemia risk in patients with frailty and such glucose ranges require regular review: it is recommended that for those with moderate to severe frailty, a higher glucose range is warranted and decided by the care team" ;
    dmo:evidenceQuote "Recommended blood glucose targets in recent guidelines8 are 6-15 mmol/L although levels of 6 and 7 mmol/L may pose an unacceptable hypoglycaemia risk in patients with frailty and such glucose ranges require regular review: it is recommended that for those with moderate to severe frailty, a higher glucose range is warranted and decided by the care team" ;
