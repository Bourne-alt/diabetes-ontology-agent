        <rdfs:label>definesSchedule</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology/Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology/MonitoringSchedule"/>
        <rdfs:comment>推荐所定义的随访/筛查频率。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>recommendation</ont:fromEntityId>
        <ont:toEntityId>monitoringSchedule</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology/schedulesTest">
        <rdfs:label>schedulesTest</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology/MonitoringSchedule"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology/LabTest"/>
        <rdfs:comment>随访计划所安排的检验项目。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>monitoringSchedule</ont:fromEntityId>
        <ont:toEntityId>labTest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology/targetMeasuredBy">
        <rdfs:label>targetMeasuredBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology/GlycemicTarget"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology/LabTest"/>
        <rdfs:comment>目标所依据的检验项目。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>glycemicTarget</ont:fromEntityId>
        <ont:toEntityId>labTest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology/citesSource">
        <rdfs:label>citesSource</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology/Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology/GuidelineSource"/>
        <rdfs:comment>推荐的出处。每条回答必须能回溯到这里。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>recommendation</ont:fromEntityId>
        <ont:toEntityId>guidelineSource</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
