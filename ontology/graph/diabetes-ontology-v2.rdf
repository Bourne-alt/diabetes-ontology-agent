        <ont:enumValues>Normal,Prediabetes,DiabetesRange,Low,High,Critical,Indeterminate</ont:enumValues>
        <ont:propertyType>enum</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/assessment_assessedAt">
        <rdfs:label>assessedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Assessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>评估生成时间</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/assessment_ruleId">
        <rdfs:label>ruleId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Assessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
