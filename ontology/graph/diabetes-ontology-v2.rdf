        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>诊断确定性</rdfs:comment>
        <ont:enumValues>Suspected,Provisional,Confirmed,Refuted,Unknown</ont:enumValues>
        <ont:propertyType>enum</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/diagnosis_severity">
        <rdfs:label>severity</rdfs:label>
