        <ont:enumValues>Strong,Conditional,Unspecified</ont:enumValues>
        <ont:propertyType>enum</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/guidelineSource_sourceId">
        <rdfs:label>sourceId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>出处唯一标识</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/guidelineSource_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>文档标题</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/guidelineSource_publisher">
        <rdfs:label>publisher</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
