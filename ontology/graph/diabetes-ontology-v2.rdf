        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/sourcePassage_passageId">
        <rdfs:label>passageId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/SourcePassage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>证据片段唯一标识</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/sourcePassage_locator">
        <rdfs:label>locator</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/SourcePassage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>页码、章节、表格或字符区间</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/sourcePassage_quote">
        <rdfs:label>quote</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/SourcePassage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>经过逐字验证的支持文本</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/sourcePassage_contentHash">
        <rdfs:label>contentHash</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/SourcePassage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>规范化片段 SHA-256</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/recommendation_recommendationId">
        <rdfs:label>recommendationId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>推荐唯一标识</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/recommendation_statement">
        <rdfs:label>statement</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>推荐正文（不含任何具体剂量数字）</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/recommendation_recommendationType">
        <rdfs:label>recommendationType</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>推荐类别</rdfs:comment>
        <ont:enumValues>Screening,Diagnosis,Treatment,Lifestyle,Monitoring,Referral,Safety</ont:enumValues>
        <ont:propertyType>enum</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/recommendation_populationScope">
        <rdfs:label>populationScope</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>适用人群限定</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/recommendation_nativeEvidenceGrade">
        <rdfs:label>nativeEvidenceGrade</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>来源指南原始证据等级；不得跨分级体系臆造转换</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/recommendation_gradingSystem">
        <rdfs:label>gradingSystem</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>证据分级体系，如 ADA、GRADE、VA-DoD</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/recommendation_recommendationStrength">
        <rdfs:label>recommendationStrength</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
