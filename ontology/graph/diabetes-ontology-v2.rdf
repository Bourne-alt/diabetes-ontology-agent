        <ont:enumValues>Active,Inactive,Resolved,Unknown</ont:enumValues>
        <ont:propertyType>enum</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/diagnosis_verificationStatus">
