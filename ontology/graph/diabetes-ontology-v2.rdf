        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/guidelineSource_documentVersion">
        <rdfs:label>documentVersion</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>指南或文档版本</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/guidelineSource_jurisdiction">
        <rdfs:label>jurisdiction</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>适用国家、地区或医疗体系</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/guidelineSource_languageCode">
        <rdfs:label>languageCode</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>BCP 47 语言代码，如 en-US、zh-CN</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/guidelineSource_retrievedAt">
        <rdfs:label>retrievedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>本地副本获取时间</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/guidelineSource_contentHash">
        <rdfs:label>contentHash</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>本地副本 SHA-256，用于来源完整性验证</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ================== -->
    <!-- Object Properties -->
    <!-- ================== -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/hasEncounter">
        <rdfs:label>hasEncounter</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Patient"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/ClinicalEncounter"/>
        <rdfs:comment>患者的历次就诊记录。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>patient</ont:fromEntityId>
        <ont:toEntityId>clinicalEncounter</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/producesLabResult">
        <rdfs:label>producesLabResult</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/ClinicalEncounter"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LabResult"/>
        <rdfs:comment>一次就诊产生的检验结果。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>clinicalEncounter</ont:fromEntityId>
        <ont:toEntityId>labResult</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/measuredByTest">
        <rdfs:label>measuredByTest</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LabResult"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LabTest"/>
        <rdfs:comment>结果对应的检验项目定义。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>labResult</ont:fromEntityId>
        <ont:toEntityId>labTest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/hasThreshold">
        <rdfs:label>hasThreshold</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LabTest"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DiagnosticThreshold"/>
        <rdfs:comment>检验项目的诊断切点集合（正常/前期/糖尿病，妊娠与非妊娠分支）。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>labTest</ont:fromEntityId>
        <ont:toEntityId>diagnosticThreshold</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/classifiesInto">
        <rdfs:label>classifiesInto</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DiagnosticThreshold"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DiabetesType"/>
        <rdfs:comment>阈值命中后支持的诊断类别术语；不得单凭血糖阈值推断 T1DM 或 T2DM 病因分型。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>diagnosticThreshold</ont:fromEntityId>
        <ont:toEntityId>diabetesType</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/thresholdCitedFrom">
        <rdfs:label>thresholdCitedFrom</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DiagnosticThreshold"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:comment>阈值的出处，保证每个数字都能追溯。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>diagnosticThreshold</ont:fromEntityId>
        <ont:toEntityId>guidelineSource</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/hasStage">
        <rdfs:label>hasStage</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Complication"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/ComplicationStage"/>
        <rdfs:comment>并发症的分期集合。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>complication</ont:fromEntityId>
        <ont:toEntityId>complicationStage</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/predisposesTo">
        <rdfs:label>predisposesTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DiabetesType"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Complication"/>
        <rdfs:comment>该分型易发生的并发症，例如 T1DM 更易发生 DKA。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>diabetesType</ont:fromEntityId>
        <ont:toEntityId>complication</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/presentsWith">
        <rdfs:label>presentsWith</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Complication"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Symptom"/>
        <rdfs:comment>并发症的典型症状表现。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>complication</ont:fromEntityId>
        <ont:toEntityId>symptom</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/screenedByTest">
        <rdfs:label>screenedByTest</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Complication"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LabTest"/>
        <rdfs:comment>并发症的筛查手段，例如 DKD 由 UACR 与 eGFR 双指标筛查。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>complication</ont:fromEntityId>
        <ont:toEntityId>labTest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/hasRiskFactor">
        <rdfs:label>hasRiskFactor</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Patient"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/RiskFactor"/>
        <rdfs:comment>患者具备的风险因素。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>patient</ont:fromEntityId>
        <ont:toEntityId>riskFactor</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/increasesRiskOf">
        <rdfs:label>increasesRiskOf</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/RiskFactor"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DiabetesType"/>
        <rdfs:comment>风险因素指向的疾病分型。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>riskFactor</ont:fromEntityId>
        <ont:toEntityId>diabetesType</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/belongsToDrugClass">
        <rdfs:label>belongsToDrugClass</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Medication"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DrugClass"/>
        <rdfs:comment>药物所属类别。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>medication</ont:fromEntityId>
        <ont:toEntityId>drugClass</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/hasContraindication">
        <rdfs:label>hasContraindication</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DrugClass"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Contraindication"/>
        <rdfs:comment>该类药物的禁忌规则。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>drugClass</ont:fromEntityId>
        <ont:toEntityId>contraindication</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/triggeredByCondition">
        <rdfs:label>triggeredByCondition</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Contraindication"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Complication"/>
        <rdfs:comment>触发禁忌的临床情形，例如 SGLT2i 禁用于严重肾功能损害/透析。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>contraindication</ont:fromEntityId>
        <ont:toEntityId>complication</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/causesAdverseEffect">
        <rdfs:label>causesAdverseEffect</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DrugClass"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/AdverseEffect"/>
        <rdfs:comment>该类药物的常见不良反应。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>drugClass</ont:fromEntityId>
        <ont:toEntityId>adverseEffect</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/usesDevice">
        <rdfs:label>usesDevice</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Patient"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Device"/>
        <rdfs:comment>患者使用的监测/给药设备。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>patient</ont:fromEntityId>
        <ont:toEntityId>device</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/deviceMeasuresTest">
        <rdfs:label>deviceMeasuresTest</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Device"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LabTest"/>
        <rdfs:comment>设备可测量的指标，例如 CGM 对应 TIR 与葡萄糖。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>device</ont:fromEntityId>
        <ont:toEntityId>labTest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/followsIntervention">
        <rdfs:label>followsIntervention</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Patient"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LifestyleIntervention"/>
        <rdfs:comment>患者执行中的生活方式干预。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>patient</ont:fromEntityId>
        <ont:toEntityId>lifestyleIntervention</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/mitigatesRiskFactor">
        <rdfs:label>mitigatesRiskFactor</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LifestyleIntervention"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/RiskFactor"/>
        <rdfs:comment>干预针对的可改变风险因素。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>lifestyleIntervention</ont:fromEntityId>
        <ont:toEntityId>riskFactor</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/appliesToType">
        <rdfs:label>appliesToType</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DiabetesType"/>
        <rdfs:comment>推荐适用的分型。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>recommendation</ont:fromEntityId>
        <ont:toEntityId>diabetesType</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/targetsComplication">
        <rdfs:label>targetsComplication</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Complication"/>
        <rdfs:comment>推荐针对的并发症。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>recommendation</ont:fromEntityId>
        <ont:toEntityId>complication</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/recommendsDrugClass">
        <rdfs:label>recommendsDrugClass</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DrugClass"/>
        <rdfs:comment>推荐涉及的药物类别（类别级，不到具体剂量）。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>recommendation</ont:fromEntityId>
        <ont:toEntityId>drugClass</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/recommendsLifestyle">
        <rdfs:label>recommendsLifestyle</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LifestyleIntervention"/>
        <rdfs:comment>推荐涉及的生活方式干预。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>recommendation</ont:fromEntityId>
        <ont:toEntityId>lifestyleIntervention</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/definesTarget">
        <rdfs:label>definesTarget</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GlycemicTarget"/>
        <rdfs:comment>推荐所定义的管理目标区间。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>recommendation</ont:fromEntityId>
        <ont:toEntityId>glycemicTarget</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/definesSchedule">
        <rdfs:label>definesSchedule</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/MonitoringSchedule"/>
        <rdfs:comment>推荐所定义的随访/筛查频率。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>recommendation</ont:fromEntityId>
        <ont:toEntityId>monitoringSchedule</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/schedulesTest">
        <rdfs:label>schedulesTest</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/MonitoringSchedule"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LabTest"/>
        <rdfs:comment>随访计划所安排的检验项目。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>monitoringSchedule</ont:fromEntityId>
        <ont:toEntityId>labTest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/targetMeasuredBy">
        <rdfs:label>targetMeasuredBy</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GlycemicTarget"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LabTest"/>
        <rdfs:comment>目标所依据的检验项目。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>glycemicTarget</ont:fromEntityId>
        <ont:toEntityId>labTest</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/citesSource">
        <rdfs:label>citesSource</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:comment>推荐的出处。每条回答必须能回溯到这里。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>recommendation</ont:fromEntityId>
        <ont:toEntityId>guidelineSource</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/hasClinicalObservation">
        <rdfs:label>hasClinicalObservation</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Patient"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/ClinicalObservation"/>
        <rdfs:comment>患者历次非实验室临床观察。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>patient</ont:fromEntityId>
        <ont:toEntityId>clinicalObservation</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/observationRecordedAt">
        <rdfs:label>observationRecordedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/ClinicalObservation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/ClinicalEncounter"/>
        <rdfs:comment>临床观察记录所在的就诊事件。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>clinicalObservation</ont:fromEntityId>
        <ont:toEntityId>clinicalEncounter</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/observationOfSymptom">
        <rdfs:label>observationOfSymptom</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/ClinicalObservation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Symptom"/>
        <rdfs:comment>症状类观察对应的症状术语；非症状观察不使用该关系。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>clinicalObservation</ont:fromEntityId>
        <ont:toEntityId>symptom</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/hasDiagnosis">
        <rdfs:label>hasDiagnosis</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Patient"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Diagnosis"/>
        <rdfs:comment>患者历次诊断或临床判断记录。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>patient</ont:fromEntityId>
        <ont:toEntityId>diagnosis</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/diagnosedAt">
        <rdfs:label>diagnosedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Diagnosis"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/ClinicalEncounter"/>
        <rdfs:comment>诊断作出或记录所在的就诊事件。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>diagnosis</ont:fromEntityId>
        <ont:toEntityId>clinicalEncounter</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/diagnosisType">
        <rdfs:label>diagnosisType</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Diagnosis"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DiabetesType"/>
        <rdfs:comment>糖尿病或糖尿病前期诊断对应的术语节点。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>diagnosis</ont:fromEntityId>
        <ont:toEntityId>diabetesType</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/diagnosisComplication">
        <rdfs:label>diagnosisComplication</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Diagnosis"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Complication"/>
        <rdfs:comment>并发症、合并症或急性事件诊断对应的术语节点。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>diagnosis</ont:fromEntityId>
        <ont:toEntityId>complication</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/currentStage">
        <rdfs:label>currentStage</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Diagnosis"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/ComplicationStage"/>
        <rdfs:comment>该次诊断记录对应的当前分期。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>diagnosis</ont:fromEntityId>
        <ont:toEntityId>complicationStage</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/basedOnLabResult">
        <rdfs:label>basedOnLabResult</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Assessment"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/LabResult"/>
        <rdfs:comment>评估使用的一个或多个检验结果。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>assessment</ont:fromEntityId>
        <ont:toEntityId>labResult</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/appliesThreshold">
        <rdfs:label>appliesThreshold</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Assessment"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DiagnosticThreshold"/>
        <rdfs:comment>评估所应用的版本化诊断阈值。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>assessment</ont:fromEntityId>
        <ont:toEntityId>diagnosticThreshold</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/supportsDiagnosis">
        <rdfs:label>supportsDiagnosis</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Assessment"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Diagnosis"/>
        <rdfs:comment>评估支持但不单独决定的诊断记录。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>assessment</ont:fromEntityId>
        <ont:toEntityId>diagnosis</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/hasMedicationUse">
        <rdfs:label>hasMedicationUse</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Patient"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/MedicationUse"/>
        <rdfs:comment>患者历次用药记录。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>patient</ont:fromEntityId>
        <ont:toEntityId>medicationUse</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/usesMedication">
        <rdfs:label>usesMedication</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/MedicationUse"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Medication"/>
        <rdfs:comment>用药记录对应的具体药物成分。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>medicationUse</ont:fromEntityId>
        <ont:toEntityId>medication</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/treatsDiagnosis">
        <rdfs:label>treatsDiagnosis</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/MedicationUse"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Diagnosis"/>
        <rdfs:comment>该用药记录所针对的一个或多个诊断。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>medicationUse</ont:fromEntityId>
        <ont:toEntityId>diagnosis</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/medicationRecordedAt">
        <rdfs:label>medicationRecordedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/MedicationUse"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/ClinicalEncounter"/>
        <rdfs:comment>用药记录创建或更新所在的就诊事件。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>medicationUse</ont:fromEntityId>
        <ont:toEntityId>clinicalEncounter</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/hasPassage">
        <rdfs:label>hasPassage</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/GuidelineSource"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/SourcePassage"/>
        <rdfs:comment>指南来源包含的可验证证据片段。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>guidelineSource</ont:fromEntityId>
        <ont:toEntityId>sourcePassage</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/thresholdCitesPassage">
        <rdfs:label>thresholdCitesPassage</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/DiagnosticThreshold"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/SourcePassage"/>
        <rdfs:comment>诊断阈值的精确来源片段。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>diagnosticThreshold</ont:fromEntityId>
        <ont:toEntityId>sourcePassage</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/diabetes-care-ontology-v2/recommendationCites">
        <rdfs:label>recommendationCites</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/diabetes-care-ontology-v2/SourcePassage"/>
        <rdfs:comment>推荐条目的精确支持片段。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>recommendation</ont:fromEntityId>
        <ont:toEntityId>sourcePassage</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
