# 复制为项目根目录的 .env.docker，并替换所有占位值：
#   cp deploy/env.example .env.docker
#
# PostgreSQL/GraphDB 在另一台云服务器时填写其 VPC 内网地址。
# 在 Docker 宿主机上运行时可填写 host.docker.internal。

DMO_UPSTREAM_DSN=postgresql://readonly_user:change-me@10.0.0.10:5432/hospital_zd
DMO_ONTO_DSN=postgresql://dmo_user:change-me@10.0.0.10:5432/onto_db

# 这里只写 GraphDB 根地址，不能带 /repositories 或仓库名。
DMO_GRAPHDB_ENDPOINT=http://10.0.0.11:7200
DMO_GRAPHDB_REPOSITORY=dmo
DMO_GRAPHDB_TIMEOUT=30
