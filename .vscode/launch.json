{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DMO API (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "dmo.cli",
      "args": ["serve", "--port", "8100"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    }
  ]
}
